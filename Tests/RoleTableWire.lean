import IxC.Kernel.Ixon.RoleTable

/-! # Interoperability vectors for the role table's wire codec (`role-table-wire`)

`Tests/Fixtures/ixon-v4/role-table.tsv` holds one encoded role table per line,
produced by IxC's codec (`RoleTable.toBytes`, round-tripped through
`RoleTable.ofBytes`). Rust's codec is checked against the file on every pull
request (`crates/ixon/src/role_table/tests.rs`); the primary entry
`role-table-wire` checks that IxC's codec still produces it, so the file cannot
go stale while Rust keeps agreeing with old bytes.

Regenerate the file from IxC's codec with
`IX_WRITE_ROLE_TABLE_WIRE=1 lake test -- role-table-wire`. This exercises wire
canonicality, not `RoleTable.check` or admission. -/

namespace Tests.RoleTableWire

open Ix.Kernel

def path : System.FilePath := "Tests" / "Fixtures" / "ixon-v4" / "role-table.tsv"

private def addr (seed : Nat) : Address :=
  ⟨⟨(Array.range 32).map fun i => (seed + i).toUInt8⟩⟩

private def cases : List (String × RoleTable) :=
  [("empty-0", ⟨0, #[], #[]⟩), ("empty-255", ⟨255, #[], #[]⟩),
   ("all-roles", ⟨2, Role.all.toArray.map (fun r => (r, addr r.idx)), #[]⟩),
   ("wire-only", ⟨0, #[(.nat, addr 7), (.natZero, addr 7)],
     #[(.eq, #[.defeq, .proof (addr 241)]), (.sorryAx, #[])]⟩),
   ("evidence-255", ⟨2, #[], #[(.natDiv, (Array.range 255).map fun i =>
     if i % 2 == 0 then .defeq else .proof (addr i))]⟩)] ++
  Role.all.map (fun r => (s!"role-{r.leanName}", ⟨r.idx, #[(r, addr r.idx)], #[]⟩))

private def hex (bytes : ByteArray) : String :=
  String.join <| bytes.data.toList.map fun b =>
    let s := String.ofList (Nat.toDigits 16 b.toNat)
    if s.length == 1 then "0" ++ s else s

/-- The file's expected contents, from IxC's codec. -/
def render : Except String String := do
  let mut out := "# Generated by Tests/RoleTableWire.lean from IxC RoleTable.toBytes/ofBytes\n"
  for (name, table) in cases do
    unless table.wireWF do throw s!"{name}: outside wireWF"
    let bytes := table.toBytes
    let some decoded := RoleTable.ofBytes bytes
      | throw s!"{name}: decode refused encoded table"
    unless decoded.toBytes == bytes do
      throw s!"{name}: decoded encoding changed"
    out := out ++ s!"{name}\t{hex bytes}\n"
  pure out

/-- `role-table-wire`: the committed vectors are IxC's codec's, or, with
`IX_WRITE_ROLE_TABLE_WIRE=1`, write them. -/
def run : IO UInt32 := do
  let expected ← match render with
    | .ok s => pure s
    | .error e => IO.eprintln s!"[role-table-wire] {e}"; return 1
  if (← IO.getEnv "IX_WRITE_ROLE_TABLE_WIRE") == some "1" then
    IO.FS.writeFile path expected
    IO.println s!"[role-table-wire] wrote {path}: {cases.length} cases"
    return 0
  unless (← IO.FS.readFile path) == expected do
    IO.eprintln s!"[role-table-wire] {path} differs from IxC's wire codec; regenerate it with \
      IX_WRITE_ROLE_TABLE_WIRE=1 lake test -- role-table-wire if the codec change is intended"
    return 1
  IO.println s!"[role-table-wire] {path} matches IxC's codec: {cases.length} cases"
  return 0

end Tests.RoleTableWire
