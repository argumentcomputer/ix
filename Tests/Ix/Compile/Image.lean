/-
  image-gen: the pure image generator (`Ix.Compile.Image`) on the prototype's
  fifteen retained prototype sub-cases (`Tests/Ix/Compile/Image/`), with
  Lean's kernel as the oracle.

  Fixtures: `Tests/Ix/Compile/Image/C*.lean` are the prototype's case files
  without its commands: each declares a source block (`Ck.Src`) with its user
  functions and the prototype's hand-written canonical block (`Ck.Can`). They
  are elaborated at run time (`getFileEnvCore`) and are in no Lake library.

  Per sub-case, in a scratch environment grown with `addDecl` (every
  declaration through Lean's kernel, `Elab.async false`):

  * **G** the canonical form from Pass 1 (`canonBlock Rules.phaseA`) and the
    canonical declarations from it (`ImageSpec.ofBlock`), declared as
    `Ck.Gen.*`: the kernel generates their recursors, whose types are the
    generator's input (in the compiler, Pass 2's recursors);
  * **T** the images of every Lean recursor of the block, generated by the
    pure function, added as definitions `Ck.View.*.rec` (38 expected);
  * **I** every computation rule over the image, as generated, by `Eq.refl`
    (62 expected);
  * **CMP** each image and rule statement against the prototype's
    `buildTransport` / `iotaStatements` on the hand-written `Ck.Can`, after
    renaming `Gen` to `Can`: equal, equal up to level normalisation, or
    different (logged);
  * **V/L** the prototype's view: every other source constant copied over
    the images under renaming (`copyAll`), as PRO did;
  * **B1** the prototype's transport-inlined normal forms `f._N` and
    `f._N = f` by `Eq.refl` (45 expected);
  * **H** the call-site form: every definition of the view whose value has
    a full application of an image is rewritten with `Image.inline` (the
    development, hereditary substitution) into `f._H`, which must type-check
    with `f`'s type and satisfy `f._H = f` by `Eq.refl`;
  * the two ablations of PRO as negative controls: `C4b-naive` (head
    recursor first: the rule `A2.rec_1.iota_node` must be rejected) and
    `C8-nolift` (no lift: all three images must be rejected).

  Logs (eliminator choices, images, differences): `out/image-gen/<case>.log`;
  every verdict: `out/image-gen/results.tsv`.

  Invoked as `lake test -- image-gen`.
-/
import Lean
import Ix.Compile.Canon
import Ix.Compile.Image
import Ix.CanonM
import Ix.Meta
import Tests.Ix.Compile.ImageProto

open Lean Meta

namespace Tests.Ix.Compile.Image

open _root_.Ix.Compile.Image (GenOptions ImageSpec Naming Image imagesOfBlock)

/-! ## Conversions between Lean's and Ix's terms (test side only) -/

def toLeanName : _root_.Ix.Name → Lean.Name
  | .anonymous _ => .anonymous
  | .str p s _ => .str (toLeanName p) s
  | .num p n _ => .num (toLeanName p) n

def ixName (n : Lean.Name) : _root_.Ix.Name := _root_.Ix.Name.fromLeanName n

def toIx (c : ConstantInfo) : _root_.Ix.ConstantInfo := (_root_.Ix.CanonM.canonConst c).run' {}
def toIxExpr (e : Expr) : _root_.Ix.Expr := (_root_.Ix.CanonM.canonExpr e).run' {}
def toLeanExpr (e : _root_.Ix.Expr) : Expr := (_root_.Ix.CanonM.uncanonExpr e).run' {}

/-- The generator's view of a Lean environment. -/
def ixLookup (env : Environment) (n : _root_.Ix.Name) : Option _root_.Ix.ConstantInfo :=
  let n' := toLeanName n
  -- the nested auxiliary recursors the kernel generates for a raw `addDecl` are in the kernel
  -- environment only (Lean 4.34.1: `Environment.find?` misses them)
  ((env.find? n').orElse fun _ => env.toKernelEnv.find? n').map toIx

/-! ## Cases -/

structure Case where
  name : String
  /-- `Ck` (source block `Ck.Src`, prototype's canonical block `Ck.Can`). -/
  ns : Lean.Name
  /-- The prototype's hand map, source member ↦ `Ck.Can` member. -/
  hand : Array (Lean.Name × Lean.Name)
  users : Array Lean.Name
  /-- B1 bridges: view names relative to `Ck.View`. -/
  nf : Array Lean.Name
  opts : GenOptions := {}
  /-- An ablation reuses its base case's canonical blocks and only builds
  images into its own view namespace. -/
  ablationOf : Option Lean.Name := none
  viewNs? : Option Lean.Name := none

def Case.srcNs (c : Case) : Lean.Name := c.ns ++ `Src
def Case.canNs (c : Case) : Lean.Name := c.ns ++ `Can
def Case.genNs (c : Case) : Lean.Name := (c.ablationOf.getD c.ns) ++ `Gen
def Case.viewNs (c : Case) : Lean.Name := c.viewNs?.getD (c.ns ++ `View)

def pairs (ns : Lean.Name) (xs : List (Lean.Name × Lean.Name)) : Array (Lean.Name × Lean.Name) :=
  xs.toArray.map fun (a, b) => (ns ++ `Src ++ a, ns ++ `Can ++ b)

