/-
  Library twins generated by Lean's own constructions (`Gen.twinBlock`), the
  oracle experiment's `LibOrig`/`LibTwin` for the blocks of Lean core:
  for each library block, `Orig` re-declares it in Lean's member order and
  `Twin` in Ix's canonical order (or split into its components), each with
  every auxiliary Lean's elaborator would add. `Orig` replays the library's
  own declaration (ORA: the replay is byte-identical to the library's
  auxiliaries); `Twin` is the canonical presentation.

  - LCNF `Alt` (`Cases`, `FunDecl`, `Alt`, `Code`): a reorder;
  - Cutsat `EqCnstr` (12 members): a reorder;
  - Linear `EqCnstr` (7 members): a split into three components.

  The experiment's other library twins, Mathlib's `Ring` `ExBase` and
  Aesop's `GoalUnsafe`, need Mathlib and Aesop, which the test library does
  not depend on.
-/
import Tests.Ix.Compile.Oracle.Gen
open Lean Tests.Ix.Compile.Oracle.Gen

namespace Tests.Ix.Compile.Oracle.Lib

/-- (a member of the library block, the canonical components) -/
def blocks : List (Name × List Comp) := [
  (`Lean.Compiler.LCNF.Alt,
    [{ members := [`Lean.Compiler.LCNF.Cases, `Lean.Compiler.LCNF.FunDecl, `Lean.Compiler.LCNF.Alt,
                   `Lean.Compiler.LCNF.Code] }]),
  (`Lean.Meta.Grind.Arith.Cutsat.EqCnstr,
    [{ members := [`Lean.Meta.Grind.Arith.Cutsat.DiseqCnstr, `Lean.Meta.Grind.Arith.Cutsat.LeCnstr,
        `Lean.Meta.Grind.Arith.Cutsat.EqCnstr, `Lean.Meta.Grind.Arith.Cutsat.CooperSplit,
        `Lean.Meta.Grind.Arith.Cutsat.DvdCnstr, `Lean.Meta.Grind.Arith.Cutsat.CooperSplitPred,
        `Lean.Meta.Grind.Arith.Cutsat.CooperSplitProof, `Lean.Meta.Grind.Arith.Cutsat.UnsatProof,
        `Lean.Meta.Grind.Arith.Cutsat.DiseqCnstrProof, `Lean.Meta.Grind.Arith.Cutsat.DvdCnstrProof,
        `Lean.Meta.Grind.Arith.Cutsat.LeCnstrProof, `Lean.Meta.Grind.Arith.Cutsat.EqCnstrProof] }]),
  (`Lean.Meta.Grind.Arith.Linear.EqCnstr,
    [{ members := [`Lean.Meta.Grind.Arith.Linear.EqCnstr, `Lean.Meta.Grind.Arith.Linear.EqCnstrProof] },
     { members := [`Lean.Meta.Grind.Arith.Linear.IneqCnstr, `Lean.Meta.Grind.Arith.Linear.UnsatProof,
        `Lean.Meta.Grind.Arith.Linear.IneqCnstrProof] },
     { members := [`Lean.Meta.Grind.Arith.Linear.DiseqCnstr,
        `Lean.Meta.Grind.Arith.Linear.DiseqCnstrProof] }])
]

run_meta do
  for (m, comps) in blocks do
    let iv ← getConstInfoInduct m
    twinBlock `Tests.Ix.Compile.Oracle.Lib.Orig [{ members := iv.all }]
    twinBlock `Tests.Ix.Compile.Oracle.Lib.Twin comps

end Tests.Ix.Compile.Oracle.Lib
