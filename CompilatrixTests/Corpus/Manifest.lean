import CompilatrixTests.Corpus.Json
import Compilatrix.Tools.Check

/-! The corpus manifest, format `compilatrix/corpus/1` (MT.1).

One manifest describes one fixture family: a directory of frozen Ixon v3
closures, each compiled by ix from one Lean source file, with its
`eq_def` sidecar and admission census. Per closure (a *fixture*) it records
the source, its licence and origins, the ix command, the closure's and the
sidecar's hashes, and per root its address, arity, result type, oracles,
tier-relevant expectations (an expected decline `stage: code`) and its cases:
arguments with the output Lean 4.34's interpreter printed for them.

Fields are either *reviewed* (written by hand: sources, licences, roots,
hand-picked arguments, independent constants, expected declines, generator
seeds) or *derived* (hashes, sizes, addresses, the interpreter's outputs, the
generated arguments). `corpus rebuild` recomputes the derived fields with ix
and Lean; `corpus check` verifies them against the frozen files without ix.
See `docs/corpus.md`. -/

namespace CompilatrixTests.Corpus

open Lean Compilatrix.Tools.Check

def format : String := "compilatrix/corpus/1"

/-- The registered families (`corpus check` and `tests-corpus` with no
manifest take all of them). -/
def families : List System.FilePath :=
  ["fixtures/ixon-v3/bench-k1/corpus.json", "fixtures/corpus/phase1-scalar/corpus.json",
   "fixtures/corpus/phase1-boundary/corpus.json",
   "fixtures/corpus/phase1-resource/corpus.json",
   "fixtures/corpus/phase1-decline/corpus.json",
   "fixtures/corpus/phase1-abi/corpus.json"]

/-- A file of the pack and its hash (`bytes` for closures). -/
structure FileRec where
  path : String
  sha256 : String := ""
  bytes : Option Nat := none
  deriving Inhabited, BEq

/-- One case of a root: arguments, the interpreter's output, and optionally
an independent constant it must equal. -/
structure Case where
  args : List Nat
  /-- What `lean --run` printed (derived). -/
  value : String := ""
  /-- An independent oracle's value (reviewed). -/
  constant : Option String := none
  /-- Also run on the typed x86 machine and ByteEval (reviewed; these step
  one instruction at a time, so only small cases). -/
  machine : Bool := false
  /-- Resource failures allowed although the arguments and the result have
  words (reviewed): `natOverflow` (status 3) when an intermediate value
  reaches `2⁶³`, `heap` (status 1) when the immortal allocations of a run
  outgrow a level's region (the word levels run in a 64 KiB region,
  native code in 16 MiB), `stack` (status 2). -/
  allow : List String := []
  /-- A failure the word levels and native code must give (reviewed):
  `natOverflow`, `heap`, `stack` or `trap` (statuses 3, 1, 2, 4). Every level
  that models it must fail with it (`stack`: the typed x86 machine, ByteEval
  and native code; the others: Lir onwards); the levels that do not, and the
  source levels, give the value. -/
  fail : Option String := none
  /-- The failure (`fail` or `allow`) is a completeness gap (reviewed):
  nothing the source program computes reaches the limit. -/
  spurious : Bool := false
  /-- The region's bytes for this case (reviewed): the word levels' region
  (default 64 KiB) and the driver's `--region` (default 16 MiB). -/
  region : Option Nat := none
  /-- The stack's bytes for this case (reviewed): the driver's `--stack`
  (default 256 MiB), and `stack − 4096` as the typed x86 machine's and
  ByteEval's stack budget (as the driver passes `cx_init`). -/
  stack : Option Nat := none
  /-- Why the case is there, and where its expectation comes from (reviewed). -/
  note : Option String := none
  /-- Lean's interpreter fails on this case (reviewed; e.g. its `Nat.pow`
  refuses an exponent of `2³²` or more), so the interpreter does not run it
  and its `value` is its `constant`. -/
  leanFails : Bool := false
  /-- Drawn from the root's generator (derived; regenerated by a rebuild). -/
  generated : Bool := false
  deriving Inhabited, BEq

/-- A seeded generator of arguments: per parameter an inclusive range. -/
structure Gen where
  seed : Nat
  count : Nat
  ranges : List (Nat × Nat)
  deriving Inhabited, BEq

/-- An expected decline. -/
structure Decline where
  stage : String
  code : String
  deriving Inhabited, BEq

structure Root where
  name : String
  address : String := ""
  params : Nat
  /-- `nat`, `bool`, `enum` (a field-less inductive of `ctors` constructors;
  the interpreter prints the constructor's index), or `other` (a declined
  root with no cases). -/
  result : String := "nat"
  /-- An `enum` result's constructor count. -/
  ctors : Option Nat := none
  /-- Further roots of the fixture compiled into the same object (the
  decline, or the cases, are of that object). -/
  together : List String := []
  oracles : List String := ["lean-run"]
  decline : Option Decline := none
  gen : Option Gen := none
  cases : List Case := []
  note : Option String := none
  deriving Inhabited, BEq

structure Source where
  path : String
  sha256 : String := ""
  license : String
  variant : String
  /-- Upstream origins (reviewed, passed through). -/
  origins : OJson := .arr #[]
  deriving Inhabited, BEq

structure Fixture where
  name : String
  source : Source
  /-- The `--consts` seeds (the roots' names, by default). -/
  consts : List String
  /-- How the interpreter is run: `args` (one `lean --run SRC ARGS…` per
  case, printing one line) or `stdin` (one run; a line `ROOT ARGS…` per
  case on stdin, one output line each). -/
  protocol : String := "stdin"
  /-- Constructs the source scan otherwise forbids (`partial`, `unsafe`, …)
  that this source uses on purpose (reviewed; decline fixtures only). -/
  allowConstructs : List String := []
  closure : FileRec
  equations : FileRec
  equationCount : Nat := 0
  failureCount : Nat := 0
  namedEnvSha256 : String := ""
  census : FileRec
  roots : List Root
  deriving Inhabited, BEq

structure Producer where
  ixRevision : String
  ixBinarySha256 : String
  ixVersion : String
  ixBuild : String := ""
  deriving Inhabited, BEq

structure Family where
  family : String
  description : String := ""
  tier : String
  phase : Nat
  /-- The frozen files' directory, relative to the repository root. -/
  directory : String
  /-- The sources' directory (ix and Lean run here), relative to the
  repository root. -/
  sourceRoot : String
  leanVersion : String := "4.34.0"
  producer : Producer
  fixtures : List Fixture
  deriving Inhabited, BEq

/-! ## The ix and Lean commands -/

/-- The anonymous closure's command (`{…}` are placeholders). -/
def anonCommand : List String :=
  ["ix", "compile", "--no-build", "--consts", "{consts}", "--equations", "--anon", "--out", "{ixe}",
   "--equations-out", "{equations}", "{src}"]

/-- The named twin's command (for addresses; not retained). -/
def namedCommand : List String :=
  ["ix", "compile", "--no-build", "--consts", "{consts}", "--equations", "--out", "{named}",
   "--equations-out", "{named-equations}", "{src}"]

def addrCommand : List String := ["ix", "addr-of", "--ixe", "{named}", "{name}"]

def interpretCommand (protocol : String) : List String :=
  if protocol == "args" then ["lean", "-Dlinter.all=false", "--run", "{src}", "{args}"]
  else ["lean", "-Dlinter.all=false", "--run", "{src}", "<", "{ROOT ARGS lines}"]

/-! ## Reading -/

private def optStr (j : Json) (k : String) : Option String := (j.getObjValAs? String k).toOption
private def optBool (j : Json) (k : String) : Bool := (j.getObjValAs? Bool k).toOption.getD false
private def optNat (j : Json) (k : String) : Option Nat := (j.getObjValAs? Nat k).toOption

def natOf (j : Json) : IO Nat := do
  match j with
  | .num n => if n.exponent == 0 && n.mantissa ≥ 0 then pure n.mantissa.toNat
              else throw (IO.userError s!"not a natural number: {j.compress}")
  | .str s => present s.toNat? s!"not a natural number: {s}"
  | _ => throw (IO.userError s!"not a natural number: {j.compress}")

def FileRec.ofJson (j : Json) : IO FileRec := do
  return { path := ← strField j "path", sha256 := (optStr j "sha256").getD "", bytes := optNat j "bytes" }

def Case.ofJson (j : Json) : IO Case := do
  return { args := ← (← arrField j "args").toList.mapM natOf
           value := (optStr j "value").getD "", constant := optStr j "constant"
           machine := optBool j "machine", allow := ((j.getObjValAs? (Array String) "allow").toOption.getD #[]).toList
           fail := optStr j "fail", spurious := optBool j "spurious"
           region := ← optNatOf j "region", stack := ← optNatOf j "stack", note := optStr j "note"
           leanFails := optBool j "lean_fails"
           generated := optBool j "generated" }
where
  optNatOf (j : Json) (k : String) : IO (Option Nat) :=
    match j.getObjVal? k with
    | .ok v => some <$> natOf v
    | .error _ => pure none

def Root.ofJson (j : Json) : IO Root := do
  let decline ← match j.getObjVal? "decline" with
    | .ok d@(.obj _) => pure (some { stage := ← strField d "stage", code := ← strField d "code" })
    | _ => pure none
  let gen ← match j.getObjVal? "generate" with
    | .ok g@(.obj _) =>
      let ranges ← (← arrField g "ranges").toList.mapM fun r => do
        match ← (array r) with
        | #[lo, hi] => return (← natOf lo, ← natOf hi)
        | _ => throw (IO.userError s!"bad range {r.compress}")
      pure (some { seed := ← nat (← field g "seed"), count := ← nat (← field g "count"), ranges })
    | _ => pure none
  return { name := ← strField j "name", address := (optStr j "address").getD ""
           params := ← nat (← field j "params"), result := (optStr j "result").getD "nat"
           ctors := optNat j "ctors"
           together := ((j.getObjValAs? (Array String) "together").toOption.getD #[]).toList
           oracles := ← ((j.getObjValAs? (Array String) "oracles").toOption.getD #["lean-run"]).toList.mapM pure
           decline, gen, note := optStr j "note"
           cases := ← (← arrField j "cases").toList.mapM Case.ofJson }

def Source.ofJson (j : Json) : IO Source := do
  return { path := ← strField j "path", sha256 := (optStr j "sha256").getD ""
           license := ← strField j "license", variant := ← strField j "variant"
           origins := ← checked (OJson.ofJson ((j.getObjVal? "origins").toOption.getD (.arr #[]))) }

def Fixture.ofJson (j : Json) : IO Fixture := do
  let eqs ← field j "equations"
  return { name := ← strField j "name", source := ← Source.ofJson (← field j "source")
           consts := ← (← arrField j "consts").toList.mapM string
           protocol := (optStr j "protocol").getD "stdin"
           allowConstructs := ((j.getObjValAs? (Array String) "allow_constructs").toOption.getD #[]).toList
           closure := ← FileRec.ofJson (← field j "closure")
           equations := ← FileRec.ofJson eqs
           equationCount := (optNat eqs "equations").getD 0, failureCount := (optNat eqs "failures").getD 0
           namedEnvSha256 := (optStr j "named_env_sha256").getD ""
           census := ← FileRec.ofJson (← field j "census")
           roots := ← (← arrField j "roots").toList.mapM Root.ofJson }

def Family.ofJson (j : Json) : IO Family := do
  need ((← strField j "format") == format) s!"not a {format} manifest"
  let p ← field j "producer"
  return { family := ← strField j "family", description := (optStr j "description").getD ""
           tier := ← strField j "tier", phase := ← nat (← field j "phase")
           directory := ← strField j "directory", sourceRoot := ← strField j "source_root"
           leanVersion := ← strField (← field j "lean") "version"
           producer := { ixRevision := ← strField p "ix_revision", ixBinarySha256 := ← strField p "ix_binary_sha256"
                         ixVersion := ← strField p "ix_version", ixBuild := (optStr p "ix_build").getD "" }
           fixtures := ← (← arrField j "fixtures").toList.mapM Fixture.ofJson }

def Family.read (path : System.FilePath) : IO Family := do
  try Family.ofJson (← readJson path)
  catch e => throw (IO.userError s!"{path}: {e}")

/-! ## Writing -/

def FileRec.toOJson (f : FileRec) (extra : List (String × Option OJson) := []) : OJson :=
  .fields ([("path", some (.str f.path)), ("sha256", some (.str f.sha256)),
    ("bytes", f.bytes.map .nat)] ++ extra)

def Case.toOJson (c : Case) : OJson :=
  .fields [("args", some (.arr (c.args.map OJson.nat).toArray)), ("value", some (.str c.value)),
    ("constant", c.constant.map .str), ("machine", if c.machine then some (.bool true) else none),
    ("allow", if c.allow.isEmpty then none else some (.strs c.allow)),
    ("fail", c.fail.map .str), ("spurious", if c.spurious then some (.bool true) else none),
    ("region", c.region.map .nat), ("stack", c.stack.map .nat), ("note", c.note.map .str),
    ("lean_fails", if c.leanFails then some (.bool true) else none),
    ("generated", if c.generated then some (.bool true) else none)]

def Root.toOJson (r : Root) : OJson :=
  .fields [("name", some (.str r.name)), ("address", some (.str r.address)), ("params", some (.nat r.params)),
    ("result", some (.str r.result)), ("ctors", r.ctors.map .nat),
    ("together", if r.together.isEmpty then none else some (.strs r.together)),
    ("oracles", some (.strs r.oracles)),
    ("decline", some (match r.decline with
      | some d => .obj #[("stage", .str d.stage), ("code", .str d.code)]
      | none => .null)),
    ("note", r.note.map .str),
    ("generate", r.gen.map fun g => .obj #[("seed", .nat g.seed), ("count", .nat g.count),
      ("ranges", .arr (g.ranges.map fun (lo, hi) => .arr #[.nat lo, .nat hi]).toArray)]),
    ("cases", some (.arr (r.cases.map Case.toOJson).toArray))]

def Fixture.toOJson (f : Fixture) : OJson :=
  .fields [("name", some (.str f.name)),
    ("source", some (.obj #[("path", .str f.source.path), ("sha256", .str f.source.sha256),
      ("license", .str f.source.license), ("variant", .str f.source.variant), ("origins", f.source.origins)])),
    ("consts", some (.strs f.consts)), ("protocol", some (.str f.protocol)),
    ("allow_constructs", if f.allowConstructs.isEmpty then none else some (.strs f.allowConstructs)),
    ("closure", some f.closure.toOJson),
    ("equations", some (f.equations.toOJson [("equations", some (.nat f.equationCount)),
      ("failures", some (.nat f.failureCount))])),
    ("named_env_sha256", some (.str f.namedEnvSha256)),
    ("census", some f.census.toOJson),
    ("roots", some (.arr (f.roots.map Root.toOJson).toArray))]

def Family.toOJson (m : Family) : OJson :=
  .fields [("format", some (.str format)), ("family", some (.str m.family)),
    ("description", if m.description.isEmpty then none else some (.str m.description)),
    ("tier", some (.str m.tier)), ("phase", some (.nat m.phase)),
    ("directory", some (.str m.directory)), ("source_root", some (.str m.sourceRoot)),
    ("lean", some (.obj #[("version", .str m.leanVersion),
      ("interpret", .obj #[("args", .strs (interpretCommand "args")), ("stdin", .strs (interpretCommand "stdin"))])])),
    ("producer", some (.fields [("ix_revision", some (.str m.producer.ixRevision)),
      ("ix_binary_sha256", some (.str m.producer.ixBinarySha256)),
      ("ix_version", some (.str m.producer.ixVersion)),
      ("ix_build", if m.producer.ixBuild.isEmpty then none else some (.str m.producer.ixBuild)),
      ("anonymous", some (.strs anonCommand)), ("named", some (.strs namedCommand)),
      ("address", some (.strs addrCommand))])),
    ("fixtures", some (.arr (m.fixtures.map Fixture.toOJson).toArray))]

def Family.write (m : Family) (path : System.FilePath) : IO Unit :=
  IO.FS.writeFile path m.toOJson.render

/-! ## Expectations -/

/-- The Phase 1 `Nat` words end at `2⁶³` (04 §2). -/
def limit : Nat := 2 ^ 63

/-- The resource failures and the trap, by their driver statuses 1–4. -/
def failures : List String := ["heap", "stack", "natOverflow", "trap"]

/-- The observation the source-level evaluators (unbounded `Nat`) must give:
`Rt.renderObs` of the interpreter's value. -/
def Case.sourceObs (r : Root) (c : Case) : Option String :=
  match r.result with
  | "nat" => c.value.toNat?.map toString
  | "bool" =>
    match c.value with
    | "true" => some "#1"
    | "false" => some "#0"
    | _ => none
  | "enum" => do
    let k ← c.value.toNat?
    if k < (← r.ctors) then some s!"#{k}" else none
  | _ => none

/-- What the word levels and native code must give on a case: the value's
observation (or one of the `allow`ed failures), unless `fail` names the
failure they must give instead. -/
structure Want where
  /-- The observation (none: the case has no word). -/
  value : Option String
  fail : Option String
  deriving BEq

/-- Whether a level models a failure (`stack`: only the machines and native
code have a stack). -/
def models (level fail : String) : Bool :=
  fail != "stack" || ["x86", "bytes", "native"].contains level

/-- What a compiled root must do on a case: `none` when the case is not
judged at the word level. Status 3 is required when an argument or the
result has no word. -/
def Case.expect (r : Root) (c : Case) : Option Want :=
  if c.args.any (· ≥ limit) then some { value := none, fail := some "natOverflow" }
  -- a trap has no source value: no well-typed argument reaches it
  else if c.fail == some "trap" then some { value := none, fail := some "trap" }
  else
    match r.result, c.value.toNat? with
    | "nat", some n =>
      if n ≥ limit then some { value := none, fail := some "natOverflow" }
      else some { value := some (toString n), fail := c.fail }
    | "nat", none => none
    | _, _ => (c.sourceObs r).map fun v => { value := some v, fail := c.fail }

end CompilatrixTests.Corpus
