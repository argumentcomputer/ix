# Lean
**/.lake

# Rust
**/target

# Nix
result*
.direnv/

#Ix
*.ixe
!Tests/Fixtures/ixon-v4/handoff/*.ixe
plans
refs

# TruthMines corpus artifacts: a .ixc is a self-contained directory
# (manifest + pieces + build cache) — never checked in.
*.ixc/

# Except IxCC's frozen fixtures (IxCC/fixtures, docs/corpus.md), which are
# tracked .ixe closures and .ixc catalogs: a refreeze or a new corpus family
# must not have its new files skipped by `git add` (and so by Nix).
!/IxCC/fixtures/**/*.ixe
!/IxCC/fixtures/**/*.ixc/
