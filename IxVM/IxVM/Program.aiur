  fn is_dec_prim_addr(a: Addr) -> Field {
    match address_eq(a, nat_dec_le_addr_dec()) {
      1 => {  1 } ,
      _ => {
      match address_eq(a, nat_dec_eq_addr_dec()) {
        1 => {  1 } ,
        _ => {
        match address_eq(a, nat_dec_lt_addr_dec()) {
          1 => {  1 } ,
          _ => {
          match address_eq(a, int_dec_le_addr_dec()) {
            1 => {  1 } ,
            _ => {
            match address_eq(a, int_dec_eq_addr_dec()) {
              1 => {  1 } ,
              _ => {
              match address_eq(a, int_dec_lt_addr_dec()) {
                1 => {  1 } ,
                _ => {  0 } ,
              } } ,
            } } ,
          } } ,
        } } ,
      } } ,
    }
  }

  fn is_int_dec_prim_addr(a: Addr) -> Field {
    match address_eq(a, int_dec_le_addr_dec()) {
      1 => {  1 } ,
      _ => {
      match address_eq(a, int_dec_eq_addr_dec()) {
        1 => {  1 } ,
        _ => {
        match address_eq(a, int_dec_lt_addr_dec()) {
          1 => {  1 } ,
          _ => {  0 } ,
        } } ,
      } } ,
    }
  }

  fn try_extract_int(e: KExpr) -> (Field, Field, KLimbs) {
    match load(e) {
      KExprNode::App(f, a) => {
        match load(f) {
          KExprNode::Const(caddr, _) => {
            let is_ofnat = address_eq(caddr, int_of_nat_addr_dec());
            let is_negsucc = address_eq(caddr, int_neg_succ_addr_dec());
            match is_ofnat + is_negsucc {
              0 => {  (0, 0, store(Lists::Node::Nil)) } ,
              _ => {
                match load(a) {
                  KExprNode::Lit(lit) => {
                    match lit {
                      KLiteral::Nat(limbs) => {  (1, is_negsucc, limbs) } ,
                      _ => {  (0, 0, store(Lists::Node::Nil)) } ,
                    } } ,
                  _ => {  (0, 0, store(Lists::Node::Nil)) } ,
                } } ,
            } } ,
          _ => {  (0, 0, store(Lists::Node::Nil)) } ,
        } } ,
      _ => {  (0, 0, store(Lists::Node::Nil)) } ,
    }
  }

  fn intern_int_lit(sign: Field, kl: KLimbs) -> KExpr {
    let head_addr = match sign {
      0 => {  int_of_nat_addr_dec() } ,
      _ => {  int_neg_succ_addr_dec() } ,
    };
    let head = store(KExprNode::Const(head_addr, store(Lists::Node::Nil)));
    let lit = store(KExprNode::Lit(KLiteral::Nat(kl)));
    store(KExprNode::App(head, lit))
  }

  fn try_normalize_int_decidable(head_addr: Addr,
                                     head_lvls: List<KLevel>,
                                     spine: List<KExpr>,
                                     types: List<KExpr>) -> (Field, KExpr) {
    match UInt32::less_than_fields(list_length(spine), 2) {
      1 => {  (0, store(KExprNode::BVar(0))) } ,
      _ => {
        let a0 = list_lookup(spine, 0);
        let a1 = list_lookup(spine, 1);
        match try_extract_int(a0) {
          (1, _, _) => {
            match try_extract_int(a1) {
              (1, _, _) => {  (0, store(KExprNode::BVar(0))) } ,
              _ => {  normalize_int_dec_rebuild(head_addr, head_lvls,
                                              spine, a0, a1, types) } ,
            } } ,
          _ => {  normalize_int_dec_rebuild(head_addr, head_lvls,
                                          spine, a0, a1, types) } ,
        } } ,
    }
  }

  fn normalize_int_dec_rebuild(head_addr: Addr, head_lvls: List<KLevel>,
                                spine: List<KExpr>, a0: KExpr, a1: KExpr,
                                types: List<KExpr>) -> (Field, KExpr) {
    let wa = whnf(a0, types);
    let wb = whnf(a1, types);
    match try_extract_int(wa) {
      (1, sa, na) => {
        match try_extract_int(wb) {
          (1, sb, nb) => {
            let a_e = intern_int_lit(sa, na);
            let b_e = intern_int_lit(sb, nb);
            let head = store(KExprNode::Const(head_addr, head_lvls));
            let r1 = store(KExprNode::App(head, a_e));
            let r2 = store(KExprNode::App(r1, b_e));
            let post = list_drop(spine, 2);
            (1, apply_spine(r2, post)) } ,
          _ => {  (0, store(KExprNode::BVar(0))) } ,
        } } ,
      _ => {  (0, store(KExprNode::BVar(0))) } ,
    }
  }

  fn try_dec_dispatch(head_addr: Addr, head_lvls: List<KLevel>,
                          spine: List<KExpr>, types: List<KExpr>)
                          -> (Field, KExpr) {
    match UInt32::less_than_fields(list_length(spine), 2) {
      1 => {  (0, store(KExprNode::BVar(0))) } ,
      _ => {
        match is_int_dec_prim_addr(head_addr) {
          1 => {  try_normalize_int_decidable(head_addr, head_lvls,
                                                spine, types) } ,
          _ => {
            let is_le = address_eq(head_addr, nat_dec_le_addr_dec());
            let is_eq = address_eq(head_addr, nat_dec_eq_addr_dec());
            let is_lt = address_eq(head_addr, nat_dec_lt_addr_dec());
            match is_lt {
              1 => {  dec_rewrite_lt_to_le(head_lvls, spine, types) } ,
              _ => {  dec_dispatch_le_eq(is_le, is_eq, head_addr,
                                       head_lvls, spine, types) } ,
            } } ,
        } } ,
    }
  }

  fn dec_rewrite_lt_to_le(head_lvls: List<KLevel>, spine: List<KExpr>,
                           types: List<KExpr>) -> (Field, KExpr) {
    let n_e = list_lookup(spine, 0);
    let m_e = list_lookup(spine, 1);
    let n_w = whnf(n_e, types);
    match try_extract_nat(n_w) {
      (0, _) => {  (0, store(KExprNode::BVar(0))) } ,
      (1, n_klimbs) => {
        let succ_lit = mk_nat_lit(klimbs_succ(n_klimbs));
        let dec_le_head = store(KExprNode::Const(
          nat_dec_le_addr_dec(), head_lvls));
        let app1 = store(KExprNode::App(dec_le_head, succ_lit));
        let app2 = store(KExprNode::App(app1, m_e));
        let post = list_drop(spine, 2);
        (1, apply_spine(app2, post)) } ,
    }
  }

  fn dec_dispatch_le_eq(is_le: Field, is_eq: Field,
                         head_addr: Addr, head_lvls: List<KLevel>,
                         spine: List<KExpr>, types: List<KExpr>)
                         -> (Field, KExpr) {
    let n_e = list_lookup(spine, 0);
    let m_e = list_lookup(spine, 1);
    let n_w = whnf(n_e, types);
    let m_w = whnf(m_e, types);
    match try_extract_nat(n_w) {
      (0, _) => {  (0, store(KExprNode::BVar(0))) } ,
      (1, n_kl) => {
        match try_extract_nat(m_w) {
          (0, _) => {  (0, store(KExprNode::BVar(0))) } ,
          (1, m_kl) => {
            let verdict = match is_le {
              1 => {  klimbs_le(n_kl, m_kl) } ,
              _ => {  klimbs_eq(n_kl, m_kl) } ,
            };
            dec_build_proof(is_le, is_eq, verdict, n_e, m_e,
                            head_addr, head_lvls, spine, types) } ,
        } } ,
    }
  }

  fn dec_build_proof(is_le: Field, is_eq: Field, verdict: Field,
                      n_e: KExpr, m_e: KExpr,
                      head_addr: Addr, head_lvls: List<KLevel>,
                      spine: List<KExpr>, types: List<KExpr>)
                      -> (Field, KExpr) {

    let bail = is_le * (1 - verdict);
    match bail {
      1 => {  (0, store(KExprNode::BVar(0))) } ,
      _ => {

        let one_lvl = store(KLevelNode::Succ(store(KLevelNode::Zero)));
        let eq_refl_lvls = store(Lists::Node::Cons(one_lvl, store(Lists::Node::Nil)));
        let eq_refl_c = store(KExprNode::Const(eq_refl_addr_dec(), eq_refl_lvls));
        let bool_c = store(KExprNode::Const(bool_type_addr_dec(), store(Lists::Node::Nil)));
        let bool_lit_addr = match verdict {
          1 => {  bool_true_addr() } ,
          _ => {  bool_false_addr() } ,
        };
        let bool_lit_c = store(KExprNode::Const(bool_lit_addr, store(Lists::Node::Nil)));
        let r1 = store(KExprNode::App(eq_refl_c, bool_c));
        let refl_proof = store(KExprNode::App(r1, bool_lit_c));
        let proof_fn_addr = match is_le {
          1 => {
            match verdict {
              1 => {  nat_le_of_ble_eq_true_addr_dec() } ,
              _ => {  nat_not_le_of_not_ble_eq_true_addr_dec() } ,
            } } ,
          _ => {
            match verdict {
              1 => {  nat_eq_of_beq_eq_true_addr_dec() } ,
              _ => {  nat_ne_of_beq_eq_false_addr_dec() } ,
            } } ,
        };
        let proof_c = store(KExprNode::Const(proof_fn_addr, store(Lists::Node::Nil)));
        let p1 = store(KExprNode::App(proof_c, n_e));
        let p2 = store(KExprNode::App(p1, m_e));
        let proof = store(KExprNode::App(p2, refl_proof));
        dec_finish(verdict, proof, head_addr, head_lvls, spine, types) } ,
    }
  }

  fn try_str_dec_eq(head_addr: Addr, spine: List<KExpr>,
                        types: List<KExpr>) -> (Field, KExpr) {
    match UInt32::less_than_fields(list_length(spine), 2) {
      1 => {  (0, store(KExprNode::BVar(0))) } ,
      _ => {
        let a0 = list_lookup(spine, 0);
        let a1 = list_lookup(spine, 1);
        match load(a0) {
          KExprNode::Lit(la) => {
            match la {
              KLiteral::Str(sa) => {
                match load(a1) {
                  KExprNode::Lit(lb) => {
                    match lb {
                      KLiteral::Str(sb) => {
                        match bytestream_eq(sa, sb) {
                          0 => {  (0, store(KExprNode::BVar(0))) } ,
                          _ => {  str_dec_eq_build(sa, head_addr, spine, types) } ,
                        } } ,
                      _ => {  (0, store(KExprNode::BVar(0))) } ,
                    } } ,
                  _ => {  (0, store(KExprNode::BVar(0))) } ,
                } } ,
              _ => {  (0, store(KExprNode::BVar(0))) } ,
            } } ,
          _ => {  (0, store(KExprNode::BVar(0))) } ,
        } } ,
    }
  }

  fn str_dec_eq_build(sa: ByteStream, head_addr: Addr, spine: List<KExpr>,
                       types: List<KExpr>) -> (Field, KExpr) {
    let one_lvl = store(KLevelNode::Succ(store(KLevelNode::Zero)));
    let eq_refl_lvls = store(Lists::Node::Cons(one_lvl, store(Lists::Node::Nil)));
    let eq_refl_c = store(KExprNode::Const(eq_refl_addr_dec(), eq_refl_lvls));
    let str_c = store(KExprNode::Const(string_type_addr(),
                                        store(Lists::Node::Nil)));
    let lit = store(KExprNode::Lit(KLiteral::Str(sa)));
    let r1 = store(KExprNode::App(eq_refl_c, str_c));
    let refl = store(KExprNode::App(r1, lit));

    let head_c = store(KExprNode::Const(head_addr, store(Lists::Node::Nil)));
    let two_args = list_take(spine, 2);
    let call_expr = apply_spine(head_c, two_args);
    let call_ty = k_infer(call_expr, types);
    let call_ty_w = whnf(call_ty, types);
    match collect_spine(call_ty_w) {
      (_, dec_args) => {
        match UInt32::less_than_fields(list_length(dec_args), 1) {
          1 => {  (0, store(KExprNode::BVar(0))) } ,
          _ => {
            let prop = list_lookup(dec_args, 0);
            let dec_c = store(KExprNode::Const(decidable_is_true_addr_dec(),
                                                store(Lists::Node::Nil)));
            let d1 = store(KExprNode::App(dec_c, prop));
            let d2 = store(KExprNode::App(d1, refl));
            let post = list_drop(spine, 2);
            (1, apply_spine(d2, post)) } ,
        } } ,
    }
  }

  fn dec_finish(verdict: Field, proof: KExpr, head_addr: Addr,
                 head_lvls: List<KLevel>, spine: List<KExpr>,
                 types: List<KExpr>) -> (Field, KExpr) {
    let dec_addr = match verdict {
      1 => {  decidable_is_true_addr_dec() } ,
      _ => {  decidable_is_false_addr_dec() } ,
    };
    let head_c = store(KExprNode::Const(head_addr, head_lvls));
    let two_args = list_take(spine, 2);
    let call_expr = apply_spine(head_c, two_args);
    let call_ty = k_infer(call_expr, types);
    let call_ty_w = whnf(call_ty, types);
    match collect_spine(call_ty_w) {
      (_, dec_args) => {
        match UInt32::less_than_fields(list_length(dec_args), 1) {
          1 => {  (0, store(KExprNode::BVar(0))) } ,
          _ => {
            let prop = list_lookup(dec_args, 0);
            let dec_c = store(KExprNode::Const(dec_addr, store(Lists::Node::Nil)));
            let d1 = store(KExprNode::App(dec_c, prop));
            let d2 = store(KExprNode::App(d1, proof));
            let post = list_drop(spine, 2);
            (1, apply_spine(d2, post)) } ,
        } } ,
    }
  }

  fn canon_ord_cmp_g(a: Field, b: Field) -> Field {
    match a - b {
      0 => {  1 } ,
      _ => {
        match UInt32::less_than_fields(a, b) {
          1 => {  0 } ,
          0 => {  2 } ,
        } } ,
    }
  }

  fn canon_ord_then(a: Field, b: Field) -> Field {
    match a {
      1 => {  b } ,
      _ => {  a } ,
    }
  }

  fn canon_sord_lt_strong() -> (Field, Field) { (0, 1) }
  fn canon_sord_eq_strong() -> (Field, Field) { (1, 1) }
  fn canon_sord_gt_strong() -> (Field, Field) { (2, 1) }

  fn canon_sord_then(a: (Field, Field), b: (Field, Field)) -> (Field, Field) {
    match a {
      (1, sa) => {
        match b {
          (bo, sb) => {  (bo, sa * sb) } ,
        } } ,
      _ => {  a } ,
    }
  }

  fn canon_sord_of_g(o: Field) -> (Field, Field) { (o, 1) }

  fn canon_addr_cmp(x: Addr, y: Addr) -> Field {
    let xa = load(x);
    let ya = load(y);
    canon_ord_then(canon_addr_chunk(UInt8::to_field(xa[0]), UInt8::to_field(xa[1]), UInt8::to_field(xa[2]), UInt8::to_field(xa[3]),
                                UInt8::to_field(ya[0]), UInt8::to_field(ya[1]), UInt8::to_field(ya[2]), UInt8::to_field(ya[3])),
      canon_ord_then(canon_addr_chunk(UInt8::to_field(xa[4]), UInt8::to_field(xa[5]), UInt8::to_field(xa[6]), UInt8::to_field(xa[7]),
                                  UInt8::to_field(ya[4]), UInt8::to_field(ya[5]), UInt8::to_field(ya[6]), UInt8::to_field(ya[7])),
        canon_ord_then(canon_addr_chunk(UInt8::to_field(xa[8]), UInt8::to_field(xa[9]), UInt8::to_field(xa[10]), UInt8::to_field(xa[11]),
                                    UInt8::to_field(ya[8]), UInt8::to_field(ya[9]), UInt8::to_field(ya[10]), UInt8::to_field(ya[11])),
          canon_ord_then(canon_addr_chunk(UInt8::to_field(xa[12]), UInt8::to_field(xa[13]), UInt8::to_field(xa[14]), UInt8::to_field(xa[15]),
                                      UInt8::to_field(ya[12]), UInt8::to_field(ya[13]), UInt8::to_field(ya[14]), UInt8::to_field(ya[15])),
            canon_ord_then(canon_addr_chunk(UInt8::to_field(xa[16]), UInt8::to_field(xa[17]), UInt8::to_field(xa[18]), UInt8::to_field(xa[19]),
                                        UInt8::to_field(ya[16]), UInt8::to_field(ya[17]), UInt8::to_field(ya[18]), UInt8::to_field(ya[19])),
              canon_ord_then(canon_addr_chunk(UInt8::to_field(xa[20]), UInt8::to_field(xa[21]), UInt8::to_field(xa[22]), UInt8::to_field(xa[23]),
                                          UInt8::to_field(ya[20]), UInt8::to_field(ya[21]), UInt8::to_field(ya[22]), UInt8::to_field(ya[23])),
                canon_ord_then(canon_addr_chunk(UInt8::to_field(xa[24]), UInt8::to_field(xa[25]), UInt8::to_field(xa[26]), UInt8::to_field(xa[27]),
                                            UInt8::to_field(ya[24]), UInt8::to_field(ya[25]), UInt8::to_field(ya[26]), UInt8::to_field(ya[27])),
                              canon_addr_chunk(UInt8::to_field(xa[28]), UInt8::to_field(xa[29]), UInt8::to_field(xa[30]), UInt8::to_field(xa[31]),
                                             UInt8::to_field(ya[28]), UInt8::to_field(ya[29]), UInt8::to_field(ya[30]), UInt8::to_field(ya[31])))))))))
  }

  fn canon_addr_chunk(x0: Field, x1: Field, x2: Field, x3: Field,
                    y0: Field, y1: Field, y2: Field, y3: Field) -> Field {
    let xv = x0 * 16777216 + x1 * 65536 + x2 * 256 + x3;
    let yv = y0 * 16777216 + y1 * 65536 + y2 * 256 + y3;
    canon_ord_cmp_g(xv, yv)
  }

  fn canon_ctx_class_idx(a: Addr, ctx: List<(Addr, Field)>) -> Field {
    match load(ctx) {
      Lists::Node::Nil => {  0 } ,
      Lists::Node::Cons(entry, rest) => {
        match entry {
          (ea, j) => {
            match address_eq(a, ea) {
              1 => {  1 + j } ,
              _ => {  canon_ctx_class_idx(a, rest) } ,
            } } ,
        } } ,
    }
  }

  fn canon_ctx_cmp_addr(x: Addr, y: Addr, ctx: List<(Addr, Field)>) -> (Field, Field) {
    match address_eq(x, y) {
      1 => {  canon_sord_eq_strong() } ,
      _ => {
        let mx = canon_ctx_class_idx(x, ctx);
        let my = canon_ctx_class_idx(y, ctx);
        match mx {
          0 => {
            match my {
              0 => {  canon_sord_of_g(canon_addr_cmp(x, y)) } ,
              _ => {  canon_sord_gt_strong() } ,
            } } ,
          _ => {
            match my {
              0 => {  canon_sord_lt_strong() } ,
              _ => {  (canon_ord_cmp_g(mx, my), 0) } ,
            } } ,
        } } ,
    }
  }

  fn canon_cmp_kuniv(x: KLevel, y: KLevel) -> Field {
    match load(x) {
      KLevelNode::Zero => {
        match load(y) {
          KLevelNode::Zero => {  1 } ,
          _ => {  0 } ,
        } } ,
      KLevelNode::Succ(xa) => {
        match load(y) {
          KLevelNode::Zero => {  2 } ,
          KLevelNode::Succ(ya) => {  canon_cmp_kuniv(xa, ya) } ,
          _ => {  0 } ,
        } } ,
      KLevelNode::Max(xl, xr) => {
        match load(y) {
          KLevelNode::Zero => {  2 } ,
          KLevelNode::Succ(_) => {  2 } ,
          KLevelNode::Max(yl, yr) => {
            canon_ord_then(canon_cmp_kuniv(xl, yl), canon_cmp_kuniv(xr, yr)) } ,
          _ => {  0 } ,
        } } ,
      KLevelNode::IMax(xl, xr) => {
        match load(y) {
          KLevelNode::Zero => {  2 } ,
          KLevelNode::Succ(_) => {  2 } ,
          KLevelNode::Max(_, _) => {  2 } ,
          KLevelNode::IMax(yl, yr) => {
            canon_ord_then(canon_cmp_kuniv(xl, yl), canon_cmp_kuniv(xr, yr)) } ,
          KLevelNode::Param(_) => {  0 } ,
        } } ,
      KLevelNode::Param(xi) => {
        match load(y) {
          KLevelNode::Param(yi) => {  canon_ord_cmp_g(xi, yi) } ,
          _ => {  2 } ,
        } } ,
    }
  }

  fn canon_cmp_kuniv_list(xs: List<KLevel>, ys: List<KLevel>) -> Field {
    match load(xs) {
      Lists::Node::Nil => {
        match load(ys) {
          Lists::Node::Nil => {  1 } ,
          _ => {  0 } ,
        } } ,
      Lists::Node::Cons(xh, xt) => {
        match load(ys) {
          Lists::Node::Nil => {  2 } ,
          Lists::Node::Cons(yh, yt) => {
            canon_ord_then(canon_cmp_kuniv(xh, yh), canon_cmp_kuniv_list(xt, yt)) } ,
        } } ,
    }
  }

  fn canon_cmp_kliteral(x: KLiteral, y: KLiteral) -> Field {
    match x {
      KLiteral::Nat(xn) => {
        match y {
          KLiteral::Nat(yn) => {  canon_cmp_klimbs(xn, yn) } ,
          KLiteral::Str(_) => {  0 } ,
        } } ,
      KLiteral::Str(xb) => {
        match y {
          KLiteral::Nat(_) => {  2 } ,
          KLiteral::Str(yb) => {  canon_cmp_bytes(xb, yb) } ,
        } } ,
    }
  }

  fn canon_cmp_klimbs(x: KLimbs, y: KLimbs) -> Field {
    let xn = klimbs_normalize(x);
    let yn = klimbs_normalize(y);
    let len_ord = canon_ord_cmp_g(list_length(xn), list_length(yn));
    match len_ord {
      1 => {  canon_cmp_klimbs_tail(xn, yn) } ,
      _ => {  len_ord } ,
    }
  }

  fn canon_cmp_klimbs_tail(x: KLimbs, y: KLimbs) -> Field {
    match load(x) {
      Lists::Node::Nil => {  1 } ,
      Lists::Node::Cons(xh, xt) => {
        match load(y) {
          Lists::Node::Cons(yh, yt) => {
            let tail_ord = canon_cmp_klimbs_tail(xt, yt);
            canon_ord_then(tail_ord, canon_cmp_u64_lex(xh, yh)) } ,
        } } ,
    }
  }

  fn canon_cmp_u64_lex(a: U64, b: U64) -> Field {
    let [a0, a1, a2, a3, a4, a5, a6, a7] = a;
    let [b0, b1, b2, b3, b4, b5, b6, b7] = b;
    canon_ord_then(canon_ord_cmp_g(UInt8::to_field(a7), UInt8::to_field(b7)),
      canon_ord_then(canon_ord_cmp_g(UInt8::to_field(a6), UInt8::to_field(b6)),
        canon_ord_then(canon_ord_cmp_g(UInt8::to_field(a5), UInt8::to_field(b5)),
          canon_ord_then(canon_ord_cmp_g(UInt8::to_field(a4), UInt8::to_field(b4)),
            canon_ord_then(canon_ord_cmp_g(UInt8::to_field(a3), UInt8::to_field(b3)),
              canon_ord_then(canon_ord_cmp_g(UInt8::to_field(a2), UInt8::to_field(b2)),
                canon_ord_then(canon_ord_cmp_g(UInt8::to_field(a1), UInt8::to_field(b1)),
                  canon_ord_cmp_g(UInt8::to_field(a0), UInt8::to_field(b0)))))))))
  }

  fn canon_cmp_bytes(x: ByteStream, y: ByteStream) -> Field {
    match load(x) {
      Lists::Node::Nil => {
        match load(y) {
          Lists::Node::Nil => {  1 } ,
          _ => {  0 } ,
        } } ,
      Lists::Node::Cons(xh, xt) => {
        match load(y) {
          Lists::Node::Nil => {  2 } ,
          Lists::Node::Cons(yh, yt) => {
            canon_ord_then(canon_ord_cmp_g(UInt8::to_field(xh), UInt8::to_field(yh)),
                         canon_cmp_bytes(xt, yt)) } ,
        } } ,
    }
  }

  fn canon_cmp_kexpr_ctx(x: KExpr, y: KExpr, ctx: List<(Addr, Field)>) -> (Field, Field) {
    canon_cmp_kexpr_node_ctx(load(x), load(y), ctx)
  }

  fn canon_cmp_kexpr_node_ctx(x: KExprNode, y: KExprNode,
                            ctx: List<(Addr, Field)>) -> (Field, Field) {
    match x {
      KExprNode::BVar(xi) => {
        match y {
          KExprNode::BVar(yi) => {  canon_sord_of_g(canon_ord_cmp_g(xi, yi)) } ,
          _ => {  canon_sord_lt_strong() } ,
        } } ,
      KExprNode::Srt(xu) => {
        match y {
          KExprNode::BVar(_) => {  canon_sord_gt_strong() } ,
          KExprNode::Srt(yu) => {  canon_sord_of_g(canon_cmp_kuniv(xu, yu)) } ,
          _ => {  canon_sord_lt_strong() } ,
        } } ,
      KExprNode::Const(xa, xls) => {
        match y {
          KExprNode::BVar(_) => {  canon_sord_gt_strong() } ,
          KExprNode::Srt(_) => {  canon_sord_gt_strong() } ,
          KExprNode::Const(ya, yls) => {
            canon_sord_then(canon_sord_of_g(canon_cmp_kuniv_list(xls, yls)),
              canon_ctx_cmp_addr(xa, ya, ctx)) } ,
          _ => {  canon_sord_lt_strong() } ,
        } } ,
      KExprNode::App(xf, xa) => {
        match y {
          KExprNode::BVar(_) => {  canon_sord_gt_strong() } ,
          KExprNode::Srt(_) => {  canon_sord_gt_strong() } ,
          KExprNode::Const(_, _) => {  canon_sord_gt_strong() } ,
          KExprNode::App(yf, ya) => {
            canon_sord_then(canon_cmp_kexpr_ctx(xf, yf, ctx),
                          canon_cmp_kexpr_ctx(xa, ya, ctx)) } ,
          _ => {  canon_sord_lt_strong() } ,
        } } ,
      KExprNode::Lam(xt, xb) => {
        match y {
          KExprNode::BVar(_) => {  canon_sord_gt_strong() } ,
          KExprNode::Srt(_) => {  canon_sord_gt_strong() } ,
          KExprNode::Const(_, _) => {  canon_sord_gt_strong() } ,
          KExprNode::App(_, _) => {  canon_sord_gt_strong() } ,
          KExprNode::Lam(yt, yb) => {
            canon_sord_then(canon_cmp_kexpr_ctx(xt, yt, ctx),
                          canon_cmp_kexpr_ctx(xb, yb, ctx)) } ,
          _ => {  canon_sord_lt_strong() } ,
        } } ,
      KExprNode::Forall(xt, xb) => {
        match y {
          KExprNode::BVar(_) => {  canon_sord_gt_strong() } ,
          KExprNode::Srt(_) => {  canon_sord_gt_strong() } ,
          KExprNode::Const(_, _) => {  canon_sord_gt_strong() } ,
          KExprNode::App(_, _) => {  canon_sord_gt_strong() } ,
          KExprNode::Lam(_, _) => {  canon_sord_gt_strong() } ,
          KExprNode::Forall(yt, yb) => {
            canon_sord_then(canon_cmp_kexpr_ctx(xt, yt, ctx),
                          canon_cmp_kexpr_ctx(xb, yb, ctx)) } ,
          _ => {  canon_sord_lt_strong() } ,
        } } ,
      KExprNode::Let(xt, xv, xb) => {
        match y {
          KExprNode::BVar(_) => {  canon_sord_gt_strong() } ,
          KExprNode::Srt(_) => {  canon_sord_gt_strong() } ,
          KExprNode::Const(_, _) => {  canon_sord_gt_strong() } ,
          KExprNode::App(_, _) => {  canon_sord_gt_strong() } ,
          KExprNode::Lam(_, _) => {  canon_sord_gt_strong() } ,
          KExprNode::Forall(_, _) => {  canon_sord_gt_strong() } ,
          KExprNode::Let(yt, yv, yb) => {
            canon_sord_then(canon_cmp_kexpr_ctx(xt, yt, ctx),
              canon_sord_then(canon_cmp_kexpr_ctx(xv, yv, ctx),
                            canon_cmp_kexpr_ctx(xb, yb, ctx))) } ,
          _ => {  canon_sord_lt_strong() } ,
        } } ,
      KExprNode::Lit(xl) => {
        match y {
          KExprNode::Proj(_, _, _) => {  canon_sord_lt_strong() } ,
          KExprNode::Lit(yl) => {  canon_sord_of_g(canon_cmp_kliteral(xl, yl)) } ,
          _ => {  canon_sord_gt_strong() } ,
        } } ,
      KExprNode::Proj(xs, xf, xe) => {
        match y {
          KExprNode::Proj(ys, yf, ye) => {
            canon_sord_then(canon_ctx_cmp_addr(xs, ys, ctx),
              canon_sord_then(canon_sord_of_g(canon_ord_cmp_g(xf, yf)),
                            canon_cmp_kexpr_ctx(xe, ye, ctx))) } ,
          _ => {  canon_sord_gt_strong() } ,
        } } ,
    }
  }

  fn canon_cmp_krec_rule_ctx(x: KRecRule, y: KRecRule,
                           ctx: List<(Addr, Field)>) -> (Field, Field) {
    match x {
      KRecRule::Mk(_xc, xn, xr) => {
        match y {
          KRecRule::Mk(_yc, yn, yr) => {
            canon_sord_then(canon_sord_of_g(canon_ord_cmp_g(xn, yn)),
                          canon_cmp_kexpr_ctx(xr, yr, ctx)) } ,
        } } ,
    }
  }

  fn canon_cmp_krec_rule_list_ctx(xs: List<KRecRule>, ys: List<KRecRule>,
                                ctx: List<(Addr, Field)>) -> (Field, Field) {
    match load(xs) {
      Lists::Node::Nil => {
        match load(ys) {
          Lists::Node::Nil => {  canon_sord_eq_strong() } ,
          _ => {  canon_sord_lt_strong() } ,
        } } ,
      Lists::Node::Cons(xh, xt) => {
        match load(ys) {
          Lists::Node::Nil => {  canon_sord_gt_strong() } ,
          Lists::Node::Cons(yh, yt) => {
            canon_sord_then(canon_cmp_krec_rule_ctx(xh, yh, ctx),
                          canon_cmp_krec_rule_list_ctx(xt, yt, ctx)) } ,
        } } ,
    }
  }

  fn canon_kind_ord(c: KConstantInfo) -> Field {
    match c {
      KConstantInfo::Defn(_, _, _, _, _) => {  0 } ,
      KConstantInfo::Thm(_, _, _) => {  0 } ,
      KConstantInfo::Opaque(_, _, _, _) => {  0 } ,
      KConstantInfo::Induct(_, _, _, _, _, _, _, _) => {  1 } ,
      KConstantInfo::Rec(_, _, _, _, _, _, _, _, _, _, _) => {  2 } ,
      KConstantInfo::Ctor(_, _, _, _, _, _, _, _) => {  3 } ,
      KConstantInfo::Axiom(_, _, _) => {  4 } ,
      KConstantInfo::Quot(_, _, _) => {  5 } ,
    }
  }

  fn canon_cmp_member_ctx(x: KConstantInfo, y: KConstantInfo,
                        ctx: List<(Addr, Field)>) -> (Field, Field) {
    let kord = canon_ord_cmp_g(canon_kind_ord(x), canon_kind_ord(y));
    match kord {
      1 => {  canon_cmp_member_same_kind_ctx(x, y, ctx) } ,
      _ => {  canon_sord_of_g(kord) } ,
    }
  }

  fn canon_cmp_member_same_kind_ctx(x: KConstantInfo, y: KConstantInfo,
                                  ctx: List<(Addr, Field)>) -> (Field, Field) {
    match x {
      KConstantInfo::Defn(xn, xt, xv, _xs, _xh) => {
        match y {
          KConstantInfo::Defn(yn, yt, yv, _ys, _yh) => {
            canon_sord_then(canon_sord_of_g(canon_ord_cmp_g(xn, yn)),
              canon_sord_then(canon_cmp_kexpr_ctx(xt, yt, ctx),
                            canon_cmp_kexpr_ctx(xv, yv, ctx))) } ,
          _ => {  canon_sord_eq_strong() } ,
        } } ,

      KConstantInfo::Induct(xn, xt, xp, xi, xc, xu, xba, xidx) => {
        match y {
          KConstantInfo::Induct(yn, yt, yp, yi, yc, yu, yba, yidx) => {
            let head = canon_sord_then(canon_sord_of_g(canon_ord_cmp_g(xu, yu)),
              canon_sord_then(canon_sord_of_g(canon_ord_cmp_g(xn, yn)),
                canon_sord_then(canon_sord_of_g(canon_ord_cmp_g(xp, yp)),
                  canon_sord_of_g(canon_ord_cmp_g(xi, yi)))));

            let nctors = canon_ord_cmp_g(xc, yc);
            match nctors {
              1 => {
                canon_sord_then(head,
                  canon_sord_then(canon_cmp_kexpr_ctx(xt, yt, ctx),
                    canon_cmp_ctor_range_ctx(xba, xidx, yba, yidx,
                                           xc, ctx, 0))) } ,
              _ => {  canon_sord_then(head, canon_sord_of_g(nctors)) } ,
            } } ,
          _ => {  canon_sord_eq_strong() } ,
        } } ,
      KConstantInfo::Rec(xn, xt, xp, xi, xm, xmi, xrules, xk, _xu, _xba, _xr) => {
        match y {
          KConstantInfo::Rec(yn, yt, yp, yi, ym, ymi, yrules, yk, _yu, _yba, _yr) => {
            canon_sord_then(canon_sord_of_g(canon_ord_cmp_g(xn, yn)),
              canon_sord_then(canon_sord_of_g(canon_ord_cmp_g(xp, yp)),
                canon_sord_then(canon_sord_of_g(canon_ord_cmp_g(xi, yi)),
                  canon_sord_then(canon_sord_of_g(canon_ord_cmp_g(xm, ym)),
                    canon_sord_then(canon_sord_of_g(canon_ord_cmp_g(xmi, ymi)),
                      canon_sord_then(canon_sord_of_g(canon_ord_cmp_g(xk, yk)),
                        canon_sord_then(canon_cmp_kexpr_ctx(xt, yt, ctx),
                          canon_cmp_krec_rule_list_ctx(xrules, yrules, ctx)))))))) } ,
          _ => {  canon_sord_eq_strong() } ,
        } } ,
      _ => {  canon_sord_eq_strong() } ,
    }
  }

  fn canon_cmp_ctor_range_ctx(xba: Addr, xidx: Field, yba: Addr, yidx: Field,
                            nc: Field, ctx: List<(Addr, Field)>, c: Field) -> (Field, Field) {
    match nc - c {
      0 => {  canon_sord_eq_strong() } ,
      _ => {
        let xc = load(get_ci_cprj(xba, xidx, c));
        let yc = load(get_ci_cprj(yba, yidx, c));
        canon_sord_then(canon_cmp_ctor_pair_ctx(xc, yc, ctx),
                      canon_cmp_ctor_range_ctx(xba, xidx, yba, yidx,
                                             nc, ctx, c + 1)) } ,
    }
  }

  fn canon_cmp_ctor_pair_ctx(x: KConstantInfo, y: KConstantInfo,
                           ctx: List<(Addr, Field)>) -> (Field, Field) {
    match x {
      KConstantInfo::Ctor(xn, xt, _xb, _xi, xc, xp, xf, _xu) => {
        match y {
          KConstantInfo::Ctor(yn, yt, _yb, _yi, yc, yp, yf, _yu) => {
            canon_sord_then(canon_sord_of_g(canon_ord_cmp_g(xn, yn)),
              canon_sord_then(canon_sord_of_g(canon_ord_cmp_g(xc, yc)),
                canon_sord_then(canon_sord_of_g(canon_ord_cmp_g(xp, yp)),
                  canon_sord_then(canon_sord_of_g(canon_ord_cmp_g(xf, yf)),
                                canon_cmp_kexpr_ctx(xt, yt, ctx))))) } ,
          _ => {  canon_sord_of_g(canon_ord_cmp_g(canon_kind_ord(x), canon_kind_ord(y))) } ,
        } } ,
      _ => {  canon_sord_of_g(canon_ord_cmp_g(canon_kind_ord(x), canon_kind_ord(y))) } ,
    }
  }

  fn canon_cprj_addr(block: Addr, ind_idx: Field, cidx: Field) -> Addr {
    let info = ConstantInfo::CPrj(ConstructorProj::Mk(
      UInt64::from_field(ind_idx), UInt64::from_field(cidx), block));
    let proj_c = Constant::Mk(info,
                             store(Lists::Node::Nil),
                             store(Lists::Node::Nil),
                             store(Lists::Node::Nil));
    let bytes = put_constant(proj_c, store(Lists::Node::Nil));
    Blake3::bytes_to_addr(bytes)
  }

  fn canon_member_ci(proj_addrs: List<Addr>, pos: Field) -> KConstantInfo {
    load(get_ci(list_lookup(proj_addrs, pos)))
  }

  fn canon_member_num_ctors(proj_addrs: List<Addr>, pos: Field) -> Field {
    match canon_member_ci(proj_addrs, pos) {
      KConstantInfo::Induct(_, _, _, _, nc, _, _, _) => {  nc } ,
      _ => {  0 } ,
    }
  }

  inline fn canon_build_ctx(classes: List<List<Field>>, proj_addrs: List<Addr>,
                   block: Addr) -> List<(Addr, Field)> {
    canon_build_ctx_classes(classes, proj_addrs, block, 0, list_length(classes))
  }

  fn canon_build_ctx_classes(classes: List<List<Field>>, proj_addrs: List<Addr>,
                           block: Addr, j: Field, i: Field) -> List<(Addr, Field)> {
    match load(classes) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(cls, rest) => {
        let (entries, max_ctors) =
          canon_build_ctx_members(cls, proj_addrs, block, j, i);
        list_concat(entries,
          canon_build_ctx_classes(rest, proj_addrs, block, j + 1, i + max_ctors)) } ,
    }
  }

  fn canon_build_ctx_members(members: List<Field>, proj_addrs: List<Addr>,
                           block: Addr, j: Field, i: Field)
                           -> (List<(Addr, Field)>, Field) {
    match load(members) {
      Lists::Node::Nil => {  (store(Lists::Node::Nil), 0) } ,
      Lists::Node::Cons(pos, rest) => {
        let (rest_entries, rest_max) =
          canon_build_ctx_members(rest, proj_addrs, block, j, i);
        let n = canon_member_num_ctors(proj_addrs, pos);
        let ctor_entries = canon_ctor_ctx_entries(block, pos, n, i, 0);
        let entries = store(Lists::Node::Cons(
          (list_lookup(proj_addrs, pos), j),
          list_concat(ctor_entries, rest_entries)));
        match UInt32::less_than_fields(rest_max, n) {
          1 => {  (entries, n) } ,
          _ => {  (entries, rest_max) } ,
        } } ,
    }
  }

  fn canon_ctor_ctx_entries(block: Addr, ind_idx: Field, n: Field, i: Field,
                          cidx: Field) -> List<(Addr, Field)> {
    match n - cidx {
      0 => {  store(Lists::Node::Nil) } ,
      _ => {
        store(Lists::Node::Cons((canon_cprj_addr(block, ind_idx, cidx), i + cidx),
          canon_ctor_ctx_entries(block, ind_idx, n, i, cidx + 1))) } ,
    }
  }

  inline fn canon_sort_members(members: List<Field>, proj_addrs: List<Addr>,
                      block: Addr) -> List<List<Field>> {
    let seed = store(Lists::Node::Cons(members, store(Lists::Node::Nil)));
    canon_sort_loop(seed, proj_addrs, block, 1 + list_length(members))
  }

  fn canon_sort_loop(classes: List<List<Field>>, proj_addrs: List<Addr>,
                   block: Addr, fuel: Field) -> List<List<Field>> {
    match fuel {
      0 => {  classes } ,
      _ => {
        let ctx = canon_build_ctx(classes, proj_addrs, block);
        let new_classes = canon_refine_classes(classes, ctx, proj_addrs);
        match canon_classes_eq(classes, new_classes) {
          1 => {  classes } ,
          _ => {  canon_sort_loop(new_classes, proj_addrs, block, fuel - 1) } ,
        } } ,
    }
  }

  fn canon_refine_classes(classes: List<List<Field>>, ctx: List<(Addr, Field)>,
                        proj_addrs: List<Addr>) -> List<List<Field>> {
    match load(classes) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(c, rest) => {
        let refined = canon_refine_one(c, ctx, proj_addrs);
        list_concat(refined, canon_refine_classes(rest, ctx, proj_addrs)) } ,
    }
  }

  fn canon_refine_one(c: List<Field>, ctx: List<(Addr, Field)>,
                    proj_addrs: List<Addr>) -> List<List<Field>> {
    match list_length(c) {
      0 => {  store(Lists::Node::Nil) } ,
      1 => {  store(Lists::Node::Cons(c, store(Lists::Node::Nil))) } ,
      _ => {
        let sorted = canon_ins_sort(c, ctx, proj_addrs);
        canon_group_consec(sorted, ctx, proj_addrs) } ,
    }
  }

  fn canon_ins_sort(xs: List<Field>, ctx: List<(Addr, Field)>,
                  proj_addrs: List<Addr>) -> List<Field> {
    match load(xs) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(x, rest) => {
        canon_insert_sorted(x, canon_ins_sort(rest, ctx, proj_addrs),
                          ctx, proj_addrs) } ,
    }
  }

  fn canon_insert_sorted(x: Field, sorted: List<Field>, ctx: List<(Addr, Field)>,
                       proj_addrs: List<Addr>) -> List<Field> {
    match load(sorted) {
      Lists::Node::Nil => {  store(Lists::Node::Cons(x, store(Lists::Node::Nil))) } ,
      Lists::Node::Cons(h, rest) => {
        match canon_cmp_member_ctx(canon_member_ci(proj_addrs, x),
                                 canon_member_ci(proj_addrs, h), ctx) {
          (0, _) => {  store(Lists::Node::Cons(x, sorted)) } ,
          _ => {  store(Lists::Node::Cons(h,
                 canon_insert_sorted(x, rest, ctx, proj_addrs))) } ,
        } } ,
    }
  }

  fn canon_group_consec(sorted: List<Field>, ctx: List<(Addr, Field)>,
                      proj_addrs: List<Addr>) -> List<List<Field>> {
    match load(sorted) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(h, rest) => {
        canon_group_walk(rest, ctx, proj_addrs, h,
                       store(Lists::Node::Cons(h, store(Lists::Node::Nil)))) } ,
    }
  }

  fn canon_group_walk(remaining: List<Field>, ctx: List<(Addr, Field)>,
                    proj_addrs: List<Addr>, last: Field,
                    current: List<Field>) -> List<List<Field>> {
    match load(remaining) {
      Lists::Node::Nil => {  store(Lists::Node::Cons(current, store(Lists::Node::Nil))) } ,
      Lists::Node::Cons(h, rest) => {
        match canon_cmp_member_ctx(canon_member_ci(proj_addrs, last),
                                 canon_member_ci(proj_addrs, h), ctx) {
          (1, _) => {
            canon_group_walk(rest, ctx, proj_addrs, h, list_snoc(current, h)) } ,
          _ => {
            store(Lists::Node::Cons(current,
              canon_group_walk(rest, ctx, proj_addrs, h,
                store(Lists::Node::Cons(h, store(Lists::Node::Nil)))))) } ,
        } } ,
    }
  }

  fn canon_classes_eq(a: List<List<Field>>, b: List<List<Field>>) -> Field {
    match load(a) {
      Lists::Node::Nil => {
        match load(b) {
          Lists::Node::Nil => {  1 } ,
          _ => {  0 } ,
        } } ,
      Lists::Node::Cons(ah, arest) => {
        match load(b) {
          Lists::Node::Nil => {  0 } ,
          Lists::Node::Cons(bh, brest) => {
            match canon_g_list_eq(ah, bh) {
              0 => {  0 } ,
              _ => {  canon_classes_eq(arest, brest) } ,
            } } ,
        } } ,
    }
  }

  fn canon_g_list_eq(xs: List<Field>, ys: List<Field>) -> Field {
    match load(xs) {
      Lists::Node::Nil => {
        match load(ys) {
          Lists::Node::Nil => {  1 } ,
          _ => {  0 } ,
        } } ,
      Lists::Node::Cons(x, xt) => {
        match load(ys) {
          Lists::Node::Nil => {  0 } ,
          Lists::Node::Cons(y, yt) => {
            match x - y {
              0 => {  canon_g_list_eq(xt, yt) } ,
              _ => {  0 } ,
            } } ,
        } } ,
    }
  }

  fn canon_flatten(classes: List<List<Field>>) -> List<Field> {
    match load(classes) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(c, rest) => {
        list_concat(c, canon_flatten(rest)) } ,
    }
  }

  fn canon_all_singleton(classes: List<List<Field>>) -> Field {
    match load(classes) {
      Lists::Node::Nil => {  1 } ,
      Lists::Node::Cons(c, rest) => {
        match list_length(c) {
          1 => {  canon_all_singleton(rest) } ,
          _ => {  0 } ,
        } } ,
    }
  }

  fn canon_indc_positions(members: List<MutConst>, pos: Field) -> List<Field> {
    match load(members) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(m, rest) => {
        let tail = canon_indc_positions(rest, pos + 1);
        match m {
          MutConst::Indc(_) => {  store(Lists::Node::Cons(pos, tail)) } ,
          _ => {  tail } ,
        } } ,
    }
  }

  fn canon_muts_has_kind(members: List<MutConst>, want_defn: Field) -> Field {
    match load(members) {
      Lists::Node::Nil => {  0 } ,
      Lists::Node::Cons(m, rest) => {
        let hit = match m {
          MutConst::Defn(_) => {  want_defn } ,
          MutConst::Indc(_) => {  1 - want_defn } ,
          MutConst::Recr(_) => {  0 } ,
        };
        match hit {
          1 => {  1 } ,
          _ => {  canon_muts_has_kind(rest, want_defn) } ,
        } } ,
    }
  }

  fn check_canonical_block(block_addr: Addr) -> () {
    let c = load_verified_constant(block_addr);
    match c {
      Constant::Mk(info, _, _, _) => {
        match info {
          ConstantInfo::Muts(members) => {

            assert_eq!(canon_muts_has_kind(members, 1) *
                         canon_muts_has_kind(members, 0), 0,
              "mutual block mixes a definition member with inductives");
            let indcs = canon_indc_positions(members, 0);
            match UInt32::less_than_fields(list_length(indcs), 2) {
              1 => {  () } ,
              _ => {
                let proj_addrs = build_recur_addrs(members, block_addr);
                let classes = canon_sort_members(indcs, proj_addrs, block_addr);
                assert_eq!(canon_all_singleton(classes), 1,
                  "canonical block: refinement left members tied, order ambiguous");
                assert_eq!(canon_g_list_eq(canon_flatten(classes), indcs), 1,
                  "canonical block: members are not in canonical order");
                () } ,
            } } ,
          _ => {  () } ,
        } } ,
    }
  }

  fn is_unsafe_ci(ci: KConstantInfo) -> Field {
    match ci {
      KConstantInfo::Axiom(_, _, u) => {  u } ,
      KConstantInfo::Defn(_, _, _, s, _) => {
        match s {
          DefinitionSafety::Safe => {  0 } ,
          _ => {  1 } ,
        } } ,
      KConstantInfo::Thm(_, _, _) => {  0 } ,
      KConstantInfo::Opaque(_, _, _, u) => {  u } ,
      KConstantInfo::Quot(_, _, _) => {  0 } ,
      KConstantInfo::Induct(_, _, _, _, _, u, _, _) => {  u } ,
      KConstantInfo::Ctor(_, _, _, _, _, _, _, u) => {  u } ,
      KConstantInfo::Rec(_, _, _, _, _, _, _, _, u, _, _) => {  u } ,
    }
  }

  fn safe_refs_only(e: KExpr) -> Field {
    match load(e) {
      KExprNode::BVar(_) => {  1 } ,
      KExprNode::Srt(_) => {  1 } ,
      KExprNode::Const(caddr, _) => {
        let ci = load(get_ci(caddr));
        1 - is_unsafe_ci(ci) } ,
      KExprNode::App(f, a) => {
        safe_refs_only(f) * safe_refs_only(a) } ,
      KExprNode::Lam(t, b) => {
        safe_refs_only(t) * safe_refs_only(b) } ,
      KExprNode::Forall(t, b) => {
        safe_refs_only(t) * safe_refs_only(b) } ,
      KExprNode::Let(t, v, b) => {
        safe_refs_only(t) * safe_refs_only(v) * safe_refs_only(b) } ,
      KExprNode::Lit(_) => {  1 } ,
      KExprNode::Proj(_, _, e1) => {  safe_refs_only(e1) } ,
    }
  }

  fn assert_safety(self_unsafe: Field, e: KExpr) -> () {
    match self_unsafe {
      1 => {  () } ,
      _ => {
        assert_eq!(safe_refs_only(e), 1,
          "safe constant references an unsafe constant");
        () } ,
    }
  }

  fn validate_univ_params_seen(u: KLevel, bound: Field) -> () {
    match load(u) {
      KLevelNode::Zero => {  () } ,
      KLevelNode::Succ(inner) => {  validate_univ_params_seen(inner, bound) } ,
      KLevelNode::Max(a, b) => {
        validate_univ_params_seen(a, bound);
        validate_univ_params_seen(b, bound) } ,
      KLevelNode::IMax(a, b) => {
        validate_univ_params_seen(a, bound);
        validate_univ_params_seen(b, bound) } ,
      KLevelNode::Param(i) => {
        assert_eq!(UInt32::less_than_fields(i, bound), 1,
          "universe param index out of range");
        () } ,
    }
  }

  fn validate_univ_params_list(lvls: List<KLevel>, bound: Field) -> () {
    match load(lvls) {
      Lists::Node::Nil => {  () } ,
      Lists::Node::Cons(u, rest) => {
        validate_univ_params_seen(u, bound);
        validate_univ_params_list(rest, bound) } ,
    }
  }

  fn validate_expr_well_scoped(e: KExpr, depth: Field, bound: Field) -> () {
    match load(e) {
      KExprNode::BVar(i) => {
        assert_eq!(UInt32::less_than_fields(i, depth), 1,
          "loose bound variable: BVar index exceeds binder depth");
        () } ,
      KExprNode::Srt(l) => {  validate_univ_params_seen(l, bound) } ,
      KExprNode::Const(addr, lvls) => {
        let ci = load(get_ci(addr));
        let expected = const_num_lvls(ci);
        assert_eq!(list_length(lvls), expected,
          "Const applied to wrong number of universe levels");
        validate_univ_params_list(lvls, bound) } ,
      KExprNode::App(f, a) => {
        validate_expr_well_scoped(f, depth, bound);
        validate_expr_well_scoped(a, depth, bound) } ,
      KExprNode::Lam(t, b) => {
        validate_expr_well_scoped(t, depth, bound);
        validate_expr_well_scoped(b, depth + 1, bound) } ,
      KExprNode::Forall(t, b) => {
        validate_expr_well_scoped(t, depth, bound);
        validate_expr_well_scoped(b, depth + 1, bound) } ,
      KExprNode::Let(t, v, b) => {
        validate_expr_well_scoped(t, depth, bound);
        validate_expr_well_scoped(v, depth, bound);
        validate_expr_well_scoped(b, depth + 1, bound) } ,
      KExprNode::Lit(_) => {  () } ,
      KExprNode::Proj(_, _, e1) => {
        validate_expr_well_scoped(e1, depth, bound) } ,
    }
  }

