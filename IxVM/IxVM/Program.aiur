  fn is_str_prim_addr(a: Addr) -> Field {
    match address_eq(a, string_utf8_byte_size_addr()) {
      1 => {  1 } ,
      _ => {
      match address_eq(a, string_append_addr()) {
        1 => {  1 } ,
        _ => {
        match address_eq(a, string_of_list_addr()) {
          1 => {  1 } ,
          _ => {
          match address_eq(a, string_back_addr()) {
            1 => {  1 } ,
            _ => {
            match address_eq(a, string_legacy_back_addr()) {
              1 => {  1 } ,
              _ => {
              match address_eq(a, string_to_byte_array_addr()) {
                1 => {  1 } ,
                _ => {
                match address_eq(a, string_dec_eq_addr()) {
                  1 => {  1 } ,
                  _ => {  0 } ,
                } } ,
              } } ,
            } } ,
          } } ,
        } } ,
      } } ,
    }
  }

  fn try_str_dispatch(head_addr: Addr, spine: List<KExpr>,
                          types: List<KExpr>) -> (Field, KExpr) {
    let spine_len = list_length(spine);
    match address_eq(head_addr, string_of_list_addr()) {
      1 => {
        match spine_len {
          1 => {
            match walk_char_list_bytes(list_lookup(spine, 0), types) {
              (1, bs) => {  (1, store(KExprNode::Lit(KLiteral::Str(bs)))) } ,
              (0, _) => {  (0, store(KExprNode::BVar(0))) } ,
            } } ,
          _ => {  (0, store(KExprNode::BVar(0))) } ,
        } } ,
      _ => {
    match address_eq(head_addr, string_utf8_byte_size_addr()) {
      1 => {
        match UInt32::less_than_fields(spine_len, 1) {
          1 => {  (0, store(KExprNode::BVar(0))) } ,
          _ => {
            let a0 = list_lookup(spine, 0);
            match load(a0) {
              KExprNode::Lit(lit) => {
                match lit {
                  KLiteral::Str(bs) => {

                    let limbs = klimbs_from_g(list_length(bs));
                    (1, store(KExprNode::Lit(KLiteral::Nat(limbs)))) } ,
                  _ => {  (0, store(KExprNode::BVar(0))) } ,
                } } ,
              _ => {  (0, store(KExprNode::BVar(0))) } ,
            } } ,
        } } ,
      _ => {
    match address_eq(head_addr, string_back_addr()) {
      1 => {  try_str_back(spine) } ,
      _ => {
    match address_eq(head_addr, string_legacy_back_addr()) {
      1 => {  try_str_back(spine) } ,
      _ => {
    match address_eq(head_addr, string_to_byte_array_addr()) {
      1 => {  try_str_to_byte_array(spine) } ,
      _ => {
    match address_eq(head_addr, string_dec_eq_addr()) {
      1 => {  try_str_dec_eq(head_addr, spine, types) } ,
      _ => {
        match address_eq(head_addr, string_append_addr()) {
          1 => {
            match UInt32::less_than_fields(spine_len, 2) {
              1 => {  (0, store(KExprNode::BVar(0))) } ,
              _ => {
                let a0 = list_lookup(spine, 0);
                let a1 = list_lookup(spine, 1);
                match load(a0) {
                  KExprNode::Lit(la) => {
                    match la {
                      KLiteral::Str(sa) => {
                        match load(a1) {
                          KExprNode::Lit(lb) => {
                            match lb {
                              KLiteral::Str(sb) => {
                                let joined = list_concat(sa, sb);
                                (1, store(KExprNode::Lit(KLiteral::Str(joined)))) } ,
                              _ => {  (0, store(KExprNode::BVar(0))) } ,
                            } } ,
                          _ => {  (0, store(KExprNode::BVar(0))) } ,
                        } } ,
                      _ => {  (0, store(KExprNode::BVar(0))) } ,
                    } } ,
                  _ => {  (0, store(KExprNode::BVar(0))) } ,
                } } ,
            } } ,
          _ => {  (0, store(KExprNode::BVar(0))) } ,
        } } ,
    } } ,
    } } ,
    } } ,
    } } ,
    } } ,
    }
  }

  fn try_str_back(spine: List<KExpr>) -> (Field, KExpr) {
    match UInt32::less_than_fields(list_length(spine), 1) {
      1 => {  (0, store(KExprNode::BVar(0))) } ,
      _ => {
        match load(list_lookup(spine, 0)) {
          KExprNode::Lit(lit) => {
            match lit {
              KLiteral::Str(bs) => {
                let cp = utf8_last_codepoint(bs);
                let cp_limbs = klimbs_from_g(cp);
                let cp_lit = store(KExprNode::Lit(KLiteral::Nat(cp_limbs)));
                let con = store(KExprNode::Const(char_of_nat_addr(),
                                                 store(Lists::Node::Nil)));
                (1, store(KExprNode::App(con, cp_lit))) } ,
              _ => {  (0, store(KExprNode::BVar(0))) } ,
            } } ,
          _ => {  (0, store(KExprNode::BVar(0))) } ,
        } } ,
    }
  }

  fn try_str_to_byte_array(spine: List<KExpr>) -> (Field, KExpr) {
    match UInt32::less_than_fields(list_length(spine), 1) {
      1 => {  (0, store(KExprNode::BVar(0))) } ,
      _ => {
        match load(list_lookup(spine, 0)) {
          KExprNode::Lit(lit) => {
            match lit {
              KLiteral::Str(bs) => {
                match load(bs) {
                  Lists::Node::Nil => {
                    (1, store(KExprNode::Const(byte_array_empty_addr(),
                                                store(Lists::Node::Nil)))) } ,
                  _ => {  (0, store(KExprNode::BVar(0))) } ,
                } } ,
              _ => {  (0, store(KExprNode::BVar(0))) } ,
            } } ,
          _ => {  (0, store(KExprNode::BVar(0))) } ,
        } } ,
    }
  }

  fn utf8_validate(bs: ByteStream) -> () {
    match load(bs) {
      Lists::Node::Nil => {  () } ,
      Lists::Node::Cons(b0, rest) => {
        match utf8_decode_one(b0, rest) {
          (_, remaining) => {  utf8_validate(remaining) } ,
        } } ,
    }
  }

  fn utf8_last_codepoint(bs: ByteStream) -> Field {
    utf8_last_go(bs, 65)
  }

  fn utf8_last_go(bs: ByteStream, prev: Field) -> Field {
    match load(bs) {
      Lists::Node::Nil => {  prev } ,
      Lists::Node::Cons(b0, rest) => {
        match utf8_decode_one(b0, rest) {
          (cp, remaining) => {  utf8_last_go(remaining, cp) } ,
        } } ,
    }
  }

  fn utf8_cont(b: U8) -> Field {
    match UInt8::less_than(b, UInt8::BYTE_128) {
      0 => {
        match UInt8::less_than(b, UInt8::BYTE_192) {
          1 => {  UInt8::to_field(b) - 128 } ,
        } } ,
    }
  }

  fn utf8_decode_one(b0: U8, rest: ByteStream) -> (Field, ByteStream) {
    match UInt8::less_than(b0, UInt8::BYTE_128) {
      1 => {  (UInt8::to_field(b0), rest) } ,
      _ => {

        match UInt8::less_than(b0, UInt8::BYTE_194) {
          0 => {
            match UInt8::less_than(b0, UInt8::BYTE_224) {
              1 => {
                match load(rest) {
                  Lists::Node::Cons(b1, r1) => {

                    let cp = (UInt8::to_field(b0) - 192) * 64 + utf8_cont(b1);
                    (cp, r1) } ,
                } } ,
              _ => {
                match UInt8::less_than(b0, UInt8::BYTE_240) {
                  1 => {
                    match load(rest) {
                      Lists::Node::Cons(b1, r1) => {
                        match load(r1) {
                          Lists::Node::Cons(b2, r2) => {
                            let cp = (UInt8::to_field(b0) - 224) * 4096
                                   + utf8_cont(b1) * 64
                                   + utf8_cont(b2);

                            match UInt32::less_than_fields(cp, 2048) {
                              0 => {  (cp, r2) } ,
                            } } ,
                        } } ,
                    } } ,
                  _ => {
                    match load(rest) {
                      Lists::Node::Cons(b1, r1) => {
                        match load(r1) {
                          Lists::Node::Cons(b2, r2) => {
                            match load(r2) {
                              Lists::Node::Cons(b3, r3) => {
                                let cp = (UInt8::to_field(b0) - 240) * 262144
                                       + utf8_cont(b1) * 4096
                                       + utf8_cont(b2) * 64
                                       + utf8_cont(b3);

                                match UInt32::less_than_fields(cp, 65536) {
                                  0 => {  (cp, r3) } ,
                                } } ,
                            } } ,
                        } } ,
                    } } ,
                } } ,
            } } ,
        } } ,
    }
  }

  fn str_lit_to_ctor(bs: ByteStream) -> KExpr {
    let zero_lvl = store(KLevelNode::Zero);
    let ulvls = store(Lists::Node::Cons(zero_lvl, store(Lists::Node::Nil)));
    let nil_const = store(KExprNode::Const(list_nil_addr(), ulvls));
    let cons_const = store(KExprNode::Const(list_cons_addr(), ulvls));
    let char_const = store(KExprNode::Const(char_type_addr(), store(Lists::Node::Nil)));
    let con_const = store(KExprNode::Const(char_of_nat_addr(), store(Lists::Node::Nil)));
    let str_const = store(KExprNode::Const(string_of_list_addr(), store(Lists::Node::Nil)));
    let nil_app = store(KExprNode::App(nil_const, char_const));
    let cons_partial = store(KExprNode::App(cons_const, char_const));
    let list_expr = build_char_list(bs, nil_app, cons_partial, con_const);
    store(KExprNode::App(str_const, list_expr))
  }

  fn build_char_list(bs: ByteStream, nil_app: KExpr,
                         cons_partial: KExpr, con_const: KExpr) -> KExpr {
    match load(bs) {
      Lists::Node::Nil => {  nil_app } ,
      Lists::Node::Cons(b0, rest) => {
        match utf8_decode_one(b0, rest) {
          (cp, remaining) => {
            let cp_limbs = klimbs_from_g(cp);
            let cp_lit = store(KExprNode::Lit(KLiteral::Nat(cp_limbs)));
            let char_val = store(KExprNode::App(con_const, cp_lit));
            let with_head = store(KExprNode::App(cons_partial, char_val));
            let tail = build_char_list(remaining, nil_app, cons_partial, con_const);
            store(KExprNode::App(with_head, tail)) } ,
        } } ,
    }
  }

  fn str_lit_delta_step(expanded: KExpr, types: List<KExpr>) -> KExpr {
    match load(expanded) {
      KExprNode::App(f, list_arg) => {
        match load(f) {
          KExprNode::Const(caddr, _) => {
            let ci = load(get_ci(caddr));
            match ci {
              KConstantInfo::Defn(_, _, value, _, _) => {
                let body = expr_inst_levels(value, store(Lists::Node::Nil));
                match load(body) {
                  KExprNode::Lam(_, lam_body) => {
                    whnf_nd(expr_inst1(lam_body, list_arg, 0), types) } ,
                  _ => {  whnf_nd(store(KExprNode::App(body, list_arg)), types) } ,
                } } ,
              _ => {  expanded } ,
            } } ,
          _ => {  expanded } ,
        } } ,
      _ => {  expanded } ,
    }
  }

  fn str_lit_to_ctor_app_or_self(e: KExpr, types: List<KExpr>) -> KExpr {
    match load(e) {
      KExprNode::Lit(lit) => {
        match lit {
          KLiteral::Str(bs) => {  str_lit_delta_step(str_lit_to_ctor(bs), types) } ,
          _ => {  e } ,
        } } ,
      _ => {  e } ,
    }
  }

  fn split_u32(x: Field) -> (Field, Field, Field, Field) {
    match divmod_256(x, 0) {
      (b0, q1) => {
        match divmod_256(q1, 0) {
          (b1, q2) => {
            match divmod_256(q2, 0) {
              (b2, q3) => {
                match divmod_256(q3, 0) {
                  (b3, _) => {  (b0, b1, b2, b3) } ,
                } } ,
            } } ,
        } } ,
    }
  }

  fn klimbs_from_g(x: Field) -> KLimbs {
    match split_u32(x) {
      (rb0, rb1, rb2, rb3) => {
        let b0 = UInt8::from_field(rb0);
        let b1 = UInt8::from_field(rb1);
        let b2 = UInt8::from_field(rb2);
        let b3 = UInt8::from_field(rb3);

        constrain_eq!(x, UInt8::to_field(b0) + 256 * UInt8::to_field(b1)
                   + 65536 * UInt8::to_field(b2) + 16777216 * UInt8::to_field(b3),
          "u32 byte split does not recompose to the original value");

        klimbs_normalize(store(Lists::Node::Cons(
          [b0, b1, b2, b3, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(Lists::Node::Nil)))) } ,
    }
  }

  fn walk_char_list_bytes(list: KExpr, types: List<KExpr>)
                              -> (Field, ByteStream) {
    let w = whnf(list, types);
    match collect_spine(w) {
      (head, args) => {
        match load(head) {
          KExprNode::Const(caddr, _) => {
            match address_eq(caddr, list_nil_addr()) {
              1 => {
                match list_length(args) {
                  1 => {  (1, store(Lists::Node::Nil)) } ,
                  _ => {  (0, store(Lists::Node::Nil)) } ,
                } } ,
              _ => {
                match address_eq(caddr, list_cons_addr()) {
                  0 => {  (0, store(Lists::Node::Nil)) } ,
                  _ => {
                    match list_length(args) {
                      3 => {
                        match char_lit_codepoint(list_lookup(args, 1), types) {
                          (0, _) => {  (0, store(Lists::Node::Nil)) } ,
                          (1, cp) => {
                            match walk_char_list_bytes(list_lookup(args, 2), types) {
                              (0, t) => {  (0, t) } ,
                              (1, t) => {  (1, utf8_encode_prepend(cp, t)) } ,
                            } } ,
                        } } ,
                      _ => {  (0, store(Lists::Node::Nil)) } ,
                    } } ,
                } } ,
            } } ,
          _ => {  (0, store(Lists::Node::Nil)) } ,
        } } ,
    }
  }

  fn char_lit_codepoint(e: KExpr, types: List<KExpr>) -> (Field, Field) {
    match char_lit_codepoint_syn(e) {
      (1, cp) => {  (1, cp) } ,
      _ => {
        let w = whnf(e, types);
        char_lit_codepoint_syn(w) } ,
    }
  }

  fn char_lit_codepoint_syn(e: KExpr) -> (Field, Field) {
    match load(e) {
      KExprNode::App(f, arg) => {
        match load(f) {
          KExprNode::Const(caddr, _) => {
            match address_eq(caddr, char_of_nat_addr()) {
              0 => {  (0, 0) } ,
              _ => {
                match load(arg) {
                  KExprNode::Lit(lit) => {
                    match lit {
                      KLiteral::Nat(limbs) => {  klimbs_scalar_value(limbs) } ,
                      _ => {  (0, 0) } ,
                    } } ,
                  _ => {  (0, 0) } ,
                } } ,
            } } ,
          _ => {  (0, 0) } ,
        } } ,
      _ => {  (0, 0) } ,
    }
  }

  fn klimbs_scalar_value(limbs: KLimbs) -> (Field, Field) {
    match load(limbs) {
      Lists::Node::Cons(limb, rest) => {
        match load(rest) {
          Lists::Node::Nil => {
            let [b0, b1, b2, b3, b4, b5, b6, b7] = limb;
            let hi = UInt8::to_field(b3) + UInt8::to_field(b4) + UInt8::to_field(b5) + UInt8::to_field(b6) + UInt8::to_field(b7);
            match Fields::is_zero(hi) {
              0 => {  (0, 0) } ,
              _ => {
                let cp = UInt8::to_field(b0) + UInt8::to_field(b1) * 256 + UInt8::to_field(b2) * 65536;
                match UInt32::less_than_fields(cp, 55296) {
                  1 => {  (1, cp) } ,
                  _ => {
                    match UInt32::less_than_fields(57343, cp) {
                      0 => {  (0, 0) } ,
                      _ => {
                        match UInt32::less_than_fields(cp, 1114112) {
                          1 => {  (1, cp) } ,
                          _ => {  (0, 0) } ,
                        } } ,
                    } } ,
                } } ,
            } } ,
          _ => {  (0, 0) } ,
        } } ,
      _ => {  (0, 0) } ,
    }
  }

  fn divmod_64u(x: Field, q: Field) -> (Field, Field) {
    match UInt32::less_than_fields(x, 64) {
      1 => {  (x, q) } ,
      _ => {  divmod_64u(x - 64, q + 1) } ,
    }
  }

  fn utf8_groups(cp: Field) -> (Field, Field, Field, Field) {
    match divmod_64u(cp, 0) {
      (g0, q1) => {
        match divmod_64u(q1, 0) {
          (g1, q2) => {
            match divmod_64u(q2, 0) {
              (g2, g3) => {  (g0, g1, g2, g3) } ,
            } } ,
        } } ,
    }
  }

  fn utf8_encode_prepend(cp: Field, tail: ByteStream) -> ByteStream {
    match utf8_groups(cp) {
      (g0, g1, g2, g3) => {
        let g0u = UInt8::from_field(g0);
        let g1u = UInt8::from_field(g1);
        let g2u = UInt8::from_field(g2);
        let g3u = UInt8::from_field(g3);
        let f0 = UInt8::to_field(g0u);
        let f1 = UInt8::to_field(g1u);
        let f2 = UInt8::to_field(g2u);
        let f3 = UInt8::to_field(g3u);

        assert_eq!(UInt32::less_than_fields(f0, 64), 1,
          "utf8 group 0 is not a 6-bit value");
        assert_eq!(UInt32::less_than_fields(f1, 64), 1,
          "utf8 group 1 is not a 6-bit value");
        assert_eq!(UInt32::less_than_fields(f2, 64), 1,
          "utf8 group 2 is not a 6-bit value");
        assert_eq!(UInt32::less_than_fields(f3, 64), 1,
          "utf8 group 3 is not a 6-bit value");
        assert_eq!(cp, f0 + f1 * 64 + f2 * 4096 + f3 * 262144,
          "utf8 groups do not recompose to the codepoint");
        match UInt32::less_than_fields(cp, 128) {
          1 => {  store(Lists::Node::Cons(UInt8::from_field(cp), tail)) } ,
          _ => {
            match UInt32::less_than_fields(cp, 2048) {
              1 => {
                let t1 = UInt8::from_field(f0 + 128);
                let l1 = UInt8::from_field(f1 + 192);
                store(Lists::Node::Cons(l1, store(Lists::Node::Cons(t1, tail)))) } ,
              _ => {
                match UInt32::less_than_fields(cp, 65536) {
                  1 => {
                    let t2 = UInt8::from_field(f0 + 128);
                    let t1 = UInt8::from_field(f1 + 128);
                    let l2 = UInt8::from_field(f2 + 224);
                    store(Lists::Node::Cons(l2, store(Lists::Node::Cons(t1, store(Lists::Node::Cons(t2, tail)))))) } ,
                  _ => {
                    let t3 = UInt8::from_field(f0 + 128);
                    let t2 = UInt8::from_field(f1 + 128);
                    let t1 = UInt8::from_field(f2 + 128);
                    let l3 = UInt8::from_field(f3 + 240);
                    store(Lists::Node::Cons(l3, store(Lists::Node::Cons(t1, store(Lists::Node::Cons(t2, store(Lists::Node::Cons(t3, tail)))))))) } ,
                } } ,
            } } ,
        } } ,
    }
  }

  inline fn is_nat_prim_addr(a: Addr) -> Field {
    match address_eq(a, nat_succ_addr()) {
      1 => {  1 } ,
      _ => {
      match address_eq(a, nat_pred_addr()) {
        1 => {  1 } ,
        _ => {
        match address_eq(a, nat_add_addr()) {
          1 => {  1 } ,
          _ => {
          match address_eq(a, nat_sub_addr()) {
            1 => {  1 } ,
            _ => {
            match address_eq(a, nat_mul_addr()) {
              1 => {  1 } ,
              _ => {
              match address_eq(a, nat_div_addr()) {
                1 => {  1 } ,
                _ => {
                match address_eq(a, nat_mod_addr()) {
                  1 => {  1 } ,
                  _ => {
                  match address_eq(a, nat_pow_addr()) {
                    1 => {  1 } ,
                    _ => {
                    match address_eq(a, nat_gcd_addr()) {
                      1 => {  1 } ,
                      _ => {
                      match address_eq(a, nat_beq_addr()) {
                        1 => {  1 } ,
                        _ => {
                        match address_eq(a, nat_ble_addr()) {
                          1 => {  1 } ,
                          _ => {
                          match address_eq(a, nat_land_addr()) {
                            1 => {  1 } ,
                            _ => {
                            match address_eq(a, nat_lor_addr()) {
                              1 => {  1 } ,
                              _ => {
                              match address_eq(a, nat_xor_addr()) {
                                1 => {  1 } ,
                                _ => {
                                match address_eq(a, nat_shift_left_addr()) {
                                  1 => {  1 } ,
                                  _ => {
                                  match address_eq(a, nat_shift_right_addr()) {
                                    1 => {  1 } ,
                                    _ => {  0 } ,
                                  } } ,
                                } } ,
                              } } ,
                            } } ,
                          } } ,
                        } } ,
                      } } ,
                    } } ,
                  } } ,
                } } ,
              } } ,
            } } ,
          } } ,
        } } ,
      } } ,
    }
  }

  fn is_int_prim_addr(a: Addr) -> Field {
    address_eq(a, int_add_addr()) + address_eq(a, int_sub_addr())
      + address_eq(a, int_mul_addr()) + address_eq(a, int_neg_addr())
      + address_eq(a, int_emod_addr()) + address_eq(a, int_ediv_addr())
      + address_eq(a, int_bmod_addr()) + address_eq(a, int_bdiv_addr())
      + address_eq(a, int_nat_abs_addr()) + address_eq(a, int_pow_addr())
  }

  fn try_extract_nat(e: KExpr) -> (Field, KLimbs) {
    match load(e) {
      KExprNode::Lit(lit) => {
        match lit {
          KLiteral::Nat(limbs) => {  (1, limbs) } ,
          _ => {  (0, store(Lists::Node::Nil)) } ,
        } } ,
      KExprNode::Const(caddr, _) => {
        match address_eq(caddr, nat_zero_addr()) {
          1 => {  (1, store(Lists::Node::Nil)) } ,
          _ => {  (0, store(Lists::Node::Nil)) } ,
        } } ,
      KExprNode::App(f, a) => {  try_extract_nat_app(f, a) } ,
      _ => {  (0, store(Lists::Node::Nil)) } ,
    }
  }

  fn try_extract_nat_app(f: KExpr, a: KExpr) -> (Field, KLimbs) {
    match load(f) {
      KExprNode::Const(caddr, _) => {
        match address_eq(caddr, nat_succ_addr()) {
          1 => {
            match try_extract_nat(a) {
              (1, pred_limbs) => {  (1, klimbs_succ(pred_limbs)) } ,
              _ => {  (0, store(Lists::Node::Nil)) } ,
            } } ,
          _ => {  (0, store(Lists::Node::Nil)) } ,
        } } ,
      _ => {  (0, store(Lists::Node::Nil)) } ,
    }
  }

  fn mk_nat_lit(n: KLimbs) -> KExpr {
    store(KExprNode::Lit(KLiteral::Nat(n)))
  }

  fn try_extract_int_prim(e: KExpr) -> (Field, Field, KLimbs) {
    match load(e) {
      KExprNode::App(f, a) => {  match load(f) {
        KExprNode::Const(caddr, _) => {  match try_extract_nat(a) {
          (1, n) => {  match address_eq(caddr, int_of_nat_addr()) {
            1 => {  (1, 0, klimbs_normalize(n)) } ,
            _ => {  match address_eq(caddr, int_neg_succ_addr()) {
              1 => {  (1, 1, klimbs_normalize(klimbs_succ(n))) } ,
              _ => {  (0, 0, store(Lists::Node::Nil)) } ,
            } } ,
          } } ,
          _ => {  (0, 0, store(Lists::Node::Nil)) } ,
        } } ,
        _ => {  (0, 0, store(Lists::Node::Nil)) } ,
      } } ,
      _ => {  (0, 0, store(Lists::Node::Nil)) } ,
    }
  }

  fn mk_int_prim(sign: Field, magnitude: KLimbs) -> KExpr {
    let mag = klimbs_normalize(magnitude);
    let neg = sign * (1 - klimbs_is_zero(mag));
    let caddr = match neg { 0 => {  int_of_nat_addr() } , _ => {  int_neg_succ_addr() } , };
    let arg = match neg { 0 => {  mag } , _ => {  klimbs_normalize(klimbs_dec(mag)) } , };
    store(KExprNode::App(store(KExprNode::Const(caddr, store(Lists::Node::Nil))), mk_nat_lit(arg)))
  }

  fn int_add_prim(sa: Field, a: KLimbs, sb: Field, b: KLimbs) -> KExpr {
    match sa - sb {
      0 => {  mk_int_prim(sa, klimbs_add(a, b)) } ,
      _ => {  match klimbs_le(a, b) {
        1 => {  mk_int_prim(sb, klimbs_sub(b, a)) } ,
        _ => {  mk_int_prim(sa, klimbs_sub(a, b)) } ,
      } } ,
    }
  }

  fn int_emod_prim(sa: Field, a: KLimbs, b: KLimbs) -> KExpr {
    match klimbs_is_zero(b) {
      1 => {  mk_int_prim(sa, a) } ,
      _ => {
        let r0 = klimbs_mod(a, b);
        match sa * (1 - klimbs_is_zero(r0)) {
          1 => {  mk_int_prim(0, klimbs_sub(b, r0)) } ,
          _ => {  mk_int_prim(0, r0) } ,
        } } ,
    }
  }

  fn int_ediv_prim(sa: Field, a: KLimbs, sb: Field, b: KLimbs) -> KExpr {
    match klimbs_is_zero(b) {
      1 => {  mk_int_prim(0, store(Lists::Node::Nil)) } ,
      _ => {
        let q0 = klimbs_div(a, b);
        let r0 = klimbs_mod(a, b);
        let q = match sa * (1 - klimbs_is_zero(r0)) {
          1 => {  klimbs_succ(q0) } ,
          _ => {  q0 } ,
        };
        mk_int_prim((sa + sb - 2 * sa * sb) * (1 - klimbs_is_zero(q)), q) } ,
    }
  }

  fn int_bmod_prim(sa: Field, a: KLimbs, m: KLimbs) -> KExpr {
    match klimbs_is_zero(m) {
      1 => {  mk_int_prim(sa, a) } ,
      _ => {
        let r0 = klimbs_mod(a, m);
        let r = match sa * (1 - klimbs_is_zero(r0)) {
          1 => {  klimbs_sub(m, r0) } ,
          _ => {  r0 } ,
        };
        let two = store(Lists::Node::Cons([UInt8::BYTE_2, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(Lists::Node::Nil)));
        let half = klimbs_div(klimbs_succ(m), two);
        match klimbs_le(half, r) {
          1 => {  mk_int_prim(1, klimbs_sub(m, r)) } ,
          _ => {  mk_int_prim(0, r) } ,
        } } ,
    }
  }

  fn int_bdiv_prim(sa: Field, a: KLimbs, m: KLimbs) -> KExpr {
    match klimbs_is_zero(m) {
      1 => {  mk_int_prim(0, store(Lists::Node::Nil)) } ,
      _ => {
        let r0 = klimbs_mod(a, m);
        let r = match sa * (1 - klimbs_is_zero(r0)) {
          1 => {  klimbs_sub(m, r0) } ,
          _ => {  r0 } ,
        };
        let q0 = klimbs_div(a, m);
        let qmag = match sa * (1 - klimbs_is_zero(r0)) { 1 => {  klimbs_succ(q0) } , _ => {  q0 } , };
        let qsign = sa * (1 - klimbs_is_zero(qmag));
        let two = store(Lists::Node::Cons([UInt8::BYTE_2, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(Lists::Node::Nil)));
        let half = klimbs_div(klimbs_succ(m), two);
        match klimbs_le(half, r) {
          0 => {  mk_int_prim(qsign, qmag) } ,
          _ => {  int_add_prim(qsign, qmag, 0,
            store(Lists::Node::Cons([UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(Lists::Node::Nil)))) } ,
        } } ,
    }
  }

  fn try_int_prim_dispatch(head_addr: Addr, spine: List<KExpr>,
                                types: List<KExpr>) -> (Field, KExpr) {
    let sw = whnf_spine(spine, types);
    let n = list_length(sw);
    let unary = address_eq(head_addr, int_neg_addr()) + address_eq(head_addr, int_nat_abs_addr());
    match unary {
      1 => {  match UInt32::less_than_fields(n, 1) {
        1 => {  (0, store(KExprNode::BVar(0))) } ,
        _ => {  match try_extract_int_prim(list_lookup(sw, 0)) {
          (1, s, a) => {
            let v = match address_eq(head_addr, int_nat_abs_addr()) {
              1 => {  mk_nat_lit(a) } ,
              _ => {  mk_int_prim((1 - s) * (1 - klimbs_is_zero(a)), a) } ,
            };
            (1, np_apply_spine(v, list_drop(sw, 1))) } ,
          _ => {  (0, store(KExprNode::BVar(0))) } ,
        } } ,
      } } ,
      _ => {  match UInt32::less_than_fields(n, 2) {
        1 => {  (0, store(KExprNode::BVar(0))) } ,
        _ => {  match try_extract_int_prim(list_lookup(sw, 0)) {
          (1, sa, a) => {  try_int_prim_second(head_addr, sw, sa, a) } ,
          _ => {  (0, store(KExprNode::BVar(0))) } ,
        } } ,
      } } ,
    }
  }

  fn try_int_prim_second(head_addr: Addr, sw: List<KExpr>,
                              sa: Field, a: KLimbs) -> (Field, KExpr) {
    let rhs_nat = address_eq(head_addr, int_bmod_addr())
      + address_eq(head_addr, int_bdiv_addr()) + address_eq(head_addr, int_pow_addr());
    match rhs_nat {
      1 => {  match try_extract_nat(list_lookup(sw, 1)) {
        (1, b) => {
          let v = match address_eq(head_addr, int_bmod_addr()) {
            1 => {  int_bmod_prim(sa, a, b) } ,
            _ => {  match address_eq(head_addr, int_bdiv_addr()) {
              1 => {  int_bdiv_prim(sa, a, b) } ,
              _ => {
                let two = store(Lists::Node::Cons([UInt8::BYTE_2, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(Lists::Node::Nil)));
                let odd = 1 - klimbs_is_zero(klimbs_mod(b, two));
                mk_int_prim(sa * odd, klimbs_pow(a, b)) } ,
            } } ,
          };
          (1, np_apply_spine(v, list_drop(sw, 2))) } ,
        _ => {  (0, store(KExprNode::BVar(0))) } ,
      } } ,
      _ => {  match try_extract_int_prim(list_lookup(sw, 1)) {
        (1, sb, b) => {
          let v = match address_eq(head_addr, int_add_addr()) {
            1 => {  int_add_prim(sa, a, sb, b) } ,
            _ => {  match address_eq(head_addr, int_sub_addr()) {
              1 => {  int_add_prim(sa, a, (1 - sb) * (1 - klimbs_is_zero(b)), b) } ,
              _ => {  match address_eq(head_addr, int_mul_addr()) {
                1 => {  mk_int_prim((sa + sb - 2 * sa * sb)
                  * (1 - klimbs_is_zero(a)) * (1 - klimbs_is_zero(b)), klimbs_mul(a, b)) } ,
                _ => {  match address_eq(head_addr, int_emod_addr()) {
                  1 => {  int_emod_prim(sa, a, b) } ,
                  _ => {  int_ediv_prim(sa, a, sb, b) } ,
                } } ,
              } } ,
            } } ,
          };
          (1, np_apply_spine(v, list_drop(sw, 2))) } ,
        _ => {  (0, store(KExprNode::BVar(0))) } ,
      } } ,
    }
  }

  fn np_apply_spine(head: KExpr, spine: List<KExpr>) -> KExpr {
    match load(spine) {
      Lists::Node::Nil => {  head } ,
      Lists::Node::Cons(a, rest) => {
        np_apply_spine(store(KExprNode::App(head, a)), rest) } ,
    }
  }

  fn try_nat_binop_addr(head_addr: Addr, a: KLimbs, b: KLimbs) -> (Field, KExpr) {
    match address_eq(head_addr, nat_add_addr()) {
      1 => {  (1, mk_nat_lit(klimbs_normalize(klimbs_add(a, b)))) } ,
      _ => {
      match address_eq(head_addr, nat_sub_addr()) {
        1 => {  (1, mk_nat_lit(klimbs_normalize(klimbs_sub(a, b)))) } ,
        _ => {
        match address_eq(head_addr, nat_mul_addr()) {
          1 => {  (1, mk_nat_lit(klimbs_normalize(klimbs_mul(a, b)))) } ,
          _ => {
          match address_eq(head_addr, nat_div_addr()) {
            1 => {  (1, mk_nat_lit(klimbs_normalize(klimbs_div(a, b)))) } ,
            _ => {
            match address_eq(head_addr, nat_mod_addr()) {
              1 => {  (1, mk_nat_lit(klimbs_normalize(klimbs_mod(a, b)))) } ,
              _ => {
              match address_eq(head_addr, nat_gcd_addr()) {
                1 => {  (1, mk_nat_lit(klimbs_normalize(klimbs_gcd(a, b)))) } ,
                _ => {
                match address_eq(head_addr, nat_pow_addr()) {
                  1 => {  (1, mk_nat_lit(klimbs_normalize(klimbs_pow(a, b)))) } ,
                  _ => {
                  match address_eq(head_addr, nat_land_addr()) {
                    1 => {  (1, mk_nat_lit(klimbs_normalize(klimbs_land(a, b)))) } ,
                    _ => {
                    match address_eq(head_addr, nat_lor_addr()) {
                      1 => {  (1, mk_nat_lit(klimbs_normalize(klimbs_lor(a, b)))) } ,
                      _ => {
                      match address_eq(head_addr, nat_xor_addr()) {
                        1 => {  (1, mk_nat_lit(klimbs_normalize(klimbs_xor_op(a, b)))) } ,
                        _ => {
                        match address_eq(head_addr, nat_shift_left_addr()) {
                          1 => {  (1, mk_nat_lit(klimbs_normalize(klimbs_shl(a, b)))) } ,
                          _ => {
                          match address_eq(head_addr, nat_shift_right_addr()) {
                            1 => {  (1, mk_nat_lit(klimbs_normalize(klimbs_shr(a, b)))) } ,
                            _ => {
                            match address_eq(head_addr, nat_beq_addr()) {
                              1 => {  (1, mk_bool(klimbs_eq(a, b))) } ,
                              _ => {
                              match address_eq(head_addr, nat_ble_addr()) {
                                1 => {  (1, mk_bool(klimbs_le(a, b))) } ,
                                _ => {  (0, store(KExprNode::BVar(0))) } ,
                              } } ,
                            } } ,
                          } } ,
                        } } ,
                      } } ,
                    } } ,
                  } } ,
                } } ,
              } } ,
            } } ,
          } } ,
        } } ,
      } } ,
    }
  }

  fn try_match_nat_add(head: KExpr, args: List<KExpr>) -> (Field, KExpr, KLimbs) {
    match load(head) {
      KExprNode::Const(caddr, _) => {
        match address_eq(caddr, nat_add_addr()) {
          0 => {  (0, head, store(Lists::Node::Nil)) } ,
          _ => {
            match list_length(args) - 2 {
              0 => {
                let lhs = list_lookup(args, 0);
                let rhs = list_lookup(args, 1);
                match load(rhs) {
                  KExprNode::Lit(lit) => {
                    match lit {
                      KLiteral::Nat(limbs) => {  (1, lhs, limbs) } ,
                      _ => {  (0, head, store(Lists::Node::Nil)) } ,
                    } } ,
                  _ => {  (0, head, store(Lists::Node::Nil)) } ,
                } } ,
              _ => {  (0, head, store(Lists::Node::Nil)) } ,
            } } ,
        } } ,
      _ => {  (0, head, store(Lists::Node::Nil)) } ,
    }
  }

  fn build_succ_offset(base: KExpr, lit: KLimbs) -> KExpr {
    let one = store(Lists::Node::Cons([UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0],
                                  store(Lists::Node::Nil)));
    let pred_lit_norm = klimbs_normalize(klimbs_sub(lit, one));
    let succ_const = store(KExprNode::Const(nat_succ_addr(), store(Lists::Node::Nil)));
    match klimbs_is_zero(pred_lit_norm) {
      1 => {  store(KExprNode::App(succ_const, base)) } ,
      _ => {
        let add_const = store(KExprNode::Const(nat_add_addr(), store(Lists::Node::Nil)));
        let pred_lit_expr = store(KExprNode::Lit(KLiteral::Nat(pred_lit_norm)));
        let pred = store(KExprNode::App(
          store(KExprNode::App(add_const, base)),
          pred_lit_expr));
        store(KExprNode::App(succ_const, pred)) } ,
    }
  }

  fn cleanup_nat_offset_major(e: KExpr) -> KExpr {
    match load(e) {
      KExprNode::Lit(_) => {  e } ,
      _ => {
        match collect_spine(e) {
          (head, args) => {
            match load(head) {
              KExprNode::Const(_, _) => {
                match try_match_nat_add(head, args) {
                  (1, base, lit) => {
                    let lit_norm = klimbs_normalize(lit);
                    match klimbs_is_zero(lit_norm) {
                      1 => {  e } ,
                      _ => {  build_succ_offset(base, lit_norm) } ,
                    } } ,
                  _ => {  e } ,
                } } ,
              _ => {  e } ,
            } } ,
        } } ,
    }
  }

  fn mk_nat_offset_stuck(base_w: KExpr, n: KLimbs,
                              post: List<KExpr>) -> (Field, KExpr) {
    match klimbs_is_zero(n) {
      1 => {  (1, np_apply_spine(base_w, post)) } ,
      _ => {
        let add_const = store(KExprNode::Const(nat_add_addr(), store(Lists::Node::Nil)));
        let off = store(KExprNode::App(
          store(KExprNode::App(add_const, base_w)),
          mk_nat_lit(n)));
        (1, np_apply_spine(off, post)) } ,
    }
  }

  fn is_nat_succ_ih_step(step: KExpr) -> Field {
    match load(step) {
      KExprNode::Lam(_, body1) => {
        match load(body1) {
          KExprNode::Lam(_, body2) => {
            match collect_spine(body2) {
              (head, args) => {
                match load(head) {
                  KExprNode::Const(caddr, _) => {
                    match address_eq(caddr, nat_succ_addr()) {
                      0 => {  0 } ,
                      _ => {
                        match list_length(args) - 1 {
                          0 => {
                            match load(list_lookup(args, 0)) {
                              KExprNode::BVar(i) => {  Fields::is_zero(i) } ,
                              _ => {  0 } ,
                            } } ,
                          _ => {  0 } ,
                        } } ,
                    } } ,
                  _ => {  0 } ,
                } } ,
            } } ,
          _ => {  0 } ,
        } } ,
      _ => {  0 } ,
    }
  }

  fn try_nat_linear_rec(spine: List<KExpr>, nparams: Field, nmotives: Field,
                             nminors: Field, major_idx: Field) -> (Field, KExpr) {
    match UInt32::less_than_fields(nminors, 2) {
      1 => {  (0, store(KExprNode::BVar(0))) } ,
      _ => {
        let raw_major = list_lookup(spine, major_idx);
        match try_extract_nat(raw_major) {
          (0, _) => {  (0, store(KExprNode::BVar(0))) } ,
          (1, n_klimbs) => {
            let base_idx = nparams + nmotives;
            let step = list_lookup(spine, base_idx + 1);
            match is_nat_succ_ih_step(step) {
              0 => {  (0, store(KExprNode::BVar(0))) } ,
              _ => {
                let base = list_lookup(spine, base_idx);
                let post = list_drop(spine, major_idx + 1);
                match try_extract_nat(base) {
                  (1, b_klimbs) => {
                    (1, np_apply_spine(mk_nat_lit(klimbs_add(b_klimbs, n_klimbs)), post)) } ,
                  _ => {  mk_nat_offset_stuck(base, n_klimbs, post) } ,
                } } ,
            } } ,
        } } ,
    }
  }

  inline fn try_nat_dispatch(head_addr: Addr, spine: List<KExpr>,
                          types: List<KExpr>) -> (Field, KExpr) {
    let spine_len = list_length(spine);
    let is_pred = address_eq(head_addr, nat_pred_addr());
    let is_succ = address_eq(head_addr, nat_succ_addr());
    match is_succ {
      1 => {
        match UInt32::less_than_fields(spine_len, 1) {
          1 => {  (0, store(KExprNode::BVar(0))) } ,
          _ => {
            let a0 = list_lookup(spine, 0);
            match try_extract_nat(a0) {
              (1, na) => {
                let post = list_drop(spine, 1);
                (1, np_apply_spine(mk_nat_lit(klimbs_succ(na)), post)) } ,
              _ => {  (0, store(KExprNode::BVar(0))) } ,
            } } ,
        } } ,
      _ => {
        match is_pred {
          1 => {
            match UInt32::less_than_fields(spine_len, 1) {
              1 => {  (0, store(KExprNode::BVar(0))) } ,
              _ => {
                let a0 = list_lookup(spine, 0);
                match try_extract_nat(a0) {
                  (1, na) => {
                    let post = list_drop(spine, 1);
                    (1, np_apply_spine(mk_nat_lit(klimbs_normalize(klimbs_dec(na))), post)) } ,
                  _ => {  (0, store(KExprNode::BVar(0))) } ,
                } } ,
            } } ,
          _ => {  try_nat_binop_dispatch(head_addr, spine, spine_len) } ,
        } } ,
    }
  }

  fn try_nat_binop_dispatch(head_addr: Addr, spine: List<KExpr>,
                                 spine_len: Field) -> (Field, KExpr) {
    match UInt32::less_than_fields(spine_len, 2) {
      1 => {  (0, store(KExprNode::BVar(0))) } ,
      _ => {
        let a0 = list_lookup(spine, 0);
        let a1 = list_lookup(spine, 1);
        match try_extract_nat(a0) {
          (1, na) => {
            match try_extract_nat(a1) {
              (1, nb) => {
                match try_nat_binop_addr(head_addr, na, nb) {
                  (1, result) => {
                    let post = list_drop(spine, 2);
                    (1, np_apply_spine(result, post)) } ,
                  _ => {  (0, store(KExprNode::BVar(0))) } ,
                } } ,
              _ => {  (0, store(KExprNode::BVar(0))) } ,
            } } ,
          _ => {

            match try_extract_nat(a1) {
              (1, nb) => {
                try_nat_offset_dispatch(head_addr, a0, nb, spine) } ,
              _ => {  (0, store(KExprNode::BVar(0))) } ,
            } } ,
        } } ,
    }
  }

  fn try_nat_offset_dispatch(head_addr: Addr, a0_w: KExpr, nb: KLimbs,
                                  spine: List<KExpr>) -> (Field, KExpr) {
    let is_add = address_eq(head_addr, nat_add_addr());
    let is_divmod = address_eq(head_addr, nat_div_addr())
      + address_eq(head_addr, nat_mod_addr());
    let eligible =
      is_add + is_divmod * (1 - klimbs_is_zero(nb))
        * (1 - klimbs_is_zero(klimbs_normalize(klimbs_dec(nb))));
    match eligible {
      0 => {  (0, store(KExprNode::BVar(0))) } ,
      _ => {
        let post = list_drop(spine, 2);

        match is_add {
          1 => {
            match mk_nat_offset_stuck(a0_w, nb, post) {
              (1, stuck) => {  (2, stuck) } ,
              _ => {  (0, store(KExprNode::BVar(0))) } ,
            } } ,
          _ => {  (2, mk_nat_binop_stuck(head_addr, a0_w, nb, post)) } ,
        } } ,
    }
  }

  fn mk_nat_binop_stuck(op_addr: Addr, base_w: KExpr, n: KLimbs,
                             post: List<KExpr>) -> KExpr {
    let op_const = store(KExprNode::Const(op_addr, store(Lists::Node::Nil)));
    let stuck = store(KExprNode::App(
      store(KExprNode::App(op_const, base_w)),
      mk_nat_lit(n)));
    np_apply_spine(stuck, post)
  }

  fn bytes_to_u64_limb(bytes: ByteStream, acc: U64, pos: Field) -> U64 {
    match pos {
      8 => {  acc } ,
      _ => {
        match load(bytes) {
          Lists::Node::Nil => {  acc } ,
          Lists::Node::Cons(byte, rest) => {
            let [v0, v1, v2, v3, v4, v5, v6, v7] = acc;
            match pos {
              0 => {  bytes_to_u64_limb(rest, [byte, v1, v2, v3, v4, v5, v6, v7], 1) } ,
              1 => {  bytes_to_u64_limb(rest, [v0, byte, v2, v3, v4, v5, v6, v7], 2) } ,
              2 => {  bytes_to_u64_limb(rest, [v0, v1, byte, v3, v4, v5, v6, v7], 3) } ,
              3 => {  bytes_to_u64_limb(rest, [v0, v1, v2, byte, v4, v5, v6, v7], 4) } ,
              4 => {  bytes_to_u64_limb(rest, [v0, v1, v2, v3, byte, v5, v6, v7], 5) } ,
              5 => {  bytes_to_u64_limb(rest, [v0, v1, v2, v3, v4, byte, v6, v7], 6) } ,
              6 => {  bytes_to_u64_limb(rest, [v0, v1, v2, v3, v4, v5, byte, v7], 7) } ,
              _ => {  bytes_to_u64_limb(rest, [v0, v1, v2, v3, v4, v5, v6, byte], 8) } ,
            } } ,
        } } ,
    }
  }

  fn skip_bytes(bytes: ByteStream, n: Field) -> ByteStream {
    match n {
      0 => {  bytes } ,
      _ => {
        match load(bytes) {
          Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
          Lists::Node::Cons(_, rest) => {  skip_bytes(rest, n - 1) } ,
        } } ,
    }
  }

  fn bytes_to_limbs(bytes: ByteStream) -> KLimbs {
    let limb = bytes_to_u64_limb(bytes, [UInt8::BYTE_0; 8], 0);
    let rest_bytes = skip_bytes(bytes, 8);
    let rest_limbs = match load(rest_bytes) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      _ => {  bytes_to_limbs(rest_bytes) } ,
    };
    match load(rest_limbs) {
      Lists::Node::Nil => {
        match UInt64::is_zero(limb) {
          1 => {  store(Lists::Node::Nil) } ,
          0 => {  store(Lists::Node::Cons(limb, store(Lists::Node::Nil))) } ,
        } } ,
      _ => {  store(Lists::Node::Cons(limb, rest_limbs)) } ,
    }
  }

  fn convert_univ(u: &Univ) -> KLevel {
    match load(u) {
      Univ::Zero => {  store(KLevelNode::Zero) } ,
      Univ::Succ(inner) => {  store(KLevelNode::Succ(convert_univ(inner))) } ,
      Univ::Max(a, b) => {  store(KLevelNode::Max(convert_univ(a), convert_univ(b))) } ,
      Univ::IMax(a, b) => {  store(KLevelNode::IMax(convert_univ(a), convert_univ(b))) } ,
      Univ::Var(idx) => {  store(KLevelNode::Param(UInt64::to_field(idx))) } ,
    }
  }

  fn convert_univ_idxs(idxs: List<U64>, univs: List<&Univ>) -> List<KLevel> {
    match load(idxs) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(idx, rest) => {
        let u_ref = list_lookup(univs, UInt64::to_field(idx));
        store(Lists::Node::Cons(convert_univ(u_ref), convert_univ_idxs(rest, univs))) } ,
    }
  }

  fn convert_expr(
    e: &Expr,
    sharing: List<&Expr>,
    refs: List<Addr>,
    recur_addrs: List<Addr>,
    univs: List<&Univ>
  ) -> KExpr {
    match load(e) {
      Expr::Srt(univ_idx) => {
        let u_ref = list_lookup(univs, UInt64::to_field(univ_idx));
        store(KExprNode::Srt(convert_univ(u_ref))) } ,

      Expr::Var(idx) => {
        store(KExprNode::BVar(UInt64::to_field(idx))) } ,

      Expr::Ref(ref_idx, univ_idxs) => {
        let ref_addr = list_lookup(refs, UInt64::to_field(ref_idx));
        let levels = convert_univ_idxs(univ_idxs, univs);
        store(KExprNode::Const(ref_addr, levels)) } ,

      Expr::Rec(rec_idx, univ_idxs) => {

        let ref_addr = list_lookup(recur_addrs, UInt64::to_field(rec_idx));
        let levels = convert_univ_idxs(univ_idxs, univs);
        store(KExprNode::Const(ref_addr, levels)) } ,

      Expr::Prj(type_ref_idx, field_idx, inner) => {
        let type_addr = list_lookup(refs, UInt64::to_field(type_ref_idx));
        store(KExprNode::Proj(
          type_addr,
          UInt64::to_field(field_idx),
          convert_expr(inner, sharing, refs, recur_addrs, univs))) } ,

      Expr::Str(blob_ref_idx) => {
        let blob_addr = list_lookup(refs, UInt64::to_field(blob_ref_idx));
        let bs = load_verified_blob(blob_addr);

        utf8_validate(bs);
        store(KExprNode::Lit(KLiteral::Str(bs))) } ,

      Expr::Nat(blob_ref_idx) => {
        let blob_addr = list_lookup(refs, UInt64::to_field(blob_ref_idx));
        let bs = load_verified_blob(blob_addr);
        let limbs = bytes_to_limbs(bs);
        store(KExprNode::Lit(KLiteral::Nat(limbs))) } ,

      Expr::App(f, a) => {
        store(KExprNode::App(
          convert_expr(f, sharing, refs, recur_addrs, univs),
          convert_expr(a, sharing, refs, recur_addrs, univs))) } ,

      Expr::Lam(_, ty, body) => {
        store(KExprNode::Lam(
          convert_expr(ty, sharing, refs, recur_addrs, univs),
          convert_expr(body, sharing, refs, recur_addrs, univs))) } ,

      Expr::All(_, _, ty, body) => {
        store(KExprNode::Forall(
          convert_expr(ty, sharing, refs, recur_addrs, univs),
          convert_expr(body, sharing, refs, recur_addrs, univs))) } ,

      Expr::Let(_, ty, val, body) => {
        store(KExprNode::Let(
          convert_expr(ty, sharing, refs, recur_addrs, univs),
          convert_expr(val, sharing, refs, recur_addrs, univs),
          convert_expr(body, sharing, refs, recur_addrs, univs))) } ,

      Expr::Share(idx) => {
        let Lists::Node::Cons(e, _) = load(list_drop(sharing, UInt64::to_field(idx)));
        convert_expr(e, sharing, refs, recur_addrs, univs) } ,
    }
  }

  fn convert_definition(d: Definition, sharing: List<&Expr>,
                            refs: List<Addr>, recur_addrs: List<Addr>,
                            univs: List<&Univ>, hint: Field) -> KConstantInfo {
    match d {
      Definition::Mk(kind, safety, lvls, typ, value) => {
        let ktyp = convert_expr(typ, sharing, refs, recur_addrs, univs);
        let kval = convert_expr(value, sharing, refs, recur_addrs, univs);
        let nlvls = UInt64::to_field(lvls);
        match kind {
          DefKind::Definition => {
            KConstantInfo::Defn(nlvls, ktyp, kval, safety, hint) } ,
          DefKind::Opaque => {
            let is_unsafe = match safety { DefinitionSafety::Unsafe => {  1 } , _ => {  0 } , };
            KConstantInfo::Opaque(nlvls, ktyp, kval, is_unsafe) } ,
          DefKind::Theorem => {
            KConstantInfo::Thm(nlvls, ktyp, kval) } ,
        } } ,
    }
  }

  fn convert_axiom(a: Axiom, sharing: List<&Expr>,
                       refs: List<Addr>, recur_addrs: List<Addr>,
                       univs: List<&Univ>) -> KConstantInfo {
    match a {
      Axiom::Mk(is_unsafe, lvls, typ) => {
        let ktyp = convert_expr(typ, sharing, refs, recur_addrs, univs);
        KConstantInfo::Axiom(UInt64::to_field(lvls), ktyp, is_unsafe) } ,
    }
  }

  fn convert_quotient(q: Quotient, sharing: List<&Expr>,
                          refs: List<Addr>, recur_addrs: List<Addr>,
                          univs: List<&Univ>) -> KConstantInfo {
    match q {
      Quotient::Mk(kind, lvls, typ) => {
        let ktyp = convert_expr(typ, sharing, refs, recur_addrs, univs);
        KConstantInfo::Quot(UInt64::to_field(lvls), ktyp, kind) } ,
    }
  }

  fn count_ctors(cs: List<Constructor>) -> Field {
    match load(cs) {
      Lists::Node::Nil => {  0 } ,
      Lists::Node::Cons(_, rest) => {  count_ctors(rest) + 1 } ,
    }
  }

  fn ctor_at(cs: List<Constructor>, cidx: Field) -> Constructor {
    match load(cs) {
      Lists::Node::Cons(c, rest) => {
        match cidx {
          0 => {  c } ,
          _ => {  ctor_at(rest, cidx - 1) } ,
        } } ,
    }
  }

  fn convert_inductive(ind: Inductive, block_addr: Addr, ind_idx: Field,
                           sharing: List<&Expr>, refs: List<Addr>,
                           recur_addrs: List<Addr>,
                           univs: List<&Univ>) -> KConstantInfo {
    match ind {
      Inductive::Mk(is_unsafe, lvls, params, indices, typ, ctors) => {
        let ktyp = convert_expr(typ, sharing, refs, recur_addrs, univs);
        KConstantInfo::Induct(
          UInt64::to_field(lvls), ktyp,
          UInt64::to_field(params), UInt64::to_field(indices),
          count_ctors(ctors), is_unsafe,
          block_addr, ind_idx) } ,
    }
  }

  fn convert_constructor(c: Constructor, block_addr: Addr, ind_idx: Field,
                             sharing: List<&Expr>, refs: List<Addr>,
                             recur_addrs: List<Addr>,
                             univs: List<&Univ>) -> KConstantInfo {
    match c {
      Constructor::Mk(is_unsafe, lvls, cidx, params, fields, typ) => {
        let ktyp = convert_expr(typ, sharing, refs, recur_addrs, univs);
        KConstantInfo::Ctor(
          UInt64::to_field(lvls), ktyp,
          block_addr, ind_idx, UInt64::to_field(cidx),
          UInt64::to_field(params), UInt64::to_field(fields), is_unsafe) } ,
    }
  }

  fn convert_rec_rules(rs: List<RecursorRule>, sharing: List<&Expr>,
                           refs: List<Addr>, recur_addrs: List<Addr>,
                           univs: List<&Univ>, cidx: Field) -> List<KRecRule> {
    match load(rs) {
      Lists::Node::Nil => {
        store(Lists::Node::Nil) } ,
      Lists::Node::Cons(r, rest) => {
        match r {
          RecursorRule::Mk(fields, rhs) => {
            let krhs = convert_expr(rhs, sharing, refs, recur_addrs, univs);
            store(Lists::Node::Cons(
              KRecRule::Mk(cidx, UInt64::to_field(fields), krhs),
              convert_rec_rules(rest, sharing, refs, recur_addrs, univs, cidx + 1))) } ,
        } } ,
    }
  }

  fn convert_recursor(r: Recursor, block_addr: Addr, rec_idx: Field,
                          sharing: List<&Expr>, refs: List<Addr>,
                          recur_addrs: List<Addr>,
                          univs: List<&Univ>) -> KConstantInfo {
    match r {
      Recursor::Mk(k, is_unsafe, lvls, params, indices, motives, minors, typ, rules) => {
        let ktyp = convert_expr(typ, sharing, refs, recur_addrs, univs);
        let krules = convert_rec_rules(rules, sharing, refs, recur_addrs, univs, 0);
        KConstantInfo::Rec(
          UInt64::to_field(lvls), ktyp,
          UInt64::to_field(params), UInt64::to_field(indices),
          UInt64::to_field(motives), UInt64::to_field(minors),
          krules, k, is_unsafe,
          block_addr, rec_idx) } ,
    }
  }

  fn load_verified_constant(addr: Addr) -> Constant {
    let raw = load(addr);
    let (idx, len) = io_get_info(2, raw);
    let bytes = read_finite_byte_stream(2, idx, len);
    Blake3::verify_bytes_against(bytes, raw);
    let (constant, rest) = get_constant(bytes);
    let Lists::Node::Nil = load(rest);
    constant
  }

  fn load_constant_hint(addr: Addr) -> Field {
    hint::<Field>("ixvm.io.tag", (3, Blake3::address_to_fields(load(addr))))
  }

  fn load_verified_blob(addr: Addr) -> ByteStream {
    let raw = load(addr);
    let (idx, len) = io_get_info(4, raw);
    let bytes = read_finite_byte_stream(4, idx, len);
    Blake3::verify_bytes_against(bytes, raw);
    bytes
  }

  fn defn_is_unsafe_ci(kind: DefKind, safety: DefinitionSafety) -> Field {
    match kind {
      DefKind::Theorem => {  0 } ,
      DefKind::Opaque => {
        match safety {
          DefinitionSafety::Unsafe => {  1 } ,
          _ => {  0 } ,
        } } ,
      DefKind::Definition => {
        match safety {
          DefinitionSafety::Safe => {  0 } ,
          _ => {  1 } ,
        } } ,
    }
  }

  fn defn_member_recur_addrs(d: Definition, members: List<MutConst>,
                                  block_addr: Addr) -> List<Addr> {
    match d {
      Definition::Mk(kind, safety, _, _, _) => {
        match defn_is_unsafe_ci(kind, safety) {
          0 => {  store(Lists::Node::Nil) } ,
          _ => {  build_recur_addrs(members, block_addr) } ,
        } } ,
    }
  }

  fn get_ci(addr: Addr) -> &KConstantInfo {
    let c = load_verified_constant(addr);
    match c {
      Constant::Mk(info, sharing, refs, univs) => {
        match info {
          ConstantInfo::Defn(defn) => {
            let hint = load_constant_hint(addr);

            let self_recur = match defn {
              Definition::Mk(kind, safety, _, _, _) => {
                match defn_is_unsafe_ci(kind, safety) {
                  0 => {  store(Lists::Node::Nil) } ,
                  _ => {  store(Lists::Node::Cons(addr, store(Lists::Node::Nil))) } ,
                } } ,
            };
            store(convert_definition(defn, sharing, refs,
                                          self_recur, univs, hint)) } ,
          ConstantInfo::Axio(axio) => {

            store(convert_axiom(axio, sharing, refs,
                                     store(Lists::Node::Nil), univs)) } ,
          ConstantInfo::Quot(quot) => {
            store(convert_quotient(quot, sharing, refs,
                                        store(Lists::Node::Nil), univs)) } ,
          ConstantInfo::DPrj(prj) => {
            match prj {
              DefinitionProj::Mk(idx, block_addr) => {
                get_ci_dprj(addr, idx, block_addr) } ,
            } } ,
          ConstantInfo::IPrj(prj) => {
            match prj {
              InductiveProj::Mk(idx, block_addr) => {
                get_ci_iprj(block_addr, UInt64::to_field(idx)) } ,
            } } ,
          ConstantInfo::CPrj(prj) => {
            match prj {
              ConstructorProj::Mk(idx, cidx, block_addr) => {
                get_ci_cprj(block_addr, UInt64::to_field(idx), UInt64::to_field(cidx)) } ,
            } } ,
          ConstantInfo::RPrj(prj) => {
            match prj {
              RecursorProj::Mk(idx, block_addr) => {
                get_ci_rprj(block_addr, UInt64::to_field(idx)) } ,
            } } ,

          ConstantInfo::Recr(recr) => {

            let self_recur = store(Lists::Node::Cons(addr, store(Lists::Node::Nil)));
            store(convert_recursor(recr, addr, 0,
                                        sharing, refs, self_recur, univs)) } ,
        } } ,
    }
  }

  fn get_ci_dprj(dprj_addr: Addr, idx: U64, block_addr: Addr) -> &KConstantInfo {
    let block_c = load_verified_constant(block_addr);
    match block_c {
      Constant::Mk(info, sharing, refs, univs) => {
        match info {
          ConstantInfo::Muts(members) => {
            let mc = list_lookup_u64(members, idx);
            match mc {
              MutConst::Defn(d) => {
                let hint = load_constant_hint(dprj_addr);
                let recur_addrs =
                  defn_member_recur_addrs(d, members, block_addr);
                store(convert_definition(d, sharing, refs, recur_addrs, univs, hint)) } ,
            } } ,
        } } ,
    }
  }

  fn get_ci_iprj(block_addr: Addr, idx: Field) -> &KConstantInfo {
    let block_c = load_verified_constant(block_addr);
    match block_c {
      Constant::Mk(info, sharing, refs, univs) => {
        match info {
          ConstantInfo::Muts(members) => {
            let mc = muts_member_at(members, idx);
            match mc {
              MutConst::Indc(ind) => {
                let recur_addrs = build_recur_addrs(members, block_addr);
                store(convert_inductive(ind, block_addr, idx,
                                             sharing, refs, recur_addrs, univs)) } ,
            } } ,
        } } ,
    }
  }

  fn get_ci_cprj(block_addr: Addr, idx: Field, cidx: Field) -> &KConstantInfo {
    let block_c = load_verified_constant(block_addr);
    match block_c {
      Constant::Mk(info, sharing, refs, univs) => {
        match info {
          ConstantInfo::Muts(members) => {
            let mc = muts_member_at(members, idx);
            match mc {
              MutConst::Indc(ind) => {
                match ind {
                  Inductive::Mk(_, _, _, _, _, ctors) => {
                    let c = ctor_at(ctors, cidx);
                    let recur_addrs = build_recur_addrs(members, block_addr);
                    store(convert_constructor(c, block_addr, idx,
                                                  sharing, refs, recur_addrs, univs)) } ,
                } } ,
            } } ,
        } } ,
    }
  }

  fn get_ci_rprj(block_addr: Addr, idx: Field) -> &KConstantInfo {
let block_c = load_verified_constant(block_addr);
    match block_c {
      Constant::Mk(info, sharing, refs, univs) => {
        match info {
          ConstantInfo::Muts(members) => {
            let mc = muts_member_at(members, idx);
            match mc {
              MutConst::Recr(r) => {
                let recur_addrs = build_recur_addrs(members, block_addr);
                store(convert_recursor(r, block_addr, idx,
                                           sharing, refs, recur_addrs, univs)) } ,
            } } ,
        } } ,
    }
  }

  fn muts_member_at(members: List<MutConst>, idx: Field) -> MutConst {
    match load(members) {
      Lists::Node::Cons(m, rest) => {
        match idx {
          0 => {  m } ,
          _ => {  muts_member_at(rest, idx - 1) } ,
        } } ,
    }
  }



  fn projection_addr(members: List<MutConst>, block_addr: Addr, idx: Field) -> Addr {
    let mc = muts_member_at(members, idx);
    let idx_u64 = UInt64::from_field(idx);
    let info = match mc {
      MutConst::Defn(_) => {
        ConstantInfo::DPrj(DefinitionProj::Mk(idx_u64, block_addr)) } ,
      MutConst::Indc(_) => {
        ConstantInfo::IPrj(InductiveProj::Mk(idx_u64, block_addr)) } ,
      MutConst::Recr(_) => {
        ConstantInfo::RPrj(RecursorProj::Mk(idx_u64, block_addr)) } ,
    };
    let proj_c = Constant::Mk(info,
                              store(Lists::Node::Nil),
                              store(Lists::Node::Nil),
                              store(Lists::Node::Nil));
    let bytes = put_constant(proj_c, store(Lists::Node::Nil));
    Blake3::bytes_to_addr(bytes)
  }

  fn build_recur_addrs(members: List<MutConst>, block_addr: Addr) -> List<Addr> {
    build_recur_addrs_walk(members, block_addr, members, 0)
  }

  fn build_recur_addrs_walk(all_members: List<MutConst>, block_addr: Addr,
                                 cur: List<MutConst>, idx: Field) -> List<Addr> {
    match load(cur) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(_, rest) => {
        store(Lists::Node::Cons(
          projection_addr(all_members, block_addr, idx),
          build_recur_addrs_walk(all_members, block_addr, rest, idx + 1))) } ,
    }
  }

  fn level_is_not_zero(l: KLevel) -> Field {
    match load(l) {
      KLevelNode::Zero => {  0 } ,
      KLevelNode::Param(_) => {  0 } ,
      KLevelNode::Succ(_) => {  1 } ,
      KLevelNode::Max(a, b) => {  match (level_is_not_zero(a), level_is_not_zero(b)) {
        (0, 0) => {  0 } ,
        _ => {  1 } ,
      } } ,
      KLevelNode::IMax(_, b) => {  level_is_not_zero(b) } ,
    }
  }

  fn level_eq(a: KLevel, b: KLevel) -> Field {
    match load(a) {
      KLevelNode::Zero => {
        match load(b) {
          KLevelNode::Zero => {  1 } ,
          _ => {  0 } ,
        } } ,
      KLevelNode::Succ(a1) => {
        match load(b) {
          KLevelNode::Succ(b1) => {  level_eq(a1, b1) } ,
          _ => {  0 } ,
        } } ,
      KLevelNode::Max(a1, a2) => {
        match load(b) {
          KLevelNode::Max(b1, b2) => {  level_eq(a1, b1) * level_eq(a2, b2) } ,
          _ => {  0 } ,
        } } ,
      KLevelNode::IMax(a1, a2) => {
        match load(b) {
          KLevelNode::IMax(b1, b2) => {  level_eq(a1, b1) * level_eq(a2, b2) } ,
          _ => {  0 } ,
        } } ,
      KLevelNode::Param(i) => {
        match load(b) {
          KLevelNode::Param(j) => {  Fields::is_zero(i - j) } ,
          _ => {  0 } ,
        } } ,
    }
  }

  fn glist_cmp(a: List<Field>, b: List<Field>) -> Field {
    match load(a) {
      Lists::Node::Nil => {
        match load(b) {
          Lists::Node::Nil => {  0 } ,
          Lists::Node::Cons(_, _) => {  1 } ,
        } } ,
      Lists::Node::Cons(x, ar) => {
        match load(b) {
          Lists::Node::Nil => {  2 } ,
          Lists::Node::Cons(y, br) => {
            match UInt32::less_than_fields(x, y) {
              1 => {  1 } ,
              0 => {
                match UInt32::less_than_fields(y, x) {
                  1 => {  2 } ,
                  0 => {  glist_cmp(ar, br) } ,
                } } ,
            } } ,
        } } ,
    }
  }

  fn glist_subset(xs: List<Field>, ys: List<Field>) -> Field {
    match load(xs) {
      Lists::Node::Nil => {  1 } ,
      Lists::Node::Cons(x, xr) => {
        match load(ys) {
          Lists::Node::Nil => {  0 } ,
          Lists::Node::Cons(y, yr) => {
            match UInt32::less_than_fields(x, y) {
              1 => {  0 } ,
              0 => {
                match UInt32::less_than_fields(y, x) {
                  1 => {  glist_subset(xs, yr) } ,
                  0 => {  glist_subset(xr, yr) } ,
                } } ,
            } } ,
        } } ,
    }
  }

  fn glist_eq_len(a: List<Field>, b: List<Field>) -> Field {
    match load(a) {
      Lists::Node::Nil => {
        match load(b) {
          Lists::Node::Nil => {  1 } ,
          Lists::Node::Cons(_, _) => {  0 } ,
        } } ,
      Lists::Node::Cons(_, ar) => {
        match load(b) {
          Lists::Node::Nil => {  0 } ,
          Lists::Node::Cons(_, br) => {  glist_eq_len(ar, br) } ,
        } } ,
    }
  }

  fn glist_ordered_insert(x: Field, l: List<Field>) -> (Field, List<Field>) {
    match load(l) {
      Lists::Node::Nil => {  (1, store(Lists::Node::Cons(x, store(Lists::Node::Nil)))) } ,
      Lists::Node::Cons(h, r) => {
        match UInt32::less_than_fields(x, h) {
          1 => {  (1, store(Lists::Node::Cons(x, l))) } ,
          0 => {
            match UInt32::less_than_fields(h, x) {
              0 => {  (0, l) } ,
              1 => {
                match glist_ordered_insert(x, r) {
                  (f, r2) => {  (f, store(Lists::Node::Cons(h, r2))) } ,
                } } ,
            } } ,
        } } ,
    }
  }

  fn nlvars_add(vars: List<&NLVar>, idx: Field, k: Field) -> List<&NLVar> {
    match load(vars) {
      Lists::Node::Nil => {
        store(Lists::Node::Cons(store(NLVar::Mk(idx, k)), store(Lists::Node::Nil))) } ,
      Lists::Node::Cons(v, rest) => {
        match load(v) {
          NLVar::Mk(vi, vo) => {
            match UInt32::less_than_fields(idx, vi) {
              1 => {  store(Lists::Node::Cons(store(NLVar::Mk(idx, k)), vars)) } ,
              0 => {
                match UInt32::less_than_fields(vi, idx) {
                  1 => {  store(Lists::Node::Cons(v, nlvars_add(rest, idx, k))) } ,
                  0 => {
                    match UInt32::less_than_fields(vo, k) {
                      1 => {  store(Lists::Node::Cons(store(NLVar::Mk(vi, k)), rest)) } ,
                      0 => {  vars } ,
                    } } ,
                } } ,
            } } ,
        } } ,
    }
  }

  fn nlvars_eq(a: List<&NLVar>, b: List<&NLVar>) -> Field {
    match load(a) {
      Lists::Node::Nil => {
        match load(b) {
          Lists::Node::Nil => {  1 } ,
          Lists::Node::Cons(_, _) => {  0 } ,
        } } ,
      Lists::Node::Cons(x, ar) => {
        match load(b) {
          Lists::Node::Nil => {  0 } ,
          Lists::Node::Cons(y, br) => {
            match load(x) {
              NLVar::Mk(xi, xo) => {
                match load(y) {
                  NLVar::Mk(yi, yo) => {
                    match xi - yi {
                      0 => {
                        match xo - yo {
                          0 => {  nlvars_eq(ar, br) } ,
                          _ => {  0 } ,
                        } } ,
                      _ => {  0 } ,
                    } } ,
                } } ,
            } } ,
        } } ,
    }
  }

  fn nlvars_max_offset(vars: List<&NLVar>) -> Field {
    match load(vars) {
      Lists::Node::Nil => {  0 } ,
      Lists::Node::Cons(v, rest) => {
        match load(v) {
          NLVar::Mk(_, vo) => {
            let m = nlvars_max_offset(rest);
            match UInt32::less_than_fields(m, vo) {
              1 => {  vo } ,
              0 => {  m } ,
            } } ,
        } } ,
    }
  }

  fn nlvars_subsume(xs: List<&NLVar>, ys: List<&NLVar>) -> List<&NLVar> {
    match load(xs) {
      Lists::Node::Nil => {  xs } ,
      Lists::Node::Cons(x, xr) => {
        match load(ys) {
          Lists::Node::Nil => {  xs } ,
          Lists::Node::Cons(y, yr) => {
            match load(x) {
              NLVar::Mk(xi, xo) => {
                match load(y) {
                  NLVar::Mk(yi, yo) => {
                    match UInt32::less_than_fields(xi, yi) {
                      1 => {  store(Lists::Node::Cons(x, nlvars_subsume(xr, ys))) } ,
                      0 => {
                        match UInt32::less_than_fields(yi, xi) {
                          1 => {  nlvars_subsume(xs, yr) } ,
                          0 => {
                            match UInt32::less_than_fields(yo, xo) {
                              1 => {  store(Lists::Node::Cons(x, nlvars_subsume(xr, yr))) } ,
                              0 => {  nlvars_subsume(xr, yr) } ,
                            } } ,
                        } } ,
                    } } ,
                } } ,
            } } ,
        } } ,
    }
  }

  fn nl_add_const(acc: List<&NLEntry>, path: List<Field>, k: Field) -> List<&NLEntry> {
    match k {
      0 => {  acc } ,
      1 => {
        match load(path) {
          Lists::Node::Nil => {  nl_add_const_go(acc, path, k) } ,
          Lists::Node::Cons(_, _) => {  acc } ,
        } } ,
      _ => {  nl_add_const_go(acc, path, k) } ,
    }
  }

  fn nl_add_const_go(acc: List<&NLEntry>, path: List<Field>, k: Field) -> List<&NLEntry> {
    match load(acc) {
      Lists::Node::Nil => {
        store(Lists::Node::Cons(
          store(NLEntry::Mk(path, k, store(Lists::Node::Nil))),
          store(Lists::Node::Nil))) } ,
      Lists::Node::Cons(e, rest) => {
        match load(e) {
          NLEntry::Mk(ep, ec, ev) => {
            match glist_cmp(path, ep) {
              0 => {
                match UInt32::less_than_fields(ec, k) {
                  1 => {  store(Lists::Node::Cons(store(NLEntry::Mk(ep, k, ev)), rest)) } ,
                  0 => {  acc } ,
                } } ,
              1 => {
                store(Lists::Node::Cons(
                  store(NLEntry::Mk(path, k, store(Lists::Node::Nil))), acc)) } ,
              _ => {  store(Lists::Node::Cons(e, nl_add_const_go(rest, path, k))) } ,
            } } ,
        } } ,
    }
  }

  fn nl_add_var(acc: List<&NLEntry>, path: List<Field>, idx: Field, k: Field) -> List<&NLEntry> {
    match load(acc) {
      Lists::Node::Nil => {
        store(Lists::Node::Cons(
          store(NLEntry::Mk(path, 0,
            store(Lists::Node::Cons(store(NLVar::Mk(idx, k)), store(Lists::Node::Nil))))),
          store(Lists::Node::Nil))) } ,
      Lists::Node::Cons(e, rest) => {
        match load(e) {
          NLEntry::Mk(ep, ec, ev) => {
            match glist_cmp(path, ep) {
              0 => {
                store(Lists::Node::Cons(
                  store(NLEntry::Mk(ep, ec, nlvars_add(ev, idx, k))), rest)) } ,
              1 => {
                store(Lists::Node::Cons(
                  store(NLEntry::Mk(path, 0,
                    store(Lists::Node::Cons(store(NLVar::Mk(idx, k)), store(Lists::Node::Nil))))),
                  acc)) } ,
              _ => {  store(Lists::Node::Cons(e, nl_add_var(rest, path, idx, k))) } ,
            } } ,
        } } ,
    }
  }

  fn normalize_aux(l: KLevel, path: List<Field>, k: Field,
                   acc: List<&NLEntry>) -> List<&NLEntry> {
    match load(l) {
      KLevelNode::Zero => {  nl_add_const(acc, path, k) } ,
      KLevelNode::Succ(inner) => {  normalize_aux(inner, path, k + 1, acc) } ,
      KLevelNode::Max(a, b) => {
        normalize_aux(b, path, k, normalize_aux(a, path, k, acc)) } ,
      KLevelNode::IMax(u, b) => {  normalize_imax_dispatch(u, b, path, k, acc) } ,
      KLevelNode::Param(idx) => {
        match glist_ordered_insert(idx, path) {
          (1, new_path) => {
            nl_add_var(nl_add_const(acc, path, k), new_path, idx, k) } ,
          (0, _) => {
            match k {
              0 => {  acc } ,
              _ => {  nl_add_var(acc, path, idx, k) } ,
            } } ,
        } } ,
    }
  }

  fn normalize_imax_dispatch(a: KLevel, b: KLevel, path: List<Field>, k: Field,
                             acc: List<&NLEntry>) -> List<&NLEntry> {
    match load(b) {
      KLevelNode::Zero => {  nl_add_const(acc, path, k) } ,
      KLevelNode::Succ(v) => {
        normalize_aux(v, path, k + 1, normalize_aux(a, path, k, acc)) } ,
      KLevelNode::Max(v, w) => {

        normalize_imax_dispatch(a, w, path, k,
          normalize_imax_dispatch(a, v, path, k, acc)) } ,
      KLevelNode::IMax(v, w) => {

        normalize_imax_dispatch(v, w, path, k,
          normalize_imax_dispatch(a, w, path, k, acc)) } ,
      KLevelNode::Param(idx) => {
        match glist_ordered_insert(idx, path) {
          (1, new_path) => {

            normalize_aux(a, new_path, k,
              nl_add_var(nl_add_const(acc, path, k), new_path, idx, k)) } ,
          (0, _) => {
            let acc2 = match k {
              0 => {  acc } ,
              _ => {  nl_add_var(acc, path, idx, k) } ,
            };
            normalize_aux(a, path, k, acc2) } ,
        } } ,
    }
  }

  fn nl_subsumption_walk(rem: List<&NLEntry>,
                         snapshot: List<&NLEntry>) -> List<&NLEntry> {
    match load(rem) {
      Lists::Node::Nil => {  rem } ,
      Lists::Node::Cons(e, rest) => {
        store(Lists::Node::Cons(
          nl_subsume_entry(e, snapshot),
          nl_subsumption_walk(rest, snapshot))) } ,
    }
  }

  fn nl_subsume_entry(e: &NLEntry, snap: List<&NLEntry>) -> &NLEntry {
    match load(snap) {
      Lists::Node::Nil => {  e } ,
      Lists::Node::Cons(s, srest) => {
        match load(e) {
          NLEntry::Mk(p1, c1, v1) => {
            match load(s) {
              NLEntry::Mk(p2, c2, v2) => {
                match glist_subset(p2, p1) {
                  0 => {  nl_subsume_entry(e, srest) } ,
                  _ => {

                    let same = glist_eq_len(p1, p2);
                    let c1n = match c1 {
                      0 => {  0 } ,
                      _ => {
                        let or1 = match same {
                          1 => {  1 } ,
                          0 => {  UInt32::less_than_fields(c2, c1) } ,
                        };
                        let or2 = match load(v2) {
                          Lists::Node::Nil => {  1 } ,
                          Lists::Node::Cons(_, _) => {
                            UInt32::less_than_fields(nlvars_max_offset(v1) + 1, c1) } ,
                        };
                        match or1 * or2 {
                          0 => {  0 } ,
                          _ => {  c1 } ,
                        } } ,
                    };
                    let v1n = match same {
                      1 => {  v1 } ,
                      0 => {
                        match load(v2) {
                          Lists::Node::Nil => {  v1 } ,
                          Lists::Node::Cons(_, _) => {  nlvars_subsume(v1, v2) } ,
                        } } ,
                    };
                    nl_subsume_entry(store(NLEntry::Mk(p1, c1n, v1n)), srest) } ,
                } } ,
            } } ,
        } } ,
    }
  }

  fn nl_skip_empty(l: List<&NLEntry>) -> List<&NLEntry> {
    match load(l) {
      Lists::Node::Nil => {  l } ,
      Lists::Node::Cons(e, rest) => {
        match load(e) {
          NLEntry::Mk(_, c, v) => {
            match c {
              0 => {
                match load(v) {
                  Lists::Node::Nil => {  nl_skip_empty(rest) } ,
                  Lists::Node::Cons(_, _) => {  l } ,
                } } ,
              _ => {  l } ,
            } } ,
        } } ,
    }
  }

  fn nl_eq(a0: List<&NLEntry>, b0: List<&NLEntry>) -> Field {
    let a = nl_skip_empty(a0);
    let b = nl_skip_empty(b0);
    match load(a) {
      Lists::Node::Nil => {
        match load(b) {
          Lists::Node::Nil => {  1 } ,
          Lists::Node::Cons(_, _) => {  0 } ,
        } } ,
      Lists::Node::Cons(x, ar) => {
        match load(b) {
          Lists::Node::Nil => {  0 } ,
          Lists::Node::Cons(y, br) => {
            match load(x) {
              NLEntry::Mk(xp, xc, xv) => {
                match load(y) {
                  NLEntry::Mk(yp, yc, yv) => {
                    match glist_cmp(xp, yp) {
                      0 => {
                        match xc - yc {
                          0 => {
                            match nlvars_eq(xv, yv) {
                              1 => {  nl_eq(ar, br) } ,
                              0 => {  0 } ,
                            } } ,
                          _ => {  0 } ,
                        } } ,
                      _ => {  0 } ,
                    } } ,
                } } ,
            } } ,
        } } ,
    }
  }

  fn nl_covers_const(l2: List<&NLEntry>, p1: List<Field>, c: Field) -> Field {
    match load(l2) {
      Lists::Node::Nil => {  0 } ,
      Lists::Node::Cons(e, rest) => {
        match load(e) {
          NLEntry::Mk(p2, c2, v2) => {
            match glist_subset(p2, p1) {
              0 => {  nl_covers_const(rest, p1, c) } ,
              _ => {
                let hit = match UInt32::less_than_fields(c2, c) {
                  0 => {  1 } ,
                  1 => {  nlvars_any_offset_geq(v2, c) } ,
                };
                match hit {
                  1 => {  1 } ,
                  0 => {  nl_covers_const(rest, p1, c) } ,
                } } ,
            } } ,
        } } ,
    }
  }

  fn nlvars_any_offset_geq(vars: List<&NLVar>, c: Field) -> Field {
    match load(vars) {
      Lists::Node::Nil => {  0 } ,
      Lists::Node::Cons(v, rest) => {
        match load(v) {
          NLVar::Mk(_, vo) => {
            match UInt32::less_than_fields(vo + 1, c) {
              0 => {  1 } ,
              1 => {  nlvars_any_offset_geq(rest, c) } ,
            } } ,
        } } ,
    }
  }

  fn nl_covers_var(l2: List<&NLEntry>, p1: List<Field>, w: Field, off: Field) -> Field {
    match load(l2) {
      Lists::Node::Nil => {  0 } ,
      Lists::Node::Cons(e, rest) => {
        match load(e) {
          NLEntry::Mk(p2, _, v2) => {
            match glist_subset(p2, p1) {
              0 => {  nl_covers_var(rest, p1, w, off) } ,
              _ => {
                match nlvars_dominates(v2, w, off) {
                  1 => {  1 } ,
                  0 => {  nl_covers_var(rest, p1, w, off) } ,
                } } ,
            } } ,
        } } ,
    }
  }

  fn nlvars_dominates(vars: List<&NLVar>, w: Field, off: Field) -> Field {
    match load(vars) {
      Lists::Node::Nil => {  0 } ,
      Lists::Node::Cons(v, rest) => {
        match load(v) {
          NLVar::Mk(vi, vo) => {
            match vi - w {
              0 => {
                match UInt32::less_than_fields(vo, off) {
                  0 => {  1 } ,
                  1 => {  nlvars_dominates(rest, w, off) } ,
                } } ,
              _ => {  nlvars_dominates(rest, w, off) } ,
            } } ,
        } } ,
    }
  }

  fn nl_le(l1: List<&NLEntry>, l2: List<&NLEntry>) -> Field {
    match load(l1) {
      Lists::Node::Nil => {  1 } ,
      Lists::Node::Cons(e, rest) => {
        match load(e) {
          NLEntry::Mk(p1, c1, v1) => {
            let c_ok = match c1 {
              0 => {  1 } ,
              _ => {  nl_covers_const(l2, p1, c1) } ,
            };
            match c_ok {
              0 => {  0 } ,
              1 => {
                match nl_le_vars(v1, l2, p1) {
                  0 => {  0 } ,
                  1 => {  nl_le(rest, l2) } ,
                } } ,
            } } ,
        } } ,
    }
  }

  fn nl_le_vars(vars: List<&NLVar>, l2: List<&NLEntry>, p1: List<Field>) -> Field {
    match load(vars) {
      Lists::Node::Nil => {  1 } ,
      Lists::Node::Cons(v, rest) => {
        match load(v) {
          NLVar::Mk(vi, vo) => {
            match nl_covers_var(l2, p1, vi, vo) {
              0 => {  0 } ,
              1 => {  nl_le_vars(rest, l2, p1) } ,
            } } ,
        } } ,
    }
  }

  fn level_normalize(l: KLevel) -> List<&NLEntry> {
    let seed = store(Lists::Node::Cons(
      store(NLEntry::Mk(store(Lists::Node::Nil), 0, store(Lists::Node::Nil))),
      store(Lists::Node::Nil)));
    let raw = normalize_aux(l, store(Lists::Node::Nil), 0, seed);
    nl_subsumption_walk(raw, raw)
  }

  fn level_leq(a: KLevel, b: KLevel) -> Field {
    match level_eq(a, b) {
      1 => {  1 } ,
      0 => {
        match load(a) {
          KLevelNode::Zero => {  1 } ,
          _ => {  nl_le(level_normalize(a), level_normalize(b)) } ,
        } } ,
    }
  }

  fn level_equal(a: KLevel, b: KLevel) -> Field {
    match level_eq(a, b) {
      1 => {  1 } ,
      0 => {  nl_eq(level_normalize(a), level_normalize(b)) } ,
    }
  }

  fn level_max(a: KLevel, b: KLevel) -> KLevel {
    match level_explicit_val(a) {
      (1, na) => {
        match level_explicit_val(b) {
          (1, nb) => {
            match UInt32::less_than_fields(na, nb) {
              1 => {  b } ,
              0 => {  a } ,
            } } ,
          _ => {  level_max_go(a, b) } ,
        } } ,
      _ => {  level_max_go(a, b) } ,
    }
  }

  fn level_max_go(a: KLevel, b: KLevel) -> KLevel {
    match level_struct_eq(a, b) {
      1 => {  a } ,
      0 => {
        match load(a) {
          KLevelNode::Zero => {  b } ,
          _ => {
            match load(b) {
              KLevelNode::Zero => {  a } ,
              _ => {
                match level_max_subsumes(b, a) {
                  1 => {  b } ,
                  0 => {
                    match level_max_subsumes(a, b) {
                      1 => {  a } ,
                      0 => {  level_max_offsets(a, b) } ,
                    } } ,
                } } ,
            } } ,
        } } ,
    }
  }

  fn level_struct_eq(a: KLevel, b: KLevel) -> Field {
    match load(a) {
          KLevelNode::Zero => {
            match load(b) {
              KLevelNode::Zero => {  1 } ,
              _ => {  0 } ,
            } } ,
          KLevelNode::Succ(x) => {
            match load(b) {
              KLevelNode::Succ(y) => {  level_struct_eq(x, y) } ,
              _ => {  0 } ,
            } } ,
          KLevelNode::Max(x1, x2) => {
            match load(b) {
              KLevelNode::Max(y1, y2) => {
                level_struct_eq(x1, y1) * level_struct_eq(x2, y2) } ,
              _ => {  0 } ,
            } } ,
          KLevelNode::IMax(x1, x2) => {
            match load(b) {
              KLevelNode::IMax(y1, y2) => {
                level_struct_eq(x1, y1) * level_struct_eq(x2, y2) } ,
              _ => {  0 } ,
            } } ,
          KLevelNode::Param(i) => {
            match load(b) {
              KLevelNode::Param(j) => {
                match i - j {
                  0 => {  1 } ,
                  _ => {  0 } ,
                } } ,
              _ => {  0 } ,
            } } ,
        }
  }

  fn level_max_subsumes(m: KLevel, x: KLevel) -> Field {
    match load(m) {
      KLevelNode::Max(l, r) => {
        match level_struct_eq(l, x) {
          1 => {  1 } ,
          0 => {  level_struct_eq(r, x) } ,
        } } ,
      _ => {  0 } ,
    }
  }

  fn level_max_offsets(a: KLevel, b: KLevel) -> KLevel {
    match level_offset_of(a, 0) {
      (base_a, off_a) => {
        match level_offset_of(b, 0) {
          (base_b, off_b) => {
            match level_struct_eq(base_a, base_b) {
              1 => {
                match UInt32::less_than_fields(off_a, off_b) {
                  1 => {  b } ,
                  0 => {  a } ,
                } } ,
              0 => {  store(KLevelNode::Max(a, b)) } ,
            } } ,
        } } ,
    }
  }

  fn level_explicit_val(l: KLevel) -> (Field, Field) {
    match load(l) {
      KLevelNode::Zero => {  (1, 0) } ,
      KLevelNode::Succ(inner) => {
        match level_explicit_val(inner) {
          (1, n) => {  (1, n + 1) } ,
          _ => {  (0, 0) } ,
        } } ,
      _ => {  (0, 0) } ,
    }
  }

  fn level_offset_of(l: KLevel, k: Field) -> (KLevel, Field) {
    match load(l) {
      KLevelNode::Succ(inner) => {  level_offset_of(inner, k + 1) } ,
      _ => {  (l, k) } ,
    }
  }

  fn level_imax(a: KLevel, b: KLevel) -> KLevel {
    match load(b) {
      KLevelNode::Zero => {  store(KLevelNode::Zero) } ,
      KLevelNode::Succ(_) => {  level_max(a, b) } ,
      _ => {
        let not_zero = level_is_not_zero(b);
        match not_zero {
          1 => {  level_max(a, b) } ,
          0 => {
            match load(a) {
              KLevelNode::Zero => {  b } ,
              _ => {
                let eq = level_eq(a, b);
                match eq {
                  1 => {  a } ,
                  0 => {  store(KLevelNode::IMax(a, b)) } ,
                } } ,
            } } ,
        } } ,
    }
  }

  fn level_reduce(l: KLevel) -> KLevel {
    match load(l) {
      KLevelNode::Zero => {  store(KLevelNode::Zero) } ,
      KLevelNode::Param(i) => {  store(KLevelNode::Param(i)) } ,
      KLevelNode::Succ(u) => {  store(KLevelNode::Succ(level_reduce(u))) } ,
      KLevelNode::Max(a, b) => {  level_max(level_reduce(a), level_reduce(b)) } ,
      KLevelNode::IMax(a, b) => {  level_imax(level_reduce(a), level_reduce(b)) } ,
    }
  }

  fn level_inst_params(l: KLevel, params: List<KLevel>) -> KLevel {
    match load(l) {
      KLevelNode::Zero => {  store(KLevelNode::Zero) } ,
      KLevelNode::Succ(u) => {  store(KLevelNode::Succ(level_inst_params(u, params))) } ,
      KLevelNode::Max(a, b) => {
        level_max(level_inst_params(a, params), level_inst_params(b, params)) } ,
      KLevelNode::IMax(a, b) => {
        level_imax(level_inst_params(a, params), level_inst_params(b, params)) } ,
      KLevelNode::Param(i) => {  list_lookup(params, i) } ,
    }
  }

  fn level_list_inst(lvls: List<KLevel>, params: List<KLevel>) -> List<KLevel> {
    match load(lvls) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(l, rest) => {
        store(Lists::Node::Cons(
          level_inst_params(l, params),
          level_list_inst(rest, params))) } ,
    }
  }

  fn expr_inst_levels(e: KExpr, params: List<KLevel>) -> KExpr {

    match load(params) {
      Lists::Node::Nil => {  e } ,
      _ => {  expr_inst_levels_walk(e, params) } ,
    }
  }

  fn expr_inst_levels_walk(e: KExpr, params: List<KLevel>) -> KExpr {
    match load(e) {
      KExprNode::BVar(i) => {  store(KExprNode::BVar(i)) } ,
      KExprNode::Srt(l) => {
        store(KExprNode::Srt(level_inst_params(l, params))) } ,
      KExprNode::Const(idx, lvls) => {
        store(KExprNode::Const(idx, level_list_inst(lvls, params))) } ,
      KExprNode::App(f, a) => {
        store(KExprNode::App(expr_inst_levels(f, params), expr_inst_levels(a, params))) } ,
      KExprNode::Lam(ty, body) => {
        store(KExprNode::Lam(expr_inst_levels(ty, params), expr_inst_levels(body, params))) } ,
      KExprNode::Forall(ty, body) => {
        store(KExprNode::Forall(expr_inst_levels(ty, params), expr_inst_levels(body, params))) } ,
      KExprNode::Let(ty, val, body) => {
        store(KExprNode::Let(
          expr_inst_levels(ty, params),
          expr_inst_levels(val, params),
          expr_inst_levels(body, params))) } ,
      KExprNode::Lit(lit) => {  store(KExprNode::Lit(lit)) } ,
      KExprNode::Proj(tidx, fidx, e1) => {
        store(KExprNode::Proj(tidx, fidx, expr_inst_levels(e1, params))) } ,
    }
  }

  fn klimbs_eq(a: KLimbs, b: KLimbs) -> Field {
    match load(a) {
      Lists::Node::Nil => {
        match load(b) {
          Lists::Node::Nil => {  1 } ,
          _ => {  0 } ,
        } } ,
      Lists::Node::Cons(la, ra) => {
        match load(b) {
          Lists::Node::Nil => {  0 } ,
          Lists::Node::Cons(lb, rb) => {
            let eq = UInt64::eq(la, lb);
            match eq {
              1 => {  klimbs_eq(ra, rb) } ,
              0 => {  0 } ,
            } } ,
        } } ,
    }
  }

  fn bytestream_eq(a: ByteStream, b: ByteStream) -> Field {
    match load(a) {
      Lists::Node::Nil => {
        match load(b) {
          Lists::Node::Nil => {  1 } ,
          _ => {  0 } ,
        } } ,
      Lists::Node::Cons(ba, ra) => {
        match load(b) {
          Lists::Node::Nil => {  0 } ,
          Lists::Node::Cons(bb, rb) => {
            match UInt8::to_field(ba) - UInt8::to_field(bb) {
              0 => {  bytestream_eq(ra, rb) } ,
              _ => {  0 } ,
            } } ,
        } } ,
    }
  }

  fn literal_eq(a: KLiteral, b: KLiteral) -> Field {
    match a {
      KLiteral::Nat(na) => {
        match b {
          KLiteral::Nat(nb) => {  klimbs_eq(na, nb) } ,
          _ => {  0 } ,
        } } ,
      KLiteral::Str(sa) => {
        match b {
          KLiteral::Str(sb) => {  bytestream_eq(sa, sb) } ,
          _ => {  0 } ,
        } } ,
    }
  }

  fn expr_lbr(e: KExpr) -> Field {
    match load(e) {
      KExprNode::BVar(i) => {  i + 1 } ,
      KExprNode::Srt(_) => {  0 } ,
      KExprNode::Const(_, _) => {  0 } ,
      KExprNode::Lit(_) => {  0 } ,
      KExprNode::App(f, a) => {  lbr_max(expr_lbr(f), expr_lbr(a)) } ,
      KExprNode::Lam(ty, body) => {
        lbr_max(expr_lbr(ty), lbr_dec(expr_lbr(body))) } ,
      KExprNode::Forall(ty, body) => {
        lbr_max(expr_lbr(ty), lbr_dec(expr_lbr(body))) } ,
      KExprNode::Let(ty, val, body) => {  expr_lbr_let(ty, val, body) } ,
      KExprNode::Proj(_, _, e1) => {  expr_lbr(e1) } ,
    }
  }

  fn expr_lbr_let(ty: KExpr, val: KExpr, body: KExpr) -> Field {
    lbr_max(lbr_max(expr_lbr(ty), expr_lbr(val)),
            lbr_dec(expr_lbr(body)))
  }

  fn lbr_max(a: Field, b: Field) -> Field {
    match UInt32::less_than_fields(a, b) {
      1 => {  b } ,
      0 => {  a } ,
    }
  }

  fn lbr_dec(n: Field) -> Field {
    match n {
      0 => {  0 } ,
      _ => {  n - 1 } ,
    }
  }

  fn lbr_min(a: Field, b: Field) -> Field {
    match UInt32::less_than_fields(a, b) {
      1 => {  a } ,
      0 => {  b } ,
    }
  }

  fn has_bvar_in_range(e: KExpr, lo: Field, hi: Field) -> Field {
    match load(e) {
      KExprNode::BVar(i) => {
        match UInt32::less_than_fields(i, lo) {
          1 => {  0 } ,
          0 => {  UInt32::less_than_fields(i, hi) } ,
        } } ,
      KExprNode::Srt(_) => {  0 } ,
      KExprNode::Const(_, _) => {  0 } ,
      KExprNode::Lit(_) => {  0 } ,
      KExprNode::App(f, a) => {
        match has_bvar_in_range(f, lo, hi) {
          1 => {  1 } ,
          0 => {  has_bvar_in_range(a, lo, hi) } ,
        } } ,
      KExprNode::Lam(ty, body) => {  has_bvar_in_range_binder(ty, body, lo, hi) } ,
      KExprNode::Forall(ty, body) => {  has_bvar_in_range_binder(ty, body, lo, hi) } ,
      KExprNode::Let(ty, val, body) => {  has_bvar_in_range_let(ty, val, body, lo, hi) } ,
      KExprNode::Proj(_, _, e1) => {  has_bvar_in_range(e1, lo, hi) } ,
    }
  }

  fn has_bvar_in_range_binder(ty: KExpr, body: KExpr, lo: Field, hi: Field) -> Field {
    match has_bvar_in_range(ty, lo, hi) {
      1 => {  1 } ,
      0 => {  has_bvar_in_range(body, lo + 1, hi + 1) } ,
    }
  }

  fn has_bvar_in_range_let(ty: KExpr, val: KExpr, body: KExpr, lo: Field, hi: Field) -> Field {
    match has_bvar_in_range(ty, lo, hi) {
      1 => {  1 } ,
      0 => {
        match has_bvar_in_range(val, lo, hi) {
          1 => {  1 } ,
          0 => {  has_bvar_in_range(body, lo + 1, hi + 1) } ,
        } } ,
    }
  }

  inline fn ctx_reachable(types: List<KExpr>, base: Field) -> Field {
    let len = list_length(types);
    ctx_seek_cut(types, lbr_min(base, len))
  }

  fn ctx_seek_cut(types: List<KExpr>, need: Field) -> Field {
    let c = ctx_next_cut(types);
    match UInt32::less_than_fields(c, need) {
      0 => {  c } ,
      1 => {  c + ctx_seek_cut(list_drop(types, c), need - c) } ,
    }
  }

  fn ctx_next_cut(types: List<KExpr>) -> Field {
    let Lists::Node::Cons(ty, rest) = load(types);
    1 + ctx_close_cut(rest, expr_lbr(ty))
  }

  fn ctx_close_cut(rest: List<KExpr>, l: Field) -> Field {
    match l {
      0 => {  0 } ,
      _ => {
        let c = ctx_next_cut(rest);
        match UInt32::less_than_fields(c, l) {
          0 => {  c } ,
          1 => {  c + ctx_close_cut(list_drop(rest, c), l - c) } ,
        } } ,
    }
  }

  fn ctx_trim(types: List<KExpr>, base: Field) -> List<KExpr> {
    match base {
      0 => {  store(Lists::Node::Nil) } ,
      _ => {
        match UInt32::less_than_fields(base, list_length(types)) {
          0 => {  types } ,
          1 => {  list_take(types, ctx_reachable(types, base)) } ,
        } } ,
    }
  }

  fn expr_glb(e: KExpr, c: Field) -> Field {

    match UInt32::less_than_fields(expr_lbr(e), c + 1) {
      1 => {  4294967295 } ,
      _ => {  expr_glb_walk(e, c) } ,
    }
  }

  fn expr_glb_walk(e: KExpr, c: Field) -> Field {

    match load(e) {
      KExprNode::BVar(i) => {
        match UInt32::less_than_fields(i, c) {
          1 => {  4294967295 } ,
          0 => {  i - c } ,
        } } ,
      KExprNode::Srt(_) => {  4294967295 } ,
      KExprNode::Const(_, _) => {  4294967295 } ,
      KExprNode::Lit(_) => {  4294967295 } ,
      KExprNode::App(f, a) => {  match expr_glb(f, c) {
        0 => {  0 } ,
        n => {  lbr_min(n, expr_glb(a, c)) } ,
      } } ,
      KExprNode::Lam(ty, body) => {  expr_glb_binder(ty, body, c) } ,
      KExprNode::Forall(ty, body) => {  expr_glb_binder(ty, body, c) } ,
      KExprNode::Let(ty, val, body) => {  expr_glb_let(ty, val, body, c) } ,
      KExprNode::Proj(_, _, e1) => {  expr_glb(e1, c) } ,
    }
  }

  fn expr_glb_binder(ty: KExpr, body: KExpr, c: Field) -> Field {
    match expr_glb(ty, c) {
      0 => {  0 } ,
      n => {  lbr_min(n, expr_glb(body, c + 1)) } ,
    }
  }

  fn expr_glb_let(ty: KExpr, val: KExpr, body: KExpr, c: Field) -> Field {
    match expr_glb(ty, c) {
      0 => {  0 } ,
      n => {  match expr_glb(val, c) {
        0 => {  0 } ,
        m => {  lbr_min(lbr_min(n, m), expr_glb(body, c + 1)) } ,
      } } ,
    }
  }

  fn expr_lift(e: KExpr, shift: Field, cutoff: Field) -> KExpr {
    match shift {
      0 => {  e } ,
      _ => {
        let l = expr_lbr(e);
        match UInt32::less_than_fields(cutoff, l) {
          0 => {  e } ,
          1 => {  expr_lift_walk(e, shift, cutoff) } ,
        } } ,
    }
  }

  fn expr_lift_walk(e: KExpr, shift: Field, cutoff: Field) -> KExpr {
    match load(e) {
      KExprNode::BVar(i) => {  expr_lift_bvar(i, shift, cutoff) } ,
      KExprNode::Srt(l) => {  store(KExprNode::Srt(l)) } ,
      KExprNode::Const(idx, lvls) => {  store(KExprNode::Const(idx, lvls)) } ,
      KExprNode::App(f, a) => {
        store(KExprNode::App(
          expr_lift(f, shift, cutoff),
          expr_lift(a, shift, cutoff))) } ,
      KExprNode::Lam(ty, body) => {
        store(KExprNode::Lam(
          expr_lift(ty, shift, cutoff),
          expr_lift(body, shift, cutoff + 1))) } ,
      KExprNode::Forall(ty, body) => {
        store(KExprNode::Forall(
          expr_lift(ty, shift, cutoff),
          expr_lift(body, shift, cutoff + 1))) } ,
      KExprNode::Let(ty, val, body) => {  expr_lift_let(ty, val, body, shift, cutoff) } ,
      KExprNode::Lit(lit) => {  store(KExprNode::Lit(lit)) } ,
      KExprNode::Proj(tidx, fidx, e1) => {
        store(KExprNode::Proj(tidx, fidx, expr_lift(e1, shift, cutoff))) } ,
    }
  }

  fn expr_lift_bvar(i: Field, shift: Field, cutoff: Field) -> KExpr {
    match UInt32::less_than_fields(i, cutoff) {
      1 => {  store(KExprNode::BVar(i)) } ,
      0 => {  store(KExprNode::BVar(i + shift)) } ,
    }
  }

  fn expr_lift_let(ty: KExpr, val: KExpr, body: KExpr, shift: Field, cutoff: Field)
      -> KExpr {
    store(KExprNode::Let(
      expr_lift(ty, shift, cutoff),
      expr_lift(val, shift, cutoff),
      expr_lift(body, shift, cutoff + 1)))
  }

  fn expr_lower(e: KExpr, shift: Field, cutoff: Field) -> KExpr {
    match shift {
      0 => {  e } ,
      _ => {
        let l = expr_lbr(e);
        match UInt32::less_than_fields(cutoff, l) {
          0 => {  e } ,
          1 => {  expr_lower_walk(e, shift, cutoff) } ,
        } } ,
    }
  }

  fn expr_lower_walk(e: KExpr, shift: Field, cutoff: Field) -> KExpr {
    match load(e) {
      KExprNode::BVar(i) => {
        let lt = UInt32::less_than_fields(i, cutoff);
        match lt {
          1 => {  e } ,
          0 => {  store(KExprNode::BVar(i - shift)) } ,
        } } ,
      KExprNode::Srt(l) => {  store(KExprNode::Srt(l)) } ,
      KExprNode::Const(idx, lvls) => {  store(KExprNode::Const(idx, lvls)) } ,
      KExprNode::App(f, a) => {
        store(KExprNode::App(
          expr_lower(f, shift, cutoff),
          expr_lower(a, shift, cutoff))) } ,
      KExprNode::Lam(ty, body) => {
        store(KExprNode::Lam(
          expr_lower(ty, shift, cutoff),
          expr_lower(body, shift, cutoff + 1))) } ,
      KExprNode::Forall(ty, body) => {
        store(KExprNode::Forall(
          expr_lower(ty, shift, cutoff),
          expr_lower(body, shift, cutoff + 1))) } ,
      KExprNode::Let(ty, val, body) => {
        store(KExprNode::Let(
          expr_lower(ty, shift, cutoff),
          expr_lower(val, shift, cutoff),
          expr_lower(body, shift, cutoff + 1))) } ,
      KExprNode::Lit(lit) => {  store(KExprNode::Lit(lit)) } ,
      KExprNode::Proj(tidx, fidx, e1) => {
        store(KExprNode::Proj(tidx, fidx, expr_lower(e1, shift, cutoff))) } ,
    }
  }

  fn expr_has_bvar_at(e: KExpr, depth: Field) -> Field {
    match load(e) {
      KExprNode::BVar(i) => {  match i - depth { 0 => {  1 } , _ => {  0 } , } } ,
      KExprNode::App(f, a) => {
        match expr_has_bvar_at(f, depth) {
          1 => {  1 } ,
          _ => {  expr_has_bvar_at(a, depth) } ,
        } } ,
      KExprNode::Lam(ty, body) => {  expr_has_bvar_at_binder(ty, body, depth) } ,
      KExprNode::Forall(ty, body) => {  expr_has_bvar_at_binder(ty, body, depth) } ,
      KExprNode::Let(ty, val, body) => {  expr_has_bvar_at_let(ty, val, body, depth) } ,
      KExprNode::Proj(_, _, inner) => {  expr_has_bvar_at(inner, depth) } ,
      _ => {  0 } ,
    }
  }

  fn expr_has_bvar_at_binder(ty: KExpr, body: KExpr, depth: Field) -> Field {
    match expr_has_bvar_at(ty, depth) {
      1 => {  1 } ,
      _ => {  expr_has_bvar_at(body, depth + 1) } ,
    }
  }

  fn expr_has_bvar_at_let(ty: KExpr, val: KExpr, body: KExpr, depth: Field) -> Field {
    match expr_has_bvar_at(ty, depth) {
      1 => {  1 } ,
      _ => {
        match expr_has_bvar_at(val, depth) {
          1 => {  1 } ,
          _ => {  expr_has_bvar_at(body, depth + 1) } ,
        } } ,
    }
  }

  fn expr_inst1(e: KExpr, arg: KExpr, depth: Field) -> KExpr {

    let l = expr_lbr(e);
    match UInt32::less_than_fields(depth, l) {
      0 => {  e } ,
      1 => {
        match expr_has_bvar_at(e, depth) {
          1 => {  expr_inst1_walk(e, arg, depth) } ,
          _ => {  expr_lower(e, 1, depth + 1) } ,
        } } ,
    }
  }

  fn expr_inst1_walk(e: KExpr, arg: KExpr, depth: Field) -> KExpr {
    match load(e) {
      KExprNode::BVar(i) => {  expr_inst1_bvar(i, arg, depth) } ,
      KExprNode::Srt(l) => {  store(KExprNode::Srt(l)) } ,
      KExprNode::Const(idx, lvls) => {  store(KExprNode::Const(idx, lvls)) } ,
      KExprNode::App(f, a) => {
        store(KExprNode::App(
          expr_inst1(f, arg, depth),
          expr_inst1(a, arg, depth))) } ,
      KExprNode::Lam(ty, body) => {
        store(KExprNode::Lam(
          expr_inst1(ty, arg, depth),
          expr_inst1(body, arg, depth + 1))) } ,
      KExprNode::Forall(ty, body) => {
        store(KExprNode::Forall(
          expr_inst1(ty, arg, depth),
          expr_inst1(body, arg, depth + 1))) } ,
      KExprNode::Let(ty, val, body) => {  expr_inst1_let(ty, val, body, arg, depth) } ,
      KExprNode::Lit(lit) => {  store(KExprNode::Lit(lit)) } ,
      KExprNode::Proj(tidx, fidx, e1) => {
        store(KExprNode::Proj(tidx, fidx, expr_inst1(e1, arg, depth))) } ,
    }
  }

  fn expr_inst1_bvar(i: Field, arg: KExpr, depth: Field) -> KExpr {
    match UInt32::less_than_fields(i, depth) {
      1 => {  store(KExprNode::BVar(i)) } ,
      0 => {
        match i - depth {
          0 => {  expr_lift(arg, depth, 0) } ,
          _ => {  store(KExprNode::BVar(i - 1)) } ,
        } } ,
    }
  }

  fn expr_inst1_let(ty: KExpr, val: KExpr, body: KExpr, arg: KExpr, depth: Field)
      -> KExpr {
    store(KExprNode::Let(
      expr_inst1(ty, arg, depth),
      expr_inst1(val, arg, depth),
      expr_inst1(body, arg, depth + 1)))
  }

  fn expr_inst_many(e: KExpr, substs: List<KExpr>, depth: Field) -> KExpr {
    let n = list_length(substs);
    match n {
      0 => {  e } ,
      _ => {
        let l = expr_lbr(e);
        match UInt32::less_than_fields(depth, l) {
          0 => {  e } ,
          1 => {
            match has_bvar_in_range(e, depth, depth + n) {
              1 => {  expr_inst_many_walk(e, substs, depth) } ,
              _ => {  expr_lower(e, n, depth + n) } ,
            } } ,
        } } ,
    }
  }

  fn expr_inst_many_bvar(i: Field, substs: List<KExpr>, depth: Field) -> KExpr {
    let n = list_length(substs);
    let ofs = i - depth;
    match UInt32::less_than_fields(ofs, n) {
      1 => {  expr_lift(list_lookup(substs, ofs), depth, 0) } ,
      0 => {  store(KExprNode::BVar(i - n)) } ,
    }
  }

  fn expr_inst_many_walk(e: KExpr, substs: List<KExpr>, depth: Field) -> KExpr {
    match load(e) {
      KExprNode::BVar(i) => {  expr_inst_many_bvar(i, substs, depth) } ,
      KExprNode::Srt(l) => {  store(KExprNode::Srt(l)) } ,
      KExprNode::Const(idx, lvls) => {  store(KExprNode::Const(idx, lvls)) } ,
      KExprNode::App(f, a) => {
        store(KExprNode::App(
          expr_inst_many(f, substs, depth),
          expr_inst_many(a, substs, depth))) } ,
      KExprNode::Lam(ty, body) => {
        store(KExprNode::Lam(
          expr_inst_many(ty, substs, depth),
          expr_inst_many(body, substs, depth + 1))) } ,
      KExprNode::Forall(ty, body) => {
        store(KExprNode::Forall(
          expr_inst_many(ty, substs, depth),
          expr_inst_many(body, substs, depth + 1))) } ,
      KExprNode::Let(ty, val, body) => {
        expr_inst_many_let(ty, val, body, substs, depth) } ,
      KExprNode::Lit(lit) => {  store(KExprNode::Lit(lit)) } ,
      KExprNode::Proj(tidx, fidx, e1) => {
        store(KExprNode::Proj(tidx, fidx, expr_inst_many(e1, substs, depth))) } ,
    }
  }

  fn expr_inst_many_let(ty: KExpr, val: KExpr, body: KExpr,
      substs: List<KExpr>, depth: Field) -> KExpr {
    store(KExprNode::Let(
      expr_inst_many(ty, substs, depth),
      expr_inst_many(val, substs, depth),
      expr_inst_many(body, substs, depth + 1)))
  }

  fn apply_spine(head: KExpr, spine: List<KExpr>) -> KExpr {
    match load(spine) {
      Lists::Node::Nil => {  head } ,
      Lists::Node::Cons(a, rest) => {
        apply_spine(store(KExprNode::App(head, a)), rest) } ,
    }
  }

  fn peel_beta(lam: KExpr, spine: List<KExpr>, acc: List<KExpr>)
                  -> (KExpr, List<KExpr>, List<KExpr>) {
    match load(lam) {
      KExprNode::Lam(_, body) => {
        match load(spine) {
          Lists::Node::Cons(a, rest) => {
            peel_beta(body, rest, store(Lists::Node::Cons(a, acc))) } ,
          Lists::Node::Nil => {  (lam, acc, spine) } ,
        } } ,
      _ => {  (lam, acc, spine) } ,
    }
  }

  fn whnf_apply_beta(spine: List<KExpr>, lam: KExpr, types: List<KExpr>) -> KExpr {
    match peel_beta(lam, spine, store(Lists::Node::Nil)) {
      (deep, consumed, rest) => {
        match list_length(consumed) {
          0 => {  apply_spine(lam, spine) } ,
          1 => {
            let body2 = expr_inst1(deep, list_lookup(consumed, 0), 0);
            whnf_with_spine(body2, rest, types) } ,
          _ => {
            let body2 = expr_inst_many(deep, consumed, 0);
            whnf_with_spine(body2, rest, types) } ,
        } } ,
    }
  }

  fn whnf_with_spine(head: KExpr, spine: List<KExpr>, types: List<KExpr>) -> KExpr {
    match load(head) {
      KExprNode::App(f, a) => {
        match collect_spine(head) {
          (inner_head, inner_spine) => {
            whnf_with_spine(inner_head, list_concat(inner_spine, spine), types) } ,
        } } ,
      KExprNode::Lam(ty, body) => {
        whnf_apply_beta(spine, head, types) } ,
      KExprNode::Const(addr, lvls) => {
        whnf_const_head(addr, lvls, head, spine, types) } ,
      KExprNode::Let(_, val, body) => {
        let next = expr_inst1(body, val, 0);
        whnf_with_spine(next, spine, types) } ,
      KExprNode::Proj(struct_addr, fidx, inner) => {
        whnf_proj_head(struct_addr, fidx, inner, spine, types) } ,
      _ => {  apply_spine(head, spine) } ,
    }
  }

  fn whnf_proj_head(struct_addr: Addr, fidx: Field, inner: KExpr,
                        spine: List<KExpr>, types: List<KExpr>) -> KExpr {
    let inner_whnf = whnf(inner, types);

    let inner_exp = str_lit_to_ctor_app_or_self(inner_whnf, types);
    match collect_spine(inner_exp) {
      (inner_head, inner_args) => {
        match try_reduce_fin_val_decidable_rec(struct_addr, fidx,
                inner_head, inner_args) {
          (1, rewritten) => {  whnf_with_spine(rewritten, spine, types) } ,
          _ => {
            match load(inner_head) {
              KExprNode::Const(_, _) => {
                match load(whnf_get_ctor_or_none(inner_head)) {
                  KConstantInfo::Ctor(_, _, _, _, _, nparams, _, _) => {
                    let field = list_lookup(inner_args, nparams + fidx);
                    whnf_with_spine(field, spine, types) } ,
                  _ => {
                    let stuck = store(KExprNode::Proj(struct_addr, fidx, inner_whnf));
                    apply_spine(stuck, spine) } ,
                } } ,
              _ => {
                let stuck = store(KExprNode::Proj(struct_addr, fidx, inner_whnf));
                apply_spine(stuck, spine) } ,
            } } ,
        } } ,
    }
  }

