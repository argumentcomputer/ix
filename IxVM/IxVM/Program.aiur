  fn binder_contract_code(contract: BinderContract) -> Field {
    let BinderContract::Mk(uses, value) = contract;
    let u = match uses { Uses::Erased => {  0 } , Uses::Linear => {  1 } , Uses::Affine => {  2 } , Uses::Many => {  3 } , };
    u + 4 * value_contract_code(value)
  }

  fn put_lam_mode(contract: BinderContract, rest: ByteStream) -> ByteStream {
    store(Lists::Node::Cons(UInt8::from_field(binder_contract_code(contract)), rest))
  }

  fn put_all_mode(contract: BinderContract, result: ValueContract, rest: ByteStream) -> ByteStream {
    let code = binder_contract_code(contract) + 16 * value_contract_code(result);
    store(Lists::Node::Cons(UInt8::from_field(code), rest))
  }

  fn app_telescope_count(expr: Expr) -> U64 {
    match expr {
      Expr::App(&func, _) => {  UInt64::wrapping_succ(app_telescope_count(func)) } ,
      _ => {  [UInt8::BYTE_0; 8] } ,
    }
  }

  fn lam_telescope_count(expr: Expr) -> U64 {
    match expr {
      Expr::Lam(_, _, &body) => {  UInt64::wrapping_succ(lam_telescope_count(body)) } ,
      _ => {  [UInt8::BYTE_0; 8] } ,
    }
  }

  fn all_telescope_count(expr: Expr) -> U64 {
    match expr {
      Expr::All(_, _, _, &body) => {  UInt64::wrapping_succ(all_telescope_count(body)) } ,
      _ => {  [UInt8::BYTE_0; 8] } ,
    }
  }

  fn put_app_telescope(expr: Expr, rest: ByteStream) -> ByteStream {
    match expr {
      Expr::App(&func, &arg) => {
        put_app_telescope(func, put_expr(arg, rest)) } ,
      _ => {  put_expr(expr, rest) } ,
    }
  }

  fn put_lam_telescope(expr: Expr, rest: ByteStream) -> ByteStream {
    match expr {
      Expr::Lam(contract, &ty, &body) => {
        put_lam_mode(contract, put_expr(ty, put_lam_telescope(body, rest))) } ,
      _ => {  put_expr(expr, rest) } ,
    }
  }

  fn put_all_telescope(expr: Expr, rest: ByteStream) -> ByteStream {
    match expr {
      Expr::All(input, result, &ty, &body) => {
        put_all_mode(input, result, put_expr(ty, put_all_telescope(body, rest))) } ,
      _ => {  put_expr(expr, rest) } ,
    }
  }

  fn put_address(a: Addr, rest: ByteStream) -> ByteStream {
    let arr = load(a);
    let list31 = store(Lists::Node::Cons(arr[31], rest));
    let list30 = store(Lists::Node::Cons(arr[30], list31));
    let list29 = store(Lists::Node::Cons(arr[29], list30));
    let list28 = store(Lists::Node::Cons(arr[28], list29));
    let list27 = store(Lists::Node::Cons(arr[27], list28));
    let list26 = store(Lists::Node::Cons(arr[26], list27));
    let list25 = store(Lists::Node::Cons(arr[25], list26));
    let list24 = store(Lists::Node::Cons(arr[24], list25));
    let list23 = store(Lists::Node::Cons(arr[23], list24));
    let list22 = store(Lists::Node::Cons(arr[22], list23));
    let list21 = store(Lists::Node::Cons(arr[21], list22));
    let list20 = store(Lists::Node::Cons(arr[20], list21));
    let list19 = store(Lists::Node::Cons(arr[19], list20));
    let list18 = store(Lists::Node::Cons(arr[18], list19));
    let list17 = store(Lists::Node::Cons(arr[17], list18));
    let list16 = store(Lists::Node::Cons(arr[16], list17));
    let list15 = store(Lists::Node::Cons(arr[15], list16));
    let list14 = store(Lists::Node::Cons(arr[14], list15));
    let list13 = store(Lists::Node::Cons(arr[13], list14));
    let list12 = store(Lists::Node::Cons(arr[12], list13));
    let list11 = store(Lists::Node::Cons(arr[11], list12));
    let list10 = store(Lists::Node::Cons(arr[10], list11));
    let list9 = store(Lists::Node::Cons(arr[9], list10));
    let list8 = store(Lists::Node::Cons(arr[8], list9));
    let list7 = store(Lists::Node::Cons(arr[7], list8));
    let list6 = store(Lists::Node::Cons(arr[6], list7));
    let list5 = store(Lists::Node::Cons(arr[5], list6));
    let list4 = store(Lists::Node::Cons(arr[4], list5));
    let list3 = store(Lists::Node::Cons(arr[3], list4));
    let list2 = store(Lists::Node::Cons(arr[2], list3));
    let list1 = store(Lists::Node::Cons(arr[1], list2));
    store(Lists::Node::Cons(arr[0], list1))
  }

  fn pack_def_kind_safety(kind: DefKind, safety: DefinitionSafety) -> Field {
    match (kind, safety) {
      (DefKind::Definition, DefinitionSafety::Unsafe) => {  0 } ,
      (DefKind::Definition, DefinitionSafety::Safe) => {  1 } ,
      (DefKind::Definition, DefinitionSafety::Partial) => {  2 } ,
      (DefKind::Opaque, DefinitionSafety::Unsafe) => {  4 } ,
      (DefKind::Opaque, DefinitionSafety::Safe) => {  5 } ,
      (DefKind::Opaque, DefinitionSafety::Partial) => {  6 } ,
      (DefKind::Theorem, DefinitionSafety::Unsafe) => {  8 } ,
      (DefKind::Theorem, DefinitionSafety::Safe) => {  9 } ,
      (DefKind::Theorem, DefinitionSafety::Partial) => {  10 } ,
    }
  }

  fn univ_succ_count(u: Univ) -> U64 {
    match u {
      Univ::Succ(&inner) => {  UInt64::wrapping_succ(univ_succ_count(inner)) } ,
      _ => {  [UInt8::BYTE_0; 8] } ,
    }
  }

  fn univ_succ_base(u: Univ) -> Univ {
    match u {
      Univ::Succ(&inner) => {  univ_succ_base(inner) } ,
      _ => {  u } ,
    }
  }

  fn put_univ(u: Univ, rest: ByteStream) -> ByteStream {
    match u {
      Univ::Zero => {

        store(Lists::Node::Cons(UInt8::BYTE_0, rest)) } ,

      Univ::Succ(_) => {

        let count = univ_succ_count(u);

        let base = univ_succ_base(u);

        put_tagn2(0, count, put_univ(base, rest)) } ,

      Univ::Max(&a, &b) => {

        put_tagn2(1, [UInt8::BYTE_0; 8], put_univ(a, put_univ(b, rest))) } ,

      Univ::IMax(&a, &b) => {

        put_tagn2(2, [UInt8::BYTE_0; 8], put_univ(a, put_univ(b, rest))) } ,

      Univ::Var(idx) => {

        put_tagn2(3, idx, rest) } ,
    }
  }

  fn put_expr_list(list: List<&Expr>, rest: ByteStream) -> ByteStream {
    match load(list) {
      Lists::Node::Nil => {  rest } ,
      Lists::Node::Cons(&expr, rest_list) => {
        put_expr(expr, put_expr_list(rest_list, rest)) } ,
    }
  }

  fn put_univ_list(list: List<&Univ>, rest: ByteStream) -> ByteStream {
    match load(list) {
      Lists::Node::Nil => {  rest } ,
      Lists::Node::Cons(&u, rest_list) => {
        put_univ(u, put_univ_list(rest_list, rest)) } ,
    }
  }

  fn put_address_list(list: List<Addr>, rest: ByteStream) -> ByteStream {
    match load(list) {
      Lists::Node::Nil => {  rest } ,
      Lists::Node::Cons(addr, rest_list) => {
        put_address(addr, put_address_list(rest_list, rest)) } ,
    }
  }

  fn put_quot_kind(kind: QuotKind, rest: ByteStream) -> ByteStream {
    match kind {
      QuotKind::Typ => {  store(Lists::Node::Cons(UInt8::BYTE_0, rest)) } ,
      QuotKind::Ctor => {  store(Lists::Node::Cons(UInt8::BYTE_1, rest)) } ,
      QuotKind::Lift => {  store(Lists::Node::Cons(UInt8::BYTE_2, rest)) } ,
      QuotKind::Ind => {  store(Lists::Node::Cons(UInt8::BYTE_3, rest)) } ,
    }
  }

  fn put_definition(defn: Definition, rest: ByteStream) -> ByteStream {
    match defn {
      Definition::Mk(kind, safety, lvls, &typ, &value) => {
        let packed = pack_def_kind_safety(kind, safety);
        store(Lists::Node::Cons(UInt8::from_field(packed), put_tagn0(lvls, put_expr(typ, put_expr(value, rest))))) } ,
    }
  }

  fn put_recursor_rule(rule: RecursorRule, rest: ByteStream) -> ByteStream {
    match rule {
      RecursorRule::Mk(fields, &rhs) => {
        put_tagn0(fields, put_expr(rhs, rest)) } ,
    }
  }

  fn put_recursor_rule_list(list: List<RecursorRule>, rest: ByteStream) -> ByteStream {
    match load(list) {
      Lists::Node::Nil => {  rest } ,
      Lists::Node::Cons(rule, rest_list) => {
        put_recursor_rule(rule, put_recursor_rule_list(rest_list, rest)) } ,
    }
  }

  fn put_recursor(recr: Recursor, rest: ByteStream) -> ByteStream {
    match recr {
      Recursor::Mk(k, is_unsafe, lvls, params, indices, motives, minors, &typ, rules) => {
        let bools = k + 2 * is_unsafe;
        let rules_len = list_length_u64(rules);
        store(Lists::Node::Cons(UInt8::from_field(bools),
          put_tagn0(lvls,
            put_tagn0(params,
              put_tagn0(indices,
                put_tagn0(motives,
                  put_tagn0(minors,
                    put_expr(typ,
                      put_tagn0(rules_len,
                        put_recursor_rule_list(rules, rest)))))))))) } ,
    }
  }

  fn put_axiom(axim: Axiom, rest: ByteStream) -> ByteStream {
    match axim {
      Axiom::Mk(is_unsafe, lvls, &typ) => {
        store(Lists::Node::Cons(UInt8::from_field(is_unsafe), put_tagn0(lvls, put_expr(typ, rest)))) } ,
    }
  }

  fn put_quotient(quot: Quotient, rest: ByteStream) -> ByteStream {
    match quot {
      Quotient::Mk(kind, lvls, &typ) => {
        put_quot_kind(kind, put_tagn0(lvls, put_expr(typ, rest))) } ,
    }
  }

  fn put_constructor(ctor: Constructor, rest: ByteStream) -> ByteStream {
    match ctor {
      Constructor::Mk(is_unsafe, lvls, cidx, params, fields, &typ) => {
        store(Lists::Node::Cons(UInt8::from_field(is_unsafe),
          put_tagn0(lvls,
            put_tagn0(cidx,
              put_tagn0(params,
                put_tagn0(fields,
                  put_expr(typ, rest))))))) } ,
    }
  }

  fn put_constructor_list(list: List<Constructor>, rest: ByteStream) -> ByteStream {
    match load(list) {
      Lists::Node::Nil => {  rest } ,
      Lists::Node::Cons(ctor, rest_list) => {
        put_constructor(ctor, put_constructor_list(rest_list, rest)) } ,
    }
  }

  fn put_inductive(indc: Inductive, rest: ByteStream) -> ByteStream {
    match indc {
      Inductive::Mk(is_unsafe, lvls, params, indices, &typ, ctors) => {
        let ctors_len = list_length_u64(ctors);
        store(Lists::Node::Cons(UInt8::from_field(is_unsafe),
          put_tagn0(lvls,
            put_tagn0(params,
              put_tagn0(indices,
                put_expr(typ,
                  put_tagn0(ctors_len,
                    put_constructor_list(ctors, rest)))))))) } ,
    }
  }

  fn put_inductive_proj(prj: InductiveProj, rest: ByteStream) -> ByteStream {
    match prj {
      InductiveProj::Mk(idx, block) => {
        put_tagn0(idx, put_address(block, rest)) } ,
    }
  }

  fn put_constructor_proj(prj: ConstructorProj, rest: ByteStream) -> ByteStream {
    match prj {
      ConstructorProj::Mk(idx, cidx, block) => {
        put_tagn0(idx, put_tagn0(cidx, put_address(block, rest))) } ,
    }
  }

  fn put_recursor_proj(prj: RecursorProj, rest: ByteStream) -> ByteStream {
    match prj {
      RecursorProj::Mk(idx, block) => {
        put_tagn0(idx, put_address(block, rest)) } ,
    }
  }

  fn put_definition_proj(prj: DefinitionProj, rest: ByteStream) -> ByteStream {
    match prj {
      DefinitionProj::Mk(idx, block) => {
        put_tagn0(idx, put_address(block, rest)) } ,
    }
  }

  fn put_mut_const(mc: MutConst, rest: ByteStream) -> ByteStream {
    match mc {
      MutConst::Defn(defn) => {
        store(Lists::Node::Cons(UInt8::BYTE_0, put_definition(defn, rest))) } ,
      MutConst::Indc(indc) => {
        store(Lists::Node::Cons(UInt8::BYTE_1, put_inductive(indc, rest))) } ,
      MutConst::Recr(recr) => {
        store(Lists::Node::Cons(UInt8::BYTE_2, put_recursor(recr, rest))) } ,
    }
  }

  fn put_mut_const_list(list: List<MutConst>, rest: ByteStream) -> ByteStream {
    match load(list) {
      Lists::Node::Nil => {  rest } ,
      Lists::Node::Cons(mc, rest_list) => {
        put_mut_const(mc, put_mut_const_list(rest_list, rest)) } ,
    }
  }

  fn put_constant_info(info: ConstantInfo, rest: ByteStream) -> ByteStream {
    match info {
      ConstantInfo::Defn(defn) => {  put_definition(defn, rest) } ,
      ConstantInfo::Recr(recr) => {  put_recursor(recr, rest) } ,
      ConstantInfo::Axio(axim) => {  put_axiom(axim, rest) } ,
      ConstantInfo::Quot(quot) => {  put_quotient(quot, rest) } ,
      ConstantInfo::CPrj(prj) => {  put_constructor_proj(prj, rest) } ,
      ConstantInfo::RPrj(prj) => {  put_recursor_proj(prj, rest) } ,
      ConstantInfo::IPrj(prj) => {  put_inductive_proj(prj, rest) } ,
      ConstantInfo::DPrj(prj) => {  put_definition_proj(prj, rest) } ,
    }
  }

  fn put_sharing(list: List<&Expr>, rest: ByteStream) -> ByteStream {
    let len = list_length_u64(list);
    put_tagn0(len, put_expr_list(list, rest))
  }

  fn put_refs(list: List<Addr>, rest: ByteStream) -> ByteStream {
    let len = list_length_u64(list);
    put_tagn0(len, put_address_list(list, rest))
  }

  fn put_univs(list: List<&Univ>, rest: ByteStream) -> ByteStream {
    let len = list_length_u64(list);
    put_tagn0(len, put_univ_list(list, rest))
  }

  fn put_constant(cnst: Constant, rest: ByteStream) -> ByteStream {
    match cnst {
      Constant::Mk(info, sharing, refs, univs) => {
        let up_to_sharing = put_sharing(sharing, put_refs(refs, put_univs(univs, rest)));
        match info {
          ConstantInfo::Muts(mutuals) => {

            let count = list_length_u64(mutuals);
            put_tagn4(12, count, put_mut_const_list(mutuals, up_to_sharing)) } ,

          ConstantInfo::Defn(_) => {
            put_tagn4(13, [UInt8::BYTE_0; 8], put_constant_info(info, up_to_sharing)) } ,
          ConstantInfo::Recr(_) => {
            put_tagn4(13, [UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], put_constant_info(info, up_to_sharing)) } ,
          ConstantInfo::Axio(_) => {
            put_tagn4(13, [UInt8::BYTE_2, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], put_constant_info(info, up_to_sharing)) } ,
          ConstantInfo::Quot(_) => {
            put_tagn4(13, [UInt8::BYTE_3, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], put_constant_info(info, up_to_sharing)) } ,
          ConstantInfo::CPrj(_) => {
            put_tagn4(13, [UInt8::BYTE_4, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], put_constant_info(info, up_to_sharing)) } ,
          ConstantInfo::RPrj(_) => {
            put_tagn4(13, [UInt8::BYTE_5, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], put_constant_info(info, up_to_sharing)) } ,
          ConstantInfo::IPrj(_) => {
            put_tagn4(13, [UInt8::BYTE_6, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], put_constant_info(info, up_to_sharing)) } ,
          ConstantInfo::DPrj(_) => {
            put_tagn4(13, [UInt8::BYTE_7, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], put_constant_info(info, up_to_sharing)) } ,
        } } ,
    }
  }

  fn read_byte(stream: ByteStream) -> (U8, ByteStream) {
    let Lists::Node::Cons(byte, rest) = load(stream);
    (byte, rest)
  }

  fn get_u64_le(stream: ByteStream, num_bytes: Field) -> (U64, ByteStream) {
    match num_bytes {
      0 => {  ([UInt8::BYTE_0; 8], stream) } ,
      _ => {
        let Lists::Node::Cons(byte, s) = load(stream);
        let (rest_bytes, s2) = get_u64_le(s, num_bytes - 1);
        let [r0, r1, r2, r3, r4, r5, r6, _] = rest_bytes;
        ([byte, r0, r1, r2, r3, r4, r5, r6], s2) } ,
    }
  }

  fn get_tagn4(stream: ByteStream) -> ((Field, U64), ByteStream) {
    let Lists::Node::Cons(byte, s) = load(stream);
    let [b0, b1, b2, b3, b4, b5, b6, b7] = UInt8::bit_decomposition(byte);
    let flag = b4 + 2 * b5 + 4 * b6 + 8 * b7;
    let low = b0 + 2 * b1 + 4 * b2;
    match b3 {
      0 => {  ((flag, [UInt8::from_field(low), UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0]), s) } ,
      1 => {
        let (value, rest) = get_tagn_tail(low, 4, s);
        ((flag, value), rest) } ,
    }
  }

  fn get_tagn2(stream: ByteStream) -> ((Field, U64), ByteStream) {
    let Lists::Node::Cons(byte, s) = load(stream);
    let [b0, b1, b2, b3, b4, b5, b6, b7] = UInt8::bit_decomposition(byte);
    let flag = b6 + 2 * b7;
    let low = b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4;
    match b5 {
      0 => {  ((flag, [UInt8::from_field(low), UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0]), s) } ,
      1 => {
        let (value, rest) = get_tagn_tail(low, 16, s);
        ((flag, value), rest) } ,
    }
  }

  fn get_tagn0(stream: ByteStream) -> (U64, ByteStream) {
    let Lists::Node::Cons(byte, s) = load(stream);
    match UInt8::less_than(byte, UInt8::BYTE_128) {
      1 => {  ([byte, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], s) } ,
      0 => {  get_tagn_tail(UInt8::to_field(byte) - 128, 64, s) } ,
    }
  }

  fn get_tagn_tail(q: Field, h: Field, stream: ByteStream) -> (U64, ByteStream) {
    match UInt8::raw_lt(q, h) {

      1 => {
        let Lists::Node::Cons(lo, s) = load(stream);
        let (v0, carry) = UInt8::raw_add(UInt8::to_field(lo), 2 * h);
        ([v0, UInt8::from_field(q + UInt8::to_field(carry)), UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], s) } ,
      0 => {  get_tagn_wide(q - h, h, stream) } ,
    }
  }

  fn get_tagn_wide(c: Field, h: Field, stream: ByteStream) -> (U64, ByteStream) {
    let r0 = UInt8::from_field(2 * h);
    let r1 = UInt8::from_field(h);
    match c {
      0 => {
        let (x, s) = get_u64_le(stream, 2);
        let (value, _) = UInt64::add(x, [r0, r1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0]);
        (value, s) } ,
      1 => {
        let (x, s) = get_u64_le(stream, 3);
        let (value, _) = UInt64::add(x, [r0, r1, UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0]);
        (value, s) } ,
      2 => {
        let (x, s) = get_u64_le(stream, 4);
        let (value, _) = UInt64::add(x, [r0, r1, UInt8::BYTE_1, UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0]);
        (value, s) } ,
      3 => {
        let (x, s) = get_u64_le(stream, 8);
        let (value, carry) = UInt64::add(x, [r0, r1, UInt8::BYTE_1, UInt8::BYTE_1, UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0]);
        assert_eq!(UInt8::to_field(carry), 0, "TagN value exceeds UInt64");
        (value, s) } ,
    }
  }

  fn get_u64_list(stream: ByteStream, count: U64) -> (List<U64>, ByteStream) {
    let is_zero = UInt64::is_zero(count);
    match is_zero {
      1 => {  (store(Lists::Node::Nil), stream) } ,
      0 => {
        let (val, s) = get_tagn0(stream);
        let (rest, s2) = get_u64_list(s, UInt64::saturating_pred(count));
        (store(Lists::Node::Cons(val, rest)), s2) } ,
    }
  }

  fn get_app_telescope(func: &Expr, stream: ByteStream, count: U64) -> (&Expr, ByteStream) {
    let is_zero = UInt64::is_zero(count);
    match is_zero {
      1 => {  (func, stream) } ,
      0 => {
        let (arg, s) = get_expr(stream);
        get_app_telescope(store(Expr::App(func, arg)), s, UInt64::saturating_pred(count)) } ,
    }
  }

  fn value_contract_from_bits(owned_bit: Field, locality_bit: Field) -> ValueContract {
    let owned = match owned_bit { 0 => {  Owned::Unique } , 1 => {  Owned::Shared } , };
    let locality = match locality_bit { 0 => {  Locality::Unrestricted } , 1 => {  Locality::Local } , };
    ValueContract::Mk(owned, locality)
  }

  fn binder_contract_from_bits(b0: Field, b1: Field, b2: Field, b3: Field) -> BinderContract {
    let uses = match b0 + 2 * b1 { 0 => {  Uses::Erased } , 1 => {  Uses::Linear } , 2 => {  Uses::Affine } , 3 => {  Uses::Many } , };
    BinderContract::Mk(uses, value_contract_from_bits(b2, b3))
  }

  fn get_lam_mode(stream: ByteStream) -> (BinderContract, ByteStream) {
    let (mode, s) = read_byte(stream);
    let [b0, b1, b2, b3, b4, b5, b6, b7] = UInt8::bit_decomposition(mode);
    assert_eq!(b4 + b5 + b6 + b7, 0, "reserved binder contract bits");
    (binder_contract_from_bits(b0, b1, b2, b3), s)
  }

  fn get_all_mode(stream: ByteStream) -> ((BinderContract, ValueContract), ByteStream) {
    let (mode, s) = read_byte(stream);
    let [b0, b1, b2, b3, b4, b5, b6, b7] = UInt8::bit_decomposition(mode);
    assert_eq!(b6 + b7, 0, "reserved forall contract bits");
    ((binder_contract_from_bits(b0, b1, b2, b3), value_contract_from_bits(b4, b5)), s)
  }

  fn get_lam_telescope(stream: ByteStream, count: U64) -> (&Expr, ByteStream) {
    let is_zero = UInt64::is_zero(count);
    match is_zero {
      1 => {
        let (body, s) = get_expr(stream);
        match load(body) {
          Expr::Lam(_, _, _) => {
            assert_eq!(0, 1, "non-canonical lambda telescope");
            (body, s) } ,
          _ => {  (body, s) } ,
        } } ,
      0 => {
        let (contract, s) = get_lam_mode(stream);
        let (ty, s2) = get_expr(s);
        let (inner, s3) = get_lam_telescope(s2, UInt64::saturating_pred(count));
        (store(Expr::Lam(contract, ty, inner)), s3) } ,
    }
  }

  fn get_all_telescope(stream: ByteStream, count: U64) -> (&Expr, ByteStream) {
    let is_zero = UInt64::is_zero(count);
    match is_zero {
      1 => {
        let (body, s) = get_expr(stream);
        match load(body) {
          Expr::All(_, _, _, _) => {
            assert_eq!(0, 1, "non-canonical forall telescope");
            (body, s) } ,
          _ => {  (body, s) } ,
        } } ,
      0 => {
        let (mode, s) = get_all_mode(stream);
        let (input, result) = mode;
        let (ty, s2) = get_expr(s);
        let (inner, s3) = get_all_telescope(s2, UInt64::saturating_pred(count));
        (store(Expr::All(input, result, ty, inner)), s3) } ,
    }
  }

  fn get_expr(stream: ByteStream) -> (&Expr, ByteStream) {
    let (tag, s) = get_tagn4(stream);
    let (flag, size) = tag;
    match flag {

      0 => {  (store(Expr::Srt(size)), s) } ,

      1 => {  (store(Expr::Var(size)), s) } ,

      2 => {
        let (ref_idx, s2) = get_tagn0(s);
        let (univ_list, s3) = get_u64_list(s2, size);
        (store(Expr::Ref(ref_idx, univ_list)), s3) } ,

      3 => {
        let (rec_idx, s2) = get_tagn0(s);
        let (univ_list, s3) = get_u64_list(s2, size);
        (store(Expr::Rec(rec_idx, univ_list)), s3) } ,

      4 => {
        let (type_ref_idx, s2) = get_tagn0(s);
        let (val, s3) = get_expr(s2);
        (store(Expr::Prj(type_ref_idx, size, val)), s3) } ,

      5 => {  (store(Expr::Str(size)), s) } ,

      6 => {  (store(Expr::Nat(size)), s) } ,

      7 => {
        assert_eq!(UInt64::is_zero(size), 0, "App with zero arguments");
        let (func, s2) = get_expr(s);

        match load(func) {
          Expr::App(_, _) => {
            assert_eq!(0, 1, "non-canonical application telescope");
            get_app_telescope(func, s2, size) } ,
          _ => {  get_app_telescope(func, s2, size) } ,
        } } ,

      8 => {
        assert_eq!(UInt64::is_zero(size), 0, "Lam with zero binders");
        get_lam_telescope(s, size) } ,

      9 => {
        assert_eq!(UInt64::is_zero(size), 0, "All with zero binders");
        get_all_telescope(s, size) } ,

      10 => {  get_expr_let(s, size) } ,

      11 => {  (store(Expr::Share(size)), s) } ,
    }
  }

  fn get_expr_let(s: ByteStream, size: U64) -> (&Expr, ByteStream) {
    let [head, b1, b2, b3, b4, b5, b6, b7] = size;
    assert_eq!(UInt8::to_field(b1) + UInt8::to_field(b2) + UInt8::to_field(b3) + UInt8::to_field(b4) +
      UInt8::to_field(b5) + UInt8::to_field(b6) + UInt8::to_field(b7), 0, "oversized let flags");
    assert_eq!(UInt8::less_than(head, UInt8::BYTE_4), 1, "reserved let flags");
    let bits = UInt8::bit_decomposition(head);
    let kind = match bits[1] { 0 => {  LetKind::Value } , 1 => {  LetKind::BorrowShared } , };
    let (contract, s1) = get_lam_mode(s);
    let (ty, s2) = get_expr(s1);
    let (value, s3) = get_expr(s2);
    let (body, rest) = get_expr(s3);
    (store(Expr::Let(LetContract::Mk(bits[0], kind, contract), ty, value, body)), rest)
  }

  fn build_succ_chain(base: Univ, count: U64) -> Univ {
    let is_zero = UInt64::is_zero(count);
    match is_zero {
      1 => {  base } ,
      0 => {
        let inner = build_succ_chain(base, UInt64::saturating_pred(count));
        Univ::Succ(store(inner)) } ,
    }
  }

  fn get_univ(stream: ByteStream) -> (Univ, ByteStream) {
    let (tag, s) = get_tagn2(stream);
    let (flag, size) = tag;
    match flag {

      0 => {
        let is_zero = UInt64::is_zero(size);
        match is_zero {
          1 => {  (Univ::Zero, s) } ,
          0 => {
            let (base, s2) = get_univ(s);
            (build_succ_chain(base, size), s2) } ,
        } } ,

      1 => {
        let (a, s2) = get_univ(s);
        let (b, s3) = get_univ(s2);
        (Univ::Max(store(a), store(b)), s3) } ,

      2 => {
        let (a, s2) = get_univ(s);
        let (b, s3) = get_univ(s2);
        (Univ::IMax(store(a), store(b)), s3) } ,

      3 => {  (Univ::Var(size), s) } ,
    }
  }

  fn get_address(stream: ByteStream) -> (Addr, ByteStream) {
    let Lists::Node::Cons(b0, s) = load(stream);
    let Lists::Node::Cons(b1, s) = load(s);
    let Lists::Node::Cons(b2, s) = load(s);
    let Lists::Node::Cons(b3, s) = load(s);
    let Lists::Node::Cons(b4, s) = load(s);
    let Lists::Node::Cons(b5, s) = load(s);
    let Lists::Node::Cons(b6, s) = load(s);
    let Lists::Node::Cons(b7, s) = load(s);
    let Lists::Node::Cons(b8, s) = load(s);
    let Lists::Node::Cons(b9, s) = load(s);
    let Lists::Node::Cons(b10, s) = load(s);
    let Lists::Node::Cons(b11, s) = load(s);
    let Lists::Node::Cons(b12, s) = load(s);
    let Lists::Node::Cons(b13, s) = load(s);
    let Lists::Node::Cons(b14, s) = load(s);
    let Lists::Node::Cons(b15, s) = load(s);
    let Lists::Node::Cons(b16, s) = load(s);
    let Lists::Node::Cons(b17, s) = load(s);
    let Lists::Node::Cons(b18, s) = load(s);
    let Lists::Node::Cons(b19, s) = load(s);
    let Lists::Node::Cons(b20, s) = load(s);
    let Lists::Node::Cons(b21, s) = load(s);
    let Lists::Node::Cons(b22, s) = load(s);
    let Lists::Node::Cons(b23, s) = load(s);
    let Lists::Node::Cons(b24, s) = load(s);
    let Lists::Node::Cons(b25, s) = load(s);
    let Lists::Node::Cons(b26, s) = load(s);
    let Lists::Node::Cons(b27, s) = load(s);
    let Lists::Node::Cons(b28, s) = load(s);
    let Lists::Node::Cons(b29, s) = load(s);
    let Lists::Node::Cons(b30, s) = load(s);
    let Lists::Node::Cons(b31, s) = load(s);
    (store([b0, b1, b2,
      b3, b4, b5,
      b6, b7, b8,
      b9, b10, b11,
      b12, b13, b14,
      b15, b16, b17,
      b18, b19, b20,
      b21, b22, b23,
      b24, b25, b26,
      b27, b28, b29,
      b30, b31]), s)
  }

  fn get_expr_list(stream: ByteStream, count: U64) -> (List<&Expr>, ByteStream) {
    let is_zero = UInt64::is_zero(count);
    match is_zero {
      1 => {  (store(Lists::Node::Nil), stream) } ,
      0 => {
        let (expr, s) = get_expr(stream);
        let (rest, s2) = get_expr_list(s, UInt64::saturating_pred(count));
        (store(Lists::Node::Cons(expr, rest)), s2) } ,
    }
  }

  fn get_univ_list(stream: ByteStream, count: U64) -> (List<&Univ>, ByteStream) {
    let is_zero = UInt64::is_zero(count);
    match is_zero {
      1 => {  (store(Lists::Node::Nil), stream) } ,
      0 => {
        let (u, s) = get_univ(stream);
        let (rest, s2) = get_univ_list(s, UInt64::saturating_pred(count));
        (store(Lists::Node::Cons(store(u), rest)), s2) } ,
    }
  }

  fn get_address_list(stream: ByteStream, count: U64) -> (List<Addr>, ByteStream) {
    let is_zero = UInt64::is_zero(count);
    match is_zero {
      1 => {  (store(Lists::Node::Nil), stream) } ,
      0 => {
        let (addr, s) = get_address(stream);
        let (rest, s2) = get_address_list(s, UInt64::saturating_pred(count));
        (store(Lists::Node::Cons(addr, rest)), s2) } ,
    }
  }

  inline fn get_sharing(stream: ByteStream) -> (List<&Expr>, ByteStream) {
    let (len, s) = get_tagn0(stream);
    get_expr_list(s, len)
  }

  inline fn get_refs(stream: ByteStream) -> (List<Addr>, ByteStream) {
    let (len, s) = get_tagn0(stream);
    get_address_list(s, len)
  }

  inline fn get_univs(stream: ByteStream) -> (List<&Univ>, ByteStream) {
    let (len, s) = get_tagn0(stream);
    get_univ_list(s, len)
  }

  fn unpack_def_kind_safety(byte: U8) -> (DefKind, DefinitionSafety) {
    match UInt8::to_field(byte) {
      0 => {  (DefKind::Definition, DefinitionSafety::Unsafe) } ,
      1 => {  (DefKind::Definition, DefinitionSafety::Safe) } ,
      2 => {  (DefKind::Definition, DefinitionSafety::Partial) } ,
      4 => {  (DefKind::Opaque, DefinitionSafety::Unsafe) } ,
      5 => {  (DefKind::Opaque, DefinitionSafety::Safe) } ,
      6 => {  (DefKind::Opaque, DefinitionSafety::Partial) } ,
      8 => {  (DefKind::Theorem, DefinitionSafety::Unsafe) } ,
      9 => {  (DefKind::Theorem, DefinitionSafety::Safe) } ,
      10 => {  (DefKind::Theorem, DefinitionSafety::Partial) } ,
    }
  }

  fn get_definition(stream: ByteStream) -> (Definition, ByteStream) {
    let (packed, s) = read_byte(stream);
    let (kind, safety) = unpack_def_kind_safety(packed);
    let (lvls, s2) = get_tagn0(s);
    let (typ, s3) = get_expr(s2);
    let (value, s4) = get_expr(s3);
    (Definition::Mk(kind, safety, lvls, typ, value), s4)
  }

  inline fn get_recursor_rule(stream: ByteStream) -> (RecursorRule, ByteStream) {
    let (fields, s) = get_tagn0(stream);
    let (rhs, s2) = get_expr(s);
    (RecursorRule::Mk(fields, rhs), s2)
  }

  fn get_recursor_rule_list(stream: ByteStream, count: U64) -> (List<RecursorRule>, ByteStream) {
    let is_zero = UInt64::is_zero(count);
    match is_zero {
      1 => {  (store(Lists::Node::Nil), stream) } ,
      0 => {
        let (rule, s) = get_recursor_rule(stream);
        let (rest, s2) = get_recursor_rule_list(s, UInt64::saturating_pred(count));
        (store(Lists::Node::Cons(rule, rest)), s2) } ,
    }
  }

  fn get_recursor(stream: ByteStream) -> (Recursor, ByteStream) {
    let (bools_byte, s) = read_byte(stream);
    assert_eq!(UInt8::less_than(bools_byte, UInt8::BYTE_4), 1, "invalid recursor flags");
    let bits = UInt8::bit_decomposition(bools_byte);
    let k = bits[0];
    let is_unsafe = bits[1];
    let (lvls, s2) = get_tagn0(s);
    let (params, s3) = get_tagn0(s2);
    let (indices, s4) = get_tagn0(s3);
    let (motives, s5) = get_tagn0(s4);
    let (minors, s6) = get_tagn0(s5);
    let (typ, s7) = get_expr(s6);
    let (rules_len, s8) = get_tagn0(s7);
    let (rules, s9) = get_recursor_rule_list(s8, rules_len);
    (Recursor::Mk(k, is_unsafe, lvls, params, indices, motives, minors, typ, rules), s9)
  }

  fn assert_wire_bool(b: U8) -> () {
    assert_eq!(UInt8::less_than(b, UInt8::BYTE_2), 1, "Bool byte is not 0 or 1");
    ()
  }

  fn get_axiom(stream: ByteStream) -> (Axiom, ByteStream) {
    let (is_unsafe, s) = read_byte(stream);
    assert_wire_bool(is_unsafe);
    let (lvls, s2) = get_tagn0(s);
    let (typ, s3) = get_expr(s2);
    (Axiom::Mk(UInt8::to_field(is_unsafe), lvls, typ), s3)
  }

  fn get_quot_kind(byte: U8) -> QuotKind {
    match UInt8::to_field(byte) {
      0 => {  QuotKind::Typ } ,
      1 => {  QuotKind::Ctor } ,
      2 => {  QuotKind::Lift } ,
      3 => {  QuotKind::Ind } ,
    }
  }

  fn get_quotient(stream: ByteStream) -> (Quotient, ByteStream) {
    let (kind_byte, s) = read_byte(stream);
    let kind = get_quot_kind(kind_byte);
    let (lvls, s2) = get_tagn0(s);
    let (typ, s3) = get_expr(s2);
    (Quotient::Mk(kind, lvls, typ), s3)
  }

  fn get_constructor(stream: ByteStream) -> (Constructor, ByteStream) {
    let (is_unsafe, s) = read_byte(stream);
    assert_wire_bool(is_unsafe);
    let (lvls, s2) = get_tagn0(s);
    let (cidx, s3) = get_tagn0(s2);
    let (params, s4) = get_tagn0(s3);
    let (fields, s5) = get_tagn0(s4);
    let (typ, s6) = get_expr(s5);
    (Constructor::Mk(UInt8::to_field(is_unsafe), lvls, cidx, params, fields, typ), s6)
  }

  fn get_constructor_list(stream: ByteStream, count: U64) -> (List<Constructor>, ByteStream) {
    let is_zero = UInt64::is_zero(count);
    match is_zero {
      1 => {  (store(Lists::Node::Nil), stream) } ,
      0 => {
        let (ctor, s) = get_constructor(stream);
        let (rest, s2) = get_constructor_list(s, UInt64::saturating_pred(count));
        (store(Lists::Node::Cons(ctor, rest)), s2) } ,
    }
  }

  fn get_inductive(stream: ByteStream) -> (Inductive, ByteStream) {
    let (bools_byte, s) = read_byte(stream);
    assert_wire_bool(bools_byte);
    let bits = UInt8::bit_decomposition(bools_byte);
    let is_unsafe = bits[0];
    let (lvls, s2) = get_tagn0(s);
    let (params, s3) = get_tagn0(s2);
    let (indices, s4) = get_tagn0(s3);
    let (typ, s5) = get_expr(s4);
    let (ctors_len, s6) = get_tagn0(s5);
    let (ctors, s7) = get_constructor_list(s6, ctors_len);
    (Inductive::Mk(is_unsafe, lvls, params, indices, typ, ctors), s7)
  }

  fn get_inductive_proj(stream: ByteStream) -> (InductiveProj, ByteStream) {
    let (idx, s) = get_tagn0(stream);
    let (block, s2) = get_address(s);
    (InductiveProj::Mk(idx, block), s2)
  }

  fn get_constructor_proj(stream: ByteStream) -> (ConstructorProj, ByteStream) {
    let (idx, s) = get_tagn0(stream);
    let (cidx, s2) = get_tagn0(s);
    let (block, s3) = get_address(s2);
    (ConstructorProj::Mk(idx, cidx, block), s3)
  }

  fn get_recursor_proj(stream: ByteStream) -> (RecursorProj, ByteStream) {
    let (idx, s) = get_tagn0(stream);
    let (block, s2) = get_address(s);
    (RecursorProj::Mk(idx, block), s2)
  }

  fn get_definition_proj(stream: ByteStream) -> (DefinitionProj, ByteStream) {
    let (idx, s) = get_tagn0(stream);
    let (block, s2) = get_address(s);
    (DefinitionProj::Mk(idx, block), s2)
  }

  fn get_mut_const(stream: ByteStream) -> (MutConst, ByteStream) {
    let (tag, s) = read_byte(stream);
    match UInt8::to_field(tag) {
      0 => {
        let (defn, s2) = get_definition(s);
        (MutConst::Defn(defn), s2) } ,
      1 => {
        let (indc, s2) = get_inductive(s);
        (MutConst::Indc(indc), s2) } ,
      2 => {
        let (recr, s2) = get_recursor(s);
        (MutConst::Recr(recr), s2) } ,
    }
  }

  fn get_mut_const_list(stream: ByteStream, count: U64) -> (List<MutConst>, ByteStream) {
    let is_zero = UInt64::is_zero(count);
    match is_zero {
      1 => {  (store(Lists::Node::Nil), stream) } ,
      0 => {
        let (mc, s) = get_mut_const(stream);
        let (rest, s2) = get_mut_const_list(s, UInt64::saturating_pred(count));
        (store(Lists::Node::Cons(mc, rest)), s2) } ,
    }
  }

  fn get_constant_info_by_variant(variant: Field, stream: ByteStream) -> (ConstantInfo, ByteStream) {
    match variant {
      0 => {
        let (defn, s) = get_definition(stream);
        (ConstantInfo::Defn(defn), s) } ,
      1 => {
        let (recr, s) = get_recursor(stream);
        (ConstantInfo::Recr(recr), s) } ,
      2 => {
        let (axim, s) = get_axiom(stream);
        (ConstantInfo::Axio(axim), s) } ,
      3 => {
        let (quot, s) = get_quotient(stream);
        (ConstantInfo::Quot(quot), s) } ,
      4 => {
        let (prj, s) = get_constructor_proj(stream);
        (ConstantInfo::CPrj(prj), s) } ,
      5 => {
        let (prj, s) = get_recursor_proj(stream);
        (ConstantInfo::RPrj(prj), s) } ,
      6 => {
        let (prj, s) = get_inductive_proj(stream);
        (ConstantInfo::IPrj(prj), s) } ,
      7 => {
        let (prj, s) = get_definition_proj(stream);
        (ConstantInfo::DPrj(prj), s) } ,
    }
  }

  inline fn get_constant_info(flag: Field, size: U64, stream: ByteStream) -> (ConstantInfo, ByteStream) {
    match flag {

      12 => {
        let (mutuals, s) = get_mut_const_list(stream, size);
        (ConstantInfo::Muts(mutuals), s) } ,

      13 => {
        let [_, sz1, sz2, sz3, sz4, sz5, sz6, sz7] = size;
        assert_eq!(((((((UInt8::to_field(sz1) + UInt8::to_field(sz2)) + UInt8::to_field(sz3))
                      + UInt8::to_field(sz4)) + UInt8::to_field(sz5)) + UInt8::to_field(sz6))
                      + UInt8::to_field(sz7)), 0,
          "constant info: TagN size exceeds a single byte");
        get_constant_info_by_variant(UInt8::to_field(size[0]), stream) } ,
    }
  }

  fn get_constant(stream: ByteStream) -> (Constant, ByteStream) {
    let (tag, s) = get_tagn4(stream);
    let (flag, size) = tag;
    let (info, s2) = get_constant_info(flag, size, s);
    let (sharing, s3) = get_sharing(s2);
    let (refs, s4) = get_refs(s3);
    let (univs, s5) = get_univs(s4);
    (Constant::Mk(info, sharing, refs, univs), s5)
  }

  fn collect_spine(e: KExpr) -> (KExpr, List<KExpr>) {
    match load(e) {
      KExprNode::App(f, a) => {
        let (head, args) = collect_spine(f);
        (head, list_snoc(args, a)) } ,
      _ => {  (e, store(Lists::Node::Nil)) } ,
    }
  }

  fn klimbs_succ(n: KLimbs) -> KLimbs {
    match load(n) {
      Lists::Node::Nil => {
        store(Lists::Node::Cons([UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(Lists::Node::Nil))) } ,
      Lists::Node::Cons(limb, rest) => {
        let pair = UInt64::add(limb, [UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0]);
        match pair {
          (sum, carry) => {
            match UInt8::to_field(carry) {
              0 => {  store(Lists::Node::Cons(sum, rest)) } ,
              _ => {  store(Lists::Node::Cons(sum, klimbs_succ(rest))) } ,
            } } ,
        } } ,
    }
  }

  fn klimbs_add_carry(a: KLimbs, b: KLimbs, carry: Field) -> KLimbs {
    match load(a) {
      Lists::Node::Nil => {
        match carry {
          0 => {  b } ,
          _ => {  klimbs_succ(b) } ,
        } } ,
      Lists::Node::Cons(la, ra) => {
        match load(b) {
          Lists::Node::Nil => {
            match carry {
              0 => {  a } ,
              _ => {  klimbs_succ(a) } ,
            } } ,
          Lists::Node::Cons(lb, rb) => {
            let pair1 = UInt64::add(la, lb);
            match pair1 {
              (sum1, carry1) => {
                let pair2 = UInt64::add(sum1, [UInt8::from_field(carry), UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0]);
                match pair2 {
                  (sum2, carry2) => {

                    let total_carry = UInt8::to_field(carry1) + UInt8::to_field(carry2);
                    store(Lists::Node::Cons(sum2, klimbs_add_carry(ra, rb, total_carry))) } ,
                } } ,
            } } ,
        } } ,
    }
  }

  fn klimbs_add(a: KLimbs, b: KLimbs) -> KLimbs {
    klimbs_add_carry(a, b, 0)
  }



  fn klimbs_sub_borrow(a: KLimbs, b: KLimbs, borrow: Field) -> (KLimbs, Field) {
    match load(a) {
      Lists::Node::Nil => {
        match load(b) {
          Lists::Node::Nil => {

            (store(Lists::Node::Nil), borrow) } ,
          Lists::Node::Cons(_, _) => {

            match klimbs_is_zero(b) {
              1 => {  (store(Lists::Node::Nil), borrow) } ,
              _ => {  (store(Lists::Node::Nil), 1) } ,
            } } ,
        } } ,
      Lists::Node::Cons(la, ra) => {
        match load(b) {
          Lists::Node::Nil => {

            match borrow {
              0 => {  (a, 0) } ,
              _ => {
                let pair = UInt64::sub_with_borrow(la, [UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0]);
                match pair {
                  (diff, br) => {
                    let pair2 = klimbs_sub_borrow(ra, store(Lists::Node::Nil), br);
                    match pair2 {
                      (rest_res, br2) => {
                        (store(Lists::Node::Cons(diff, rest_res)), br2) } ,
                    } } ,
                } } ,
            } } ,
          Lists::Node::Cons(lb, rb) => {
            let pair1 = UInt64::sub_with_borrow(la, lb);
            match pair1 {
              (sum1, br1) => {
                let pair2 = UInt64::sub_with_borrow(sum1, [UInt8::from_field(borrow), UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0]);
                match pair2 {
                  (sum2, br2) => {

                    let total = br1 + br2;
                    let rec_pair = klimbs_sub_borrow(ra, rb, total);
                    match rec_pair {
                      (rest_res, br_final) => {
                        (store(Lists::Node::Cons(sum2, rest_res)), br_final) } ,
                    } } ,
                } } ,
            } } ,
        } } ,
    }
  }

  fn klimbs_normalize(n: KLimbs) -> KLimbs {
    match load(n) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(limb, rest) => {
        let normalized_rest = klimbs_normalize(rest);
        match load(normalized_rest) {
          Lists::Node::Nil => {
            match UInt64::is_zero(limb) {
              1 => {  store(Lists::Node::Nil) } ,
              0 => {  store(Lists::Node::Cons(limb, store(Lists::Node::Nil))) } ,
            } } ,
          _ => {  store(Lists::Node::Cons(limb, normalized_rest)) } ,
        } } ,
    }
  }

  fn klimbs_sub(a: KLimbs, b: KLimbs) -> KLimbs {
    let pair = klimbs_sub_borrow(a, b, 0);
    match pair {
      (result, borrow) => {
        match borrow {
          1 => {  store(Lists::Node::Nil) } ,
          0 => {  klimbs_normalize(result) } ,
        } } ,
    }
  }

  fn klimbs_le(a: KLimbs, b: KLimbs) -> Field {
    let diff = klimbs_sub(a, b);
    match load(diff) {
      Lists::Node::Nil => {  1 } ,
      _ => {  0 } ,
    }
  }

  fn klimbs_dec(a: KLimbs) -> KLimbs {
    let one = store(Lists::Node::Cons([UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(Lists::Node::Nil)));
    klimbs_sub(a, one)
  }

  fn divmod_256(x: Field, q: Field) -> (Field, Field) {
    match UInt32::less_than_fields(x, 256) {
      1 => {  (x, q) } ,
      0 => {  divmod_256(x - 256, q + 1) } ,
    }
  }





  fn klimbs_mul(a: KLimbs, b: KLimbs) -> KLimbs {
    klimbs_mul_outer(a, b, store(Lists::Node::Nil), 0)
  }

  fn klimbs_mul_outer(a: KLimbs, b: KLimbs, acc: KLimbs, shift: Field) -> KLimbs {
    match load(a) {
      Lists::Node::Nil => {  acc } ,
      Lists::Node::Cons(a_limb, rest) => {
        let prod = klimbs_mul_single(a_limb, b, [UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0]);
        let shifted = klimbs_shl_limbs(prod, shift);
        let new_acc = klimbs_add(acc, shifted);
        klimbs_mul_outer(rest, b, new_acc, shift + 1) } ,
    }
  }

  fn klimbs_mul_single(a_limb: U64, b: KLimbs, carry: U64) -> KLimbs {
    match load(b) {
      Lists::Node::Nil => {
        match UInt64::is_zero(carry) {
          1 => {  store(Lists::Node::Nil) } ,
          0 => {  store(Lists::Node::Cons(carry, store(Lists::Node::Nil))) } ,
        } } ,
      Lists::Node::Cons(b_limb, rest) => {
        match UInt64::mul(a_limb, b_limb) {
          (lo, hi) => {
            match UInt64::add(lo, carry) {
              (sum, carry_out) => {

                match UInt8::to_field(carry_out) {
                  0 => {  store(Lists::Node::Cons(sum,
                    klimbs_mul_single(a_limb, rest, hi))) } ,
                  _ => {  store(Lists::Node::Cons(sum,
                    klimbs_mul_single(a_limb, rest, UInt64::wrapping_succ(hi)))) } ,
                } } ,
            } } ,
        } } ,
    }
  }

  fn klimbs_shl_limbs(x: KLimbs, shift: Field) -> KLimbs {
    match shift {
      0 => {  x } ,
      _ => {
        let prepended = store(Lists::Node::Cons([UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], x));
        klimbs_shl_limbs(prepended, shift - 1) } ,
    }
  }

  fn klimbs_is_zero(x: KLimbs) -> Field {
    match load(klimbs_normalize(x)) {
      Lists::Node::Nil => {  1 } ,
      _ => {  0 } ,
    }
  }

  fn klimbs_div_mod(a: KLimbs, b: KLimbs) -> (KLimbs, KLimbs) {
    let (q_hint, r_hint) = ordinary_div_mod(a, b);

    let q = klimbs_normalize(q_hint);
    let r = klimbs_normalize(r_hint);
    let qb = klimbs_mul(q, b);
    let lhs = klimbs_normalize(klimbs_add(qb, r));
    let rhs = klimbs_normalize(a);

    assert_eq!(klimbs_eq(lhs, rhs), 1, "div/mod hint: q*b + r != a");
    match klimbs_is_zero(b) {
      1 => {

        assert_eq!(klimbs_is_zero(q), 1,
          "div/mod hint: division by zero must yield a zero quotient");
        (q, r) } ,
      0 => {

        assert_eq!(klimbs_le(klimbs_succ(r), b), 1,
          "div/mod hint: remainder is not less than the divisor");
        (q, r) } ,
    }
  }

  fn klimbs_div(a: KLimbs, b: KLimbs) -> KLimbs {
    match klimbs_div_mod(a, b) { (q, _) => {  q } , }
  }

  fn klimbs_mod(a: KLimbs, b: KLimbs) -> KLimbs {
    match klimbs_div_mod(a, b) { (_, r) => {  r } , }
  }

  fn klimbs_gcd(a: KLimbs, b: KLimbs) -> KLimbs {
    match klimbs_is_zero(b) {
      1 => {  a } ,
      0 => {  klimbs_gcd(b, klimbs_mod(a, b)) } ,
    }
  }

  fn klimbs_pow(base: KLimbs, exp: KLimbs) -> KLimbs {
    match klimbs_is_zero(exp) {
      1 => {  store(Lists::Node::Cons([UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(Lists::Node::Nil))) } ,
      0 => {
        let two = store(Lists::Node::Cons([UInt8::BYTE_2, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(Lists::Node::Nil)));
        let (half, r) = klimbs_div_mod(exp, two);
        let sq = klimbs_pow(klimbs_normalize(klimbs_mul(base, base)), klimbs_normalize(half));
        match klimbs_is_zero(r) {
          1 => {  sq } ,
          0 => {  klimbs_mul(base, sq) } ,
        } } ,
    }
  }







  fn klimbs_land(a: KLimbs, b: KLimbs) -> KLimbs {
    match load(a) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(la, ra) => {
        match load(b) {
          Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
          Lists::Node::Cons(lb, rb) => {
            store(Lists::Node::Cons(UInt64::and(la, lb), klimbs_land(ra, rb))) } ,
        } } ,
    }
  }

  fn klimbs_lor(a: KLimbs, b: KLimbs) -> KLimbs {
    match load(a) {
      Lists::Node::Nil => {  b } ,
      Lists::Node::Cons(la, ra) => {
        match load(b) {
          Lists::Node::Nil => {  a } ,
          Lists::Node::Cons(lb, rb) => {
            store(Lists::Node::Cons(UInt64::or(la, lb), klimbs_lor(ra, rb))) } ,
        } } ,
    }
  }

  fn klimbs_xor_op(a: KLimbs, b: KLimbs) -> KLimbs {
    match load(a) {
      Lists::Node::Nil => {  b } ,
      Lists::Node::Cons(la, ra) => {
        match load(b) {
          Lists::Node::Nil => {  a } ,
          Lists::Node::Cons(lb, rb) => {
            store(Lists::Node::Cons(UInt64::xor(la, lb), klimbs_xor_op(ra, rb))) } ,
        } } ,
    }
  }

  fn klimbs_shl(a: KLimbs, n: KLimbs) -> KLimbs {
    let two = store(Lists::Node::Cons([UInt8::BYTE_2, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(Lists::Node::Nil)));
    klimbs_mul(a, klimbs_pow(two, n))
  }

  fn klimbs_shr(a: KLimbs, n: KLimbs) -> KLimbs {
    let two = store(Lists::Node::Cons([UInt8::BYTE_2, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(Lists::Node::Nil)));
    klimbs_div(a, klimbs_pow(two, n))
  }

