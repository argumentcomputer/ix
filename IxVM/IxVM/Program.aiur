module IxVM {
  fn verify_serde(digest: [Field; 32]) -> () {
      let digest = Blake3::address_from_fields(digest);
      let (idx, len) = IxVMCompat::io_get_info(2, digest);
      let bytes = IxByteStream::read_byte_stream(2, idx, len);
      Blake3::verify_bytes_against(bytes, digest);
      let (constant, rest) = IxonDeserialize::get_constant(bytes);
      let Lists::Node::Nil = (*(rest));
      let output = IxonSerialize::put_constant(constant, (&(Lists::Node::Nil)));
      assert_eq!(IxVMCompat::stream_equal(bytes, output), 1, "Ixon serialization round trip");
      ()
  }

  fn verify_constant(digest: [Field; 32]) -> () {
      KernelClaim::run_check(KernelRoles::role_ctx_assumed(IxVMCompat::default_binding_addr()), (&(Blake3::address_from_fields(digest))))
  }

  fn verify_transitive(digest: [Field; 32]) -> () {
      KernelClaim::run_check_transitive(KernelRoles::role_ctx_assumed(IxVMCompat::default_binding_addr()), (&(Blake3::address_from_fields(digest))))
  }

  fn check_primitives() -> () {
      assert_eq!(UInt32::compact_field(UInt32::compact(UInt32::add(UInt32::MAX, UInt32::ONE))), 0, "u32 carry");
      assert_eq!(UInt32::compact_field(UInt32::compact(UInt32::add3(UInt32::MAX, UInt32::MAX, UInt32::MAX))), 4294967293, "three-word carry");
      assert_eq!(UInt32::less_than_fields(255, 256), 1, "u32 compare");
      assert_eq!(UInt32::less_than_fields(256, 255), 0, "u32 compare reverse");
      let a = (&(Lists::Node::Cons([UInt8::BYTE_25,UInt8::BYTE_0,UInt8::BYTE_0,UInt8::BYTE_0,UInt8::BYTE_0,UInt8::BYTE_0,UInt8::BYTE_0,UInt8::BYTE_0], (&(Lists::Node::Nil)))));
      let b = (&(Lists::Node::Cons([UInt8::BYTE_7,UInt8::BYTE_0,UInt8::BYTE_0,UInt8::BYTE_0,UInt8::BYTE_0,UInt8::BYTE_0,UInt8::BYTE_0,UInt8::BYTE_0], (&(Lists::Node::Nil)))));
      let (q,r) = IxVMCompat::ordinary_div_mod(a,b);
      let Lists::Node::Cons(q0, qt) = (*(q));
      let Lists::Node::Nil = (*(qt));
      assert_eq!(UInt64::eq(q0, [UInt8::BYTE_3,UInt8::BYTE_0,UInt8::BYTE_0,UInt8::BYTE_0,UInt8::BYTE_0,UInt8::BYTE_0,UInt8::BYTE_0,UInt8::BYTE_0]), 1, "division");
      let Lists::Node::Cons(r0, rt) = (*(r));
      let Lists::Node::Nil = (*(rt));
      assert_eq!(UInt64::eq(r0, [UInt8::BYTE_4,UInt8::BYTE_0,UInt8::BYTE_0,UInt8::BYTE_0,UInt8::BYTE_0,UInt8::BYTE_0,UInt8::BYTE_0,UInt8::BYTE_0]), 1, "remainder");

      let empty = (&(Lists::Node::Nil));
      let zero_addr = (&([UInt8::BYTE_0; 32]));
      let rc = (&(KernelRoles::RoleCtxNode::Assumed((&(KernelRoles::RoleTableNode::Mk(
        zero_addr,
        KernelRoles::RoleMap::Node(1, KernelRoleSpec::role_nat_zero(), zero_addr, (&(KernelRoles::RoleMap::Nil)), (&(KernelRoles::RoleMap::Nil))),
        RBTreeMap::RBTreeMap::Node(1, zero_addr, KernelRoleSpec::role_nat_zero() + 1, (&(RBTreeMap::RBTreeMap::Nil)), (&(RBTreeMap::RBTreeMap::Nil))),
        KernelRoles::RoleMap::Nil))), RBTreeMap::RBTreeMap::Nil)));
      let prop = (&(KernelTypes::KExprNode::Srt((&(KernelTypes::KLevelNode::Zero)))));
      let var = (&(KernelTypes::KExprNode::BVar(0)));
      let ctx = (&(Lists::Node::Cons(prop, empty)));
      let lam = (&(KernelTypes::KExprNode::Lam(prop, var)));
      assert_eq!(KernelDefEq::k_is_def_eq(rc, prop, prop, empty), 1, "sort reflexivity without pointer shortcut");
      assert_eq!(KernelDefEq::k_is_def_eq(rc, var, var, ctx), 1, "open reflexivity without pointer shortcut");
      assert_eq!(KernelDefEq::k_is_def_eq(rc, var, var, empty), 1, "context-free variable comparison");
      let head = (&(KernelTypes::KExprNode::BVar(1)));
      let app = (&(KernelTypes::KExprNode::App(head, var)));
      assert_eq!(KernelDefEq::k_is_def_eq(rc, app, app, empty), 1, "context-free application comparison");
      let other = (&(KernelTypes::KExprNode::App(var, var)));
      assert_eq!(KernelDefEq::try_def_eq_app(rc, app, other, empty), 0, "different variable heads");
      assert_eq!(KernelDefEq::k_is_def_eq(rc, lam, lam, empty), 1, "lambda reflexivity without pointer shortcut");
      assert_eq!(KernelDefEq::k_is_def_eq_struct_bounded(rc, lam, lam, 3, empty), (1, 3), "structural credit");
      let str = (&(KernelTypes::KExprNode::Lit(KernelTypes::KLiteral::Str((&(Lists::Node::Nil))))));
      assert_eq!(KernelDefEq::k_is_def_eq_struct_go(rc, str, var, ctx), 0, "string expansion makes no progress");
      let zero = (&(KernelTypes::KExprNode::Lit(KernelTypes::KLiteral::Nat((&(Lists::Node::Nil))))));
      let ctor = (&(KernelTypes::KExprNode::Const(zero_addr, (&(Lists::Node::Nil)))));
      assert_eq!(KernelDefEq::k_is_def_eq_struct_go(rc, zero, ctor, empty), 1, "natural literal expansion");
      ()
  }

  fn verify_claim(digest: [Field; 8]) -> () { KernelClaim::run_claim(digest) }

  fn verify_check_env(digest: [Field; 32]) -> () {
      KernelClaim::run_check_env(KernelRoles::role_ctx_assumed(IxVMCompat::default_binding_addr()), (&(Blake3::address_from_fields(digest))), Options::Option::None)
  }

  fn check_port_cases() -> () {
      IxVMCompat::audit_div((&(Lists::Node::Nil)), (&(Lists::Node::Nil)), (&(Lists::Node::Nil)), (&(Lists::Node::Nil)));
      IxVMCompat::audit_div((&(Lists::Node::Nil)), (&(Lists::Node::Cons([UInt8::BYTE_7, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil))))), (&(Lists::Node::Nil)), (&(Lists::Node::Nil)));
      IxVMCompat::audit_div((&(Lists::Node::Cons([UInt8::BYTE_25, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil))))), (&(Lists::Node::Nil)), (&(Lists::Node::Nil)), (&(Lists::Node::Cons([UInt8::BYTE_25, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil))))));
      IxVMCompat::audit_div((&(Lists::Node::Cons([UInt8::BYTE_25, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil))))), (&(Lists::Node::Cons([UInt8::BYTE_7, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil))))), (&(Lists::Node::Cons([UInt8::BYTE_3, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil))))), (&(Lists::Node::Cons([UInt8::BYTE_4, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil))))));
      IxVMCompat::audit_div((&(Lists::Node::Cons([UInt8::BYTE_0, UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil))))), (&(Lists::Node::Cons([UInt8::BYTE_255, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil))))), (&(Lists::Node::Cons([UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil))))), (&(Lists::Node::Cons([UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil))))));
      IxVMCompat::audit_div((&(Lists::Node::Cons([UInt8::BYTE_255, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil))))), (&(Lists::Node::Cons([UInt8::BYTE_0, UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil))))), (&(Lists::Node::Nil)), (&(Lists::Node::Cons([UInt8::BYTE_255, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil))))));
      IxVMCompat::audit_div((&(Lists::Node::Cons([UInt8::BYTE_7, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Cons([UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil)))))))), (&(Lists::Node::Cons([UInt8::BYTE_1, UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil))))), (&(Lists::Node::Cons([UInt8::BYTE_255, UInt8::BYTE_0, UInt8::BYTE_255, UInt8::BYTE_0, UInt8::BYTE_255, UInt8::BYTE_0, UInt8::BYTE_255, UInt8::BYTE_0], (&(Lists::Node::Nil))))), (&(Lists::Node::Cons([UInt8::BYTE_8, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil))))));
      IxVMCompat::audit_div((&(Lists::Node::Cons([UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_255], (&(Lists::Node::Cons([UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil)))))))), (&(Lists::Node::Cons([UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil))))), (&(Lists::Node::Cons([UInt8::BYTE_254, UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil))))), (&(Lists::Node::Cons([UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil))))));
      IxVMCompat::audit_div((&(Lists::Node::Cons([UInt8::BYTE_123, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Cons([UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil)))))))), (&(Lists::Node::Cons([UInt8::BYTE_5, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Cons([UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil)))))))), (&(Lists::Node::Cons([UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil))))), (&(Lists::Node::Cons([UInt8::BYTE_128, UInt8::BYTE_0, UInt8::BYTE_251, UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_255], (&(Lists::Node::Nil))))));
      let empty = (&(Lists::Node::Nil));
      let rc = (&(KernelRoles::RoleCtxNode::Assumed((&(KernelRoles::RoleTableNode::Mk(
        (&([UInt8::BYTE_0; 32])),
        KernelRoles::RoleMap::Nil,
        RBTreeMap::RBTreeMap::Nil,
        KernelRoles::RoleMap::Nil))), RBTreeMap::RBTreeMap::Nil)));
      let zero_level = (&(KernelTypes::KLevelNode::Zero));
      let prop = (&(KernelTypes::KExprNode::Srt(zero_level)));
      let v0 = (&(KernelTypes::KExprNode::BVar(0)));
      let v1 = (&(KernelTypes::KExprNode::BVar(1)));
      let lam = (&(KernelTypes::KExprNode::Lam(prop, v0)));
      let app = (&(KernelTypes::KExprNode::App(lam, prop)));
      assert_eq!(KernelDefEq::k_is_def_eq(rc, prop, prop, empty), 1, "reflexive sort");
      assert_eq!(KernelDefEq::k_is_def_eq(rc, lam, lam, empty), 1, "reflexive lambda");
      assert_eq!(KernelDefEq::k_is_def_eq(rc, app, prop, empty), 1, "beta reduction left");
      assert_eq!(KernelDefEq::k_is_def_eq(rc, prop, app, empty), 1, "beta reduction right");
      assert_eq!(KernelCheck::kexpr_struct_eq(v0, v1), 0, "distinct variables");
      assert_eq!(KernelCheck::kexpr_struct_eq(app, app), 1, "structural reflexivity");
      assert_eq!(KernelLevels::level_struct_eq(zero_level, (&(KernelTypes::KLevelNode::Succ(zero_level)))), 0, "distinct levels");
      assert_eq!(KernelLevels::level_struct_eq((&(KernelTypes::KLevelNode::Max(zero_level, zero_level))), (&(KernelTypes::KLevelNode::Max(zero_level, zero_level)))), 1, "recursive level equality");
      assert_eq!(UInt32::less_than_fields(0, 4294967295), 1, "u32 upper bound");
      assert_eq!(UInt32::less_than_fields(4294967295, 0), 0, "u32 reverse upper bound");
      assert_eq!(UInt32::less_than_fields(4294967295, 4294967295), 0, "u32 equality");
      ()
  }
}
