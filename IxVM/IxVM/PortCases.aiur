// Shared semantic probes; converted lexically for the Ix comparison exporter.
fn audit_div(a: KLimbs, b: KLimbs, expected_q: KLimbs, expected_r: KLimbs) -> () {
    let (q, r) = klimbs_div_mod(a, b);
    assert_eq!(klimbs_eq(q, expected_q), 1, "audit quotient");
    assert_eq!(klimbs_eq(r, expected_r), 1, "audit remainder");
    ()
}
fn check_port_cases() -> () {
    audit_div(store(ListNode::Nil), store(ListNode::Nil), store(ListNode::Nil), store(ListNode::Nil));
    audit_div(store(ListNode::Nil), store(ListNode::Cons([UInt8::BYTE_7, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))), store(ListNode::Nil), store(ListNode::Nil));
    audit_div(store(ListNode::Cons([UInt8::BYTE_25, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))), store(ListNode::Nil), store(ListNode::Nil), store(ListNode::Cons([UInt8::BYTE_25, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))));
    audit_div(store(ListNode::Cons([UInt8::BYTE_25, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))), store(ListNode::Cons([UInt8::BYTE_7, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))), store(ListNode::Cons([UInt8::BYTE_3, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))), store(ListNode::Cons([UInt8::BYTE_4, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))));
    audit_div(store(ListNode::Cons([UInt8::BYTE_0, UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))), store(ListNode::Cons([UInt8::BYTE_255, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))), store(ListNode::Cons([UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))), store(ListNode::Cons([UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))));
    audit_div(store(ListNode::Cons([UInt8::BYTE_255, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))), store(ListNode::Cons([UInt8::BYTE_0, UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))), store(ListNode::Nil), store(ListNode::Cons([UInt8::BYTE_255, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))));
    audit_div(store(ListNode::Cons([UInt8::BYTE_7, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Cons([UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))))), store(ListNode::Cons([UInt8::BYTE_1, UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))), store(ListNode::Cons([UInt8::BYTE_255, UInt8::BYTE_0, UInt8::BYTE_255, UInt8::BYTE_0, UInt8::BYTE_255, UInt8::BYTE_0, UInt8::BYTE_255, UInt8::BYTE_0], store(ListNode::Nil))), store(ListNode::Cons([UInt8::BYTE_8, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))));
    audit_div(store(ListNode::Cons([UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_255], store(ListNode::Cons([UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))))), store(ListNode::Cons([UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))), store(ListNode::Cons([UInt8::BYTE_254, UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))), store(ListNode::Cons([UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))));
    audit_div(store(ListNode::Cons([UInt8::BYTE_123, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Cons([UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))))), store(ListNode::Cons([UInt8::BYTE_5, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Cons([UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))))), store(ListNode::Cons([UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], store(ListNode::Nil))), store(ListNode::Cons([UInt8::BYTE_128, UInt8::BYTE_0, UInt8::BYTE_251, UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_255, UInt8::BYTE_255], store(ListNode::Nil))));
    let empty = store(ListNode::Nil);
    let zero_level = store(KLevelNode::Zero);
    let prop = store(KExprNode::Srt(zero_level));
    let v0 = store(KExprNode::BVar(0));
    let v1 = store(KExprNode::BVar(1));
    let lam = store(KExprNode::Lam(prop, v0));
    let app = store(KExprNode::App(lam, prop));
    assert_eq!(k_is_def_eq(prop, prop, empty), 1, "reflexive sort");
    assert_eq!(k_is_def_eq(lam, lam, empty), 1, "reflexive lambda");
    assert_eq!(k_is_def_eq(app, prop, empty), 1, "beta reduction left");
    assert_eq!(k_is_def_eq(prop, app, empty), 1, "beta reduction right");
    assert_eq!(kexpr_struct_eq(v0, v1), 0, "distinct variables");
    assert_eq!(kexpr_struct_eq(app, app), 1, "structural reflexivity");
    assert_eq!(canon_cmp_kexpr_ctx(app, app, store(ListNode::Nil)), (1, 1), "canonical reflexivity");
    assert_eq!(level_struct_eq(zero_level, store(KLevelNode::Succ(zero_level))), 0, "distinct levels");
    assert_eq!(level_struct_eq(store(KLevelNode::Max(zero_level, zero_level)), store(KLevelNode::Max(zero_level, zero_level))), 1, "recursive level equality");
    assert_eq!(UInt32::less_than_fields(0, 4294967295), 1, "u32 upper bound");
    assert_eq!(UInt32::less_than_fields(4294967295, 0), 0, "u32 reverse upper bound");
    assert_eq!(UInt32::less_than_fields(4294967295, 4294967295), 0, "u32 equality");
    ()
}
