        Ixon::ConstantInfo::Defn(defn) => {  put_definition(defn, rest) } ,
        Ixon::ConstantInfo::Recr(recr) => {  put_recursor(recr, rest) } ,
        Ixon::ConstantInfo::Axio(axim) => {  put_axiom(axim, rest) } ,
        Ixon::ConstantInfo::Quot(quot) => {  put_quotient(quot, rest) } ,
        Ixon::ConstantInfo::CPrj(prj) => {  put_constructor_proj(prj, rest) } ,
        Ixon::ConstantInfo::RPrj(prj) => {  put_recursor_proj(prj, rest) } ,
        Ixon::ConstantInfo::IPrj(prj) => {  put_inductive_proj(prj, rest) } ,
        Ixon::ConstantInfo::DPrj(prj) => {  put_definition_proj(prj, rest) } ,
      }
    }

  fn put_sharing(list: Lists::List<&Ixon::Expr>, rest: Bytes::Stream) -> Bytes::Stream {
      let len = WordLists::length_u64(list);
      put_tagn0(len, put_expr_list(list, rest))
    }

  fn put_refs(list: Lists::List<Bytes::AddressRef>, rest: Bytes::Stream) -> Bytes::Stream {
      let len = WordLists::length_u64(list);
      put_tagn0(len, put_address_list(list, rest))
    }

  fn put_univs(list: Lists::List<&Ixon::Univ>, rest: Bytes::Stream) -> Bytes::Stream {
      let len = WordLists::length_u64(list);
      put_tagn0(len, put_univ_list(list, rest))
    }

  fn put_constant(cnst: Ixon::Constant, rest: Bytes::Stream) -> Bytes::Stream {
      match cnst {
        Ixon::Constant::Mk(info, sharing, refs, univs) => {
          let up_to_sharing = put_sharing(sharing, put_refs(refs, put_univs(univs, rest)));
          match info {
            Ixon::ConstantInfo::Muts(mutuals) => {

              let count = WordLists::length_u64(mutuals);
              put_tagn4(12, count, put_mut_const_list(mutuals, up_to_sharing)) } ,

            Ixon::ConstantInfo::Defn(_) => {
              put_tagn4(13, [UInt8::BYTE_0; 8], put_constant_info(info, up_to_sharing)) } ,
            Ixon::ConstantInfo::Recr(_) => {
              put_tagn4(13, [UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], put_constant_info(info, up_to_sharing)) } ,
            Ixon::ConstantInfo::Axio(_) => {
              put_tagn4(13, [UInt8::BYTE_2, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], put_constant_info(info, up_to_sharing)) } ,
            Ixon::ConstantInfo::Quot(_) => {
              put_tagn4(13, [UInt8::BYTE_3, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], put_constant_info(info, up_to_sharing)) } ,
            Ixon::ConstantInfo::CPrj(_) => {
              put_tagn4(13, [UInt8::BYTE_4, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], put_constant_info(info, up_to_sharing)) } ,
            Ixon::ConstantInfo::RPrj(_) => {
              put_tagn4(13, [UInt8::BYTE_5, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], put_constant_info(info, up_to_sharing)) } ,
            Ixon::ConstantInfo::IPrj(_) => {
              put_tagn4(13, [UInt8::BYTE_6, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], put_constant_info(info, up_to_sharing)) } ,
            Ixon::ConstantInfo::DPrj(_) => {
              put_tagn4(13, [UInt8::BYTE_7, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], put_constant_info(info, up_to_sharing)) } ,
          } } ,
      }
    }
}
