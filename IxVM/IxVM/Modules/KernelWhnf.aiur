                1 => {  (1, arity, struct_addr, field, (arity - 1) - i) } ,
                _ => {  (0, 0, (&([UInt8::BYTE_0; 32])), 0, 0) } ,
              } } ,
            _ => {  (0, 0, (&([UInt8::BYTE_0; 32])), 0, 0) } ,
          } } ,
        _ => {  (0, 0, (&([UInt8::BYTE_0; 32])), 0, 0) } ,
      }
    }

