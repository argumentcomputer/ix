  fn check_quot(self_addr: Bytes::AddressRef, kind: Ixon::QuotKind,
                      num_lvls: Field, ty: KernelTypes::KExpr) -> () {
      let pair = match kind {
        Ixon::QuotKind::Typ => {
          assert_eq!(Bytes::address_eq(self_addr, quot_type_addr()), 1,
            "Quot.Typ declared at a non-canonical address");
          (1, 2) } ,
        Ixon::QuotKind::Ctor => {
          assert_eq!(Bytes::address_eq(self_addr, quot_ctor_addr()), 1,
            "Quot.mk declared at a non-canonical address");
          (1, 3) } ,
        Ixon::QuotKind::Lift => {
          assert_eq!(Bytes::address_eq(self_addr, quot_lift_addr()), 1,
            "Quot.lift declared at a non-canonical address");
          check_eq_type();
          (2, 6) } ,
        Ixon::QuotKind::Ind => {
          assert_eq!(Bytes::address_eq(self_addr, quot_ind_addr()), 1,
            "Quot.ind declared at a non-canonical address");
          (1, 5) } ,
      };
      match pair {
        (expected_lvls, expected_foralls) => {
          assert_eq!(num_lvls, expected_lvls,
            "Quot constant: wrong universe param count for its kind");
          assert_eq!(count_foralls_at_least(ty, expected_foralls, 0), 1,
            "Quot constant: type has too few foralls for its kind");
          () } ,
      }
    }

