            KernelTypes::KLevelNode::Max(x1, x2) => {
              match (*(b)) {
                KernelTypes::KLevelNode::Max(y1, y2) => {
                  level_struct_eq(x1, y1) * level_struct_eq(x2, y2) } ,
                _ => {  0 } ,
              } } ,
            KernelTypes::KLevelNode::IMax(x1, x2) => {
              match (*(b)) {
                KernelTypes::KLevelNode::IMax(y1, y2) => {
                  level_struct_eq(x1, y1) * level_struct_eq(x2, y2) } ,
                _ => {  0 } ,
              } } ,
            KernelTypes::KLevelNode::Param(i) => {
              match (*(b)) {
                KernelTypes::KLevelNode::Param(j) => {
                  match i - j {
                    0 => {  1 } ,
                    _ => {  0 } ,
                  } } ,
                _ => {  0 } ,
              } } ,
          }
    }

  fn level_max_subsumes(m: KernelTypes::KLevel, x: KernelTypes::KLevel) -> Field {
      match (*(m)) {
        KernelTypes::KLevelNode::Max(l, r) => {
          match level_struct_eq(l, x) {
            1 => {  1 } ,
            0 => {  level_struct_eq(r, x) } ,
          } } ,
        _ => {  0 } ,
      }
    }

  fn level_max_offsets(a: KernelTypes::KLevel, b: KernelTypes::KLevel) -> KernelTypes::KLevel {
      match level_offset_of(a, 0) {
        (base_a, off_a) => {
          match level_offset_of(b, 0) {
            (base_b, off_b) => {
              match level_struct_eq(base_a, base_b) {
                1 => {
                  match UInt32::less_than_fields(off_a, off_b) {
                    1 => {  b } ,
                    0 => {  a } ,
                  } } ,
                0 => {  (&(KernelTypes::KLevelNode::Max(a, b))) } ,
              } } ,
          } } ,
      }
    }

  fn level_explicit_val(l: KernelTypes::KLevel) -> (Field, Field) {
      match (*(l)) {
        KernelTypes::KLevelNode::Zero => {  (1, 0) } ,
        KernelTypes::KLevelNode::Succ(inner) => {
          match level_explicit_val(inner) {
            (1, n) => {  (1, n + 1) } ,
            _ => {  (0, 0) } ,
          } } ,
        _ => {  (0, 0) } ,
      }
    }

  fn level_offset_of(l: KernelTypes::KLevel, k: Field) -> (KernelTypes::KLevel, Field) {
      match (*(l)) {
        KernelTypes::KLevelNode::Succ(inner) => {  level_offset_of(inner, k + 1) } ,
        _ => {  (l, k) } ,
      }
    }

  fn level_imax(a: KernelTypes::KLevel, b: KernelTypes::KLevel) -> KernelTypes::KLevel {
      match (*(b)) {
        KernelTypes::KLevelNode::Zero => {  (&(KernelTypes::KLevelNode::Zero)) } ,
        KernelTypes::KLevelNode::Succ(_) => {  level_max(a, b) } ,
        _ => {
          let not_zero = level_is_not_zero(b);
          match not_zero {
            1 => {  level_max(a, b) } ,
            0 => {
              match (*(a)) {
                KernelTypes::KLevelNode::Zero => {  b } ,
                _ => {
                  let eq = level_eq(a, b);
                  match eq {
                    1 => {  a } ,
                    0 => {  (&(KernelTypes::KLevelNode::IMax(a, b))) } ,
                  } } ,
              } } ,
          } } ,
      }
    }

  fn level_reduce(l: KernelTypes::KLevel) -> KernelTypes::KLevel {
      match (*(l)) {
        KernelTypes::KLevelNode::Zero => {  (&(KernelTypes::KLevelNode::Zero)) } ,
        KernelTypes::KLevelNode::Param(i) => {  (&(KernelTypes::KLevelNode::Param(i))) } ,
        KernelTypes::KLevelNode::Succ(u) => {  (&(KernelTypes::KLevelNode::Succ(level_reduce(u)))) } ,
        KernelTypes::KLevelNode::Max(a, b) => {  level_max(level_reduce(a), level_reduce(b)) } ,
        KernelTypes::KLevelNode::IMax(a, b) => {  level_imax(level_reduce(a), level_reduce(b)) } ,
      }
    }

  fn level_inst_params(l: KernelTypes::KLevel, params: Lists::List<KernelTypes::KLevel>) -> KernelTypes::KLevel {
      match (*(l)) {
        KernelTypes::KLevelNode::Zero => {  (&(KernelTypes::KLevelNode::Zero)) } ,
        KernelTypes::KLevelNode::Succ(u) => {  (&(KernelTypes::KLevelNode::Succ(level_inst_params(u, params)))) } ,
        KernelTypes::KLevelNode::Max(a, b) => {
          level_max(level_inst_params(a, params), level_inst_params(b, params)) } ,
        KernelTypes::KLevelNode::IMax(a, b) => {
          level_imax(level_inst_params(a, params), level_inst_params(b, params)) } ,
        KernelTypes::KLevelNode::Param(i) => {  Lists::lookup(params, i) } ,
      }
    }

  fn level_list_inst(lvls: Lists::List<KernelTypes::KLevel>, params: Lists::List<KernelTypes::KLevel>) -> Lists::List<KernelTypes::KLevel> {
      match (*(lvls)) {
        Lists::Node::Nil => {  (&(Lists::Node::Nil)) } ,
        Lists::Node::Cons(l, rest) => {
          (&(Lists::Node::Cons(
            level_inst_params(l, params),
            level_list_inst(rest, params)))) } ,
      }
    }

  fn expr_inst_levels(e: KernelTypes::KExpr, params: Lists::List<KernelTypes::KLevel>) -> KernelTypes::KExpr {

      match (*(params)) {
        Lists::Node::Nil => {  e } ,
        _ => {  expr_inst_levels_walk(e, params) } ,
      }
    }

  fn expr_inst_levels_walk(e: KernelTypes::KExpr, params: Lists::List<KernelTypes::KLevel>) -> KernelTypes::KExpr {
      match (*(e)) {
        KernelTypes::KExprNode::BVar(i) => {  (&(KernelTypes::KExprNode::BVar(i))) } ,
        KernelTypes::KExprNode::Srt(l) => {
          (&(KernelTypes::KExprNode::Srt(level_inst_params(l, params)))) } ,
        KernelTypes::KExprNode::Const(idx, lvls) => {
          (&(KernelTypes::KExprNode::Const(idx, level_list_inst(lvls, params)))) } ,
        KernelTypes::KExprNode::App(f, a) => {
          (&(KernelTypes::KExprNode::App(expr_inst_levels(f, params), expr_inst_levels(a, params)))) } ,
        KernelTypes::KExprNode::Lam(ty, body) => {
          (&(KernelTypes::KExprNode::Lam(expr_inst_levels(ty, params), expr_inst_levels(body, params)))) } ,
        KernelTypes::KExprNode::Forall(ty, body) => {
          (&(KernelTypes::KExprNode::Forall(expr_inst_levels(ty, params), expr_inst_levels(body, params)))) } ,
        KernelTypes::KExprNode::Let(ty, val, body) => {
          (&(KernelTypes::KExprNode::Let(
            expr_inst_levels(ty, params),
            expr_inst_levels(val, params),
            expr_inst_levels(body, params)))) } ,
        KernelTypes::KExprNode::Lit(lit) => {  (&(KernelTypes::KExprNode::Lit(lit))) } ,
        KernelTypes::KExprNode::Proj(tidx, fidx, e1) => {
          (&(KernelTypes::KExprNode::Proj(tidx, fidx, expr_inst_levels(e1, params)))) } ,
      }
    }

  fn klimbs_eq(a: KernelTypes::KLimbs, b: KernelTypes::KLimbs) -> Field {
      match (*(a)) {
        Lists::Node::Nil => {
          match (*(b)) {
            Lists::Node::Nil => {  1 } ,
            _ => {  0 } ,
          } } ,
        Lists::Node::Cons(la, ra) => {
          match (*(b)) {
            Lists::Node::Nil => {  0 } ,
            Lists::Node::Cons(lb, rb) => {
              let eq = UInt64::eq(la, lb);
              match eq {
                1 => {  klimbs_eq(ra, rb) } ,
                0 => {  0 } ,
              } } ,
          } } ,
      }
    }

  fn bytestream_eq(a: Bytes::Stream, b: Bytes::Stream) -> Field {
      match (*(a)) {
        Lists::Node::Nil => {
          match (*(b)) {
            Lists::Node::Nil => {  1 } ,
            _ => {  0 } ,
          } } ,
        Lists::Node::Cons(ba, ra) => {
          match (*(b)) {
            Lists::Node::Nil => {  0 } ,
            Lists::Node::Cons(bb, rb) => {
              match UInt8::to_field(ba) - UInt8::to_field(bb) {
                0 => {  bytestream_eq(ra, rb) } ,
                _ => {  0 } ,
              } } ,
          } } ,
      }
    }

  fn literal_eq(a: KernelTypes::KLiteral, b: KernelTypes::KLiteral) -> Field {
      match a {
        KernelTypes::KLiteral::Nat(na) => {
          match b {
            KernelTypes::KLiteral::Nat(nb) => {  klimbs_eq(na, nb) } ,
            _ => {  0 } ,
          } } ,
        KernelTypes::KLiteral::Str(sa) => {
          match b {
            KernelTypes::KLiteral::Str(sb) => {  bytestream_eq(sa, sb) } ,
            _ => {  0 } ,
          } } ,
      }
    }
}
