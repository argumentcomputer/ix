  fn is_bitvec_prim_addr(a: Bytes::AddressRef) -> Field {
      match Bytes::address_eq(a, bit_vec_to_nat_addr()) {
        1 => {  1 } ,
        _ => {
        match Bytes::address_eq(a, bit_vec_ult_addr()) {
          1 => {  1 } ,
          _ => {
          match Bytes::address_eq(a, decidable_decide_addr()) {
            1 => {  1 } ,
            _ => {  0 } ,
          } } ,
        } } ,
      }
    }

  fn mk_bool(g: Field) -> KernelTypes::KExpr {
      match g {
        0 => {  (&(KernelTypes::KExprNode::Const(bool_false_addr(), (&(Lists::Node::Nil))))) } ,
        _ => {  (&(KernelTypes::KExprNode::Const(bool_true_addr(), (&(Lists::Node::Nil))))) } ,
      }
    }

  fn bv_to_nat_via(width_e: KernelTypes::KExpr, val_e: KernelTypes::KExpr) -> (Field, KernelTypes::KLimbs) {
      match bitvec_of_nat_args_direct(val_e) {
        (0, _, _) => {  (0, (&(Lists::Node::Nil))) } ,
        (1, val_width, n_e) => {
          match try_extract_nat(n_e) {
            (0, _) => {  (0, (&(Lists::Node::Nil))) } ,
            (1, n_kl) => {
              match try_extract_nat(val_width) {
                (0, _) => {  (0, (&(Lists::Node::Nil))) } ,
                (1, w_kl) => {
                  let two = (&(Lists::Node::Cons(
                    [UInt8::BYTE_2, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0],
                    (&(Lists::Node::Nil)))));
                  let modulus = KernelKlimbs::klimbs_pow(two, w_kl);
                  (1, KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_mod(n_kl, modulus))) } ,
              } } ,
          } } ,
      }
    }

  fn try_reduce_bit_vec_ult(spine: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr) {
      match UInt32::less_than_fields(Lists::length(spine), 3) {
        1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
        _ => {
          let width_e = Lists::lookup(spine, 0);
          let lhs_e = Lists::lookup(spine, 1);
          let rhs_e = Lists::lookup(spine, 2);
          match bv_to_nat_via(width_e, lhs_e) {
            (0, _) => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
            (1, lhs_n) => {
              match bv_to_nat_via(width_e, rhs_e) {
                (0, _) => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                (1, rhs_n) => {

                  let r = 1 - KernelKlimbs::klimbs_le(rhs_n, lhs_n);
                  (1, mk_bool(r)) } ,
              } } ,
          } } ,
      }
    }

  fn try_reduce_decide_bitvec_lt(spine: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr) {
      match UInt32::less_than_fields(Lists::length(spine), 2) {
        1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
        _ => {
          let prop = Lists::lookup(spine, 0);
          match KernelTypes::collect_spine(prop) {
            (lt_head, lt_args) => {
              match (*(lt_head)) {
                KernelTypes::KExprNode::Const(lt_caddr, _) => {
                  match Bytes::address_eq(lt_caddr, lt_lt_addr()) {
                    0 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                    _ => {
                      match UInt32::less_than_fields(Lists::length(lt_args), 4) {
                        1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                        _ => {
                          let ty_arg = Lists::lookup(lt_args, 0);
                          match KernelTypes::collect_spine(ty_arg) {
                            (ty_head, ty_args) => {
                              match (*(ty_head)) {
                                KernelTypes::KExprNode::Const(ty_caddr, _) => {
                                  match Bytes::address_eq(ty_caddr, bit_vec_addr()) {
                                    0 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                                    _ => {
                                      match UInt32::less_than_fields(Lists::length(ty_args), 1) {
                                        1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                                        _ => {
                                          let width = Lists::lookup(ty_args, 0);
                                          let lhs = Lists::lookup(lt_args, 2);
                                          let rhs = Lists::lookup(lt_args, 3);
                                          let inner = (&(Lists::Node::Cons(width,
                                            (&(Lists::Node::Cons(lhs,
                                              (&(Lists::Node::Cons(rhs,
                                                (&(Lists::Node::Nil)))))))))));
                                          try_reduce_bit_vec_ult(inner) } ,
                                      } } ,
                                  } } ,
                                _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                              } } ,
                          } } ,
                      } } ,
                  } } ,
                _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
              } } ,
          } } ,
      }
    }

  fn bitvec_of_nat_args_direct(e: KernelTypes::KExpr) -> (Field, KernelTypes::KExpr, KernelTypes::KExpr) {
      match KernelTypes::collect_spine(e) {
        (head, args) => {
          match (*(head)) {
            KernelTypes::KExprNode::Const(caddr, _) => {
              match Bytes::address_eq(caddr, bit_vec_of_nat_addr()) {
                1 => {
                  match Lists::length(args) - 2 {
                    0 => {  (1, Lists::lookup(args, 0), Lists::lookup(args, 1)) } ,
                    _ => {  (0, (&(KernelTypes::KExprNode::BVar(0))), (&(KernelTypes::KExprNode::BVar(0)))) } ,
                  } } ,
                _ => {  (0, (&(KernelTypes::KExprNode::BVar(0))), (&(KernelTypes::KExprNode::BVar(0)))) } ,
              } } ,
            _ => {  (0, (&(KernelTypes::KExprNode::BVar(0))), (&(KernelTypes::KExprNode::BVar(0)))) } ,
          } } ,
      }
    }

  fn try_bitvec_dispatch(head_addr: Bytes::AddressRef, spine: Lists::List<KernelTypes::KExpr>,
                                types: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr) {
      match Bytes::address_eq(head_addr, bit_vec_to_nat_addr()) {
        1 => {
          match UInt32::less_than_fields(Lists::length(spine), 2) {
            1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
            _ => {
              let spine_p = KernelWhnf::bitvec_prep_spine(spine, types);
              let width_e = Lists::lookup(spine_p, 0);
              let val_e = Lists::lookup(spine_p, 1);
              match bv_to_nat_via(width_e, val_e) {
                (0, _) => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                (1, kl) => {  (1, mk_nat_lit(kl)) } ,
              } } ,
          } } ,
        _ => {
          match Bytes::address_eq(head_addr, bit_vec_ult_addr()) {
            1 => {
              let spine_p = bitvec_prep_spine_ult(spine, types);
              try_reduce_bit_vec_ult(spine_p) } ,
            _ => {
              match Bytes::address_eq(head_addr, decidable_decide_addr()) {
                1 => {  try_reduce_decide_bitvec_lt(spine) } ,
                _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
              } } ,
          } } ,
      }
    }

  fn bitvec_prep_spine_ult(spine: Lists::List<KernelTypes::KExpr>, types: Lists::List<KernelTypes::KExpr>)
                                  -> Lists::List<KernelTypes::KExpr> {
      let sw = KernelWhnf::whnf_spine(spine, types);
      match (*(sw)) {
        Lists::Node::Nil => {  sw } ,
        Lists::Node::Cons(width_e, r1) => {
          match (*(r1)) {
            Lists::Node::Nil => {  sw } ,
            Lists::Node::Cons(lhs_e, r2) => {
              match (*(r2)) {
                Lists::Node::Nil => {  sw } ,
                Lists::Node::Cons(rhs_e, tail) => {
                  let lhs_p = np_whnf_inner_bv(lhs_e, types);
                  let rhs_p = np_whnf_inner_bv(rhs_e, types);
                  (&(Lists::Node::Cons(width_e,
                    (&(Lists::Node::Cons(lhs_p,
                      (&(Lists::Node::Cons(rhs_p, tail))))))))) } ,
              } } ,
          } } ,
      }
    }

  fn np_whnf_inner_bv(e: KernelTypes::KExpr, types: Lists::List<KernelTypes::KExpr>) -> KernelTypes::KExpr {
      match KernelTypes::collect_spine(e) {
        (h, a) => {  KernelWhnf::apply_spine(h, KernelWhnf::whnf_spine(a, types)) } ,
      }
    }

