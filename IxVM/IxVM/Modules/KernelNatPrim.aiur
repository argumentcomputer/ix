  fn is_native_prim_addr(a: Bytes::AddressRef) -> Field {
      match Bytes::address_eq(a, system_platform_num_bits_addr()) {
        1 => {  1 } ,
        _ => {
        match Bytes::address_eq(a, punit_size_of_1_addr()) {
          1 => {  1 } ,
          _ => {
          match Bytes::address_eq(a, reduce_bool_addr()) {
            1 => {  1 } ,
            _ => {
            match Bytes::address_eq(a, reduce_nat_addr()) {
              1 => {  1 } ,
              _ => {
              match Bytes::address_eq(a, subtype_val_addr()) {
                1 => {  1 } ,
                _ => {  0 } ,
              } } ,
            } } ,
          } } ,
        } } ,
      }
    }

  fn mk_nat_literal_64() -> KernelTypes::KExpr {
      let limbs = (&(Lists::Node::Cons(
        [UInt8::BYTE_64, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil)))));
      (&(KernelTypes::KExprNode::Lit(KernelTypes::KLiteral::Nat(limbs))))
    }

  fn mk_nat_one() -> KernelTypes::KExpr {
      let limbs = (&(Lists::Node::Cons(
        [UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil)))));
      (&(KernelTypes::KExprNode::Lit(KernelTypes::KLiteral::Nat(limbs))))
    }

  fn try_native_dispatch(head_addr: Bytes::AddressRef, spine: Lists::List<KernelTypes::KExpr>,
                               types: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr) {
      match Bytes::address_eq(head_addr, system_platform_num_bits_addr()) {
        1 => {  (1, mk_nat_literal_64()) } ,
        _ => {
        match Bytes::address_eq(head_addr, punit_size_of_1_addr()) {
          1 => {  (1, mk_nat_one()) } ,
          _ => {
          match Bytes::address_eq(head_addr, subtype_val_addr()) {
            1 => {  try_reduce_subtype_val(spine) } ,
            _ => {
                let is_rb = Bytes::address_eq(head_addr, reduce_bool_addr());
                let is_rn = Bytes::address_eq(head_addr, reduce_nat_addr());
                match is_rb + is_rn {
                  0 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                  _ => {
                    match UInt32::less_than_fields(Lists::length(spine), 1) {
                      1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                      _ => {
                        let arg = Lists::lookup(spine, 0);
                        let result = KernelWhnf::whnf(arg, types);
                        match is_rb {
                          1 => {  check_native_bool(result) } ,
                          _ => {  check_native_nat(result) } ,
                        } } ,
                    } } ,
                } } ,
          } } ,
        } } ,
      }
    }

  fn try_reduce_subtype_val(spine: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr) {
      match UInt32::less_than_fields(Lists::length(spine), 3) {
        1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
        _ => {
          match KernelTypes::collect_spine(Lists::lookup(spine, 2)) {
            (head, _) => {
              match (*(head)) {
                KernelTypes::KExprNode::Const(caddr, _) => {
                  match Bytes::address_eq(caddr, system_platform_get_num_bits_addr()) {
                    1 => {  (1, mk_nat_literal_64()) } ,
                    _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                  } } ,
                _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
              } } ,
          } } ,
      }
    }

  fn check_native_bool(e: KernelTypes::KExpr) -> (Field, KernelTypes::KExpr) {
      match (*(e)) {
        KernelTypes::KExprNode::Const(caddr, _) => {
          let is_t = Bytes::address_eq(caddr, bool_true_addr());
          let is_f = Bytes::address_eq(caddr, bool_false_addr());
          match is_t + is_f {
            0 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
            _ => {  (1, e) } ,
          } } ,
        _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
      }
    }

  fn check_native_nat(e: KernelTypes::KExpr) -> (Field, KernelTypes::KExpr) {
      match (*(e)) {
        KernelTypes::KExprNode::Lit(lit) => {
          match lit {
            KernelTypes::KLiteral::Nat(_) => {  (1, e) } ,
            _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
          } } ,
        _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
      }
    }

