  fn is_str_prim_addr(a: Bytes::AddressRef) -> Field {
      match Bytes::address_eq(a, string_utf8_byte_size_addr()) {
        1 => {  1 } ,
        _ => {
        match Bytes::address_eq(a, string_append_addr()) {
          1 => {  1 } ,
          _ => {
          match Bytes::address_eq(a, string_of_list_addr()) {
            1 => {  1 } ,
            _ => {
            match Bytes::address_eq(a, string_back_addr()) {
              1 => {  1 } ,
              _ => {
              match Bytes::address_eq(a, string_legacy_back_addr()) {
                1 => {  1 } ,
                _ => {
                match Bytes::address_eq(a, string_to_byte_array_addr()) {
                  1 => {  1 } ,
                  _ => {
                  match Bytes::address_eq(a, string_dec_eq_addr()) {
                    1 => {  1 } ,
                    _ => {  0 } ,
                  } } ,
                } } ,
              } } ,
            } } ,
          } } ,
        } } ,
      }
    }

  fn try_str_dispatch(head_addr: Bytes::AddressRef, spine: Lists::List<KernelTypes::KExpr>,
                            types: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr) {
      let spine_len = Lists::length(spine);
      match Bytes::address_eq(head_addr, string_of_list_addr()) {
        1 => {
          match spine_len {
            1 => {
              match walk_char_list_bytes(Lists::lookup(spine, 0), types) {
                (1, bs) => {  (1, (&(KernelTypes::KExprNode::Lit(KernelTypes::KLiteral::Str(bs))))) } ,
                (0, _) => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
              } } ,
            _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
          } } ,
        _ => {
      match Bytes::address_eq(head_addr, string_utf8_byte_size_addr()) {
        1 => {
          match UInt32::less_than_fields(spine_len, 1) {
            1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
            _ => {
              let a0 = Lists::lookup(spine, 0);
              match (*(a0)) {
                KernelTypes::KExprNode::Lit(lit) => {
                  match lit {
                    KernelTypes::KLiteral::Str(bs) => {

                      let limbs = klimbs_from_g(Lists::length(bs));
                      (1, (&(KernelTypes::KExprNode::Lit(KernelTypes::KLiteral::Nat(limbs))))) } ,
                    _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                  } } ,
                _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
              } } ,
          } } ,
        _ => {
      match Bytes::address_eq(head_addr, string_back_addr()) {
        1 => {  try_str_back(spine) } ,
        _ => {
      match Bytes::address_eq(head_addr, string_legacy_back_addr()) {
        1 => {  try_str_back(spine) } ,
        _ => {
      match Bytes::address_eq(head_addr, string_to_byte_array_addr()) {
        1 => {  try_str_to_byte_array(spine) } ,
        _ => {
      match Bytes::address_eq(head_addr, string_dec_eq_addr()) {
        1 => {  KernelInfer::try_str_dec_eq(head_addr, spine, types) } ,
        _ => {
          match Bytes::address_eq(head_addr, string_append_addr()) {
            1 => {
              match UInt32::less_than_fields(spine_len, 2) {
                1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                _ => {
                  let a0 = Lists::lookup(spine, 0);
                  let a1 = Lists::lookup(spine, 1);
                  match (*(a0)) {
                    KernelTypes::KExprNode::Lit(la) => {
                      match la {
                        KernelTypes::KLiteral::Str(sa) => {
                          match (*(a1)) {
                            KernelTypes::KExprNode::Lit(lb) => {
                              match lb {
                                KernelTypes::KLiteral::Str(sb) => {
                                  let joined = Lists::concat(sa, sb);
                                  (1, (&(KernelTypes::KExprNode::Lit(KernelTypes::KLiteral::Str(joined))))) } ,
                                _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                              } } ,
                            _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                          } } ,
                        _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                      } } ,
                    _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                  } } ,
              } } ,
            _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
          } } ,
      } } ,
      } } ,
      } } ,
      } } ,
      } } ,
      }
    }

  fn try_str_back(spine: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr) {
      match UInt32::less_than_fields(Lists::length(spine), 1) {
        1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
        _ => {
          match (*(Lists::lookup(spine, 0))) {
            KernelTypes::KExprNode::Lit(lit) => {
              match lit {
                KernelTypes::KLiteral::Str(bs) => {
                  let cp = utf8_last_codepoint(bs);
                  let cp_limbs = klimbs_from_g(cp);
                  let cp_lit = (&(KernelTypes::KExprNode::Lit(KernelTypes::KLiteral::Nat(cp_limbs))));
                  let con = (&(KernelTypes::KExprNode::Const(char_of_nat_addr(),
                                                   (&(Lists::Node::Nil)))));
                  (1, (&(KernelTypes::KExprNode::App(con, cp_lit)))) } ,
                _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
              } } ,
            _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
          } } ,
      }
    }

  fn try_str_to_byte_array(spine: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr) {
      match UInt32::less_than_fields(Lists::length(spine), 1) {
        1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
        _ => {
          match (*(Lists::lookup(spine, 0))) {
            KernelTypes::KExprNode::Lit(lit) => {
              match lit {
                KernelTypes::KLiteral::Str(bs) => {
                  match (*(bs)) {
                    Lists::Node::Nil => {
                      (1, (&(KernelTypes::KExprNode::Const(byte_array_empty_addr(),
                                                  (&(Lists::Node::Nil)))))) } ,
                    _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                  } } ,
                _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
              } } ,
            _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
          } } ,
      }
    }

  fn utf8_validate(bs: Bytes::Stream) -> () {
      match (*(bs)) {
        Lists::Node::Nil => {  () } ,
        Lists::Node::Cons(b0, rest) => {
          match utf8_decode_one(b0, rest) {
            (_, remaining) => {  utf8_validate(remaining) } ,
          } } ,
      }
    }

  fn utf8_last_codepoint(bs: Bytes::Stream) -> Field {
      utf8_last_go(bs, 65)
    }

  fn utf8_last_go(bs: Bytes::Stream, prev: Field) -> Field {
      match (*(bs)) {
        Lists::Node::Nil => {  prev } ,
        Lists::Node::Cons(b0, rest) => {
          match utf8_decode_one(b0, rest) {
            (cp, remaining) => {  utf8_last_go(remaining, cp) } ,
          } } ,
      }
    }

  fn utf8_cont(b: UInt8::U8) -> Field {
      match UInt8::less_than(b, UInt8::BYTE_128) {
        0 => {
          match UInt8::less_than(b, UInt8::BYTE_192) {
            1 => {  UInt8::to_field(b) - 128 } ,
          } } ,
      }
    }

  fn utf8_decode_one(b0: UInt8::U8, rest: Bytes::Stream) -> (Field, Bytes::Stream) {
      match UInt8::less_than(b0, UInt8::BYTE_128) {
        1 => {  (UInt8::to_field(b0), rest) } ,
        _ => {

          match UInt8::less_than(b0, UInt8::BYTE_194) {
            0 => {
              match UInt8::less_than(b0, UInt8::BYTE_224) {
                1 => {
                  match (*(rest)) {
                    Lists::Node::Cons(b1, r1) => {

                      let cp = (UInt8::to_field(b0) - 192) * 64 + utf8_cont(b1);
                      (cp, r1) } ,
                  } } ,
                _ => {
                  match UInt8::less_than(b0, UInt8::BYTE_240) {
                    1 => {
                      match (*(rest)) {
                        Lists::Node::Cons(b1, r1) => {
                          match (*(r1)) {
                            Lists::Node::Cons(b2, r2) => {
                              let cp = (UInt8::to_field(b0) - 224) * 4096
                                     + utf8_cont(b1) * 64
                                     + utf8_cont(b2);

                              match UInt32::less_than_fields(cp, 2048) {
                                0 => {  (cp, r2) } ,
                              } } ,
                          } } ,
                      } } ,
                    _ => {
                      match (*(rest)) {
                        Lists::Node::Cons(b1, r1) => {
                          match (*(r1)) {
                            Lists::Node::Cons(b2, r2) => {
                              match (*(r2)) {
                                Lists::Node::Cons(b3, r3) => {
                                  let cp = (UInt8::to_field(b0) - 240) * 262144
                                         + utf8_cont(b1) * 4096
                                         + utf8_cont(b2) * 64
                                         + utf8_cont(b3);

                                  match UInt32::less_than_fields(cp, 65536) {
                                    0 => {  (cp, r3) } ,
                                  } } ,
                              } } ,
                          } } ,
                      } } ,
                  } } ,
              } } ,
          } } ,
      }
    }

  fn str_lit_to_ctor(bs: Bytes::Stream) -> KernelTypes::KExpr {
      let zero_lvl = (&(KernelTypes::KLevelNode::Zero));
      let ulvls = (&(Lists::Node::Cons(zero_lvl, (&(Lists::Node::Nil)))));
      let nil_const = (&(KernelTypes::KExprNode::Const(list_nil_addr(), ulvls)));
      let cons_const = (&(KernelTypes::KExprNode::Const(list_cons_addr(), ulvls)));
      let char_const = (&(KernelTypes::KExprNode::Const(char_type_addr(), (&(Lists::Node::Nil)))));
      let con_const = (&(KernelTypes::KExprNode::Const(char_of_nat_addr(), (&(Lists::Node::Nil)))));
      let str_const = (&(KernelTypes::KExprNode::Const(string_of_list_addr(), (&(Lists::Node::Nil)))));
      let nil_app = (&(KernelTypes::KExprNode::App(nil_const, char_const)));
      let cons_partial = (&(KernelTypes::KExprNode::App(cons_const, char_const)));
      let list_expr = build_char_list(bs, nil_app, cons_partial, con_const);
      (&(KernelTypes::KExprNode::App(str_const, list_expr)))
    }

  fn build_char_list(bs: Bytes::Stream, nil_app: KernelTypes::KExpr,
                           cons_partial: KernelTypes::KExpr, con_const: KernelTypes::KExpr) -> KernelTypes::KExpr {
      match (*(bs)) {
        Lists::Node::Nil => {  nil_app } ,
        Lists::Node::Cons(b0, rest) => {
          match utf8_decode_one(b0, rest) {
            (cp, remaining) => {
              let cp_limbs = klimbs_from_g(cp);
              let cp_lit = (&(KernelTypes::KExprNode::Lit(KernelTypes::KLiteral::Nat(cp_limbs))));
              let char_val = (&(KernelTypes::KExprNode::App(con_const, cp_lit)));
              let with_head = (&(KernelTypes::KExprNode::App(cons_partial, char_val)));
              let tail = build_char_list(remaining, nil_app, cons_partial, con_const);
              (&(KernelTypes::KExprNode::App(with_head, tail))) } ,
          } } ,
      }
    }

  fn str_lit_delta_step(expanded: KernelTypes::KExpr, types: Lists::List<KernelTypes::KExpr>) -> KernelTypes::KExpr {
      match (*(expanded)) {
        KernelTypes::KExprNode::App(f, list_arg) => {
          match (*(f)) {
            KernelTypes::KExprNode::Const(caddr, _) => {
              let ci = (*(Ingress::get_ci(caddr)));
              match ci {
                KernelTypes::KConstantInfo::Defn(_, _, value, _, _) => {
                  let body = KernelLevels::expr_inst_levels(value, (&(Lists::Node::Nil)));
                  match (*(body)) {
                    KernelTypes::KExprNode::Lam(_, lam_body) => {
                      KernelWhnf::whnf_nd(KernelSubst::expr_inst1(lam_body, list_arg, 0), types) } ,
                    _ => {  KernelWhnf::whnf_nd((&(KernelTypes::KExprNode::App(body, list_arg))), types) } ,
                  } } ,
                _ => {  expanded } ,
              } } ,
            _ => {  expanded } ,
          } } ,
        _ => {  expanded } ,
      }
    }

  fn str_lit_to_ctor_app_or_self(e: KernelTypes::KExpr, types: Lists::List<KernelTypes::KExpr>) -> KernelTypes::KExpr {
      match (*(e)) {
        KernelTypes::KExprNode::Lit(lit) => {
          match lit {
            KernelTypes::KLiteral::Str(bs) => {  str_lit_delta_step(str_lit_to_ctor(bs), types) } ,
            _ => {  e } ,
          } } ,
        _ => {  e } ,
      }
    }

  fn split_u32(x: Field) -> (Field, Field, Field, Field) {
      match KernelKlimbs::divmod_256(x, 0) {
        (b0, q1) => {
          match KernelKlimbs::divmod_256(q1, 0) {
            (b1, q2) => {
              match KernelKlimbs::divmod_256(q2, 0) {
                (b2, q3) => {
                  match KernelKlimbs::divmod_256(q3, 0) {
                    (b3, _) => {  (b0, b1, b2, b3) } ,
                  } } ,
              } } ,
          } } ,
      }
    }

  fn klimbs_from_g(x: Field) -> KernelTypes::KLimbs {
      match split_u32(x) {
        (rb0, rb1, rb2, rb3) => {
          let b0 = UInt8::from_field(rb0);
          let b1 = UInt8::from_field(rb1);
          let b2 = UInt8::from_field(rb2);
          let b3 = UInt8::from_field(rb3);

          constrain_eq!(x, UInt8::to_field(b0) + 256 * UInt8::to_field(b1)
                     + 65536 * UInt8::to_field(b2) + 16777216 * UInt8::to_field(b3),
            "u32 byte split does not recompose to the original value");

          KernelKlimbs::klimbs_normalize((&(Lists::Node::Cons(
            [b0, b1, b2, b3, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil)))))) } ,
      }
    }

  fn walk_char_list_bytes(list: KernelTypes::KExpr, types: Lists::List<KernelTypes::KExpr>)
                                -> (Field, Bytes::Stream) {
      let w = KernelWhnf::whnf(list, types);
      match KernelTypes::collect_spine(w) {
        (head, args) => {
          match (*(head)) {
            KernelTypes::KExprNode::Const(caddr, _) => {
              match Bytes::address_eq(caddr, list_nil_addr()) {
                1 => {
                  match Lists::length(args) {
                    1 => {  (1, (&(Lists::Node::Nil))) } ,
                    _ => {  (0, (&(Lists::Node::Nil))) } ,
                  } } ,
                _ => {
                  match Bytes::address_eq(caddr, list_cons_addr()) {
                    0 => {  (0, (&(Lists::Node::Nil))) } ,
                    _ => {
                      match Lists::length(args) {
                        3 => {
                          match char_lit_codepoint(Lists::lookup(args, 1), types) {
                            (0, _) => {  (0, (&(Lists::Node::Nil))) } ,
                            (1, cp) => {
                              match walk_char_list_bytes(Lists::lookup(args, 2), types) {
                                (0, t) => {  (0, t) } ,
                                (1, t) => {  (1, utf8_encode_prepend(cp, t)) } ,
                              } } ,
                          } } ,
                        _ => {  (0, (&(Lists::Node::Nil))) } ,
                      } } ,
                  } } ,
              } } ,
            _ => {  (0, (&(Lists::Node::Nil))) } ,
          } } ,
      }
    }

  fn char_lit_codepoint(e: KernelTypes::KExpr, types: Lists::List<KernelTypes::KExpr>) -> (Field, Field) {
      match char_lit_codepoint_syn(e) {
        (1, cp) => {  (1, cp) } ,
        _ => {
          let w = KernelWhnf::whnf(e, types);
          char_lit_codepoint_syn(w) } ,
      }
    }

  fn char_lit_codepoint_syn(e: KernelTypes::KExpr) -> (Field, Field) {
      match (*(e)) {
        KernelTypes::KExprNode::App(f, arg) => {
          match (*(f)) {
            KernelTypes::KExprNode::Const(caddr, _) => {
              match Bytes::address_eq(caddr, char_of_nat_addr()) {
                0 => {  (0, 0) } ,
                _ => {
                  match (*(arg)) {
                    KernelTypes::KExprNode::Lit(lit) => {
                      match lit {
                        KernelTypes::KLiteral::Nat(limbs) => {  klimbs_scalar_value(limbs) } ,
                        _ => {  (0, 0) } ,
                      } } ,
                    _ => {  (0, 0) } ,
                  } } ,
              } } ,
            _ => {  (0, 0) } ,
          } } ,
        _ => {  (0, 0) } ,
      }
    }

  fn klimbs_scalar_value(limbs: KernelTypes::KLimbs) -> (Field, Field) {
      match (*(limbs)) {
        Lists::Node::Cons(limb, rest) => {
          match (*(rest)) {
            Lists::Node::Nil => {
              let [b0, b1, b2, b3, b4, b5, b6, b7] = limb;
              let hi = UInt8::to_field(b3) + UInt8::to_field(b4) + UInt8::to_field(b5) + UInt8::to_field(b6) + UInt8::to_field(b7);
              match Fields::is_zero(hi) {
                0 => {  (0, 0) } ,
                _ => {
                  let cp = UInt8::to_field(b0) + UInt8::to_field(b1) * 256 + UInt8::to_field(b2) * 65536;
                  match UInt32::less_than_fields(cp, 55296) {
                    1 => {  (1, cp) } ,
                    _ => {
                      match UInt32::less_than_fields(57343, cp) {
                        0 => {  (0, 0) } ,
                        _ => {
                          match UInt32::less_than_fields(cp, 1114112) {
                            1 => {  (1, cp) } ,
                            _ => {  (0, 0) } ,
                          } } ,
                      } } ,
                  } } ,
              } } ,
            _ => {  (0, 0) } ,
          } } ,
        _ => {  (0, 0) } ,
      }
    }

  fn divmod_64u(x: Field, q: Field) -> (Field, Field) {
      match UInt32::less_than_fields(x, 64) {
        1 => {  (x, q) } ,
        _ => {  divmod_64u(x - 64, q + 1) } ,
      }
    }

  fn utf8_groups(cp: Field) -> (Field, Field, Field, Field) {
      match divmod_64u(cp, 0) {
        (g0, q1) => {
          match divmod_64u(q1, 0) {
            (g1, q2) => {
              match divmod_64u(q2, 0) {
                (g2, g3) => {  (g0, g1, g2, g3) } ,
              } } ,
          } } ,
      }
    }

  fn utf8_encode_prepend(cp: Field, tail: Bytes::Stream) -> Bytes::Stream {
      match utf8_groups(cp) {
        (g0, g1, g2, g3) => {
          let g0u = UInt8::from_field(g0);
          let g1u = UInt8::from_field(g1);
          let g2u = UInt8::from_field(g2);
          let g3u = UInt8::from_field(g3);
          let f0 = UInt8::to_field(g0u);
          let f1 = UInt8::to_field(g1u);
          let f2 = UInt8::to_field(g2u);
          let f3 = UInt8::to_field(g3u);

          assert_eq!(UInt32::less_than_fields(f0, 64), 1,
            "utf8 group 0 is not a 6-bit value");
          assert_eq!(UInt32::less_than_fields(f1, 64), 1,
            "utf8 group 1 is not a 6-bit value");
          assert_eq!(UInt32::less_than_fields(f2, 64), 1,
            "utf8 group 2 is not a 6-bit value");
          assert_eq!(UInt32::less_than_fields(f3, 64), 1,
            "utf8 group 3 is not a 6-bit value");
          assert_eq!(cp, f0 + f1 * 64 + f2 * 4096 + f3 * 262144,
            "utf8 groups do not recompose to the codepoint");
          match UInt32::less_than_fields(cp, 128) {
            1 => {  (&(Lists::Node::Cons(UInt8::from_field(cp), tail))) } ,
            _ => {
              match UInt32::less_than_fields(cp, 2048) {
                1 => {
                  let t1 = UInt8::from_field(f0 + 128);
                  let l1 = UInt8::from_field(f1 + 192);
                  (&(Lists::Node::Cons(l1, (&(Lists::Node::Cons(t1, tail)))))) } ,
                _ => {
                  match UInt32::less_than_fields(cp, 65536) {
                    1 => {
                      let t2 = UInt8::from_field(f0 + 128);
                      let t1 = UInt8::from_field(f1 + 128);
                      let l2 = UInt8::from_field(f2 + 224);
                      (&(Lists::Node::Cons(l2, (&(Lists::Node::Cons(t1, (&(Lists::Node::Cons(t2, tail))))))))) } ,
                    _ => {
                      let t3 = UInt8::from_field(f0 + 128);
                      let t2 = UInt8::from_field(f1 + 128);
                      let t1 = UInt8::from_field(f2 + 128);
                      let l3 = UInt8::from_field(f3 + 240);
                      (&(Lists::Node::Cons(l3, (&(Lists::Node::Cons(t1, (&(Lists::Node::Cons(t2, (&(Lists::Node::Cons(t3, tail)))))))))))) } ,
                  } } ,
              } } ,
          } } ,
      }
    }

  inline fn is_nat_prim_addr(a: Bytes::AddressRef) -> Field {
      match Bytes::address_eq(a, nat_succ_addr()) {
        1 => {  1 } ,
        _ => {
        match Bytes::address_eq(a, nat_pred_addr()) {
          1 => {  1 } ,
          _ => {
          match Bytes::address_eq(a, nat_add_addr()) {
            1 => {  1 } ,
            _ => {
            match Bytes::address_eq(a, nat_sub_addr()) {
              1 => {  1 } ,
              _ => {
              match Bytes::address_eq(a, nat_mul_addr()) {
                1 => {  1 } ,
                _ => {
                match Bytes::address_eq(a, nat_div_addr()) {
                  1 => {  1 } ,
                  _ => {
                  match Bytes::address_eq(a, nat_mod_addr()) {
                    1 => {  1 } ,
                    _ => {
                    match Bytes::address_eq(a, nat_pow_addr()) {
                      1 => {  1 } ,
                      _ => {
                      match Bytes::address_eq(a, nat_gcd_addr()) {
                        1 => {  1 } ,
                        _ => {
                        match Bytes::address_eq(a, nat_beq_addr()) {
                          1 => {  1 } ,
                          _ => {
                          match Bytes::address_eq(a, nat_ble_addr()) {
                            1 => {  1 } ,
                            _ => {
                            match Bytes::address_eq(a, nat_land_addr()) {
                              1 => {  1 } ,
                              _ => {
                              match Bytes::address_eq(a, nat_lor_addr()) {
                                1 => {  1 } ,
                                _ => {
                                match Bytes::address_eq(a, nat_xor_addr()) {
                                  1 => {  1 } ,
                                  _ => {
                                  match Bytes::address_eq(a, nat_shift_left_addr()) {
                                    1 => {  1 } ,
                                    _ => {
                                    match Bytes::address_eq(a, nat_shift_right_addr()) {
                                      1 => {  1 } ,
                                      _ => {  0 } ,
                                    } } ,
                                  } } ,
                                } } ,
                              } } ,
                            } } ,
                          } } ,
                        } } ,
                      } } ,
                    } } ,
                  } } ,
                } } ,
              } } ,
            } } ,
          } } ,
        } } ,
      }
    }

  fn is_int_prim_addr(a: Bytes::AddressRef) -> Field {
      Bytes::address_eq(a, int_add_addr()) + Bytes::address_eq(a, int_sub_addr())
        + Bytes::address_eq(a, int_mul_addr()) + Bytes::address_eq(a, int_neg_addr())
        + Bytes::address_eq(a, int_emod_addr()) + Bytes::address_eq(a, int_ediv_addr())
        + Bytes::address_eq(a, int_bmod_addr()) + Bytes::address_eq(a, int_bdiv_addr())
        + Bytes::address_eq(a, int_nat_abs_addr()) + Bytes::address_eq(a, int_pow_addr())
    }

  fn try_extract_nat(e: KernelTypes::KExpr) -> (Field, KernelTypes::KLimbs) {
      match (*(e)) {
        KernelTypes::KExprNode::Lit(lit) => {
          match lit {
            KernelTypes::KLiteral::Nat(limbs) => {  (1, limbs) } ,
            _ => {  (0, (&(Lists::Node::Nil))) } ,
          } } ,
        KernelTypes::KExprNode::Const(caddr, _) => {
          match Bytes::address_eq(caddr, nat_zero_addr()) {
            1 => {  (1, (&(Lists::Node::Nil))) } ,
            _ => {  (0, (&(Lists::Node::Nil))) } ,
          } } ,
        KernelTypes::KExprNode::App(f, a) => {  try_extract_nat_app(f, a) } ,
        _ => {  (0, (&(Lists::Node::Nil))) } ,
      }
    }

  fn try_extract_nat_app(f: KernelTypes::KExpr, a: KernelTypes::KExpr) -> (Field, KernelTypes::KLimbs) {
      match (*(f)) {
        KernelTypes::KExprNode::Const(caddr, _) => {
          match Bytes::address_eq(caddr, nat_succ_addr()) {
            1 => {
              match try_extract_nat(a) {
                (1, pred_limbs) => {  (1, KernelKlimbs::klimbs_succ(pred_limbs)) } ,
                _ => {  (0, (&(Lists::Node::Nil))) } ,
              } } ,
            _ => {  (0, (&(Lists::Node::Nil))) } ,
          } } ,
        _ => {  (0, (&(Lists::Node::Nil))) } ,
      }
    }

  fn mk_nat_lit(n: KernelTypes::KLimbs) -> KernelTypes::KExpr {
      (&(KernelTypes::KExprNode::Lit(KernelTypes::KLiteral::Nat(n))))
    }

  fn try_extract_int_prim(e: KernelTypes::KExpr) -> (Field, Field, KernelTypes::KLimbs) {
      match (*(e)) {
        KernelTypes::KExprNode::App(f, a) => {  match (*(f)) {
          KernelTypes::KExprNode::Const(caddr, _) => {  match try_extract_nat(a) {
            (1, n) => {  match Bytes::address_eq(caddr, int_of_nat_addr()) {
              1 => {  (1, 0, KernelKlimbs::klimbs_normalize(n)) } ,
              _ => {  match Bytes::address_eq(caddr, int_neg_succ_addr()) {
                1 => {  (1, 1, KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_succ(n))) } ,
                _ => {  (0, 0, (&(Lists::Node::Nil))) } ,
              } } ,
            } } ,
            _ => {  (0, 0, (&(Lists::Node::Nil))) } ,
          } } ,
          _ => {  (0, 0, (&(Lists::Node::Nil))) } ,
        } } ,
        _ => {  (0, 0, (&(Lists::Node::Nil))) } ,
      }
    }

  fn mk_int_prim(sign: Field, magnitude: KernelTypes::KLimbs) -> KernelTypes::KExpr {
      let mag = KernelKlimbs::klimbs_normalize(magnitude);
      let neg = sign * (1 - KernelKlimbs::klimbs_is_zero(mag));
      let caddr = match neg { 0 => {  int_of_nat_addr() } , _ => {  int_neg_succ_addr() } , };
      let arg = match neg { 0 => {  mag } , _ => {  KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_dec(mag)) } , };
      (&(KernelTypes::KExprNode::App((&(KernelTypes::KExprNode::Const(caddr, (&(Lists::Node::Nil))))), mk_nat_lit(arg))))
    }

  fn int_add_prim(sa: Field, a: KernelTypes::KLimbs, sb: Field, b: KernelTypes::KLimbs) -> KernelTypes::KExpr {
      match sa - sb {
        0 => {  mk_int_prim(sa, KernelKlimbs::klimbs_add(a, b)) } ,
        _ => {  match KernelKlimbs::klimbs_le(a, b) {
          1 => {  mk_int_prim(sb, KernelKlimbs::klimbs_sub(b, a)) } ,
          _ => {  mk_int_prim(sa, KernelKlimbs::klimbs_sub(a, b)) } ,
        } } ,
      }
    }

  fn int_emod_prim(sa: Field, a: KernelTypes::KLimbs, b: KernelTypes::KLimbs) -> KernelTypes::KExpr {
      match KernelKlimbs::klimbs_is_zero(b) {
        1 => {  mk_int_prim(sa, a) } ,
        _ => {
          let r0 = KernelKlimbs::klimbs_mod(a, b);
          match sa * (1 - KernelKlimbs::klimbs_is_zero(r0)) {
            1 => {  mk_int_prim(0, KernelKlimbs::klimbs_sub(b, r0)) } ,
            _ => {  mk_int_prim(0, r0) } ,
          } } ,
      }
    }

  fn int_ediv_prim(sa: Field, a: KernelTypes::KLimbs, sb: Field, b: KernelTypes::KLimbs) -> KernelTypes::KExpr {
      match KernelKlimbs::klimbs_is_zero(b) {
        1 => {  mk_int_prim(0, (&(Lists::Node::Nil))) } ,
        _ => {
          let q0 = KernelKlimbs::klimbs_div(a, b);
          let r0 = KernelKlimbs::klimbs_mod(a, b);
          let q = match sa * (1 - KernelKlimbs::klimbs_is_zero(r0)) {
            1 => {  KernelKlimbs::klimbs_succ(q0) } ,
            _ => {  q0 } ,
          };
          mk_int_prim((sa + sb - 2 * sa * sb) * (1 - KernelKlimbs::klimbs_is_zero(q)), q) } ,
      }
    }

  fn int_bmod_prim(sa: Field, a: KernelTypes::KLimbs, m: KernelTypes::KLimbs) -> KernelTypes::KExpr {
      match KernelKlimbs::klimbs_is_zero(m) {
        1 => {  mk_int_prim(sa, a) } ,
        _ => {
          let r0 = KernelKlimbs::klimbs_mod(a, m);
          let r = match sa * (1 - KernelKlimbs::klimbs_is_zero(r0)) {
            1 => {  KernelKlimbs::klimbs_sub(m, r0) } ,
            _ => {  r0 } ,
          };
          let two = (&(Lists::Node::Cons([UInt8::BYTE_2, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil)))));
          let half = KernelKlimbs::klimbs_div(KernelKlimbs::klimbs_succ(m), two);
          match KernelKlimbs::klimbs_le(half, r) {
            1 => {  mk_int_prim(1, KernelKlimbs::klimbs_sub(m, r)) } ,
            _ => {  mk_int_prim(0, r) } ,
          } } ,
      }
    }

  fn int_bdiv_prim(sa: Field, a: KernelTypes::KLimbs, m: KernelTypes::KLimbs) -> KernelTypes::KExpr {
      match KernelKlimbs::klimbs_is_zero(m) {
        1 => {  mk_int_prim(0, (&(Lists::Node::Nil))) } ,
        _ => {
          let r0 = KernelKlimbs::klimbs_mod(a, m);
          let r = match sa * (1 - KernelKlimbs::klimbs_is_zero(r0)) {
            1 => {  KernelKlimbs::klimbs_sub(m, r0) } ,
            _ => {  r0 } ,
          };
          let q0 = KernelKlimbs::klimbs_div(a, m);
          let qmag = match sa * (1 - KernelKlimbs::klimbs_is_zero(r0)) { 1 => {  KernelKlimbs::klimbs_succ(q0) } , _ => {  q0 } , };
          let qsign = sa * (1 - KernelKlimbs::klimbs_is_zero(qmag));
          let two = (&(Lists::Node::Cons([UInt8::BYTE_2, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil)))));
          let half = KernelKlimbs::klimbs_div(KernelKlimbs::klimbs_succ(m), two);
          match KernelKlimbs::klimbs_le(half, r) {
            0 => {  mk_int_prim(qsign, qmag) } ,
            _ => {  int_add_prim(qsign, qmag, 0,
              (&(Lists::Node::Cons([UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil)))))) } ,
          } } ,
      }
    }

  fn try_int_prim_dispatch(head_addr: Bytes::AddressRef, spine: Lists::List<KernelTypes::KExpr>,
                                  types: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr) {
      let sw = KernelWhnf::whnf_spine(spine, types);
      let n = Lists::length(sw);
      let unary = Bytes::address_eq(head_addr, int_neg_addr()) + Bytes::address_eq(head_addr, int_nat_abs_addr());
      match unary {
        1 => {  match UInt32::less_than_fields(n, 1) {
          1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
          _ => {  match try_extract_int_prim(Lists::lookup(sw, 0)) {
            (1, s, a) => {
              let v = match Bytes::address_eq(head_addr, int_nat_abs_addr()) {
                1 => {  mk_nat_lit(a) } ,
                _ => {  mk_int_prim((1 - s) * (1 - KernelKlimbs::klimbs_is_zero(a)), a) } ,
              };
              (1, np_apply_spine(v, Lists::drop(sw, 1))) } ,
            _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
          } } ,
        } } ,
        _ => {  match UInt32::less_than_fields(n, 2) {
          1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
          _ => {  match try_extract_int_prim(Lists::lookup(sw, 0)) {
            (1, sa, a) => {  try_int_prim_second(head_addr, sw, sa, a) } ,
            _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
          } } ,
        } } ,
      }
    }

  fn try_int_prim_second(head_addr: Bytes::AddressRef, sw: Lists::List<KernelTypes::KExpr>,
                                sa: Field, a: KernelTypes::KLimbs) -> (Field, KernelTypes::KExpr) {
      let rhs_nat = Bytes::address_eq(head_addr, int_bmod_addr())
        + Bytes::address_eq(head_addr, int_bdiv_addr()) + Bytes::address_eq(head_addr, int_pow_addr());
      match rhs_nat {
        1 => {  match try_extract_nat(Lists::lookup(sw, 1)) {
          (1, b) => {
            let v = match Bytes::address_eq(head_addr, int_bmod_addr()) {
              1 => {  int_bmod_prim(sa, a, b) } ,
              _ => {  match Bytes::address_eq(head_addr, int_bdiv_addr()) {
                1 => {  int_bdiv_prim(sa, a, b) } ,
                _ => {
                  let two = (&(Lists::Node::Cons([UInt8::BYTE_2, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil)))));
                  let odd = 1 - KernelKlimbs::klimbs_is_zero(KernelKlimbs::klimbs_mod(b, two));
                  mk_int_prim(sa * odd, KernelKlimbs::klimbs_pow(a, b)) } ,
              } } ,
            };
            (1, np_apply_spine(v, Lists::drop(sw, 2))) } ,
          _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
        } } ,
        _ => {  match try_extract_int_prim(Lists::lookup(sw, 1)) {
          (1, sb, b) => {
            let v = match Bytes::address_eq(head_addr, int_add_addr()) {
              1 => {  int_add_prim(sa, a, sb, b) } ,
              _ => {  match Bytes::address_eq(head_addr, int_sub_addr()) {
                1 => {  int_add_prim(sa, a, (1 - sb) * (1 - KernelKlimbs::klimbs_is_zero(b)), b) } ,
                _ => {  match Bytes::address_eq(head_addr, int_mul_addr()) {
                  1 => {  mk_int_prim((sa + sb - 2 * sa * sb)
                    * (1 - KernelKlimbs::klimbs_is_zero(a)) * (1 - KernelKlimbs::klimbs_is_zero(b)), KernelKlimbs::klimbs_mul(a, b)) } ,
                  _ => {  match Bytes::address_eq(head_addr, int_emod_addr()) {
                    1 => {  int_emod_prim(sa, a, b) } ,
                    _ => {  int_ediv_prim(sa, a, sb, b) } ,
                  } } ,
                } } ,
              } } ,
            };
            (1, np_apply_spine(v, Lists::drop(sw, 2))) } ,
          _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
        } } ,
      }
    }

  fn np_apply_spine(head: KernelTypes::KExpr, spine: Lists::List<KernelTypes::KExpr>) -> KernelTypes::KExpr {
      match (*(spine)) {
        Lists::Node::Nil => {  head } ,
        Lists::Node::Cons(a, rest) => {
          np_apply_spine((&(KernelTypes::KExprNode::App(head, a))), rest) } ,
      }
    }

  fn try_nat_binop_addr(head_addr: Bytes::AddressRef, a: KernelTypes::KLimbs, b: KernelTypes::KLimbs) -> (Field, KernelTypes::KExpr) {
      match Bytes::address_eq(head_addr, nat_add_addr()) {
        1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_add(a, b)))) } ,
        _ => {
        match Bytes::address_eq(head_addr, nat_sub_addr()) {
          1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_sub(a, b)))) } ,
          _ => {
          match Bytes::address_eq(head_addr, nat_mul_addr()) {
            1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_mul(a, b)))) } ,
            _ => {
            match Bytes::address_eq(head_addr, nat_div_addr()) {
              1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_div(a, b)))) } ,
              _ => {
              match Bytes::address_eq(head_addr, nat_mod_addr()) {
                1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_mod(a, b)))) } ,
                _ => {
                match Bytes::address_eq(head_addr, nat_gcd_addr()) {
                  1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_gcd(a, b)))) } ,
                  _ => {
                  match Bytes::address_eq(head_addr, nat_pow_addr()) {
                    1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_pow(a, b)))) } ,
                    _ => {
                    match Bytes::address_eq(head_addr, nat_land_addr()) {
                      1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_land(a, b)))) } ,
                      _ => {
                      match Bytes::address_eq(head_addr, nat_lor_addr()) {
                        1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_lor(a, b)))) } ,
                        _ => {
                        match Bytes::address_eq(head_addr, nat_xor_addr()) {
                          1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_xor_op(a, b)))) } ,
                          _ => {
                          match Bytes::address_eq(head_addr, nat_shift_left_addr()) {
                            1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_shl(a, b)))) } ,
                            _ => {
                            match Bytes::address_eq(head_addr, nat_shift_right_addr()) {
                              1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_shr(a, b)))) } ,
                              _ => {
                              match Bytes::address_eq(head_addr, nat_beq_addr()) {
                                1 => {  (1, mk_bool(KernelLevels::klimbs_eq(a, b))) } ,
                                _ => {
                                match Bytes::address_eq(head_addr, nat_ble_addr()) {
                                  1 => {  (1, mk_bool(KernelKlimbs::klimbs_le(a, b))) } ,
                                  _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                                } } ,
                              } } ,
                            } } ,
                          } } ,
                        } } ,
                      } } ,
                    } } ,
                  } } ,
                } } ,
              } } ,
            } } ,
          } } ,
        } } ,
      }
    }

  fn try_match_nat_add(head: KernelTypes::KExpr, args: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr, KernelTypes::KLimbs) {
      match (*(head)) {
        KernelTypes::KExprNode::Const(caddr, _) => {
          match Bytes::address_eq(caddr, nat_add_addr()) {
            0 => {  (0, head, (&(Lists::Node::Nil))) } ,
            _ => {
              match Lists::length(args) - 2 {
                0 => {
                  let lhs = Lists::lookup(args, 0);
                  let rhs = Lists::lookup(args, 1);
                  match (*(rhs)) {
                    KernelTypes::KExprNode::Lit(lit) => {
                      match lit {
                        KernelTypes::KLiteral::Nat(limbs) => {  (1, lhs, limbs) } ,
                        _ => {  (0, head, (&(Lists::Node::Nil))) } ,
                      } } ,
                    _ => {  (0, head, (&(Lists::Node::Nil))) } ,
                  } } ,
                _ => {  (0, head, (&(Lists::Node::Nil))) } ,
              } } ,
          } } ,
        _ => {  (0, head, (&(Lists::Node::Nil))) } ,
      }
    }

  fn build_succ_offset(base: KernelTypes::KExpr, lit: KernelTypes::KLimbs) -> KernelTypes::KExpr {
      let one = (&(Lists::Node::Cons([UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0],
                                    (&(Lists::Node::Nil)))));
      let pred_lit_norm = KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_sub(lit, one));
      let succ_const = (&(KernelTypes::KExprNode::Const(nat_succ_addr(), (&(Lists::Node::Nil)))));
      match KernelKlimbs::klimbs_is_zero(pred_lit_norm) {
        1 => {  (&(KernelTypes::KExprNode::App(succ_const, base))) } ,
        _ => {
          let add_const = (&(KernelTypes::KExprNode::Const(nat_add_addr(), (&(Lists::Node::Nil)))));
          let pred_lit_expr = (&(KernelTypes::KExprNode::Lit(KernelTypes::KLiteral::Nat(pred_lit_norm))));
          let pred = (&(KernelTypes::KExprNode::App(
            (&(KernelTypes::KExprNode::App(add_const, base))),
            pred_lit_expr)));
          (&(KernelTypes::KExprNode::App(succ_const, pred))) } ,
      }
    }

  fn cleanup_nat_offset_major(e: KernelTypes::KExpr) -> KernelTypes::KExpr {
      match (*(e)) {
        KernelTypes::KExprNode::Lit(_) => {  e } ,
        _ => {
          match KernelTypes::collect_spine(e) {
            (head, args) => {
              match (*(head)) {
                KernelTypes::KExprNode::Const(_, _) => {
                  match try_match_nat_add(head, args) {
                    (1, base, lit) => {
                      let lit_norm = KernelKlimbs::klimbs_normalize(lit);
                      match KernelKlimbs::klimbs_is_zero(lit_norm) {
                        1 => {  e } ,
                        _ => {  build_succ_offset(base, lit_norm) } ,
                      } } ,
                    _ => {  e } ,
                  } } ,
                _ => {  e } ,
              } } ,
          } } ,
      }
    }

  fn mk_nat_offset_stuck(base_w: KernelTypes::KExpr, n: KernelTypes::KLimbs,
                                post: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr) {
      match KernelKlimbs::klimbs_is_zero(n) {
        1 => {  (1, np_apply_spine(base_w, post)) } ,
        _ => {
          let add_const = (&(KernelTypes::KExprNode::Const(nat_add_addr(), (&(Lists::Node::Nil)))));
          let off = (&(KernelTypes::KExprNode::App(
            (&(KernelTypes::KExprNode::App(add_const, base_w))),
            mk_nat_lit(n))));
          (1, np_apply_spine(off, post)) } ,
      }
    }

  fn is_nat_succ_ih_step(step: KernelTypes::KExpr) -> Field {
      match (*(step)) {
        KernelTypes::KExprNode::Lam(_, body1) => {
          match (*(body1)) {
            KernelTypes::KExprNode::Lam(_, body2) => {
              match KernelTypes::collect_spine(body2) {
                (head, args) => {
                  match (*(head)) {
                    KernelTypes::KExprNode::Const(caddr, _) => {
                      match Bytes::address_eq(caddr, nat_succ_addr()) {
                        0 => {  0 } ,
                        _ => {
                          match Lists::length(args) - 1 {
                            0 => {
                              match (*(Lists::lookup(args, 0))) {
                                KernelTypes::KExprNode::BVar(i) => {  Fields::is_zero(i) } ,
                                _ => {  0 } ,
                              } } ,
                            _ => {  0 } ,
                          } } ,
                      } } ,
                    _ => {  0 } ,
                  } } ,
              } } ,
            _ => {  0 } ,
          } } ,
        _ => {  0 } ,
      }
    }

  fn try_nat_linear_rec(spine: Lists::List<KernelTypes::KExpr>, nparams: Field, nmotives: Field,
                               nminors: Field, major_idx: Field) -> (Field, KernelTypes::KExpr) {
      match UInt32::less_than_fields(nminors, 2) {
        1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
        _ => {
          let raw_major = Lists::lookup(spine, major_idx);
          match try_extract_nat(raw_major) {
            (0, _) => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
            (1, n_klimbs) => {
              let base_idx = nparams + nmotives;
              let step = Lists::lookup(spine, base_idx + 1);
              match is_nat_succ_ih_step(step) {
                0 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                _ => {
                  let base = Lists::lookup(spine, base_idx);
                  let post = Lists::drop(spine, major_idx + 1);
                  match try_extract_nat(base) {
                    (1, b_klimbs) => {
                      (1, np_apply_spine(mk_nat_lit(KernelKlimbs::klimbs_add(b_klimbs, n_klimbs)), post)) } ,
                    _ => {  mk_nat_offset_stuck(base, n_klimbs, post) } ,
                  } } ,
              } } ,
          } } ,
      }
    }

  inline fn try_nat_dispatch(head_addr: Bytes::AddressRef, spine: Lists::List<KernelTypes::KExpr>,
                            types: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr) {
      let spine_len = Lists::length(spine);
      let is_pred = Bytes::address_eq(head_addr, nat_pred_addr());
      let is_succ = Bytes::address_eq(head_addr, nat_succ_addr());
      match is_succ {
        1 => {
          match UInt32::less_than_fields(spine_len, 1) {
            1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
            _ => {
              let a0 = Lists::lookup(spine, 0);
              match try_extract_nat(a0) {
                (1, na) => {
                  let post = Lists::drop(spine, 1);
                  (1, np_apply_spine(mk_nat_lit(KernelKlimbs::klimbs_succ(na)), post)) } ,
                _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
              } } ,
          } } ,
        _ => {
          match is_pred {
            1 => {
              match UInt32::less_than_fields(spine_len, 1) {
                1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                _ => {
                  let a0 = Lists::lookup(spine, 0);
                  match try_extract_nat(a0) {
                    (1, na) => {
                      let post = Lists::drop(spine, 1);
                      (1, np_apply_spine(mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_dec(na))), post)) } ,
                    _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                  } } ,
              } } ,
            _ => {  try_nat_binop_dispatch(head_addr, spine, spine_len) } ,
          } } ,
      }
    }

  fn try_nat_binop_dispatch(head_addr: Bytes::AddressRef, spine: Lists::List<KernelTypes::KExpr>,
                                   spine_len: Field) -> (Field, KernelTypes::KExpr) {
      match UInt32::less_than_fields(spine_len, 2) {
        1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
        _ => {
          let a0 = Lists::lookup(spine, 0);
          let a1 = Lists::lookup(spine, 1);
          match try_extract_nat(a0) {
            (1, na) => {
              match try_extract_nat(a1) {
                (1, nb) => {
                  match try_nat_binop_addr(head_addr, na, nb) {
                    (1, result) => {
                      let post = Lists::drop(spine, 2);
                      (1, np_apply_spine(result, post)) } ,
                    _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                  } } ,
                _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
              } } ,
            _ => {

              match try_extract_nat(a1) {
                (1, nb) => {
                  try_nat_offset_dispatch(head_addr, a0, nb, spine) } ,
                _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
              } } ,
          } } ,
      }
    }

  fn try_nat_offset_dispatch(head_addr: Bytes::AddressRef, a0_w: KernelTypes::KExpr, nb: KernelTypes::KLimbs,
                                    spine: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr) {
      let is_add = Bytes::address_eq(head_addr, nat_add_addr());
      let is_divmod = Bytes::address_eq(head_addr, nat_div_addr())
        + Bytes::address_eq(head_addr, nat_mod_addr());
      let eligible =
        is_add + is_divmod * (1 - KernelKlimbs::klimbs_is_zero(nb))
          * (1 - KernelKlimbs::klimbs_is_zero(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_dec(nb))));
      match eligible {
        0 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
        _ => {
          let post = Lists::drop(spine, 2);

          match is_add {
            1 => {
              match mk_nat_offset_stuck(a0_w, nb, post) {
                (1, stuck) => {  (2, stuck) } ,
                _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
              } } ,
            _ => {  (2, mk_nat_binop_stuck(head_addr, a0_w, nb, post)) } ,
          } } ,
      }
    }

  fn mk_nat_binop_stuck(op_addr: Bytes::AddressRef, base_w: KernelTypes::KExpr, n: KernelTypes::KLimbs,
                               post: Lists::List<KernelTypes::KExpr>) -> KernelTypes::KExpr {
      let op_const = (&(KernelTypes::KExprNode::Const(op_addr, (&(Lists::Node::Nil)))));
      let stuck = (&(KernelTypes::KExprNode::App(
        (&(KernelTypes::KExprNode::App(op_const, base_w))),
        mk_nat_lit(n))));
      np_apply_spine(stuck, post)
    }
}
