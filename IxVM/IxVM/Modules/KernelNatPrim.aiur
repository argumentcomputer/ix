            Lists::Node::Nil => {
              let [b0, b1, b2, b3, b4, b5, b6, b7] = limb;
              let hi = UInt8::to_field(b3) + UInt8::to_field(b4) + UInt8::to_field(b5) + UInt8::to_field(b6) + UInt8::to_field(b7);
              match Fields::is_zero(hi) {
                0 => {  (0, 0) } ,
                _ => {
                  let cp = UInt8::to_field(b0) + UInt8::to_field(b1) * 256 + UInt8::to_field(b2) * 65536;
                  match UInt32::less_than_fields(cp, 55296) {
                    1 => {  (1, cp) } ,
                    _ => {
                      match UInt32::less_than_fields(57343, cp) {
                        0 => {  (0, 0) } ,
                        _ => {
                          match UInt32::less_than_fields(cp, 1114112) {
                            1 => {  (1, cp) } ,
                            _ => {  (0, 0) } ,
                          } } ,
                      } } ,
                  } } ,
              } } ,
            _ => {  (0, 0) } ,
          } } ,
        _ => {  (0, 0) } ,
      }
    }

  fn divmod_64u(x: Field, q: Field) -> (Field, Field) {
      match UInt32::less_than_fields(x, 64) {
        1 => {  (x, q) } ,
        _ => {  divmod_64u(x - 64, q + 1) } ,
      }
    }

  fn utf8_groups(cp: Field) -> (Field, Field, Field, Field) {
      match divmod_64u(cp, 0) {
        (g0, q1) => {
          match divmod_64u(q1, 0) {
            (g1, q2) => {
              match divmod_64u(q2, 0) {
                (g2, g3) => {  (g0, g1, g2, g3) } ,
              } } ,
          } } ,
      }
    }

  fn utf8_encode_prepend(cp: Field, tail: Bytes::Stream) -> Bytes::Stream {
      match utf8_groups(cp) {
        (g0, g1, g2, g3) => {
          let g0u = UInt8::from_field(g0);
          let g1u = UInt8::from_field(g1);
          let g2u = UInt8::from_field(g2);
          let g3u = UInt8::from_field(g3);
          let f0 = UInt8::to_field(g0u);
          let f1 = UInt8::to_field(g1u);
          let f2 = UInt8::to_field(g2u);
          let f3 = UInt8::to_field(g3u);

          assert_eq!(UInt32::less_than_fields(f0, 64), 1,
            "utf8 group 0 is not a 6-bit value");
          assert_eq!(UInt32::less_than_fields(f1, 64), 1,
            "utf8 group 1 is not a 6-bit value");
          assert_eq!(UInt32::less_than_fields(f2, 64), 1,
            "utf8 group 2 is not a 6-bit value");
          assert_eq!(UInt32::less_than_fields(f3, 64), 1,
            "utf8 group 3 is not a 6-bit value");
          assert_eq!(cp, f0 + f1 * 64 + f2 * 4096 + f3 * 262144,
            "utf8 groups do not recompose to the codepoint");
          match UInt32::less_than_fields(cp, 128) {
            1 => {  (&(Lists::Node::Cons(UInt8::from_field(cp), tail))) } ,
            _ => {
              match UInt32::less_than_fields(cp, 2048) {
                1 => {
                  let t1 = UInt8::from_field(f0 + 128);
                  let l1 = UInt8::from_field(f1 + 192);
                  (&(Lists::Node::Cons(l1, (&(Lists::Node::Cons(t1, tail)))))) } ,
                _ => {
                  match UInt32::less_than_fields(cp, 65536) {
                    1 => {
                      let t2 = UInt8::from_field(f0 + 128);
                      let t1 = UInt8::from_field(f1 + 128);
                      let l2 = UInt8::from_field(f2 + 224);
                      (&(Lists::Node::Cons(l2, (&(Lists::Node::Cons(t1, (&(Lists::Node::Cons(t2, tail))))))))) } ,
                    _ => {
                      let t3 = UInt8::from_field(f0 + 128);
                      let t2 = UInt8::from_field(f1 + 128);
                      let t1 = UInt8::from_field(f2 + 128);
                      let l3 = UInt8::from_field(f3 + 240);
                      (&(Lists::Node::Cons(l3, (&(Lists::Node::Cons(t1, (&(Lists::Node::Cons(t2, (&(Lists::Node::Cons(t3, tail)))))))))))) } ,
                  } } ,
              } } ,
          } } ,
      }
    }

  fn try_extract_nat(rc: KernelRoles::RoleCtx, e: KernelTypes::KExpr) -> (Field, KernelTypes::KLimbs) {
      match (*(e)) {
        KernelTypes::KExprNode::Lit(lit) => {
          match lit {
            KernelTypes::KLiteral::Nat(limbs) => {  (1, limbs) } ,
            _ => {  (0, (&(Lists::Node::Nil))) } ,
          } } ,
        KernelTypes::KExprNode::Const(caddr, _) => {
          match KernelRoles::role_is(rc, caddr, KernelRoleSpec::role_nat_zero()) {
            1 => {  (1, (&(Lists::Node::Nil))) } ,
            _ => {  (0, (&(Lists::Node::Nil))) } ,
          } } ,
        KernelTypes::KExprNode::App(f, a) => {  try_extract_nat_app(rc, f, a) } ,
        _ => {  (0, (&(Lists::Node::Nil))) } ,
      }
    }

  fn try_extract_nat_app(rc: KernelRoles::RoleCtx, f: KernelTypes::KExpr, a: KernelTypes::KExpr) -> (Field, KernelTypes::KLimbs) {
      match (*(f)) {
        KernelTypes::KExprNode::Const(caddr, _) => {
          match KernelRoles::role_is(rc, caddr, KernelRoleSpec::role_nat_succ()) {
            1 => {
              match try_extract_nat(rc, a) {
                (1, pred_limbs) => {  (1, KernelKlimbs::klimbs_succ(pred_limbs)) } ,
                _ => {  (0, (&(Lists::Node::Nil))) } ,
              } } ,
            _ => {  (0, (&(Lists::Node::Nil))) } ,
          } } ,
        _ => {  (0, (&(Lists::Node::Nil))) } ,
      }
    }

  fn mk_nat_lit(n: KernelTypes::KLimbs) -> KernelTypes::KExpr {
      (&(KernelTypes::KExprNode::Lit(KernelTypes::KLiteral::Nat(n))))
    }

  fn try_extract_int_prim(rc: KernelRoles::RoleCtx, e: KernelTypes::KExpr) -> (Field, Field, KernelTypes::KLimbs) {
      match (*(e)) {
        KernelTypes::KExprNode::App(f, a) => {  match (*(f)) {
          KernelTypes::KExprNode::Const(caddr, _) => {  match try_extract_nat(rc, a) {
            (1, n) => {  match KernelRoles::role_is(rc, caddr, KernelRoleSpec::role_int_of_nat()) {
              1 => {  (1, 0, KernelKlimbs::klimbs_normalize(n)) } ,
              _ => {  match KernelRoles::role_is(rc, caddr, KernelRoleSpec::role_int_neg_succ()) {
                1 => {  (1, 1, KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_succ(n))) } ,
                _ => {  (0, 0, (&(Lists::Node::Nil))) } ,
              } } ,
            } } ,
            _ => {  (0, 0, (&(Lists::Node::Nil))) } ,
          } } ,
          _ => {  (0, 0, (&(Lists::Node::Nil))) } ,
        } } ,
        _ => {  (0, 0, (&(Lists::Node::Nil))) } ,
      }
    }

  fn mk_int_prim(rc: KernelRoles::RoleCtx, sign: Field, magnitude: KernelTypes::KLimbs) -> KernelTypes::KExpr {
      let mag = KernelKlimbs::klimbs_normalize(magnitude);
      let neg = sign * (1 - KernelKlimbs::klimbs_is_zero(mag));
      let caddr = match neg {
        0 => {  KernelRoles::role_used_implicitly(rc, KernelRoleSpec::role_int_of_nat()) } ,
        _ => {  KernelRoles::role_used_implicitly(rc, KernelRoleSpec::role_int_neg_succ()) } ,
      };
      let arg = match neg { 0 => {  mag } , _ => {  KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_dec(mag)) } , };
      (&(KernelTypes::KExprNode::App((&(KernelTypes::KExprNode::Const(caddr, (&(Lists::Node::Nil))))), mk_nat_lit(arg))))
    }

  fn int_add_prim(rc: KernelRoles::RoleCtx, sa: Field, a: KernelTypes::KLimbs, sb: Field, b: KernelTypes::KLimbs) -> KernelTypes::KExpr {
      match sa - sb {
        0 => {  mk_int_prim(rc, sa, KernelKlimbs::klimbs_add(a, b)) } ,
        _ => {  match KernelKlimbs::klimbs_le(a, b) {
          1 => {  mk_int_prim(rc, sb, KernelKlimbs::klimbs_sub(b, a)) } ,
          _ => {  mk_int_prim(rc, sa, KernelKlimbs::klimbs_sub(a, b)) } ,
        } } ,
      }
    }

  fn int_emod_prim(rc: KernelRoles::RoleCtx, sa: Field, a: KernelTypes::KLimbs, b: KernelTypes::KLimbs) -> KernelTypes::KExpr {
      match KernelKlimbs::klimbs_is_zero(b) {
        1 => {  mk_int_prim(rc, sa, a) } ,
        _ => {
          let r0 = KernelKlimbs::klimbs_mod(a, b);
          match sa * (1 - KernelKlimbs::klimbs_is_zero(r0)) {
            1 => {  mk_int_prim(rc, 0, KernelKlimbs::klimbs_sub(b, r0)) } ,
            _ => {  mk_int_prim(rc, 0, r0) } ,
          } } ,
      }
    }

  fn int_ediv_prim(rc: KernelRoles::RoleCtx, sa: Field, a: KernelTypes::KLimbs, sb: Field, b: KernelTypes::KLimbs) -> KernelTypes::KExpr {
      match KernelKlimbs::klimbs_is_zero(b) {
        1 => {  mk_int_prim(rc, 0, (&(Lists::Node::Nil))) } ,
        _ => {
          let q0 = KernelKlimbs::klimbs_div(a, b);
          let r0 = KernelKlimbs::klimbs_mod(a, b);
          let q = match sa * (1 - KernelKlimbs::klimbs_is_zero(r0)) {
            1 => {  KernelKlimbs::klimbs_succ(q0) } ,
            _ => {  q0 } ,
          };
          mk_int_prim(rc, (sa + sb - 2 * sa * sb) * (1 - KernelKlimbs::klimbs_is_zero(q)), q) } ,
      }
    }

  fn int_bmod_prim(rc: KernelRoles::RoleCtx, sa: Field, a: KernelTypes::KLimbs, m: KernelTypes::KLimbs) -> KernelTypes::KExpr {
      match KernelKlimbs::klimbs_is_zero(m) {
        1 => {  mk_int_prim(rc, sa, a) } ,
        _ => {
          let r0 = KernelKlimbs::klimbs_mod(a, m);
          let r = match sa * (1 - KernelKlimbs::klimbs_is_zero(r0)) {
            1 => {  KernelKlimbs::klimbs_sub(m, r0) } ,
            _ => {  r0 } ,
          };
          let two = (&(Lists::Node::Cons([UInt8::BYTE_2, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil)))));
          let half = KernelKlimbs::klimbs_div(KernelKlimbs::klimbs_succ(m), two);
          match KernelKlimbs::klimbs_le(half, r) {
            1 => {  mk_int_prim(rc, 1, KernelKlimbs::klimbs_sub(m, r)) } ,
            _ => {  mk_int_prim(rc, 0, r) } ,
          } } ,
      }
    }

  fn int_bdiv_prim(rc: KernelRoles::RoleCtx, sa: Field, a: KernelTypes::KLimbs, m: KernelTypes::KLimbs) -> KernelTypes::KExpr {
      match KernelKlimbs::klimbs_is_zero(m) {
        1 => {  mk_int_prim(rc, 0, (&(Lists::Node::Nil))) } ,
        _ => {
          let r0 = KernelKlimbs::klimbs_mod(a, m);
          let r = match sa * (1 - KernelKlimbs::klimbs_is_zero(r0)) {
            1 => {  KernelKlimbs::klimbs_sub(m, r0) } ,
            _ => {  r0 } ,
          };
          let q0 = KernelKlimbs::klimbs_div(a, m);
          let qmag = match sa * (1 - KernelKlimbs::klimbs_is_zero(r0)) { 1 => {  KernelKlimbs::klimbs_succ(q0) } , _ => {  q0 } , };
          let qsign = sa * (1 - KernelKlimbs::klimbs_is_zero(qmag));
          let two = (&(Lists::Node::Cons([UInt8::BYTE_2, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil)))));
          let half = KernelKlimbs::klimbs_div(KernelKlimbs::klimbs_succ(m), two);
          match KernelKlimbs::klimbs_le(half, r) {
            0 => {  mk_int_prim(rc, qsign, qmag) } ,
            _ => {  int_add_prim(rc, qsign, qmag, 0,
              (&(Lists::Node::Cons([UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil)))))) } ,
          } } ,
      }
    }

  fn try_int_prim_dispatch(rc: KernelRoles::RoleCtx, head_addr: Bytes::AddressRef, spine: Lists::List<KernelTypes::KExpr>,
                                  types: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr) {
      let sw = KernelWhnf::whnf_spine(rc, spine, types);
      let n = Lists::length(sw);
      let unary = KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_int_neg()) + KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_int_nat_abs());
      match unary {
        1 => {  match UInt32::less_than_fields(n, 1) {
          1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
          _ => {  match try_extract_int_prim(rc, Lists::lookup(sw, 0)) {
            (1, s, a) => {
              let v = match KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_int_nat_abs()) {
                1 => {  mk_nat_lit(a) } ,
                _ => {  mk_int_prim(rc, (1 - s) * (1 - KernelKlimbs::klimbs_is_zero(a)), a) } ,
              };
              (1, np_apply_spine(v, Lists::drop(sw, 1))) } ,
            _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
          } } ,
        } } ,
        _ => {  match UInt32::less_than_fields(n, 2) {
          1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
          _ => {  match try_extract_int_prim(rc, Lists::lookup(sw, 0)) {
            (1, sa, a) => {  try_int_prim_second(rc, head_addr, sw, sa, a) } ,
            _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
          } } ,
        } } ,
      }
    }

  fn try_int_prim_second(rc: KernelRoles::RoleCtx, head_addr: Bytes::AddressRef, sw: Lists::List<KernelTypes::KExpr>,
                                sa: Field, a: KernelTypes::KLimbs) -> (Field, KernelTypes::KExpr) {
      let rhs_nat = KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_int_bmod())
        + KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_int_bdiv()) + KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_int_pow());
      match rhs_nat {
        1 => {  match try_extract_nat(rc, Lists::lookup(sw, 1)) {
          (1, b) => {
            let v = match KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_int_bmod()) {
              1 => {  int_bmod_prim(rc, sa, a, b) } ,
              _ => {  match KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_int_bdiv()) {
                1 => {  int_bdiv_prim(rc, sa, a, b) } ,
                _ => {
                  let two = (&(Lists::Node::Cons([UInt8::BYTE_2, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], (&(Lists::Node::Nil)))));
                  let odd = 1 - KernelKlimbs::klimbs_is_zero(KernelKlimbs::klimbs_mod(b, two));
                  mk_int_prim(rc, sa * odd, KernelKlimbs::klimbs_pow(a, b)) } ,
              } } ,
            };
            (1, np_apply_spine(v, Lists::drop(sw, 2))) } ,
          _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
        } } ,
        _ => {  match try_extract_int_prim(rc, Lists::lookup(sw, 1)) {
          (1, sb, b) => {
            let v = match KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_int_add()) {
              1 => {  int_add_prim(rc, sa, a, sb, b) } ,
              _ => {  match KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_int_sub()) {
                1 => {  int_add_prim(rc, sa, a, (1 - sb) * (1 - KernelKlimbs::klimbs_is_zero(b)), b) } ,
                _ => {  match KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_int_mul()) {
                  1 => {  mk_int_prim(rc, (sa + sb - 2 * sa * sb)
                    * (1 - KernelKlimbs::klimbs_is_zero(a)) * (1 - KernelKlimbs::klimbs_is_zero(b)), KernelKlimbs::klimbs_mul(a, b)) } ,
                  _ => {  match KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_int_emod()) {
                    1 => {  int_emod_prim(rc, sa, a, b) } ,
                    _ => {  int_ediv_prim(rc, sa, a, sb, b) } ,
                  } } ,
                } } ,
              } } ,
            };
            (1, np_apply_spine(v, Lists::drop(sw, 2))) } ,
          _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
        } } ,
      }
    }

  fn np_apply_spine(head: KernelTypes::KExpr, spine: Lists::List<KernelTypes::KExpr>) -> KernelTypes::KExpr {
      match (*(spine)) {
        Lists::Node::Nil => {  head } ,
        Lists::Node::Cons(a, rest) => {
          np_apply_spine((&(KernelTypes::KExprNode::App(head, a))), rest) } ,
      }
    }

  fn try_nat_binop_addr(rc: KernelRoles::RoleCtx, head_addr: Bytes::AddressRef, a: KernelTypes::KLimbs, b: KernelTypes::KLimbs) -> (Field, KernelTypes::KExpr) {
      match KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_nat_add()) {
        1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_add(a, b)))) } ,
        _ => {
        match KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_nat_sub()) {
          1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_sub(a, b)))) } ,
          _ => {
          match KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_nat_mul()) {
            1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_mul(a, b)))) } ,
            _ => {
            match KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_nat_div()) {
              1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_div(a, b)))) } ,
              _ => {
              match KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_nat_mod()) {
                1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_mod(a, b)))) } ,
                _ => {
                match KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_nat_gcd()) {
                  1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_gcd(a, b)))) } ,
                  _ => {
                  match KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_nat_pow()) {
                    1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_pow(a, b)))) } ,
                    _ => {
                    match KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_nat_land()) {
                      1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_land(a, b)))) } ,
                      _ => {
                      match KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_nat_lor()) {
                        1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_lor(a, b)))) } ,
                        _ => {
                        match KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_nat_xor()) {
                          1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_xor_op(a, b)))) } ,
                          _ => {
                          match KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_nat_shift_left()) {
                            1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_shl(a, b)))) } ,
                            _ => {
                            match KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_nat_shift_right()) {
                              1 => {  (1, mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_shr(a, b)))) } ,
                              _ => {
                              match KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_nat_beq()) {
                                1 => {  (1, mk_bool(rc, KernelLevels::klimbs_eq(a, b))) } ,
                                _ => {
                                match KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_nat_ble()) {
                                  1 => {  (1, mk_bool(rc, KernelKlimbs::klimbs_le(a, b))) } ,
                                  _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                                } } ,
                              } } ,
                            } } ,
                          } } ,
                        } } ,
                      } } ,
                    } } ,
                  } } ,
                } } ,
              } } ,
            } } ,
          } } ,
        } } ,
      }
    }

  fn try_match_nat_add(rc: KernelRoles::RoleCtx, head: KernelTypes::KExpr, args: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr, KernelTypes::KLimbs) {
      match (*(head)) {
        KernelTypes::KExprNode::Const(caddr, _) => {
          match KernelRoles::role_is(rc, caddr, KernelRoleSpec::role_nat_add()) {
            0 => {  (0, head, (&(Lists::Node::Nil))) } ,
            _ => {
              match Lists::length(args) - 2 {
                0 => {
                  let lhs = Lists::lookup(args, 0);
                  let rhs = Lists::lookup(args, 1);
                  match (*(rhs)) {
                    KernelTypes::KExprNode::Lit(lit) => {
                      match lit {
                        KernelTypes::KLiteral::Nat(limbs) => {  (1, lhs, limbs) } ,
                        _ => {  (0, head, (&(Lists::Node::Nil))) } ,
                      } } ,
                    _ => {  (0, head, (&(Lists::Node::Nil))) } ,
                  } } ,
                _ => {  (0, head, (&(Lists::Node::Nil))) } ,
              } } ,
          } } ,
        _ => {  (0, head, (&(Lists::Node::Nil))) } ,
      }
    }

  fn build_succ_offset(rc: KernelRoles::RoleCtx, base: KernelTypes::KExpr, lit: KernelTypes::KLimbs) -> KernelTypes::KExpr {
      let one = (&(Lists::Node::Cons([UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0],
                                    (&(Lists::Node::Nil)))));
      let pred_lit_norm = KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_sub(lit, one));
      let succ_const = (&(KernelTypes::KExprNode::Const(KernelRoles::role_addr(rc, KernelRoleSpec::role_nat_succ()), (&(Lists::Node::Nil)))));
      match KernelKlimbs::klimbs_is_zero(pred_lit_norm) {
        1 => {  (&(KernelTypes::KExprNode::App(succ_const, base))) } ,
        _ => {
          let add_const = (&(KernelTypes::KExprNode::Const(KernelRoles::role_addr(rc, KernelRoleSpec::role_nat_add()), (&(Lists::Node::Nil)))));
          let pred_lit_expr = (&(KernelTypes::KExprNode::Lit(KernelTypes::KLiteral::Nat(pred_lit_norm))));
          let pred = (&(KernelTypes::KExprNode::App(
            (&(KernelTypes::KExprNode::App(add_const, base))),
            pred_lit_expr)));
          (&(KernelTypes::KExprNode::App(succ_const, pred))) } ,
      }
    }

  fn cleanup_nat_offset_major(rc: KernelRoles::RoleCtx, e: KernelTypes::KExpr) -> KernelTypes::KExpr {
      match (*(e)) {
        KernelTypes::KExprNode::Lit(_) => {  e } ,
        _ => {
          match KernelTypes::collect_spine(e) {
            (head, args) => {
              match (*(head)) {
                KernelTypes::KExprNode::Const(_, _) => {
                  match try_match_nat_add(rc, head, args) {
                    (1, base, lit) => {
                      let lit_norm = KernelKlimbs::klimbs_normalize(lit);
                      match KernelKlimbs::klimbs_is_zero(lit_norm) {
                        1 => {  e } ,
                        _ => {  build_succ_offset(rc, base, lit_norm) } ,
                      } } ,
                    _ => {  e } ,
                  } } ,
                _ => {  e } ,
              } } ,
          } } ,
      }
    }

  fn mk_nat_offset_stuck(rc: KernelRoles::RoleCtx, base_w: KernelTypes::KExpr, n: KernelTypes::KLimbs,
                                post: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr) {
      match KernelKlimbs::klimbs_is_zero(n) {
        1 => {  (1, np_apply_spine(base_w, post)) } ,
        _ => {
          let add_const = (&(KernelTypes::KExprNode::Const(KernelRoles::role_addr(rc, KernelRoleSpec::role_nat_add()), (&(Lists::Node::Nil)))));
          let off = (&(KernelTypes::KExprNode::App(
            (&(KernelTypes::KExprNode::App(add_const, base_w))),
            mk_nat_lit(n))));
          (1, np_apply_spine(off, post)) } ,
      }
    }

  fn is_nat_succ_ih_step(rc: KernelRoles::RoleCtx, step: KernelTypes::KExpr) -> Field {
      match (*(step)) {
        KernelTypes::KExprNode::Lam(_, body1) => {
          match (*(body1)) {
            KernelTypes::KExprNode::Lam(_, body2) => {
              match KernelTypes::collect_spine(body2) {
                (head, args) => {
                  match (*(head)) {
                    KernelTypes::KExprNode::Const(caddr, _) => {
                      match KernelRoles::role_is(rc, caddr, KernelRoleSpec::role_nat_succ()) {
                        0 => {  0 } ,
                        _ => {
                          match Lists::length(args) - 1 {
                            0 => {
                              match (*(Lists::lookup(args, 0))) {
                                KernelTypes::KExprNode::BVar(i) => {  Fields::is_zero(i) } ,
                                _ => {  0 } ,
                              } } ,
                            _ => {  0 } ,
                          } } ,
                      } } ,
                    _ => {  0 } ,
                  } } ,
              } } ,
            _ => {  0 } ,
          } } ,
        _ => {  0 } ,
      }
    }

  fn try_nat_linear_rec(rc: KernelRoles::RoleCtx, spine: Lists::List<KernelTypes::KExpr>, nparams: Field, nmotives: Field,
                               nminors: Field, major_idx: Field) -> (Field, KernelTypes::KExpr) {
      match UInt32::less_than_fields(nminors, 2) {
        1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
        _ => {
          let raw_major = Lists::lookup(spine, major_idx);
          match try_extract_nat(rc, raw_major) {
            (0, _) => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
            (1, n_klimbs) => {
              let base_idx = nparams + nmotives;
              let step = Lists::lookup(spine, base_idx + 1);
              match is_nat_succ_ih_step(rc, step) {
                0 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                _ => {
                  let base = Lists::lookup(spine, base_idx);
                  let post = Lists::drop(spine, major_idx + 1);
                  match try_extract_nat(rc, base) {
                    (1, b_klimbs) => {
                      (1, np_apply_spine(mk_nat_lit(KernelKlimbs::klimbs_add(b_klimbs, n_klimbs)), post)) } ,
                    _ => {  mk_nat_offset_stuck(rc, base, n_klimbs, post) } ,
                  } } ,
              } } ,
          } } ,
      }
    }

  inline fn try_nat_dispatch(rc: KernelRoles::RoleCtx, head_addr: Bytes::AddressRef, spine: Lists::List<KernelTypes::KExpr>,
                            types: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr) {
      let spine_len = Lists::length(spine);
      let is_pred = KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_nat_pred());
      let is_succ = KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_nat_succ());
      match is_succ {
        1 => {
          match UInt32::less_than_fields(spine_len, 1) {
            1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
            _ => {
              let a0 = Lists::lookup(spine, 0);
              match try_extract_nat(rc, a0) {
                (1, na) => {
                  let post = Lists::drop(spine, 1);
                  (1, np_apply_spine(mk_nat_lit(KernelKlimbs::klimbs_succ(na)), post)) } ,
                _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
              } } ,
          } } ,
        _ => {
          match is_pred {
            1 => {
              match UInt32::less_than_fields(spine_len, 1) {
                1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                _ => {
                  let a0 = Lists::lookup(spine, 0);
                  match try_extract_nat(rc, a0) {
                    (1, na) => {
                      let post = Lists::drop(spine, 1);
                      (1, np_apply_spine(mk_nat_lit(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_dec(na))), post)) } ,
                    _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                  } } ,
              } } ,
            _ => {  try_nat_binop_dispatch(rc, head_addr, spine, spine_len) } ,
          } } ,
      }
    }

  fn try_nat_binop_dispatch(rc: KernelRoles::RoleCtx, head_addr: Bytes::AddressRef, spine: Lists::List<KernelTypes::KExpr>,
                                   spine_len: Field) -> (Field, KernelTypes::KExpr) {
      match UInt32::less_than_fields(spine_len, 2) {
        1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
        _ => {
          let a0 = Lists::lookup(spine, 0);
          let a1 = Lists::lookup(spine, 1);
          match try_extract_nat(rc, a0) {
            (1, na) => {
              match try_extract_nat(rc, a1) {
                (1, nb) => {
                  match try_nat_binop_addr(rc, head_addr, na, nb) {
                    (1, result) => {
                      let post = Lists::drop(spine, 2);
                      (1, np_apply_spine(result, post)) } ,
                    _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                  } } ,
                _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
              } } ,
            _ => {

              match try_extract_nat(rc, a1) {
                (1, nb) => {
                  try_nat_offset_dispatch(rc, head_addr, a0, nb, spine) } ,
                _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
              } } ,
          } } ,
      }
    }

  fn try_nat_offset_dispatch(rc: KernelRoles::RoleCtx, head_addr: Bytes::AddressRef, a0_w: KernelTypes::KExpr, nb: KernelTypes::KLimbs,
                                    spine: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr) {
      let is_add = KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_nat_add());
      let is_divmod = KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_nat_div())
        + KernelRoles::role_is(rc, head_addr, KernelRoleSpec::role_nat_mod());
      let eligible =
        is_add + is_divmod * (1 - KernelKlimbs::klimbs_is_zero(nb))
          * (1 - KernelKlimbs::klimbs_is_zero(KernelKlimbs::klimbs_normalize(KernelKlimbs::klimbs_dec(nb))));
      match eligible {
        0 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
        _ => {
          let post = Lists::drop(spine, 2);

          match is_add {
            1 => {
              match mk_nat_offset_stuck(rc, a0_w, nb, post) {
                (1, stuck) => {  (2, stuck) } ,
                _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
              } } ,
            _ => {  (2, mk_nat_binop_stuck(head_addr, a0_w, nb, post)) } ,
          } } ,
      }
    }

  fn mk_nat_binop_stuck(op_addr: Bytes::AddressRef, base_w: KernelTypes::KExpr, n: KernelTypes::KLimbs,
                               post: Lists::List<KernelTypes::KExpr>) -> KernelTypes::KExpr {
      let op_const = (&(KernelTypes::KExprNode::Const(op_addr, (&(Lists::Node::Nil)))));
      let stuck = (&(KernelTypes::KExprNode::App(
        (&(KernelTypes::KExprNode::App(op_const, base_w))),
        mk_nat_lit(n))));
      np_apply_spine(stuck, post)
    }
}
