          match y {
            KernelTypes::KConstantInfo::Ctor(yn, yt, _yb, _yi, yc, yp, yf, _yu) => {
              canon_sord_then(canon_sord_of_g(canon_ord_cmp_g(xn, yn)),
                canon_sord_then(canon_sord_of_g(canon_ord_cmp_g(xc, yc)),
                  canon_sord_then(canon_sord_of_g(canon_ord_cmp_g(xp, yp)),
                    canon_sord_then(canon_sord_of_g(canon_ord_cmp_g(xf, yf)),
                                  canon_cmp_kexpr_ctx(xt, yt, ctx))))) } ,
            _ => {  canon_sord_of_g(canon_ord_cmp_g(canon_kind_ord(x), canon_kind_ord(y))) } ,
          } } ,
        _ => {  canon_sord_of_g(canon_ord_cmp_g(canon_kind_ord(x), canon_kind_ord(y))) } ,
      }
    }

  fn canon_cprj_addr(block: Bytes::AddressRef, ind_idx: Field, cidx: Field) -> Bytes::AddressRef {
      let info = Ixon::ConstantInfo::CPrj(Ixon::ConstructorProj::Mk(
        UInt64::from_field(ind_idx), UInt64::from_field(cidx), block));
      let proj_c = Ixon::Constant::Mk(info,
                               (&(Lists::Node::Nil)),
                               (&(Lists::Node::Nil)),
                               (&(Lists::Node::Nil)));
      let bytes = IxonSerialize::put_constant(proj_c, (&(Lists::Node::Nil)));
      Blake3::bytes_to_addr(bytes)
    }

  fn canon_member_ci(proj_addrs: Lists::List<Bytes::AddressRef>, pos: Field) -> KernelTypes::KConstantInfo {
      (*(Ingress::get_ci(Lists::lookup(proj_addrs, pos))))
    }

  fn canon_member_num_ctors(proj_addrs: Lists::List<Bytes::AddressRef>, pos: Field) -> Field {
      match canon_member_ci(proj_addrs, pos) {
        KernelTypes::KConstantInfo::Induct(_, _, _, _, nc, _, _, _) => {  nc } ,
        _ => {  0 } ,
      }
    }

  inline fn canon_build_ctx(classes: Lists::List<Lists::List<Field>>, proj_addrs: Lists::List<Bytes::AddressRef>,
                     block: Bytes::AddressRef) -> Lists::List<(Bytes::AddressRef, Field)> {
      canon_build_ctx_classes(classes, proj_addrs, block, 0, Lists::length(classes))
    }

  fn canon_build_ctx_classes(classes: Lists::List<Lists::List<Field>>, proj_addrs: Lists::List<Bytes::AddressRef>,
                             block: Bytes::AddressRef, j: Field, i: Field) -> Lists::List<(Bytes::AddressRef, Field)> {
      match (*(classes)) {
        Lists::Node::Nil => {  (&(Lists::Node::Nil)) } ,
        Lists::Node::Cons(cls, rest) => {
          let (entries, max_ctors) =
            canon_build_ctx_members(cls, proj_addrs, block, j, i);
          Lists::concat(entries,
            canon_build_ctx_classes(rest, proj_addrs, block, j + 1, i + max_ctors)) } ,
      }
    }

  fn canon_build_ctx_members(members: Lists::List<Field>, proj_addrs: Lists::List<Bytes::AddressRef>,
                             block: Bytes::AddressRef, j: Field, i: Field)
                             -> (Lists::List<(Bytes::AddressRef, Field)>, Field) {
      match (*(members)) {
        Lists::Node::Nil => {  ((&(Lists::Node::Nil)), 0) } ,
        Lists::Node::Cons(pos, rest) => {
          let (rest_entries, rest_max) =
            canon_build_ctx_members(rest, proj_addrs, block, j, i);
          let n = canon_member_num_ctors(proj_addrs, pos);
          let ctor_entries = canon_ctor_ctx_entries(block, pos, n, i, 0);
          let entries = (&(Lists::Node::Cons(
            (Lists::lookup(proj_addrs, pos), j),
            Lists::concat(ctor_entries, rest_entries))));
          match UInt32::less_than_fields(rest_max, n) {
            1 => {  (entries, n) } ,
            _ => {  (entries, rest_max) } ,
          } } ,
      }
    }

  fn canon_ctor_ctx_entries(block: Bytes::AddressRef, ind_idx: Field, n: Field, i: Field,
                            cidx: Field) -> Lists::List<(Bytes::AddressRef, Field)> {
      match n - cidx {
        0 => {  (&(Lists::Node::Nil)) } ,
        _ => {
          (&(Lists::Node::Cons((canon_cprj_addr(block, ind_idx, cidx), i + cidx),
            canon_ctor_ctx_entries(block, ind_idx, n, i, cidx + 1)))) } ,
      }
    }

  inline fn canon_sort_members(members: Lists::List<Field>, proj_addrs: Lists::List<Bytes::AddressRef>,
                        block: Bytes::AddressRef) -> Lists::List<Lists::List<Field>> {
      let seed = (&(Lists::Node::Cons(members, (&(Lists::Node::Nil)))));
      canon_sort_loop(seed, proj_addrs, block, 1 + Lists::length(members))
    }

  fn canon_sort_loop(classes: Lists::List<Lists::List<Field>>, proj_addrs: Lists::List<Bytes::AddressRef>,
                     block: Bytes::AddressRef, fuel: Field) -> Lists::List<Lists::List<Field>> {
      match fuel {
        0 => {  classes } ,
        _ => {
          let ctx = canon_build_ctx(classes, proj_addrs, block);
          let new_classes = canon_refine_classes(classes, ctx, proj_addrs);
          match canon_classes_eq(classes, new_classes) {
            1 => {  classes } ,
            _ => {  canon_sort_loop(new_classes, proj_addrs, block, fuel - 1) } ,
          } } ,
      }
    }

  fn canon_refine_classes(classes: Lists::List<Lists::List<Field>>, ctx: Lists::List<(Bytes::AddressRef, Field)>,
                          proj_addrs: Lists::List<Bytes::AddressRef>) -> Lists::List<Lists::List<Field>> {
      match (*(classes)) {
        Lists::Node::Nil => {  (&(Lists::Node::Nil)) } ,
        Lists::Node::Cons(c, rest) => {
          let refined = canon_refine_one(c, ctx, proj_addrs);
          Lists::concat(refined, canon_refine_classes(rest, ctx, proj_addrs)) } ,
      }
    }

  fn canon_refine_one(c: Lists::List<Field>, ctx: Lists::List<(Bytes::AddressRef, Field)>,
                      proj_addrs: Lists::List<Bytes::AddressRef>) -> Lists::List<Lists::List<Field>> {
      match Lists::length(c) {
        0 => {  (&(Lists::Node::Nil)) } ,
        1 => {  (&(Lists::Node::Cons(c, (&(Lists::Node::Nil))))) } ,
        _ => {
          let sorted = canon_ins_sort(c, ctx, proj_addrs);
          canon_group_consec(sorted, ctx, proj_addrs) } ,
      }
    }

  fn canon_ins_sort(xs: Lists::List<Field>, ctx: Lists::List<(Bytes::AddressRef, Field)>,
                    proj_addrs: Lists::List<Bytes::AddressRef>) -> Lists::List<Field> {
      match (*(xs)) {
        Lists::Node::Nil => {  (&(Lists::Node::Nil)) } ,
        Lists::Node::Cons(x, rest) => {
          canon_insert_sorted(x, canon_ins_sort(rest, ctx, proj_addrs),
                            ctx, proj_addrs) } ,
      }
    }

  fn canon_insert_sorted(x: Field, sorted: Lists::List<Field>, ctx: Lists::List<(Bytes::AddressRef, Field)>,
                         proj_addrs: Lists::List<Bytes::AddressRef>) -> Lists::List<Field> {
      match (*(sorted)) {
        Lists::Node::Nil => {  (&(Lists::Node::Cons(x, (&(Lists::Node::Nil))))) } ,
        Lists::Node::Cons(h, rest) => {
          match canon_cmp_member_ctx(canon_member_ci(proj_addrs, x),
                                   canon_member_ci(proj_addrs, h), ctx) {
            (0, _) => {  (&(Lists::Node::Cons(x, sorted))) } ,
            _ => {  (&(Lists::Node::Cons(h,
                   canon_insert_sorted(x, rest, ctx, proj_addrs)))) } ,
          } } ,
      }
    }

  fn canon_group_consec(sorted: Lists::List<Field>, ctx: Lists::List<(Bytes::AddressRef, Field)>,
                        proj_addrs: Lists::List<Bytes::AddressRef>) -> Lists::List<Lists::List<Field>> {
      match (*(sorted)) {
        Lists::Node::Nil => {  (&(Lists::Node::Nil)) } ,
        Lists::Node::Cons(h, rest) => {
          canon_group_walk(rest, ctx, proj_addrs, h,
                         (&(Lists::Node::Cons(h, (&(Lists::Node::Nil)))))) } ,
      }
    }

  fn canon_group_walk(remaining: Lists::List<Field>, ctx: Lists::List<(Bytes::AddressRef, Field)>,
                      proj_addrs: Lists::List<Bytes::AddressRef>, last: Field,
                      current: Lists::List<Field>) -> Lists::List<Lists::List<Field>> {
      match (*(remaining)) {
        Lists::Node::Nil => {  (&(Lists::Node::Cons(current, (&(Lists::Node::Nil))))) } ,
        Lists::Node::Cons(h, rest) => {
          match canon_cmp_member_ctx(canon_member_ci(proj_addrs, last),
                                   canon_member_ci(proj_addrs, h), ctx) {
            (1, _) => {
              canon_group_walk(rest, ctx, proj_addrs, h, Lists::snoc(current, h)) } ,
            _ => {
              (&(Lists::Node::Cons(current,
                canon_group_walk(rest, ctx, proj_addrs, h,
                  (&(Lists::Node::Cons(h, (&(Lists::Node::Nil))))))))) } ,
          } } ,
      }
    }

  fn canon_classes_eq(a: Lists::List<Lists::List<Field>>, b: Lists::List<Lists::List<Field>>) -> Field {
      match (*(a)) {
        Lists::Node::Nil => {
          match (*(b)) {
            Lists::Node::Nil => {  1 } ,
            _ => {  0 } ,
          } } ,
        Lists::Node::Cons(ah, arest) => {
          match (*(b)) {
            Lists::Node::Nil => {  0 } ,
            Lists::Node::Cons(bh, brest) => {
              match canon_g_list_eq(ah, bh) {
                0 => {  0 } ,
                _ => {  canon_classes_eq(arest, brest) } ,
              } } ,
          } } ,
      }
    }

  fn canon_g_list_eq(xs: Lists::List<Field>, ys: Lists::List<Field>) -> Field {
      match (*(xs)) {
        Lists::Node::Nil => {
          match (*(ys)) {
            Lists::Node::Nil => {  1 } ,
            _ => {  0 } ,
          } } ,
        Lists::Node::Cons(x, xt) => {
          match (*(ys)) {
            Lists::Node::Nil => {  0 } ,
            Lists::Node::Cons(y, yt) => {
              match x - y {
                0 => {  canon_g_list_eq(xt, yt) } ,
                _ => {  0 } ,
              } } ,
          } } ,
      }
    }

  fn canon_flatten(classes: Lists::List<Lists::List<Field>>) -> Lists::List<Field> {
      match (*(classes)) {
        Lists::Node::Nil => {  (&(Lists::Node::Nil)) } ,
        Lists::Node::Cons(c, rest) => {
          Lists::concat(c, canon_flatten(rest)) } ,
      }
    }

  fn canon_all_singleton(classes: Lists::List<Lists::List<Field>>) -> Field {
      match (*(classes)) {
        Lists::Node::Nil => {  1 } ,
        Lists::Node::Cons(c, rest) => {
          match Lists::length(c) {
            1 => {  canon_all_singleton(rest) } ,
            _ => {  0 } ,
          } } ,
      }
    }

  fn canon_indc_positions(members: Lists::List<Ixon::MutConst>, pos: Field) -> Lists::List<Field> {
      match (*(members)) {
        Lists::Node::Nil => {  (&(Lists::Node::Nil)) } ,
        Lists::Node::Cons(m, rest) => {
          let tail = canon_indc_positions(rest, pos + 1);
          match m {
            Ixon::MutConst::Indc(_) => {  (&(Lists::Node::Cons(pos, tail))) } ,
            _ => {  tail } ,
          } } ,
      }
    }

  fn canon_muts_has_kind(members: Lists::List<Ixon::MutConst>, want_defn: Field) -> Field {
      match (*(members)) {
        Lists::Node::Nil => {  0 } ,
        Lists::Node::Cons(m, rest) => {
          let hit = match m {
            Ixon::MutConst::Defn(_) => {  want_defn } ,
            Ixon::MutConst::Indc(_) => {  1 - want_defn } ,
            Ixon::MutConst::Recr(_) => {  0 } ,
          };
          match hit {
            1 => {  1 } ,
            _ => {  canon_muts_has_kind(rest, want_defn) } ,
          } } ,
      }
    }

  fn check_canonical_block(block_addr: Bytes::AddressRef) -> () {
      let c = Ingress::load_verified_constant(block_addr);
      match c {
        Ixon::Constant::Mk(info, _, _, _) => {
          match info {
            Ixon::ConstantInfo::Muts(members) => {

              assert_eq!(canon_muts_has_kind(members, 1) *
                           canon_muts_has_kind(members, 0), 0,
                "mutual block mixes a definition member with inductives");
              let indcs = canon_indc_positions(members, 0);
              match UInt32::less_than_fields(Lists::length(indcs), 2) {
                1 => {  () } ,
                _ => {
                  let proj_addrs = Ingress::build_recur_addrs(members, block_addr);
                  let classes = canon_sort_members(indcs, proj_addrs, block_addr);
                  assert_eq!(canon_all_singleton(classes), 1,
                    "canonical block: refinement left members tied, order ambiguous");
                  assert_eq!(canon_g_list_eq(canon_flatten(classes), indcs), 1,
                    "canonical block: members are not in canonical order");
                  () } ,
              } } ,
            _ => {  () } ,
          } } ,
      }
    }
}
