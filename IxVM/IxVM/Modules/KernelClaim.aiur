  fn load_assumption_tree(root: Bytes::AddressRef) -> Lists::List<Bytes::AddressRef> {
      let raw = (*(root));
      let (idx, len) = IxVMCompat::io_get_info(1, raw);

      let bytes = IxByteStream::read_finite_byte_stream(1, idx, len);

      let (tag, s) = IxonDeserialize::read_byte(bytes);
      assert_eq!(UInt8::to_field(tag), 226, "assumption tree: wrong TagN header");
