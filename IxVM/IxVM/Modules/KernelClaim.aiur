  fn get_reveal_ctor_info(stream: Bytes::Stream)
        -> (RevealConstructorInfo, Bytes::Stream) {
      let (mask, s) = IxonDeserialize::get_tagn0(stream);
      let mask_lo = UInt8::bit_decomposition(mask[0]);
      let [b0, b1, b2, b3, b4, b5, _, _] = mask_lo;
      let (is_unsafe, s) = get_opt_bool_masked(b0, s);
      let (lvls, s) = get_opt_u64_masked(b1, s);
      let (cidx, s) = get_opt_u64_masked(b2, s);
      let (params, s) = get_opt_u64_masked(b3, s);
      let (fields, s) = get_opt_u64_masked(b4, s);
      let (typ, s) = get_opt_addr_masked(b5, s);
      (RevealConstructorInfo::Mk(is_unsafe, lvls, cidx, params, fields, typ), s)
    }

  fn get_ctor_entry(stream: Bytes::Stream)
        -> ((UInt64::U64, RevealConstructorInfo), Bytes::Stream) {
      let (idx, s) = IxonDeserialize::get_tagn0(stream);
      let (info, s) = get_reveal_ctor_info(s);
      ((idx, info), s)
    }

  fn get_ctor_entry_list_inner(stream: Bytes::Stream, count: UInt64::U64)
        -> (Lists::List<(UInt64::U64, RevealConstructorInfo)>, Bytes::Stream) {
      match UInt64::is_zero(count) {
        1 => {  ((&(Lists::Node::Nil)), stream) } ,
        _ => {
          let (entry, s) = get_ctor_entry(stream);
          let (rest, s2) = get_ctor_entry_list_inner(s, UInt64::saturating_pred(count));
          ((&(Lists::Node::Cons(entry, rest))), s2) } ,
      }
    }

  fn get_opt_ctor_entry_list_masked(mb: Field, stream: Bytes::Stream)
        -> (Options::Option<Lists::List<(UInt64::U64, RevealConstructorInfo)>>, Bytes::Stream) {
      match mb {
        0 => {  (Options::Option::None, stream) } ,
        _ => {
          let (count, s) = IxonDeserialize::get_tagn0(stream);
          let (list, s2) = get_ctor_entry_list_inner(s, count);
          (Options::Option::Some(list), s2) } ,
      }
    }

  fn get_reveal_mut_const_info(stream: Bytes::Stream)
        -> (RevealMutConstInfo, Bytes::Stream) {
      let (variant, s) = IxonDeserialize::read_byte(stream);
      let (mask, s) = IxonDeserialize::get_tagn0(s);
      let mask_lo = UInt8::bit_decomposition(mask[0]);
      let [b0, b1, b2, b3, b4, b5, b6, b7] = mask_lo;
      let mask_hi = UInt8::bit_decomposition(mask[1]);
      let [b8, _, _, _, _, _, _, _] = mask_hi;
      match UInt8::to_field(variant) {
        0 => {
          let (kind, s) = get_opt_def_kind_masked(b0, s);
          let (safety, s) = get_opt_def_safety_masked(b1, s);
          let (lvls, s) = get_opt_u64_masked(b2, s);
          let (typ, s) = get_opt_addr_masked(b3, s);
          let (value, s) = get_opt_addr_masked(b4, s);
          (RevealMutConstInfo::Defn(kind, safety, lvls, typ, value), s) } ,
        1 => {
          let (is_unsafe, s) = get_opt_bool_masked(b0, s);
          let (lvls, s) = get_opt_u64_masked(b1, s);
          let (params, s) = get_opt_u64_masked(b2, s);
          let (indices, s) = get_opt_u64_masked(b3, s);
          let (typ, s) = get_opt_addr_masked(b4, s);
          let (ctors, s) = get_opt_ctor_entry_list_masked(b5, s);
          (RevealMutConstInfo::Indc(is_unsafe, lvls, params,
                                    indices, typ, ctors), s) } ,
        2 => {
          let (k, s) = get_opt_bool_masked(b0, s);
          let (is_unsafe, s) = get_opt_bool_masked(b1, s);
          let (lvls, s) = get_opt_u64_masked(b2, s);
          let (params, s) = get_opt_u64_masked(b3, s);
          let (indices, s) = get_opt_u64_masked(b4, s);
          let (motives, s) = get_opt_u64_masked(b5, s);
          let (minors, s) = get_opt_u64_masked(b6, s);
          let (typ, s) = get_opt_addr_masked(b7, s);
          let (rules, s) = get_opt_rule_list_masked(b8, s);
          (RevealMutConstInfo::Recr(k, is_unsafe, lvls, params, indices,
                                    motives, minors, typ, rules), s) } ,
      }
    }

  fn get_mut_entry(stream: Bytes::Stream)
        -> ((UInt64::U64, RevealMutConstInfo), Bytes::Stream) {
      let (idx, s) = IxonDeserialize::get_tagn0(stream);
      let (info, s) = get_reveal_mut_const_info(s);
      ((idx, info), s)
    }

  fn get_mut_entry_list_inner(stream: Bytes::Stream, count: UInt64::U64)
        -> (Lists::List<(UInt64::U64, RevealMutConstInfo)>, Bytes::Stream) {
      match UInt64::is_zero(count) {
        1 => {  ((&(Lists::Node::Nil)), stream) } ,
        _ => {
          let (entry, s) = get_mut_entry(stream);
          let (rest, s2) = get_mut_entry_list_inner(s, UInt64::saturating_pred(count));
          ((&(Lists::Node::Cons(entry, rest))), s2) } ,
      }
    }

  fn get_reveal_info(stream: Bytes::Stream) -> (RevealConstantInfo, Bytes::Stream) {
      let (variant, s) = IxonDeserialize::read_byte(stream);
      let (mask, s) = IxonDeserialize::get_tagn0(s);
      let mask_lo = UInt8::bit_decomposition(mask[0]);
      let [b0, b1, b2, b3, b4, b5, b6, b7] = mask_lo;
      let mask_hi = UInt8::bit_decomposition(mask[1]);
      let [b8, _, _, _, _, _, _, _] = mask_hi;
      match UInt8::to_field(variant) {
        0 => {
          let (kind, s) = get_opt_def_kind_masked(b0, s);
          let (safety, s) = get_opt_def_safety_masked(b1, s);
          let (lvls, s) = get_opt_u64_masked(b2, s);
          let (typ, s) = get_opt_addr_masked(b3, s);
          let (value, s) = get_opt_addr_masked(b4, s);
          (RevealConstantInfo::Defn(kind, safety, lvls, typ, value), s) } ,
        1 => {
          let (k, s) = get_opt_bool_masked(b0, s);
          let (is_unsafe, s) = get_opt_bool_masked(b1, s);
          let (lvls, s) = get_opt_u64_masked(b2, s);
          let (params, s) = get_opt_u64_masked(b3, s);
          let (indices, s) = get_opt_u64_masked(b4, s);
          let (motives, s) = get_opt_u64_masked(b5, s);
          let (minors, s) = get_opt_u64_masked(b6, s);
          let (typ, s) = get_opt_addr_masked(b7, s);
          let (rules, s) = get_opt_rule_list_masked(b8, s);
          (RevealConstantInfo::Recr(k, is_unsafe, lvls, params, indices,
                                    motives, minors, typ, rules), s) } ,
        2 => {
          let (is_unsafe, s) = get_opt_bool_masked(b0, s);
          let (lvls, s) = get_opt_u64_masked(b1, s);
          let (typ, s) = get_opt_addr_masked(b2, s);
          (RevealConstantInfo::Axio(is_unsafe, lvls, typ), s) } ,
        3 => {
          let (kind, s) = get_opt_quot_kind_masked(b0, s);
          let (lvls, s) = get_opt_u64_masked(b1, s);
          let (typ, s) = get_opt_addr_masked(b2, s);
          (RevealConstantInfo::Quot(kind, lvls, typ), s) } ,
        4 => {
          let (idx, s) = get_opt_u64_masked(b0, s);
          let (cidx, s) = get_opt_u64_masked(b1, s);
          let (block, s) = get_opt_addr_masked(b2, s);
          (RevealConstantInfo::CPrj(idx, cidx, block), s) } ,
        5 => {
          let (idx, s) = get_opt_u64_masked(b0, s);
          let (block, s) = get_opt_addr_masked(b1, s);
          (RevealConstantInfo::RPrj(idx, block), s) } ,
        6 => {
          let (idx, s) = get_opt_u64_masked(b0, s);
          let (block, s) = get_opt_addr_masked(b1, s);
          (RevealConstantInfo::IPrj(idx, block), s) } ,
        7 => {
          let (idx, s) = get_opt_u64_masked(b0, s);
          let (block, s) = get_opt_addr_masked(b1, s);
          (RevealConstantInfo::DPrj(idx, block), s) } ,
        8 => {
          let (components, s) = match b0 {
            0 => {  ((&(Lists::Node::Nil)), s) } ,
            1 => {
              let (count, s2) = IxonDeserialize::get_tagn0(s);
              get_mut_entry_list_inner(s2, count) } ,
          };
          (RevealConstantInfo::Muts(components), s) } ,
      }
    }

  fn expr_addr(e_ref: &Ixon::Expr) -> Bytes::AddressRef {
      let bytes = IxonSerialize::put_expr((*(e_ref)), (&(Lists::Node::Nil)));
      Blake3::bytes_to_addr(bytes)
    }

  fn def_kind_tag(k: Ixon::DefKind) -> Field {
      match k {
        Ixon::DefKind::Definition => {  0 } ,
        Ixon::DefKind::Opaque => {  1 } ,
        Ixon::DefKind::Theorem => {  2 } ,
      }
    }

  fn def_safety_tag(s: Ixon::DefinitionSafety) -> Field {
      match s {
        Ixon::DefinitionSafety::Unsafe => {  0 } ,
        Ixon::DefinitionSafety::Safe => {  1 } ,
        Ixon::DefinitionSafety::Partial => {  2 } ,
      }
    }

  fn quot_kind_tag(k: Ixon::QuotKind) -> Field {
      match k {
        Ixon::QuotKind::Typ => {  0 } ,
        Ixon::QuotKind::Ctor => {  1 } ,
        Ixon::QuotKind::Lift => {  2 } ,
        Ixon::QuotKind::Ind => {  3 } ,
      }
    }

  fn check_opt_def_kind(real: Ixon::DefKind, opt: Options::Option<Ixon::DefKind>) -> () {
      match opt {
        Options::Option::None => {  () } ,
        Options::Option::Some(claimed) => {
          assert_eq!(def_kind_tag(real), def_kind_tag(claimed),
            "Reveal: claimed definition kind != real");
          () } ,
      }
    }

  fn check_opt_def_safety(real: Ixon::DefinitionSafety,
                            opt: Options::Option<Ixon::DefinitionSafety>) -> () {
      match opt {
        Options::Option::None => {  () } ,
        Options::Option::Some(claimed) => {
          assert_eq!(def_safety_tag(real), def_safety_tag(claimed),
            "Reveal: claimed definition safety != real");
          () } ,
      }
    }

  fn check_opt_quot_kind(real: Ixon::QuotKind, opt: Options::Option<Ixon::QuotKind>) -> () {
      match opt {
        Options::Option::None => {  () } ,
        Options::Option::Some(claimed) => {
          assert_eq!(quot_kind_tag(real), quot_kind_tag(claimed),
            "Reveal: claimed quotient kind != real");
          () } ,
      }
    }

  fn check_opt_bool(real: Field, opt: Options::Option<Field>) -> () {
      match opt {
        Options::Option::None => {  () } ,
        Options::Option::Some(claimed) => {
          assert_eq!(real, claimed, "Reveal: claimed flag != real");
          () } ,
      }
    }

  fn check_opt_u64(real: UInt64::U64, opt: Options::Option<UInt64::U64>) -> () {
      match opt {
        Options::Option::None => {  () } ,
        Options::Option::Some(claimed) => {
          assert_eq!(UInt64::eq(real, claimed), 1, "Reveal: claimed numeric field != real");
          () } ,
      }
    }

  fn check_opt_addr(real: Bytes::AddressRef, opt: Options::Option<Bytes::AddressRef>) -> () {
      match opt {
        Options::Option::None => {  () } ,
        Options::Option::Some(claimed) => {
          assert_eq!(Bytes::address_eq(real, claimed), 1,
            "Reveal: claimed address field != real");
          () } ,
      }
    }

  fn check_opt_expr_addr(real_e: &Ixon::Expr, opt: Options::Option<Bytes::AddressRef>) -> () {
      match opt {
        Options::Option::None => {  () } ,
        Options::Option::Some(claimed) => {
          let computed = expr_addr(real_e);
          assert_eq!(Bytes::address_eq(computed, claimed), 1,
            "Reveal: claimed expr hash != hash of the real expr");
          () } ,
      }
    }

  fn check_recr_rules(real: Lists::List<Ixon::RecursorRule>,
                        claimed: Lists::List<RevealRecursorRule>,
                        pos: UInt64::U64) -> () {
      match (*(claimed)) {
        Lists::Node::Nil => {
          match (*(real)) {
            Lists::Node::Nil => {  () } ,
          } } ,
        Lists::Node::Cons(cr, rest_claimed) => {
          match (*(real)) {
            Lists::Node::Cons(rr, rest_real) => {
              match cr {
                RevealRecursorRule::Mk(c_idx, c_fields, c_rhs) => {
                  match rr {
                    Ixon::RecursorRule::Mk(r_fields, r_rhs) => {
                      assert_eq!(UInt64::eq(c_idx, pos), 1,
                        "Reveal: claimed recursor rule index != its position");
                      assert_eq!(UInt64::eq(r_fields, c_fields), 1,
                        "Reveal: claimed recursor rule field count != real");
                      check_opt_expr_addr(r_rhs, Options::Option::Some(c_rhs));
                      check_recr_rules(rest_real, rest_claimed,
                        UInt64::wrapping_succ(pos)) } ,
                  } } ,
              } } ,
          } } ,
      }
    }

  fn check_opt_recr_rules(real: Lists::List<Ixon::RecursorRule>,
                            opt: Options::Option<Lists::List<RevealRecursorRule>>) -> () {
      match opt {
        Options::Option::None => {  () } ,
        Options::Option::Some(claimed) => {
          check_recr_rules(real, claimed,
            [UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0]) } ,
      }
    }

  fn check_ctor_entry(real_list: Lists::List<Ixon::Constructor>,
                        idx: UInt64::U64,
                        info: RevealConstructorInfo) -> () {
      let real_ctor = WordLists::lookup_u64(real_list, idx);
      match info {
        RevealConstructorInfo::Mk(opt_unsafe, opt_lvls, opt_cidx,
                                  opt_params, opt_fields, opt_typ) => {
          match real_ctor {
            Ixon::Constructor::Mk(r_unsafe, r_lvls, r_cidx, r_params, r_fields, r_typ) => {
              check_opt_bool(r_unsafe, opt_unsafe);
              check_opt_u64(r_lvls, opt_lvls);
              check_opt_u64(r_cidx, opt_cidx);
              check_opt_u64(r_params, opt_params);
              check_opt_u64(r_fields, opt_fields);
              check_opt_expr_addr(r_typ, opt_typ) } ,
          } } ,
      }
    }

  fn check_ctor_entries(real_list: Lists::List<Ixon::Constructor>,
                          claimed: Lists::List<(UInt64::U64, RevealConstructorInfo)>) -> () {
      match (*(claimed)) {
        Lists::Node::Nil => {  () } ,
        Lists::Node::Cons(entry, rest) => {
          match entry {
            (idx, info) => {
              check_ctor_entry(real_list, idx, info);
              check_ctor_entries(real_list, rest) } ,
          } } ,
      }
    }

  fn check_opt_ctor_entries(real_list: Lists::List<Ixon::Constructor>,
                              opt: Options::Option<Lists::List<(UInt64::U64, RevealConstructorInfo)>>) -> () {
      match opt {
        Options::Option::None => {  () } ,
        Options::Option::Some(claimed) => {  check_ctor_entries(real_list, claimed) } ,
      }
    }

  fn check_mut_const(real: Ixon::MutConst, claimed: RevealMutConstInfo) -> () {
      match real {
        Ixon::MutConst::Defn(d) => {
          match claimed {
            RevealMutConstInfo::Defn(opt_kind, opt_safety, opt_lvls,
                                     opt_typ, opt_value) => {
              match d {
                Ixon::Definition::Mk(r_kind, r_safety, r_lvls, r_typ, r_value) => {
                  check_opt_def_kind(r_kind, opt_kind);
                  check_opt_def_safety(r_safety, opt_safety);
                  check_opt_u64(r_lvls, opt_lvls);
                  check_opt_expr_addr(r_typ, opt_typ);
                  check_opt_expr_addr(r_value, opt_value) } ,
              } } ,
          } } ,
        Ixon::MutConst::Indc(i) => {
          match claimed {
            RevealMutConstInfo::Indc(opt_unsafe, opt_lvls,
                                     opt_params, opt_indices,
                                     opt_typ, opt_ctors) => {
              match i {
                Ixon::Inductive::Mk(r_unsafe, r_lvls, r_params,
                              r_indices, r_typ, r_ctors) => {
                  check_opt_bool(r_unsafe, opt_unsafe);
                  check_opt_u64(r_lvls, opt_lvls);
                  check_opt_u64(r_params, opt_params);
                  check_opt_u64(r_indices, opt_indices);
                  check_opt_expr_addr(r_typ, opt_typ);
                  check_opt_ctor_entries(r_ctors, opt_ctors) } ,
              } } ,
          } } ,
        Ixon::MutConst::Recr(r) => {
          match claimed {
            RevealMutConstInfo::Recr(opt_k, opt_unsafe, opt_lvls, opt_params,
                                     opt_indices, opt_motives, opt_minors,
                                     opt_typ, opt_rules) => {
              match r {
                Ixon::Recursor::Mk(r_k, r_unsafe, r_lvls, r_params, r_indices,
                             r_motives, r_minors, r_typ, r_rules) => {
                  check_opt_bool(r_k, opt_k);
                  check_opt_bool(r_unsafe, opt_unsafe);
                  check_opt_u64(r_lvls, opt_lvls);
                  check_opt_u64(r_params, opt_params);
                  check_opt_u64(r_indices, opt_indices);
                  check_opt_u64(r_motives, opt_motives);
                  check_opt_u64(r_minors, opt_minors);
                  check_opt_expr_addr(r_typ, opt_typ);
                  check_opt_recr_rules(r_rules, opt_rules) } ,
              } } ,
          } } ,
      }
    }

  fn check_muts_components(real: Lists::List<Ixon::MutConst>,
                             claimed: Lists::List<(UInt64::U64, RevealMutConstInfo)>) -> () {
      match (*(claimed)) {
        Lists::Node::Nil => {  () } ,
        Lists::Node::Cons(entry, rest_claimed) => {
          match entry {
            (idx, info) => {
              let real_mc = WordLists::lookup_u64(real, idx);
              check_mut_const(real_mc, info);
              check_muts_components(real, rest_claimed) } ,
          } } ,
      }
    }

  fn run_reveal(comm_addr: Bytes::AddressRef, info: RevealConstantInfo) -> () {
      let c = Ingress::load_verified_constant(comm_addr);
      match c {
        Ixon::Constant::Mk(ci, _, _, _) => {
          match ci {
            Ixon::ConstantInfo::Defn(d) => {
              match info {
                RevealConstantInfo::Defn(opt_kind, opt_safety, opt_lvls,
                                         opt_typ, opt_value) => {
                  match d {
                    Ixon::Definition::Mk(r_kind, r_safety, r_lvls, r_typ, r_value) => {
                      check_opt_def_kind(r_kind, opt_kind);
                      check_opt_def_safety(r_safety, opt_safety);
                      check_opt_u64(r_lvls, opt_lvls);
                      check_opt_expr_addr(r_typ, opt_typ);
                      check_opt_expr_addr(r_value, opt_value) } ,
                  } } ,
              } } ,
            Ixon::ConstantInfo::Recr(r) => {
              match info {
                RevealConstantInfo::Recr(opt_k, opt_unsafe, opt_lvls, opt_params,
                                         opt_indices, opt_motives, opt_minors,
                                         opt_typ, opt_rules) => {
                  match r {
                    Ixon::Recursor::Mk(r_k, r_unsafe, r_lvls, r_params, r_indices,
                                 r_motives, r_minors, r_typ, r_rules) => {
                      check_opt_bool(r_k, opt_k);
                      check_opt_bool(r_unsafe, opt_unsafe);
                      check_opt_u64(r_lvls, opt_lvls);
                      check_opt_u64(r_params, opt_params);
                      check_opt_u64(r_indices, opt_indices);
                      check_opt_u64(r_motives, opt_motives);
                      check_opt_u64(r_minors, opt_minors);
                      check_opt_expr_addr(r_typ, opt_typ);
                      check_opt_recr_rules(r_rules, opt_rules) } ,
                  } } ,
              } } ,
            Ixon::ConstantInfo::Axio(a) => {
              match info {
                RevealConstantInfo::Axio(opt_unsafe, opt_lvls, opt_typ) => {
                  match a {
                    Ixon::Axiom::Mk(r_unsafe, r_lvls, r_typ) => {
                      check_opt_bool(r_unsafe, opt_unsafe);
                      check_opt_u64(r_lvls, opt_lvls);
                      check_opt_expr_addr(r_typ, opt_typ) } ,
                  } } ,
              } } ,
            Ixon::ConstantInfo::Quot(q) => {
              match info {
                RevealConstantInfo::Quot(opt_kind, opt_lvls, opt_typ) => {
                  match q {
                    Ixon::Quotient::Mk(r_kind, r_lvls, r_typ) => {
                      check_opt_quot_kind(r_kind, opt_kind);
                      check_opt_u64(r_lvls, opt_lvls);
                      check_opt_expr_addr(r_typ, opt_typ) } ,
                  } } ,
              } } ,
            Ixon::ConstantInfo::CPrj(p) => {
              match info {
                RevealConstantInfo::CPrj(opt_idx, opt_cidx, opt_block) => {
                  match p {
                    Ixon::ConstructorProj::Mk(r_idx, r_cidx, r_block) => {
                      check_opt_u64(r_idx, opt_idx);
                      check_opt_u64(r_cidx, opt_cidx);
                      check_opt_addr(r_block, opt_block) } ,
                  } } ,
              } } ,
            Ixon::ConstantInfo::RPrj(p) => {
              match info {
                RevealConstantInfo::RPrj(opt_idx, opt_block) => {
                  match p {
                    Ixon::RecursorProj::Mk(r_idx, r_block) => {
                      check_opt_u64(r_idx, opt_idx);
                      check_opt_addr(r_block, opt_block) } ,
                  } } ,
              } } ,
            Ixon::ConstantInfo::IPrj(p) => {
              match info {
                RevealConstantInfo::IPrj(opt_idx, opt_block) => {
                  match p {
                    Ixon::InductiveProj::Mk(r_idx, r_block) => {
                      check_opt_u64(r_idx, opt_idx);
                      check_opt_addr(r_block, opt_block) } ,
                  } } ,
              } } ,
            Ixon::ConstantInfo::DPrj(p) => {
              match info {
                RevealConstantInfo::DPrj(opt_idx, opt_block) => {
                  match p {
                    Ixon::DefinitionProj::Mk(r_idx, r_block) => {
                      check_opt_u64(r_idx, opt_idx);
                      check_opt_addr(r_block, opt_block) } ,
                  } } ,
              } } ,
            Ixon::ConstantInfo::Muts(real_mc_list) => {
              match info {
                RevealConstantInfo::Muts(claimed_components) => {
                  check_muts_components(real_mc_list, claimed_components) } ,
              } } ,
          } } ,
      }
    }

  fn run_contains(tree_root: Bytes::AddressRef, target: Bytes::AddressRef) -> () {
      let leaves = load_assumption_tree(tree_root);
      assert_eq!(KernelWhnf::se_addr_in(target, leaves), 1,
        "Contains: target is not a leaf of the claimed tree");
    }

  fn run_claim(digest: [Field; 8]) -> () {

      let (idx, len) = hint::<(Field, Field)>("ixvm.io.claim", digest);
      let bytes = IxByteStream::read_finite_byte_stream(0, idx, len);

      let h = Blake3::hash(bytes);
      assert_eq!(Blake3::pack_digest(h), digest,
        "claim: bytes do not hash to the public claim digest");

      let (tag, s) = IxonDeserialize::get_tagn4(bytes);
      let (flag, size) = tag;
      assert_eq!(flag, 14, "claim: wrong TagN flag");

      let [_, sz1, sz2, sz3, sz4, sz5, sz6, sz7] = size;
      assert_eq!(((((((UInt8::to_field(sz1) + UInt8::to_field(sz2)) + UInt8::to_field(sz3))
                    + UInt8::to_field(sz4)) + UInt8::to_field(sz5)) + UInt8::to_field(sz6))
                    + UInt8::to_field(sz7)), 0,
        "claim: TagN size exceeds a single byte");
      let variant = size[0];

      let (format, s) = IxonDeserialize::read_byte(s);
      assert_eq!(UInt8::to_field(format), 4, "claim: unsupported object format");
      let (validator, s) = IxonDeserialize::read_byte(s);
      match UInt8::to_field(variant) {
        3 => {
          assert_eq!(UInt8::to_field(validator), 1, "claim: wrong validator identity");
          let (input, s) = IxonDeserialize::get_address(s);
          let (output, s) = IxonDeserialize::get_address(s);
          let (asm, rest) = get_opt_addr(s);
          let Lists::Node::Nil = (*(rest));
          KernelEval::run_eval(input, output, asm) } ,
        4 => {
          assert_eq!(UInt8::to_field(validator), 1, "claim: wrong validator identity");
          let (target, s2) = IxonDeserialize::get_address(s);
          let (asm, rest) = get_opt_addr(s2);
          let Lists::Node::Nil = (*(rest));
          match asm {
            Options::Option::None => {  run_check_transitive(target) } ,
            Options::Option::Some(r) => {
              let asm_leaves = load_assumption_tree(r);
              let asm_set = addr_set_build(asm_leaves, RBTreeMap::RBTreeMap::Nil);
              env_walk(target, RBTreeMap::RBTreeMap::Nil, asm_set, 0) } ,
          } } ,
        5 => {
          assert_eq!(UInt8::to_field(validator), 1, "claim: wrong validator identity");
          let (root, s2) = IxonDeserialize::get_address(s);
          let (asm, rest) = get_opt_addr(s2);
          let Lists::Node::Nil = (*(rest));
          run_check_env(root, asm) } ,
        6 => {
          assert_eq!(UInt8::to_field(validator), 0, "claim: wrong validator identity");
          let (comm, s2) = IxonDeserialize::get_address(s);
          let (info, rest) = get_reveal_info(s2);
          let Lists::Node::Nil = (*(rest));
          run_reveal(comm, info) } ,
        7 => {
          assert_eq!(UInt8::to_field(validator), 0, "claim: wrong validator identity");
          let (tree, s2) = IxonDeserialize::get_address(s);
          let (target, rest) = IxonDeserialize::get_address(s2);
          let Lists::Node::Nil = (*(rest));
          run_contains(tree, target) } ,
        9 => {
          assert_eq!(UInt8::to_field(validator), 2, "claim: wrong resource validator identity");

          assert_eq!(0, 1, "claim: resource-v1 is not implemented by LegacyIxVM");
          () } ,
      }
    }
}
