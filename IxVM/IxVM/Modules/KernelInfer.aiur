  fn is_dec_prim_addr(a: Bytes::AddressRef) -> Field {
      match Bytes::address_eq(a, nat_dec_le_addr_dec()) {
        1 => {  1 } ,
        _ => {
        match Bytes::address_eq(a, nat_dec_eq_addr_dec()) {
          1 => {  1 } ,
          _ => {
          match Bytes::address_eq(a, nat_dec_lt_addr_dec()) {
            1 => {  1 } ,
            _ => {
            match Bytes::address_eq(a, int_dec_le_addr_dec()) {
              1 => {  1 } ,
              _ => {
              match Bytes::address_eq(a, int_dec_eq_addr_dec()) {
                1 => {  1 } ,
                _ => {
                match Bytes::address_eq(a, int_dec_lt_addr_dec()) {
                  1 => {  1 } ,
                  _ => {  0 } ,
                } } ,
              } } ,
            } } ,
          } } ,
        } } ,
      }
    }

  fn is_int_dec_prim_addr(a: Bytes::AddressRef) -> Field {
      match Bytes::address_eq(a, int_dec_le_addr_dec()) {
        1 => {  1 } ,
        _ => {
        match Bytes::address_eq(a, int_dec_eq_addr_dec()) {
          1 => {  1 } ,
          _ => {
          match Bytes::address_eq(a, int_dec_lt_addr_dec()) {
            1 => {  1 } ,
            _ => {  0 } ,
          } } ,
        } } ,
      }
    }

  fn try_extract_int(e: KernelTypes::KExpr) -> (Field, Field, KernelTypes::KLimbs) {
      match (*(e)) {
        KernelTypes::KExprNode::App(f, a) => {
          match (*(f)) {
            KernelTypes::KExprNode::Const(caddr, _) => {
              let is_ofnat = Bytes::address_eq(caddr, int_of_nat_addr_dec());
              let is_negsucc = Bytes::address_eq(caddr, int_neg_succ_addr_dec());
              match is_ofnat + is_negsucc {
                0 => {  (0, 0, (&(Lists::Node::Nil))) } ,
                _ => {
                  match (*(a)) {
                    KernelTypes::KExprNode::Lit(lit) => {
                      match lit {
                        KernelTypes::KLiteral::Nat(limbs) => {  (1, is_negsucc, limbs) } ,
                        _ => {  (0, 0, (&(Lists::Node::Nil))) } ,
                      } } ,
                    _ => {  (0, 0, (&(Lists::Node::Nil))) } ,
                  } } ,
              } } ,
            _ => {  (0, 0, (&(Lists::Node::Nil))) } ,
          } } ,
        _ => {  (0, 0, (&(Lists::Node::Nil))) } ,
      }
    }

  fn intern_int_lit(sign: Field, kl: KernelTypes::KLimbs) -> KernelTypes::KExpr {
      let head_addr = match sign {
        0 => {  int_of_nat_addr_dec() } ,
        _ => {  int_neg_succ_addr_dec() } ,
      };
      let head = (&(KernelTypes::KExprNode::Const(head_addr, (&(Lists::Node::Nil)))));
      let lit = (&(KernelTypes::KExprNode::Lit(KernelTypes::KLiteral::Nat(kl))));
      (&(KernelTypes::KExprNode::App(head, lit)))
    }

  fn try_normalize_int_decidable(head_addr: Bytes::AddressRef,
                                       head_lvls: Lists::List<KernelTypes::KLevel>,
                                       spine: Lists::List<KernelTypes::KExpr>,
                                       types: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr) {
      match UInt32::less_than_fields(Lists::length(spine), 2) {
        1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
        _ => {
          let a0 = Lists::lookup(spine, 0);
          let a1 = Lists::lookup(spine, 1);
          match try_extract_int(a0) {
            (1, _, _) => {
              match try_extract_int(a1) {
                (1, _, _) => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                _ => {  normalize_int_dec_rebuild(head_addr, head_lvls,
                                                spine, a0, a1, types) } ,
              } } ,
            _ => {  normalize_int_dec_rebuild(head_addr, head_lvls,
                                            spine, a0, a1, types) } ,
          } } ,
      }
    }

  fn normalize_int_dec_rebuild(head_addr: Bytes::AddressRef, head_lvls: Lists::List<KernelTypes::KLevel>,
                                  spine: Lists::List<KernelTypes::KExpr>, a0: KernelTypes::KExpr, a1: KernelTypes::KExpr,
                                  types: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr) {
      let wa = KernelWhnf::whnf(a0, types);
      let wb = KernelWhnf::whnf(a1, types);
      match try_extract_int(wa) {
        (1, sa, na) => {
          match try_extract_int(wb) {
            (1, sb, nb) => {
              let a_e = intern_int_lit(sa, na);
              let b_e = intern_int_lit(sb, nb);
              let head = (&(KernelTypes::KExprNode::Const(head_addr, head_lvls)));
              let r1 = (&(KernelTypes::KExprNode::App(head, a_e)));
              let r2 = (&(KernelTypes::KExprNode::App(r1, b_e)));
              let post = Lists::drop(spine, 2);
              (1, KernelWhnf::apply_spine(r2, post)) } ,
            _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
          } } ,
        _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
      }
    }

  fn try_dec_dispatch(head_addr: Bytes::AddressRef, head_lvls: Lists::List<KernelTypes::KLevel>,
                            spine: Lists::List<KernelTypes::KExpr>, types: Lists::List<KernelTypes::KExpr>)
                            -> (Field, KernelTypes::KExpr) {
      match UInt32::less_than_fields(Lists::length(spine), 2) {
        1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
        _ => {
          match is_int_dec_prim_addr(head_addr) {
            1 => {  try_normalize_int_decidable(head_addr, head_lvls,
                                                  spine, types) } ,
            _ => {
              let is_le = Bytes::address_eq(head_addr, nat_dec_le_addr_dec());
              let is_eq = Bytes::address_eq(head_addr, nat_dec_eq_addr_dec());
              let is_lt = Bytes::address_eq(head_addr, nat_dec_lt_addr_dec());
              match is_lt {
                1 => {  dec_rewrite_lt_to_le(head_lvls, spine, types) } ,
                _ => {  dec_dispatch_le_eq(is_le, is_eq, head_addr,
                                         head_lvls, spine, types) } ,
              } } ,
          } } ,
      }
    }

  fn dec_rewrite_lt_to_le(head_lvls: Lists::List<KernelTypes::KLevel>, spine: Lists::List<KernelTypes::KExpr>,
                             types: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr) {
      let n_e = Lists::lookup(spine, 0);
      let m_e = Lists::lookup(spine, 1);
      let n_w = KernelWhnf::whnf(n_e, types);
      match KernelNatPrim::try_extract_nat(n_w) {
        (0, _) => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
        (1, n_klimbs) => {
          let succ_lit = KernelNatPrim::mk_nat_lit(KernelKlimbs::klimbs_succ(n_klimbs));
          let dec_le_head = (&(KernelTypes::KExprNode::Const(
            nat_dec_le_addr_dec(), head_lvls)));
          let app1 = (&(KernelTypes::KExprNode::App(dec_le_head, succ_lit)));
          let app2 = (&(KernelTypes::KExprNode::App(app1, m_e)));
          let post = Lists::drop(spine, 2);
          (1, KernelWhnf::apply_spine(app2, post)) } ,
      }
    }

  fn dec_dispatch_le_eq(is_le: Field, is_eq: Field,
                           head_addr: Bytes::AddressRef, head_lvls: Lists::List<KernelTypes::KLevel>,
                           spine: Lists::List<KernelTypes::KExpr>, types: Lists::List<KernelTypes::KExpr>)
                           -> (Field, KernelTypes::KExpr) {
      let n_e = Lists::lookup(spine, 0);
      let m_e = Lists::lookup(spine, 1);
      let n_w = KernelWhnf::whnf(n_e, types);
      let m_w = KernelWhnf::whnf(m_e, types);
      match KernelNatPrim::try_extract_nat(n_w) {
        (0, _) => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
        (1, n_kl) => {
          match KernelNatPrim::try_extract_nat(m_w) {
            (0, _) => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
            (1, m_kl) => {
              let verdict = match is_le {
                1 => {  KernelKlimbs::klimbs_le(n_kl, m_kl) } ,
                _ => {  KernelLevels::klimbs_eq(n_kl, m_kl) } ,
              };
              dec_build_proof(is_le, is_eq, verdict, n_e, m_e,
                              head_addr, head_lvls, spine, types) } ,
          } } ,
      }
    }

  fn dec_build_proof(is_le: Field, is_eq: Field, verdict: Field,
                        n_e: KernelTypes::KExpr, m_e: KernelTypes::KExpr,
                        head_addr: Bytes::AddressRef, head_lvls: Lists::List<KernelTypes::KLevel>,
                        spine: Lists::List<KernelTypes::KExpr>, types: Lists::List<KernelTypes::KExpr>)
                        -> (Field, KernelTypes::KExpr) {

      let bail = is_le * (1 - verdict);
      match bail {
        1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
        _ => {

          let one_lvl = (&(KernelTypes::KLevelNode::Succ((&(KernelTypes::KLevelNode::Zero)))));
          let eq_refl_lvls = (&(Lists::Node::Cons(one_lvl, (&(Lists::Node::Nil)))));
          let eq_refl_c = (&(KernelTypes::KExprNode::Const(eq_refl_addr_dec(), eq_refl_lvls)));
          let bool_c = (&(KernelTypes::KExprNode::Const(bool_type_addr_dec(), (&(Lists::Node::Nil)))));
          let bool_lit_addr = match verdict {
            1 => {  KernelNatPrim::bool_true_addr() } ,
            _ => {  KernelNatPrim::bool_false_addr() } ,
          };
          let bool_lit_c = (&(KernelTypes::KExprNode::Const(bool_lit_addr, (&(Lists::Node::Nil)))));
          let r1 = (&(KernelTypes::KExprNode::App(eq_refl_c, bool_c)));
          let refl_proof = (&(KernelTypes::KExprNode::App(r1, bool_lit_c)));
          let proof_fn_addr = match is_le {
            1 => {
              match verdict {
                1 => {  nat_le_of_ble_eq_true_addr_dec() } ,
                _ => {  nat_not_le_of_not_ble_eq_true_addr_dec() } ,
              } } ,
            _ => {
              match verdict {
                1 => {  nat_eq_of_beq_eq_true_addr_dec() } ,
                _ => {  nat_ne_of_beq_eq_false_addr_dec() } ,
              } } ,
          };
          let proof_c = (&(KernelTypes::KExprNode::Const(proof_fn_addr, (&(Lists::Node::Nil)))));
          let p1 = (&(KernelTypes::KExprNode::App(proof_c, n_e)));
          let p2 = (&(KernelTypes::KExprNode::App(p1, m_e)));
          let proof = (&(KernelTypes::KExprNode::App(p2, refl_proof)));
          dec_finish(verdict, proof, head_addr, head_lvls, spine, types) } ,
      }
    }

  fn try_str_dec_eq(head_addr: Bytes::AddressRef, spine: Lists::List<KernelTypes::KExpr>,
                          types: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr) {
      match UInt32::less_than_fields(Lists::length(spine), 2) {
        1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
        _ => {
          let a0 = Lists::lookup(spine, 0);
          let a1 = Lists::lookup(spine, 1);
          match (*(a0)) {
            KernelTypes::KExprNode::Lit(la) => {
              match la {
                KernelTypes::KLiteral::Str(sa) => {
                  match (*(a1)) {
                    KernelTypes::KExprNode::Lit(lb) => {
                      match lb {
                        KernelTypes::KLiteral::Str(sb) => {
                          match KernelLevels::bytestream_eq(sa, sb) {
                            0 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                            _ => {  str_dec_eq_build(sa, head_addr, spine, types) } ,
                          } } ,
                        _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                      } } ,
                    _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
                  } } ,
                _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
              } } ,
            _ => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
          } } ,
      }
    }

  fn str_dec_eq_build(sa: Bytes::Stream, head_addr: Bytes::AddressRef, spine: Lists::List<KernelTypes::KExpr>,
                         types: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr) {
      let one_lvl = (&(KernelTypes::KLevelNode::Succ((&(KernelTypes::KLevelNode::Zero)))));
      let eq_refl_lvls = (&(Lists::Node::Cons(one_lvl, (&(Lists::Node::Nil)))));
      let eq_refl_c = (&(KernelTypes::KExprNode::Const(eq_refl_addr_dec(), eq_refl_lvls)));
      let str_c = (&(KernelTypes::KExprNode::Const(KernelNatPrim::string_type_addr(),
                                          (&(Lists::Node::Nil)))));
      let lit = (&(KernelTypes::KExprNode::Lit(KernelTypes::KLiteral::Str(sa))));
      let r1 = (&(KernelTypes::KExprNode::App(eq_refl_c, str_c)));
      let refl = (&(KernelTypes::KExprNode::App(r1, lit)));

      let head_c = (&(KernelTypes::KExprNode::Const(head_addr, (&(Lists::Node::Nil)))));
      let two_args = Lists::take(spine, 2);
      let call_expr = KernelWhnf::apply_spine(head_c, two_args);
      let call_ty = k_infer(call_expr, types);
      let call_ty_w = KernelWhnf::whnf(call_ty, types);
      match KernelTypes::collect_spine(call_ty_w) {
        (_, dec_args) => {
          match UInt32::less_than_fields(Lists::length(dec_args), 1) {
            1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
            _ => {
              let prop = Lists::lookup(dec_args, 0);
              let dec_c = (&(KernelTypes::KExprNode::Const(decidable_is_true_addr_dec(),
                                                  (&(Lists::Node::Nil)))));
              let d1 = (&(KernelTypes::KExprNode::App(dec_c, prop)));
              let d2 = (&(KernelTypes::KExprNode::App(d1, refl)));
              let post = Lists::drop(spine, 2);
              (1, KernelWhnf::apply_spine(d2, post)) } ,
          } } ,
      }
    }

  fn dec_finish(verdict: Field, proof: KernelTypes::KExpr, head_addr: Bytes::AddressRef,
                   head_lvls: Lists::List<KernelTypes::KLevel>, spine: Lists::List<KernelTypes::KExpr>,
                   types: Lists::List<KernelTypes::KExpr>) -> (Field, KernelTypes::KExpr) {
      let dec_addr = match verdict {
        1 => {  decidable_is_true_addr_dec() } ,
        _ => {  decidable_is_false_addr_dec() } ,
      };
      let head_c = (&(KernelTypes::KExprNode::Const(head_addr, head_lvls)));
      let two_args = Lists::take(spine, 2);
      let call_expr = KernelWhnf::apply_spine(head_c, two_args);
      let call_ty = k_infer(call_expr, types);
      let call_ty_w = KernelWhnf::whnf(call_ty, types);
      match KernelTypes::collect_spine(call_ty_w) {
        (_, dec_args) => {
          match UInt32::less_than_fields(Lists::length(dec_args), 1) {
            1 => {  (0, (&(KernelTypes::KExprNode::BVar(0)))) } ,
            _ => {
              let prop = Lists::lookup(dec_args, 0);
              let dec_c = (&(KernelTypes::KExprNode::Const(dec_addr, (&(Lists::Node::Nil)))));
              let d1 = (&(KernelTypes::KExprNode::App(dec_c, prop)));
              let d2 = (&(KernelTypes::KExprNode::App(d1, proof)));
              let post = Lists::drop(spine, 2);
              (1, KernelWhnf::apply_spine(d2, post)) } ,
          } } ,
      }
    }
}
