  fn peel_params_subst(ty: KernelTypes::KExpr, args: Lists::List<KernelTypes::KExpr>, n_params: Field) -> KernelTypes::KExpr {
      match n_params {
        0 => {  ty } ,
        _ => {
          match (*(ty)) {
            KernelTypes::KExprNode::Forall(_, body) => {
              match (*(args)) {
                Lists::Node::Cons(arg, rest) => {
                  let body_substed = KernelSubst::expr_inst1(body, arg, 0);
                  peel_params_subst(body_substed, rest, n_params - 1) } ,
              } } ,
          } } ,
      }
    }

  fn is_inductive_prop(ind_ty: KernelTypes::KExpr, lvls: Lists::List<KernelTypes::KLevel>, n_skip: Field,
                              types: Lists::List<KernelTypes::KExpr>) -> Field {
      let ind_ty_inst = KernelLevels::expr_inst_levels(ind_ty, lvls);
      let result = peel_n_alls_whnf(ind_ty_inst, n_skip, types);

      match (*(result)) {
        KernelTypes::KExprNode::Srt(l) => {  KernelLevels::level_equal(l, (&(KernelTypes::KLevelNode::Zero))) } ,
      }
    }

  fn peel_n_alls_whnf(e: KernelTypes::KExpr, n: Field, types: Lists::List<KernelTypes::KExpr>) -> KernelTypes::KExpr {
      match n {
        0 => {  KernelWhnf::whnf(e, types) } ,
        _ => {
          let ew = KernelWhnf::whnf(e, types);
          match (*(ew)) {
            KernelTypes::KExprNode::Forall(dom, body) => {
              let t2 = (&(Lists::Node::Cons(dom, types)));
              peel_n_alls_whnf(body, n - 1, t2) } ,
            _ => {  ew } ,
          } } ,
      }
    }

  fn check_prop_field_if_prop(is_prop: Field, dom: KernelTypes::KExpr,
                                     types: Lists::List<KernelTypes::KExpr>) -> () {
      match is_prop {
        0 => {  () } ,
        _ => {
          let lvl = k_ensure_sort(dom, types);
          assert_eq!(KernelLevels::level_equal(lvl, (&(KernelTypes::KLevelNode::Zero))), 1,
            "projection on a Prop structure: field is not a Prop");
          () } ,
      }
    }

  fn check_no_dep_data_field_if_prop(is_prop: Field, dom: KernelTypes::KExpr, body: KernelTypes::KExpr,
                                            types: Lists::List<KernelTypes::KExpr>) -> () {
      match is_prop {
        0 => {  () } ,
        _ => {
          let lvl = k_ensure_sort(dom, types);
          match KernelLevels::level_equal(lvl, (&(KernelTypes::KLevelNode::Zero))) {
            1 => {  () } ,
            _ => {

              assert_eq!(KernelSubst::expr_lbr(body), 0,
                "projection on a Prop structure: later fields depend on a data field");
              () } ,
          } } ,
      }
    }

  fn peel_field_loop(ty: KernelTypes::KExpr, target: Field, current: Field,
                           struct_addr: Bytes::AddressRef, val: KernelTypes::KExpr, is_prop: Field,
                           types: Lists::List<KernelTypes::KExpr>) -> KernelTypes::KExpr {
      match (*(ty)) {
        KernelTypes::KExprNode::Forall(dom, body) => {
          match target - current {
            0 => {
              check_prop_field_if_prop(is_prop, dom, types);
              dom } ,
            _ => {
              check_no_dep_data_field_if_prop(is_prop, dom, body, types);
              let proj_expr = (&(KernelTypes::KExprNode::Proj(struct_addr, current, val)));
              let body_substed = KernelSubst::expr_inst1(body, proj_expr, 0);
              peel_field_loop(body_substed, target, current + 1,
                                   struct_addr, val, is_prop, types) } ,
          } } ,
      }
    }

  fn k_infer_proj(struct_addr: Bytes::AddressRef, fidx: Field, e1: KernelTypes::KExpr,
                        types: Lists::List<KernelTypes::KExpr>) -> KernelTypes::KExpr {
      let val_ty = k_infer(e1, types);
      let wty = KernelWhnf::whnf(val_ty, types);
      match KernelTypes::collect_spine(wty) {
        (head, args) => {
          match (*(head)) {
            KernelTypes::KExprNode::Const(head_addr, lvls) => {
              assert_eq!(Bytes::address_eq(head_addr, struct_addr), 1,
                "projection's structure type differs from the value's head");
              let ind_ci = (*(Ingress::get_ci(head_addr)));
              match ind_ci {
                KernelTypes::KConstantInfo::Induct(_, ind_ty, n_params, n_indices, num_ctors, _,
                                       block_addr, ind_idx) => {

                  assert_eq!(num_ctors, 1,
                    "projection on an inductive with more than one constructor");
                  let ctor_ci = (*(Ingress::get_ci_cprj(block_addr, ind_idx, 0)));
                  match ctor_ci {
                    KernelTypes::KConstantInfo::Ctor(_, ctor_ty, _, _, _, _, _, _) => {
                      let ctor_ty_inst = KernelLevels::expr_inst_levels(ctor_ty, lvls);
                      let after_params = peel_params_subst(ctor_ty_inst, args, n_params);

                      let is_prop = is_inductive_prop(ind_ty, lvls,
                                      n_params + n_indices, types);
                      peel_field_loop(after_params, fidx, 0,
                                           struct_addr, e1, is_prop, types) } ,
                  } } ,
              } } ,
          } } ,
      }
    }

  fn k_ensure_sort(e: KernelTypes::KExpr, types: Lists::List<KernelTypes::KExpr>) -> KernelTypes::KLevel {
      let t = k_infer(e, types);
      let tw = KernelWhnf::whnf(t, types);
      match (*(tw)) {
        KernelTypes::KExprNode::Srt(l) => {  l } ,
      }
    }

  fn k_check(e: KernelTypes::KExpr, expected: KernelTypes::KExpr, types: Lists::List<KernelTypes::KExpr>) -> () {
      let inferred = k_infer(e, types);
      let d = KernelDefEq::k_is_def_eq(inferred, expected, types);
      assert_eq!(d, 1, "inferred type is not def-eq to the expected type");
    }

