    let (commit_pow_witnesses, j1) = read_u64_vec(j0);
    let (input_openings, j2) = read_batch_opening_vec(j1);
    let (commit_phase_openings, j3) = read_commit_phase_step_vec(j2);
    let (final_poly, j4) = read_ext_vec(j3);
    let (query_pow_witness, j5) = read_u64_at(j4);
    (FriProof::Mk(commit_phase_commits, commit_pow_witnesses, input_openings,
                 commit_phase_openings, final_poly, query_pow_witness), j5)
  }

  fn read_active(i: Field) -> (List<Field>, Field) {
    let (n, j) = read_count_at(i);
    read_active_n(j, n)
  }
  fn read_active_n(i: Field, n: Field) -> (List<Field>, Field) {
    match n {
      0 => {  (store(Lists::Node::Nil), i) } ,
      _ => {
        let (b, j) = read_u8_at(i);
        let (rest, j2) = read_active_n(j, n - 1);
        (store(Lists::Node::Cons(UInt8::to_field(b), rest)), j2) } ,
    }
  }

  fn read_preprocessed(i: Field) -> (PreprocessedOpt, Field) {
    let (tag, j) = read_u8_at(i);
    match UInt8::to_field(tag) {
      0 => {  (PreprocessedOpt::NoPreprocessed, j) } ,
      _ => {
        let (r, j2) = read_opened_round(j);
        (PreprocessedOpt::SomePreprocessed(r), j2) } ,
    }
  }

  fn read_proof(i: Field) -> (Proof, Field) {
    let (active, ja) = read_active(i);
    let (commitments, j0) = read_commitments(ja);
    let (intermediate_accumulators, j1) = read_ext_vec(j0);
    let (log_degrees, j2) = read_u8_vec(j1);
    let (opening_proof, j3) = read_fri_proof(j2);
    let (quotient_opened_values, j4) = read_opened_round(j3);
    let (preprocessed_opened_values, j5) = read_preprocessed(j4);
    let (stage_1_opened_values, j6) = read_opened_round(j5);
    let (stage_2_opened_values, j7) = read_opened_round(j6);
    (Proof::Mk(active, commitments, intermediate_accumulators, log_degrees,
              opening_proof, quotient_opened_values, preprocessed_opened_values,
              stage_1_opened_values, stage_2_opened_values), j7)
  }

  fn read_header(i: Field) -> (ShardHeader, Field) {
    let (active, j0) = read_active(i);
    let (stage_1, j1) = read_merkle_cap_at(j0);
    let (log_degrees, j2) = read_u8_vec(j1);
    let (claims, j3) = read_u64_vec_vec(j2);
    (ShardHeader::Mk(active, stage_1, log_degrees, claims), j3)
  }
  fn read_header_vec(i: Field) -> (List<ShardHeader>, Field) {
    let (n, j) = read_count_at(i);
    read_header_vec_n(j, n)
  }
  fn read_header_vec_n(i: Field, n: Field) -> (List<ShardHeader>, Field) {
    match n {
      0 => {  (store(Lists::Node::Nil), i) } ,
      _ => {
        let (x, j) = read_header(i);
        let (rest, j2) = read_header_vec_n(j, n - 1);
        (store(Lists::Node::Cons(x, rest)), j2) } ,
    }
  }

  fn read_message(i: Field) -> (BatchMessage, Field) {
    let (args, j0) = read_u64_vec(i);
    let (multiplicity, j1) = read_u64_at(j0);
    (BatchMessage::Mk(args, multiplicity), j1)
  }
  fn read_message_vec(i: Field) -> (List<BatchMessage>, Field) {
    let (n, j) = read_count_at(i);
    read_message_vec_n(j, n)
  }
  fn read_message_vec_n(i: Field, n: Field) -> (List<BatchMessage>, Field) {
    match n {
      0 => {  (store(Lists::Node::Nil), i) } ,
      _ => {
        let (x, j) = read_message(i);
        let (rest, j2) = read_message_vec_n(j, n - 1);
        (store(Lists::Node::Cons(x, rest)), j2) } ,
    }
  }

  fn read_proof_vec(i: Field) -> (List<Proof>, Field) {
    let (n, j) = read_count_at(i);
    read_proof_vec_n(j, n)
  }
  fn read_proof_vec_n(i: Field, n: Field) -> (List<Proof>, Field) {
    match n {
      0 => {  (store(Lists::Node::Nil), i) } ,
      _ => {
        let (x, j) = read_proof(i);
        let (rest, j2) = read_proof_vec_n(j, n - 1);
        (store(Lists::Node::Cons(x, rest)), j2) } ,
    }
  }

  fn read_batch(i: Field) -> (Batch, Field) {
    let (headers, j0) = read_header_vec(i);
    let (messages, j1) = read_message_vec(j0);
    let (proofs, j2) = read_proof_vec(j1);
    (Batch::Mk(headers, messages, proofs), j2)
  }

  fn read_vk_u8(s: ByteStream) -> (U8, ByteStream) {
    match load(s) {
      Lists::Node::Cons(byte, rest) => {  (byte, rest) } ,
    }
  }

  fn read_vk_tag(s: ByteStream) -> (Field, ByteStream) {
    let (b, rest) = read_vk_u8(s);
    (UInt8::to_field(b), rest)
  }

  fn read_vk_u16(s: ByteStream) -> (Field, ByteStream) {
    let (b0, s0) = read_vk_u8(s);
    let (b1, s1) = read_vk_u8(s0);
    (UInt8::to_field(b0) + 256 * UInt8::to_field(b1), s1)
  }

  fn read_vk_u16_limb(s: ByteStream) -> (Field, U64, ByteStream) {
    let (b0, s0) = read_vk_u8(s);
    let (b1, s1) = read_vk_u8(s0);
    (UInt8::to_field(b0) + 256 * UInt8::to_field(b1),
     [b0, b1,
      UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0],
     s1)
  }

  fn read_vk_u32_limb(s: ByteStream) -> (Field, U64, ByteStream) {
    let (b0, s0) = read_vk_u8(s); let (b1, s1) = read_vk_u8(s0);
    let (b2, s2) = read_vk_u8(s1); let (b3, s3) = read_vk_u8(s2);
    (UInt8::to_field(b0) + 256 * UInt8::to_field(b1) + 65536 * UInt8::to_field(b2) + 16777216 * UInt8::to_field(b3),
     [b0, b1, b2, b3,
      UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0],
     s3)
  }

  fn read_vk_u64(s: ByteStream) -> (U64, ByteStream) {
    let (b0, s0) = read_vk_u8(s); let (b1, s1) = read_vk_u8(s0);
    let (b2, s2) = read_vk_u8(s1); let (b3, s3) = read_vk_u8(s2);
    let (b4, s4) = read_vk_u8(s3); let (b5, s5) = read_vk_u8(s4);
    let (b6, s6) = read_vk_u8(s5); let (b7, s7) = read_vk_u8(s6);
    ([b0, b1, b2, b3, b4, b5, b6, b7], s7)
  }

  fn read_field(i: ByteStream) -> (Field, ByteStream) {
    let (u, j) = read_vk_u64(i);
    (gl_val(u), j)
  }

  fn read_vk_digest(i: ByteStream) -> (Digest, ByteStream) {
    let (a, j0) = read_vk_u64(i);
    let (b, j1) = read_vk_u64(j0);
    let (c, j2) = read_vk_u64(j1);
    let (d, j3) = read_vk_u64(j2);
    ([a, b, c, d], j3)
  }
  fn read_vk_cap_n(i: ByteStream, n: Field) -> (MerkleCap, ByteStream) {
    match n {
      0 => {  (store(Lists::Node::Nil), i) } ,
      _ => {
        let (x, j) = read_vk_digest(i);
        let (rest, j2) = read_vk_cap_n(j, n - 1);
        (store(Lists::Node::Cons(store(x), rest)), j2) } ,
    }
  }

  fn read_nodes_n(i: ByteStream, n: Field, node_idx: Field) -> (List<SysNode>, ByteStream) {
    match n {
      0 => {  (store(Lists::Node::Nil), i) } ,
      _ => {
        let (tag, i1) = read_vk_tag(i);
        match tag {
          0 => {
            let (c, i2) = read_vk_u16(i1);
            let (rest, i3) = read_nodes_n(i2, n - 1, node_idx + 1);
            (store(Lists::Node::Cons(SysNode::Const(c), rest)), i3) } ,
          1 => {
            let (c, i2) = read_field(i1);
            let (rest, i3) = read_nodes_n(i2, n - 1, node_idx + 1);
            (store(Lists::Node::Cons(SysNode::Const(c), rest)), i3) } ,
          2 => {
            let (idx, i2) = read_vk_tag(i1);
            let (rest, i3) = read_nodes_n(i2, n - 1, node_idx + 1);
            (store(Lists::Node::Cons(SysNode::Public(idx), rest)), i3) } ,
          3 => {
            let (rest, i3) = read_nodes_n(i1, n - 1, node_idx + 1);
            (store(Lists::Node::Cons(SysNode::IsFirstRow, rest)), i3) } ,
          4 => {
            let (rest, i3) = read_nodes_n(i1, n - 1, node_idx + 1);
            (store(Lists::Node::Cons(SysNode::IsLastRow, rest)), i3) } ,
          5 => {
            let (rest, i3) = read_nodes_n(i1, n - 1, node_idx + 1);
            (store(Lists::Node::Cons(SysNode::IsTransition, rest)), i3) } ,
          6 => {
            let (a, i2) = read_vk_u16(i1);
            let (b, i3) = read_vk_u16(i2);
            assert_eq!(UInt32::less_than_fields(a, node_idx), 1,
              "vk: expression child must precede its parent");
            assert_eq!(UInt32::less_than_fields(b, node_idx), 1,
              "vk: expression child must precede its parent");
            let (rest, i4) = read_nodes_n(i3, n - 1, node_idx + 1);
            (store(Lists::Node::Cons(SysNode::Add(a, b), rest)), i4) } ,
          7 => {
            let (a, i2) = read_vk_u16(i1);
            let (b, i3) = read_vk_u16(i2);
            assert_eq!(UInt32::less_than_fields(a, node_idx), 1,
              "vk: expression child must precede its parent");
            assert_eq!(UInt32::less_than_fields(b, node_idx), 1,
              "vk: expression child must precede its parent");
            let (rest, i4) = read_nodes_n(i3, n - 1, node_idx + 1);
            (store(Lists::Node::Cons(SysNode::Sub(a, b), rest)), i4) } ,
          8 => {
            let (a, i2) = read_vk_u16(i1);
            let (b, i3) = read_vk_u16(i2);
            assert_eq!(UInt32::less_than_fields(a, node_idx), 1,
              "vk: expression child must precede its parent");
            assert_eq!(UInt32::less_than_fields(b, node_idx), 1,
              "vk: expression child must precede its parent");
            let (rest, i4) = read_nodes_n(i3, n - 1, node_idx + 1);
            (store(Lists::Node::Cons(SysNode::Mul(a, b), rest)), i4) } ,
          9 => {
            let (a, i2) = read_vk_u16(i1);
            assert_eq!(UInt32::less_than_fields(a, node_idx), 1,
              "vk: expression child must precede its parent");
            let (rest, i3) = read_nodes_n(i2, n - 1, node_idx + 1);
            (store(Lists::Node::Cons(SysNode::Neg(a), rest)), i3) } ,
          10 => {
            let (idx, i2) = read_vk_u16(i1);
            let (rest, i3) = read_nodes_n(i2, n - 1, node_idx + 1);
            (store(Lists::Node::Cons(SysNode::Var(0, 0, idx), rest)), i3) } ,
          11 => {
            let (idx, i2) = read_vk_u16(i1);
            let (rest, i3) = read_nodes_n(i2, n - 1, node_idx + 1);
            (store(Lists::Node::Cons(SysNode::Var(0, 1, idx), rest)), i3) } ,
          12 => {
            let (idx, i2) = read_vk_u16(i1);
            let (rest, i3) = read_nodes_n(i2, n - 1, node_idx + 1);
            (store(Lists::Node::Cons(SysNode::Var(1, 0, idx), rest)), i3) } ,
          13 => {
            let (idx, i2) = read_vk_u16(i1);
            let (rest, i3) = read_nodes_n(i2, n - 1, node_idx + 1);
            (store(Lists::Node::Cons(SysNode::Var(1, 1, idx), rest)), i3) } ,
          14 => {
            let (idx, i2) = read_vk_u16(i1);
            let (rest, i3) = read_nodes_n(i2, n - 1, node_idx + 1);
            (store(Lists::Node::Cons(SysNode::Var(2, 0, idx), rest)), i3) } ,
          _ => {
            let (idx, i2) = read_vk_u16(i1);
            let (rest, i3) = read_nodes_n(i2, n - 1, node_idx + 1);
            (store(Lists::Node::Cons(SysNode::Var(2, 1, idx), rest)), i3) } ,
        } } ,
    }
  }

  fn read_node_ids_n(i: ByteStream, n: Field) -> (List<Field>, ByteStream) {
    match n {
      0 => {  (store(Lists::Node::Nil), i) } ,
      _ => {
        let (id, i1) = read_vk_u16(i);
        let (rest, i2) = read_node_ids_n(i1, n - 1);
        (store(Lists::Node::Cons(id, rest)), i2) } ,
    }
  }

  fn read_sys_lookup(i: ByteStream) -> (SysLookup, ByteStream) {
    let (m, i1) = read_vk_u16(i);
    let (ac, i2) = read_vk_u16(i1);
    let (args, i3) = read_node_ids_n(i2, ac);
    (SysLookup::Mk(m, args), i3)
  }
  fn read_sys_lookups_n(i: ByteStream, n: Field) -> (List<SysLookup>, ByteStream) {
    match n {
      0 => {  (store(Lists::Node::Nil), i) } ,
      _ => {
        let (x, j) = read_sys_lookup(i);
        let (rest, j2) = read_sys_lookups_n(j, n - 1);
        (store(Lists::Node::Cons(x, rest)), j2) } ,
    }
  }

  fn lookup_groups_count(n: Field, rem: Field, k: Field) -> Field {
    match n {
      0 => {  0 } ,
      _ => {  match rem {
        0 => {  1 + lookup_groups_count(n - 1, k - 1, k) } ,
        _ => {  lookup_groups_count(n - 1, rem - 1, k) } ,
      } } ,
    }
  }

  fn read_sys_circuit(base: ByteStream) -> (SysCircuit, [U64; 7], ByteStream) {
    let (mw, mwl, c1) = read_vk_u16_limb(base);
    let (pw, pwl, c2) = read_vk_u16_limb(c1);
    let (ph, phl, c3) = read_vk_u32_limb(c2);
    let (md, mdl, c4) = read_vk_u16_limb(c3);
    let (k, c4b) = read_vk_tag(c4);
    let (ncount, c5) = read_vk_u16(c4b);
    let (nodes, c6) = read_nodes_n(c5, ncount, 0);
    let (zcount, c7) = read_vk_u16(c6);
    let (zeros, c8) = read_node_ids_n(c7, zcount);
    let (lcount, c9) = read_vk_u16(c8);
    let (lks, c10) = read_sys_lookups_n(c9, lcount);

    let groups = lookup_groups_count(lcount, 0, k);
    let gslots = groups + Fields::is_zero(groups);
    let s2w = gslots + gslots;
    let ccl = gl_to_bytes(zcount + s2w);
    let s2wl = gl_to_bytes(s2w);
    let kl = gl_to_bytes(k);
    (SysCircuit::Mk(nodes, ncount, zeros, md, lks, k, mw, pw, s2w),
     [ccl, mdl, phl, pwl, mwl, s2wl, kl], c10)
  }
  fn cons_shape7(l: [U64; 7], tail: List<U64>) -> List<U64> {
    store(Lists::Node::Cons(l[0], store(Lists::Node::Cons(l[1], store(Lists::Node::Cons(l[2],
    store(Lists::Node::Cons(l[3], store(Lists::Node::Cons(l[4], store(Lists::Node::Cons(l[5],
    store(Lists::Node::Cons(l[6], tail))))))))))))))
  }

  fn read_sys_circuits_n(i: ByteStream, n: Field) -> (List<SysCircuit>, List<U64>, ByteStream) {
    match n {
      0 => {  (store(Lists::Node::Nil), store(Lists::Node::Nil), i) } ,
      _ => {
        let (x, xl, j) = read_sys_circuit(i);
        let (rest, lrest, j2) = read_sys_circuits_n(j, n - 1);
        (store(Lists::Node::Cons(x, rest)), cons_shape7(xl, lrest), j2) } ,
    }
  }

  fn read_opt_commit(i: ByteStream) -> (OptCommit, ByteStream) {
    let (tag, j) = read_vk_u8(i);
    match UInt8::to_field(tag) {
      0 => {  (OptCommit::NoCommit, j) } ,
      _ => {
        let (n, j1) = read_vk_u16(j);
        let (c, j2) = read_vk_cap_n(j1, n);
        (OptCommit::SomeCommit(c), j2) } ,
    }
  }

  fn read_opt_idx_n(i: ByteStream, n: Field) -> (List<OptIdx>, ByteStream) {
    match n {
      0 => {  (store(Lists::Node::Nil), i) } ,
      _ => {
        let (v, j) = read_vk_u16(i);
        let (rest, j2) = read_opt_idx_n(j, n - 1);
        match v {
          65535 => {  (store(Lists::Node::Cons(OptIdx::NoIdx, rest)), j2) } ,
          _ => {  (store(Lists::Node::Cons(OptIdx::SomeIdx(v), rest)), j2) } ,
        } } ,
    }
  }

  fn read_sys_params(i: ByteStream) -> (SysParams, List<U64>, ByteStream) {
    let (p0, l0, j0) = read_vk_u16_limb(i);
    let (p1, l1, j1) = read_vk_u16_limb(j0);
    let (p2, l2, j2) = read_vk_u16_limb(j1);
    let (p3, l3, j3) = read_vk_u16_limb(j2);
    let (p4, l4, j4) = read_vk_u16_limb(j3);
    let (p5, l5, j5) = read_vk_u16_limb(j4);
    let (p6, l6, j6) = read_vk_u16_limb(j5);
    (SysParams::Mk(p0, p1, p2, p3, p4, p5, p6),
     store(Lists::Node::Cons(l0, store(Lists::Node::Cons(l1, store(Lists::Node::Cons(l2,
     store(Lists::Node::Cons(l3, store(Lists::Node::Cons(l4, store(Lists::Node::Cons(l5,
     store(Lists::Node::Cons(l6, store(Lists::Node::Nil))))))))))))))),
     j6)
  }

  fn read_system(i: ByteStream) -> (Sys, ByteStream) {
    let (params, plimbs, j) = read_sys_params(i);
    let (n, nlimb, j1) = read_vk_u16_limb(j);
    let (circuits, climbs, j2) = read_sys_circuits_n(j1, n);
    let (commit, j3) = read_opt_commit(j2);
    let (indices, j4) = read_opt_idx_n(j3, n);
    (Sys::Mk(params,
            list_concat(plimbs, store(Lists::Node::Cons(nlimb, climbs))),
            circuits, commit, indices),
     j4)
  }

  fn b3_w4_onto(w: U32, tail: ByteStream) -> ByteStream {
    let w = UInt32::to_bytes(w);
    store(Lists::Node::Cons(w[0], store(Lists::Node::Cons(w[1], store(Lists::Node::Cons(w[2],
    store(Lists::Node::Cons(w[3], tail))))))))
  }

  fn b3_flatten_onto(h: [U32; 8], tail: ByteStream) -> ByteStream {
    b3_w4_onto(h[0], b3_w4_onto(h[1], b3_w4_onto(h[2], b3_w4_onto(h[3],
    b3_w4_onto(h[4], b3_w4_onto(h[5], b3_w4_onto(h[6], b3_w4_onto(h[7], tail))))))))
  }

  fn b3_to_digest(h: [U32; 8]) -> Digest {
    let h = [UInt32::to_bytes(h[0]), UInt32::to_bytes(h[1]), UInt32::to_bytes(h[2]), UInt32::to_bytes(h[3]), UInt32::to_bytes(h[4]), UInt32::to_bytes(h[5]), UInt32::to_bytes(h[6]), UInt32::to_bytes(h[7])];
    [[h[0][0], h[0][1], h[0][2], h[0][3], h[1][0], h[1][1], h[1][2], h[1][3]],
     [h[2][0], h[2][1], h[2][2], h[2][3], h[3][0], h[3][1], h[3][2], h[3][3]],
     [h[4][0], h[4][1], h[4][2], h[4][3], h[5][0], h[5][1], h[5][2], h[5][3]],
     [h[6][0], h[6][1], h[6][2], h[6][3], h[7][0], h[7][1], h[7][2], h[7][3]]]
  }

  fn mmcs_compress(ap: DigestP, bp: DigestP) -> DigestP {
    let IV = [UInt32::from_bytes([UInt8::BYTE_103, UInt8::BYTE_230, UInt8::BYTE_9, UInt8::BYTE_106]), UInt32::from_bytes([UInt8::BYTE_133, UInt8::BYTE_174, UInt8::BYTE_103, UInt8::BYTE_187]), UInt32::from_bytes([UInt8::BYTE_114, UInt8::BYTE_243, UInt8::BYTE_110, UInt8::BYTE_60]), UInt32::from_bytes([UInt8::BYTE_58, UInt8::BYTE_245, UInt8::BYTE_79, UInt8::BYTE_165]), UInt32::from_bytes([UInt8::BYTE_127, UInt8::BYTE_82, UInt8::BYTE_14, UInt8::BYTE_81]), UInt32::from_bytes([UInt8::BYTE_140, UInt8::BYTE_104, UInt8::BYTE_5, UInt8::BYTE_155]), UInt32::from_bytes([UInt8::BYTE_171, UInt8::BYTE_217, UInt8::BYTE_131, UInt8::BYTE_31]), UInt32::from_bytes([UInt8::BYTE_25, UInt8::BYTE_205, UInt8::BYTE_224, UInt8::BYTE_91])];
    let a = load(ap);
    let b = load(bp);
    let block = [
      UInt32::from_bytes([a[0][0], a[0][1], a[0][2], a[0][3]]), UInt32::from_bytes([a[0][4], a[0][5], a[0][6], a[0][7]]),
      UInt32::from_bytes([a[1][0], a[1][1], a[1][2], a[1][3]]), UInt32::from_bytes([a[1][4], a[1][5], a[1][6], a[1][7]]),
      UInt32::from_bytes([a[2][0], a[2][1], a[2][2], a[2][3]]), UInt32::from_bytes([a[2][4], a[2][5], a[2][6], a[2][7]]),
      UInt32::from_bytes([a[3][0], a[3][1], a[3][2], a[3][3]]), UInt32::from_bytes([a[3][4], a[3][5], a[3][6], a[3][7]]),
      UInt32::from_bytes([b[0][0], b[0][1], b[0][2], b[0][3]]), UInt32::from_bytes([b[0][4], b[0][5], b[0][6], b[0][7]]),
      UInt32::from_bytes([b[1][0], b[1][1], b[1][2], b[1][3]]), UInt32::from_bytes([b[1][4], b[1][5], b[1][6], b[1][7]]),
      UInt32::from_bytes([b[2][0], b[2][1], b[2][2], b[2][3]]), UInt32::from_bytes([b[2][4], b[2][5], b[2][6], b[2][7]]),
      UInt32::from_bytes([b[3][0], b[3][1], b[3][2], b[3][3]]), UInt32::from_bytes([b[3][4], b[3][5], b[3][6], b[3][7]])];
    store(b3_to_digest(Blake3::compress_init(IV, block, [UInt8::BYTE_0; 8], 64, 11)))
  }
fn digest_eq(ap: DigestP, bp: DigestP) -> Field {
    let a = load(ap);
    let b = load(bp);
    UInt64::eq(a[0], b[0]) * UInt64::eq(a[1], b[1]) *
    UInt64::eq(a[2], b[2]) * UInt64::eq(a[3], b[3])
}

  fn compress_ordered(bit: Field, d: DigestP, s: DigestP) -> DigestP {
    match bit {
      0 => {  mmcs_compress(d, s) } ,
      _ => {  mmcs_compress(s, d) } ,
    }
  }

  fn has_height(lhs: List<Field>, target: Field) -> Field {
    match load(lhs) {
      Lists::Node::Nil => {  0 } ,
      Lists::Node::Cons(h, rest) => {
        match Fields::is_zero(h - target) {
          1 => {  1 } ,
          _ => {  has_height(rest, target) } ,
        } } ,
    }
  }

  fn select_rows(rows: List<List<U64>>, lhs: List<Field>, target: Field) -> List<List<U64>> {
    match load(rows) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(r, rrest) => {
        let &Lists::Node::Cons(lh, lrest) = lhs;
        match Fields::is_zero(lh - target) {
          0 => {  select_rows(rrest, lrest, target) } ,
          _ => {  match load(r) {
            Lists::Node::Nil => {  select_rows(rrest, lrest, target) } ,
            _ => {  store(Lists::Node::Cons(r, select_rows(rrest, lrest, target))) } ,
          } } ,
        } } ,
    }
  }

  fn select_rows_le(rows: List<List<U64>>, lhs: List<Field>, target: Field) -> List<List<U64>> {
    match load(rows) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(r, rrest) => {
        let &Lists::Node::Cons(lh, lrest) = lhs;
        match UInt32::less_than_fields(target, lh) {
          1 => {  select_rows_le(rrest, lrest, target) } ,
          _ => {  match load(r) {
            Lists::Node::Nil => {  select_rows_le(rrest, lrest, target) } ,
            _ => {  store(Lists::Node::Cons(r, select_rows_le(rrest, lrest, target))) } ,
          } } ,
        } } ,
    }
  }

  fn rows_pop(cur: List<U64>, rows: List<List<U64>>) -> (U64, List<U64>, List<List<U64>>, Field) {
    match load(cur) {
      Lists::Node::Cons(x, rest) => {  (gl_to_bytes(gl_val(x)), rest, rows, 1) } ,
      Lists::Node::Nil => {  match load(rows) {
        Lists::Node::Nil => {  ([UInt8::BYTE_0; 8], cur, rows, 0) } ,
        Lists::Node::Cons(r, rrest) => {  rows_pop(r, rrest) } ,
      } } ,
    }
  }

  fn b3_rows_chunks(cur: List<U64>, rows: List<List<U64>>, block_no: Field, chunk_count: &U64, cv: &[U32; 8], layer: Layer) -> Layer {
    let (l0, c1, r1, g0) = rows_pop(cur, rows);
    match g0 {

      0 => {
        match UInt64::is_zero(load(chunk_count)) { 1 => {
            store(Blake3::LayerNode::Push(layer, Blake3::compress_init(load(cv), [UInt32::ZERO; 16], load(chunk_count), 0, 11))) } ,
          _ => {  layer } ,
        } } ,
      _ => {
        let (l1, c2, r2, g1) = rows_pop(c1, r1);
        let (l2, c3, r3, g2) = rows_pop(c2, r2);
        let (l3, c4, r4, g3) = rows_pop(c3, r3);
        let (l4, c5, r5, g4) = rows_pop(c4, r4);
        let (l5, c6, r6, g5) = rows_pop(c5, r5);
        let (l6, c7, r7, g6) = rows_pop(c6, r6);
        let (l7, c8, r8, g7) = rows_pop(c7, r7);
        let nbytes = 8 * (g0 + g1 + g2 + g3 + g4 + g5 + g6 + g7);
        let block = [
          UInt32::from_bytes([l0[0], l0[1], l0[2], l0[3]]), UInt32::from_bytes([l0[4], l0[5], l0[6], l0[7]]),
          UInt32::from_bytes([l1[0], l1[1], l1[2], l1[3]]), UInt32::from_bytes([l1[4], l1[5], l1[6], l1[7]]),
          UInt32::from_bytes([l2[0], l2[1], l2[2], l2[3]]), UInt32::from_bytes([l2[4], l2[5], l2[6], l2[7]]),
          UInt32::from_bytes([l3[0], l3[1], l3[2], l3[3]]), UInt32::from_bytes([l3[4], l3[5], l3[6], l3[7]]),
          UInt32::from_bytes([l4[0], l4[1], l4[2], l4[3]]), UInt32::from_bytes([l4[4], l4[5], l4[6], l4[7]]),
          UInt32::from_bytes([l5[0], l5[1], l5[2], l5[3]]), UInt32::from_bytes([l5[4], l5[5], l5[6], l5[7]]),
          UInt32::from_bytes([l6[0], l6[1], l6[2], l6[3]]), UInt32::from_bytes([l6[4], l6[5], l6[6], l6[7]]),
          UInt32::from_bytes([l7[0], l7[1], l7[2], l7[3]]), UInt32::from_bytes([l7[4], l7[5], l7[6], l7[7]])];
        let empty = match load(c8) {
          Lists::Node::Nil => {  match load(r8) { Lists::Node::Nil => {  1 } , _ => {  0 } , } } ,
          _ => {  0 } ,
        };
        let at15 = Fields::is_zero(block_no - 15);
        let start_flag = Fields::is_zero(block_no);
        let end_flag = empty + at15 - (empty * at15);
        let root_flag = empty * UInt64::is_zero(load(chunk_count));
        let flags = start_flag + 2 * end_flag + 8 * root_flag;
        let digest = Blake3::compress_init(load(cv), block, load(chunk_count), nbytes, flags);
        match (empty, at15) {
          (1, _) => {  store(Blake3::LayerNode::Push(layer, digest)) } ,
          (_, 1) => {
            let IV = [UInt32::from_bytes([UInt8::BYTE_103, UInt8::BYTE_230, UInt8::BYTE_9, UInt8::BYTE_106]), UInt32::from_bytes([UInt8::BYTE_133, UInt8::BYTE_174, UInt8::BYTE_103, UInt8::BYTE_187]), UInt32::from_bytes([UInt8::BYTE_114, UInt8::BYTE_243, UInt8::BYTE_110, UInt8::BYTE_60]), UInt32::from_bytes([UInt8::BYTE_58, UInt8::BYTE_245, UInt8::BYTE_79, UInt8::BYTE_165]), UInt32::from_bytes([UInt8::BYTE_127, UInt8::BYTE_82, UInt8::BYTE_14, UInt8::BYTE_81]), UInt32::from_bytes([UInt8::BYTE_140, UInt8::BYTE_104, UInt8::BYTE_5, UInt8::BYTE_155]), UInt32::from_bytes([UInt8::BYTE_171, UInt8::BYTE_217, UInt8::BYTE_131, UInt8::BYTE_31]), UInt32::from_bytes([UInt8::BYTE_25, UInt8::BYTE_205, UInt8::BYTE_224, UInt8::BYTE_91])];
            b3_rows_chunks(c8, r8, 0, store(UInt64::wrapping_succ(load(chunk_count))), store(IV), store(Blake3::LayerNode::Push(layer, digest))) } ,
          (_, _) => {  b3_rows_chunks(c8, r8, block_no + 1, chunk_count, store(digest), layer) } ,
        } } ,
    }
  }

  fn b3_rows(rows: List<List<U64>>) -> [U32; 8] {
    let IV = [UInt32::from_bytes([UInt8::BYTE_103, UInt8::BYTE_230, UInt8::BYTE_9, UInt8::BYTE_106]), UInt32::from_bytes([UInt8::BYTE_133, UInt8::BYTE_174, UInt8::BYTE_103, UInt8::BYTE_187]), UInt32::from_bytes([UInt8::BYTE_114, UInt8::BYTE_243, UInt8::BYTE_110, UInt8::BYTE_60]), UInt32::from_bytes([UInt8::BYTE_58, UInt8::BYTE_245, UInt8::BYTE_79, UInt8::BYTE_165]), UInt32::from_bytes([UInt8::BYTE_127, UInt8::BYTE_82, UInt8::BYTE_14, UInt8::BYTE_81]), UInt32::from_bytes([UInt8::BYTE_140, UInt8::BYTE_104, UInt8::BYTE_5, UInt8::BYTE_155]), UInt32::from_bytes([UInt8::BYTE_171, UInt8::BYTE_217, UInt8::BYTE_131, UInt8::BYTE_31]), UInt32::from_bytes([UInt8::BYTE_25, UInt8::BYTE_205, UInt8::BYTE_224, UInt8::BYTE_91])];
    Blake3::compress_layer(b3_rows_chunks(store(Lists::Node::Nil), rows, 0, store([UInt8::BYTE_0; 8]), store(IV), store(Blake3::LayerNode::Nil)))
  }

  fn leaf_hash_at(rows: List<List<U64>>, lhs: List<Field>, target: Field) -> DigestP {
    store(b3_to_digest(b3_rows(select_rows(rows, lhs, target))))
  }

  fn inject_maybe(rows: List<List<U64>>, lhs: List<Field>, lh: Field, d: DigestP) -> DigestP {
    match has_height(lhs, lh) {
      0 => {  d } ,
      _ => {  mmcs_compress(d, leaf_hash_at(rows, lhs, lh)) } ,
    }
  }

  fn bits_to_num(bits: List<Field>) -> Field {
    match load(bits) {
      Lists::Node::Nil => {  0 } ,
      Lists::Node::Cons(b, rest) => {  b + 2 * bits_to_num(rest) } ,
    }
  }

  fn frontier_merge(xs: List<FrontierNode>, ys: List<FrontierNode>) -> List<FrontierNode> {
    match load(xs) {
      Lists::Node::Nil => {  ys } ,
      Lists::Node::Cons(x, xrest) => {  match load(ys) {
        Lists::Node::Nil => {  xs } ,
        Lists::Node::Cons(y, yrest) => {
          let FrontierNode::Mk(xi, _xb, xr, xd) = x;
          let FrontierNode::Mk(yi, _yb, yr, yd) = y;
          match UInt32::less_than_fields(xi, yi) {
            1 => {  store(Lists::Node::Cons(x, frontier_merge(xrest, ys))) } ,
            _ => {  match Fields::is_zero(xi - yi) {
              1 => {

                assert_eq!(digest_eq(xd, yd), 1);
                assert_eq!(assert_same_claims(xr, yr), 1);
                store(Lists::Node::Cons(x, frontier_merge(xrest, yrest))) } ,
              _ => {  store(Lists::Node::Cons(y, frontier_merge(xs, yrest))) } ,
            } } ,
          } } ,
      } } ,
    }
  }

  fn frontier_split(xs: List<FrontierNode>) -> (List<FrontierNode>, List<FrontierNode>) {
    match load(xs) {
      Lists::Node::Nil => {  (store(Lists::Node::Nil), store(Lists::Node::Nil)) } ,
      Lists::Node::Cons(x, rest) => {  match load(rest) {
        Lists::Node::Nil => {  (store(Lists::Node::Cons(x, store(Lists::Node::Nil))), store(Lists::Node::Nil)) } ,
        Lists::Node::Cons(y, tail) => {
          let (left, right) = frontier_split(tail);
          (store(Lists::Node::Cons(x, left)), store(Lists::Node::Cons(y, right))) } ,
      } } ,
    }
  }

  fn frontier_sort(xs: List<FrontierNode>) -> List<FrontierNode> {
    match load(xs) {
      Lists::Node::Nil => {  xs } ,
      Lists::Node::Cons(_x, rest) => {  match load(rest) {
        Lists::Node::Nil => {  xs } ,
        Lists::Node::Cons(_y, _tail) => {
          let (left, right) = frontier_split(xs);
          frontier_merge(frontier_sort(left), frontier_sort(right)) } ,
      } } ,
    }
  }

  fn frontier_leaves(indices: List<List<Field>>, rows: List<List<List<U64>>>,
      lhs: List<Field>, log_max: Field) -> List<FrontierNode> {
    match load(indices) {
      Lists::Node::Nil => {
        assert_eq!(list_length(rows), 0);
        store(Lists::Node::Nil) } ,
      Lists::Node::Cons(bits, irest) => {
        let &Lists::Node::Cons(r, rrest) = rows;
        let d = leaf_hash_at(r, lhs, log_max);
        store(Lists::Node::Cons(FrontierNode::Mk(bits_to_num(bits), bits, r, d),
          frontier_leaves(irest, rrest, lhs, log_max))) } ,
    }
  }

  fn frontier_level(nodes: List<FrontierNode>, proof: List<DigestP>,
      lhs: List<Field>, next_lh: Field) -> (List<FrontierNode>, List<DigestP>) {
    match load(nodes) {
      Lists::Node::Nil => {  (store(Lists::Node::Nil), proof) } ,
      Lists::Node::Cons(a, rest) => {
        let FrontierNode::Mk(ai, abits, ar, ad) = a;
        let &Lists::Node::Cons(abit, aparent_bits) = abits;
        let aparent = bits_to_num(aparent_bits);
        match load(rest) {
          Lists::Node::Cons(b, brest) => {
            let FrontierNode::Mk(bi, bbits, br, bd) = b;
            let &Lists::Node::Cons(_bbit, bparent_bits) = bbits;
            match Fields::is_zero(aparent - bits_to_num(bparent_bits)) {
              1 => {

                assert_eq!(assert_same_claims(select_rows_le(ar, lhs, next_lh), select_rows_le(br, lhs, next_lh)), 1);
                let parent = inject_maybe(ar, lhs, next_lh, mmcs_compress(ad, bd));
                let (tail, p2) = frontier_level(brest, proof, lhs, next_lh);
                (store(Lists::Node::Cons(FrontierNode::Mk(aparent, aparent_bits, ar, parent), tail)), p2) } ,
              _ => {
                let &Lists::Node::Cons(sib, prest) = proof;
                let parent = inject_maybe(ar, lhs, next_lh, compress_ordered(abit, ad, sib));
                let (tail, p2) = frontier_level(rest, prest, lhs, next_lh);
                (store(Lists::Node::Cons(FrontierNode::Mk(aparent, aparent_bits, ar, parent), tail)), p2) } ,
            } } ,
          Lists::Node::Nil => {
            let &Lists::Node::Cons(sib, prest) = proof;
            let parent = inject_maybe(ar, lhs, next_lh, compress_ordered(abit, ad, sib));
            (store(Lists::Node::Cons(FrontierNode::Mk(aparent, aparent_bits, ar, parent), store(Lists::Node::Nil))), prest) } ,
        } } ,
    }
  }

  fn frontier_fold(nodes: List<FrontierNode>, proof: List<DigestP>,
      lhs: List<Field>, levels: Field) -> (List<FrontierNode>, List<DigestP>) {
    match levels {
      0 => {  (nodes, proof) } ,
      _ => {
        let (next, p2) = frontier_level(nodes, proof, lhs, levels - 1);
        frontier_fold(next, p2, lhs, levels - 1) } ,
    }
  }

  fn mmcs_verify_multi(cap: MerkleCap, rows: List<List<List<U64>>>,
      lhs: List<Field>, indices: List<List<Field>>, proof: List<DigestP>, log_max: Field) -> Field {
    assert_eq!(Fields::is_zero(list_length(rows) - list_length(indices)), 1);
    let leaves = frontier_sort(frontier_leaves(indices, rows, lhs, log_max));
    let (roots, rest) = frontier_fold(leaves, proof, lhs, log_max);
    assert_eq!(list_length(rest), 0);
    let &Lists::Node::Cons(root, no_more) = roots;
    assert_eq!(list_length(no_more), 0);
    let FrontierNode::Mk(capidx, _bits, _rows, digest) = root;
    digest_eq(list_lookup(cap, capidx), digest)
  }

  fn glist_rev(l: List<Field>, acc: List<Field>) -> List<Field> {
    match load(l) {
      Lists::Node::Nil => {  acc } ,
      Lists::Node::Cons(b, rest) => {  glist_rev(rest, store(Lists::Node::Cons(b, acc))) } ,
    }
  }

  fn exp_by_bits(base: Goldilocks, bits: List<Field>) -> Goldilocks {
    match load(bits) {
      Lists::Node::Nil => {  1 } ,
      Lists::Node::Cons(b, rest) => {
        let half = exp_by_bits(base * base, rest);
        match b {
          0 => {  half } ,
          _ => {  base * half } ,
        } } ,
    }
  }

  fn fri_fold2(index_bits: List<Field>, log_height: Field, beta: Ext, e0: Ext, e1: Ext) -> Ext {
    let g = two_adic_gen(log_height + 1);
    let s = exp_by_bits(g, glist_rev(index_bits, store(Lists::Node::Nil)));
    let two_s = s + s;
    let t1 = eg_div(eg_add(e0, e1), [2, 0]);
    let t2 = eg_mul(beta, eg_div(eg_sub(e0, e1), [two_s, 0]));
    eg_add(t1, t2)
  }

  fn ro_x(index_bits: List<Field>, log_height: Field) -> Goldilocks {
    7 * exp_by_bits(two_adic_gen(log_height), glist_rev(index_bits, store(Lists::Node::Nil)))
  }

  fn ro_fold(p_x: List<U64>, p_z: List<Ext>, alpha: Ext, s: Ext, ap: Ext)
      -> (Ext, Ext) {
    match load(p_x) {
      Lists::Node::Nil => {  (s, ap) } ,
      Lists::Node::Cons(lane, pxr) => {
        let &Lists::Node::Cons(pz, pzr) = p_z;
        let term = eg_mul(ap, eg_sub(pz, [limb_to_field(lane), 0]));
        ro_fold(pxr, pzr, alpha, eg_add(s, term), eg_mul(ap, alpha)) } ,
    }
  }

  fn ext_row_onto(row: List<Ext>, tail: ByteStream) -> ByteStream {
    match load(row) {
      Lists::Node::Nil => {  tail } ,
      Lists::Node::Cons(e, rest) => {  b8_onto(gl_to_bytes(e[0]), b8_onto(gl_to_bytes(e[1]), ext_row_onto(rest, tail))) } ,
    }
  }
  fn points_onto(pts: List<List<Ext>>, tail: ByteStream) -> ByteStream {
    match load(pts) {
      Lists::Node::Nil => {  tail } ,
      Lists::Node::Cons(row, rest) => {  ext_row_onto(row, points_onto(rest, tail)) } ,
    }
  }
  fn round_onto(round: OpenedRound, tail: ByteStream) -> ByteStream {
    match load(round) {
      Lists::Node::Nil => {  tail } ,
      Lists::Node::Cons(mat, rest) => {  points_onto(mat, round_onto(rest, tail)) } ,
    }
  }
  fn prep_onto(prep_opt: PreprocessedOpt, tail: ByteStream) -> ByteStream {
    match prep_opt {
      PreprocessedOpt::NoPreprocessed => {  tail } ,
      PreprocessedOpt::SomePreprocessed(round) => {  round_onto(round, tail) } ,
    }
  }

  fn obs_log_arities(input: ByteStream, comms: List<MerkleCap>) -> ByteStream {
    match load(comms) {
      Lists::Node::Nil => {  input } ,
      Lists::Node::Cons(_c, rest) => {
        obs_log_arities(snoc_b8(input, [UInt8::BYTE_1, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0]), rest) } ,
    }
  }

  fn pcs_check_witness(input: ByteStream, witness: U64, bits: Field) -> (ByteStream, ByteStream) {
    match bits {
      0 => {  (input, store(Lists::Node::Nil)) } ,
      _ => {
        let (pbits, i1, o1) = ch_sample_bits(snoc_b8(input, witness), store(Lists::Node::Nil), bits);
        assert_eq!(bits_to_num(pbits), 0);
        (i1, o1) } ,
    }
  }

  fn pcs_betas(input: ByteStream, comms: List<MerkleCap>, witnesses: List<U64>, bits: Field)
      -> (List<Ext>, ByteStream) {
    match load(comms) {
      Lists::Node::Nil => {  (store(Lists::Node::Nil), input) } ,
      Lists::Node::Cons(c, rest) => {
        let &Lists::Node::Cons(w, wrest) = witnesses;
        let (i1, o1) = pcs_check_witness(snoc_cap(input, c), w, bits);
        let (b0, b1, i2, _o) = ch_sample_ext(i1, o1);
        let (bs, i3) = pcs_betas(i2, rest, wrest, bits);
        (store(Lists::Node::Cons([gl_val(b0), gl_val(b1)], bs)), i3) } ,
    }
  }

  fn circ_has_height(log_degrees: List<U8>, log_blowup: Field, rem: Field, i: Field, h: Field) -> Field {
    match rem {
      0 => {  0 } ,
      _ => {  match Fields::is_zero(UInt8::to_field(list_lookup(log_degrees, i)) + log_blowup - h) {
        1 => {  1 } ,
        _ => {  circ_has_height(log_degrees, log_blowup, rem - 1, i + 1, h) } ,
      } } ,
    }
  }

  fn build_buckets(log_degrees: List<U8>, log_blowup: Field, num_circuits: Field, h: Field) -> List<Bucket> {
    match h {
      0 => {  store(Lists::Node::Nil) } ,
      _ => {  match circ_has_height(log_degrees, log_blowup, num_circuits, 0, h) {
        0 => {  build_buckets(log_degrees, log_blowup, num_circuits, h - 1) } ,
        _ => {  store(Lists::Node::Cons(
               Bucket::Mk(h, [1, 0], [0, 0]),
               build_buckets(log_degrees, log_blowup, num_circuits, h - 1))) } ,
      } } ,
    }
  }

  fn bucket_update(buckets: List<Bucket>, lh: Field, p_x: List<U64>, p_z: List<Ext>,
      q: Ext, alpha: Ext) -> List<Bucket> {
    match load(buckets) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(b, rest) => {
        let Bucket::Mk(h, ap, ro) = b;
        match Fields::is_zero(h - lh) {
          1 => {
            let (s, ap2) = ro_fold(p_x, p_z, alpha, [0, 0], ap);
            let ro2 = eg_add(ro, eg_mul(q, s));
            store(Lists::Node::Cons(Bucket::Mk(h, ap2, ro2), rest)) } ,
          _ => {  store(Lists::Node::Cons(b, bucket_update(rest, lh, p_x, p_z, q, alpha))) } ,
        } } ,
    }
  }

  fn assert_blowup_zero(buckets: List<Bucket>, log_blowup: Field) -> Field {
    match load(buckets) {
      Lists::Node::Nil => {  1 } ,
      Lists::Node::Cons(b, rest) => {
        let Bucket::Mk(h, _ap, ro) = b;
        match Fields::is_zero(h - log_blowup) {
          1 => {  assert_eq!(eg_eq(ro, [0, 0]), 1); 1 } ,
          _ => {  assert_blowup_zero(rest, log_blowup) } ,
        } } ,
    }
  }

  fn prep_count(prep_opt: PreprocessedOpt) -> Field {
    match prep_opt {
      PreprocessedOpt::NoPreprocessed => {  0 } ,
      PreprocessedOpt::SomePreprocessed(_r) => {  1 } ,
    }
  }

  fn ri_apply(buckets: List<Bucket>, lh: Field, idxbits: List<Field>, log_gmax: Field,
      z: Ext, p_x: List<U64>, p_z: List<Ext>, alpha: Ext) -> List<Bucket> {

    assert_eq!(Fields::is_zero(list_length(p_x) - list_length(p_z)), 1);
    let x = ro_x(list_drop(idxbits, log_gmax - lh), lh);
    let q = eg_inverse(eg_sub(z, [x, 0]));
    bucket_update(buckets, lh, p_x, p_z, q, alpha)
  }

  fn open_2pt_mat(buckets: List<Bucket>, idxbits: List<Field>, log_gmax: Field, lh: Field,
      ldeg: Field, zeta: Ext, p_x: List<U64>, mat: List<List<Ext>>, alpha: Ext)
      -> List<Bucket> {
    let pz0 = list_lookup(mat, 0);
    let pz1 = list_lookup(mat, 1);
    let zn = eg_mul(zeta, [two_adic_gen(ldeg), 0]);
    let b1 = ri_apply(buckets, lh, idxbits, log_gmax, zeta, p_x, pz0, alpha);
    ri_apply(b1, lh, idxbits, log_gmax, zn, p_x, pz1, alpha)
  }
  fn open_batch_2pt(buckets: List<Bucket>, idxbits: List<Field>, log_gmax: Field, log_blowup: Field, ci: Field,
      rem: Field, log_degrees: List<U8>, zeta: Ext, base_rows: List<List<U64>>,
      opened: OpenedRound, alpha: Ext) -> List<Bucket> {
    match rem {
      0 => {  buckets } ,
      _ => {
        let ldeg = UInt8::to_field(list_lookup(log_degrees, ci));
        let b = open_2pt_mat(buckets, idxbits, log_gmax, ldeg + log_blowup, ldeg, zeta,
                  list_lookup(base_rows, ci), list_lookup(opened, ci), alpha);
        open_batch_2pt(b, idxbits, log_gmax, log_blowup, ci + 1, rem - 1, log_degrees, zeta,
                       base_rows, opened, alpha) } ,
    }
  }

  fn open_quotient(buckets: List<Bucket>, idxbits: List<Field>, log_gmax: Field, log_blowup: Field, ci: Field,
      rem: Field, log_degrees: List<U8>, zeta: Ext,
      base_rows: List<List<U64>>, q_opened: OpenedRound, alpha: Ext) -> List<Bucket> {
    match rem {
      0 => {  buckets } ,
      _ => {
        let lh = UInt8::to_field(list_lookup(log_degrees, ci)) + log_blowup;
        let b = ri_apply(buckets, lh, idxbits, log_gmax, zeta,
                  list_lookup(base_rows, ci), list_lookup(list_lookup(q_opened, ci), 0), alpha);
        open_quotient(b, idxbits, log_gmax, log_blowup, ci + 1, rem - 1, log_degrees, zeta, base_rows, q_opened, alpha) } ,
    }
  }

  fn open_prep(buckets: List<Bucket>, idxbits: List<Field>, log_gmax: Field, log_blowup: Field, ci: Field, rem: Field,
      k: Field, log_degrees: List<U8>, prep_indices: List<OptIdx>, zeta: Ext,
      base_rows: List<List<U64>>, prep_round: OpenedRound, alpha: Ext) -> List<Bucket> {
    match rem {
      0 => {  buckets } ,
      _ => {  match list_lookup(prep_indices, ci) {
        OptIdx::NoIdx => {
          open_prep(buckets, idxbits, log_gmax, log_blowup, ci + 1, rem - 1, k, log_degrees,
                    prep_indices, zeta, base_rows, prep_round, alpha) } ,
        OptIdx::SomeIdx(_j) => {
          let ldeg = UInt8::to_field(list_lookup(log_degrees, ci));
          let b = open_2pt_mat(buckets, idxbits, log_gmax, ldeg + log_blowup, ldeg, zeta,
                    list_lookup(base_rows, k), list_lookup(prep_round, k), alpha);
          open_prep(b, idxbits, log_gmax, log_blowup, ci + 1, rem - 1, k + 1, log_degrees,
                    prep_indices, zeta, base_rows, prep_round, alpha) } ,
      } } ,
    }
  }
  fn open_prep_batch(buckets: List<Bucket>, input_proof: List<BatchOpening>,
      prep_commit: MerkleCap, prep_opt: PreprocessedOpt, prep_indices: List<OptIdx>,
      log_degrees: List<U8>, num_circuits: Field, idxbits: List<Field>, log_gmax: Field, log_blowup: Field,
      zeta: Ext, alpha: Ext) -> List<Bucket> {
    match prep_opt {
      PreprocessedOpt::NoPreprocessed => {  buckets } ,
      PreprocessedOpt::SomePreprocessed(prep_round) => {
        let BatchOpening::Mk(rows_p) = list_lookup(input_proof, 3);

        assert_eq!(Fields::is_zero(list_length(rows_p) - list_length(prep_round)), 1);

        let prep_heights = heights_prep(log_degrees, log_blowup, prep_indices, num_circuits, 0);
        let log_pmax = heights_max(prep_heights);
        open_prep(buckets, idxbits, log_gmax, log_blowup, 0, num_circuits, 0, log_degrees,
                  prep_indices, zeta, rows_p, prep_round, alpha) } ,
    }
  }

  fn heights_all(log_degrees: List<U8>, log_blowup: Field, rem: Field, i: Field) -> List<Field> {
    match rem {
      0 => {  store(Lists::Node::Nil) } ,
      _ => {  store(Lists::Node::Cons(UInt8::to_field(list_lookup(log_degrees, i)) + log_blowup,
                               heights_all(log_degrees, log_blowup, rem - 1, i + 1))) } ,
    }
  }

  fn heights_max(hs: List<Field>) -> Field {
    match load(hs) {
      Lists::Node::Nil => {  0 } ,
      Lists::Node::Cons(h, rest) => {
        let m = heights_max(rest);
        match UInt32::less_than_fields(m, h) {
          0 => {  m } ,
          _ => {  h } ,
        } } ,
    }
  }
  fn heights_prep(log_degrees: List<U8>, log_blowup: Field, prep_indices: List<OptIdx>, rem: Field, i: Field) -> List<Field> {
    match rem {
      0 => {  store(Lists::Node::Nil) } ,
      _ => {  match list_lookup(prep_indices, i) {
        OptIdx::NoIdx => {  heights_prep(log_degrees, log_blowup, prep_indices, rem - 1, i + 1) } ,
        OptIdx::SomeIdx(_j) => {
          store(Lists::Node::Cons(UInt8::to_field(list_lookup(log_degrees, i)) + log_blowup,
                              heights_prep(log_degrees, log_blowup, prep_indices, rem - 1, i + 1))) } ,
      } } ,
    }
  }

  fn recon_evals(bit: Field, folded: Ext, sib: Ext) -> (Ext, Ext) {
    match bit {
      0 => {  (folded, sib) } ,
      _ => {  (sib, folded) } ,
    }
  }

  fn flatten2(e0: Ext, e1: Ext) -> List<U64> {
    store(Lists::Node::Cons(gl_to_bytes(e0[0]), store(Lists::Node::Cons(gl_to_bytes(e0[1]),
      store(Lists::Node::Cons(gl_to_bytes(e1[0]), store(Lists::Node::Cons(gl_to_bytes(e1[1]), store(Lists::Node::Nil)))))))))
  }

  fn rollin(folded: Ext, log_folded: Field, beta: Ext, ro_rest: List<Bucket>) -> (Ext, List<Bucket>) {
    match load(ro_rest) {
      Lists::Node::Nil => {  (folded, ro_rest) } ,
      Lists::Node::Cons(b, rest) => {
        let Bucket::Mk(h, _ap, ro) = b;
        match Fields::is_zero(h - log_folded) {
          1 => {  (eg_add(folded, eg_mul(ext_exp_pow2(beta, 1), ro)), rest) } ,
          _ => {  (folded, ro_rest) } ,
        } } ,
    }
  }
  fn verify_query(folded: Ext, betas: List<Ext>, comms: List<MerkleCap>,
      openings: List<CommitPhaseProofStep>, domidx: List<Field>, log_cur: Field,
      ro_rest: List<Bucket>, log_final: Field) -> (Ext, List<List<U64>>) {
    match load(openings) {
      Lists::Node::Nil => {

        assert_eq!(Fields::is_zero(log_cur - log_final), 1);
        assert_eq!(list_length(ro_rest), 0);
        (folded, store(Lists::Node::Nil)) } ,
      Lists::Node::Cons(op, op_rest) => {
        let &Lists::Node::Cons(beta, beta_rest) = betas;
        let &Lists::Node::Cons(comm, comm_rest) = comms;
        let CommitPhaseProofStep::Mk(_la, sibs) = op;

        assert_eq!(list_length(sibs), 1);
        let &Lists::Node::Cons(ibit, idrest) = domidx;
        let log_folded = log_cur - 1;
        let (e0, e1) = recon_evals(ibit, folded, list_lookup(sibs, 0));
        let folded1 = fri_fold2(idrest, log_folded, beta, e0, e1);
        let (folded2, ro_rest2) = rollin(folded1, log_folded, beta, ro_rest);
        let (result, rows) = verify_query(folded2, beta_rest, comm_rest, op_rest, idrest, log_folded, ro_rest2, log_final);
        (result, store(Lists::Node::Cons(flatten2(e0, e1), rows))) } ,
    }
  }

  fn verify_one_query(idxbits: List<Field>, qp: QueryProof, alpha: Ext,
      stage1: OpenedRound, stage2: OpenedRound, q_opened: OpenedRound,
      prep_opt: PreprocessedOpt, s1c: MerkleCap, s2c: MerkleCap, qc: MerkleCap,
      prep_commit: MerkleCap, prep_indices: List<OptIdx>,
      log_degrees: List<U8>, zeta: Ext, num_circuits: Field, log_blowup: Field, log_gmax: Field,
      betas: List<Ext>, commit_phase_commits: List<MerkleCap>, final_poly: List<Ext>,
      num_rounds: Field) -> List<List<U64>> {
    let QueryProof::Mk(input_proof, commit_phase_openings) = qp;

    assert_eq!(Fields::is_zero(list_length(commit_phase_openings) - num_rounds), 1);
    assert_eq!(Fields::is_zero(list_length(input_proof) - (3 + prep_count(prep_opt))), 1);
    let buckets = build_buckets(log_degrees, log_blowup, num_circuits, log_gmax);

    let hall = heights_all(log_degrees, log_blowup, num_circuits, 0);
    let BatchOpening::Mk(rows_s1) = list_lookup(input_proof, 0);
    assert_eq!(Fields::is_zero(list_length(rows_s1) - num_circuits), 1);
    let buckets = open_batch_2pt(buckets, idxbits, log_gmax, log_blowup, 0, num_circuits, log_degrees, zeta, rows_s1, stage1, alpha);
    let BatchOpening::Mk(rows_s2) = list_lookup(input_proof, 1);
    assert_eq!(Fields::is_zero(list_length(rows_s2) - num_circuits), 1);
    let buckets = open_batch_2pt(buckets, idxbits, log_gmax, log_blowup, 0, num_circuits, log_degrees, zeta, rows_s2, stage2, alpha);
    let BatchOpening::Mk(rows_q) = list_lookup(input_proof, 2);

    assert_eq!(Fields::is_zero(list_length(rows_q) - num_circuits), 1);
    let buckets = open_quotient(buckets, idxbits, log_gmax, log_blowup, 0, num_circuits, log_degrees, zeta, rows_q, q_opened, alpha);
    let buckets = open_prep_batch(buckets, input_proof, prep_commit, prep_opt, prep_indices, log_degrees, num_circuits, idxbits, log_gmax, log_blowup, zeta, alpha);

    let _cz = assert_blowup_zero(buckets, log_blowup);

    let &Lists::Node::Cons(b0, ro_rest) = buckets;
    let Bucket::Mk(h0, _ap0, folded_start) = b0;
    assert_eq!(Fields::is_zero(h0 - log_gmax), 1);
    let (folded, fri_rows) = verify_query(folded_start, betas, commit_phase_commits, commit_phase_openings, idxbits, log_gmax, ro_rest, log_blowup);

    assert_eq!(eg_eq(list_lookup(final_poly, 0), folded), 1);
    fri_rows
  }

  fn query_loop(input: ByteStream, output: ByteStream, query_proofs: List<QueryProof>,
      alpha: Ext, stage1: OpenedRound, stage2: OpenedRound, q_opened: OpenedRound,
      prep_opt: PreprocessedOpt, s1c: MerkleCap, s2c: MerkleCap, qc: MerkleCap,
      prep_commit: MerkleCap, prep_indices: List<OptIdx>,
      log_degrees: List<U8>, zeta: Ext, num_circuits: Field, log_blowup: Field, log_gmax: Field,
      betas: List<Ext>, commit_phase_commits: List<MerkleCap>, final_poly: List<Ext>,
      num_rounds: Field) -> List<List<List<U64>>> {
    match load(query_proofs) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(qp, rest) => {
        let (idxbits, input2, output2) = ch_sample_bits(input, output, log_gmax);
        let qrows = verify_one_query(idxbits, qp, alpha, stage1, stage2, q_opened, prep_opt,
          s1c, s2c, qc, prep_commit, prep_indices, log_degrees, zeta, num_circuits,
          log_blowup, log_gmax, betas, commit_phase_commits, final_poly, num_rounds);
        store(Lists::Node::Cons(qrows, query_loop(input2, output2, rest, alpha, stage1, stage2, q_opened, prep_opt,
          s1c, s2c, qc, prep_commit, prep_indices, log_degrees, zeta, num_circuits,
          log_blowup, log_gmax, betas, commit_phase_commits, final_poly, num_rounds))) } ,
    }
  }

  fn sample_query_indices(input: ByteStream, output: ByteStream, n: Field,
      log_gmax: Field) -> List<List<Field>> {
    match n {
      0 => {  store(Lists::Node::Nil) } ,
      _ => {
        let (bits, input2, output2) = ch_sample_bits(input, output, log_gmax);
        store(Lists::Node::Cons(bits, sample_query_indices(input2, output2, n - 1, log_gmax))) } ,
    }
  }

  fn batch_views_at(bs: List<BatchMultiOpening>, q: Field) -> List<BatchOpening> {
    match load(bs) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(b, rest) => {
        let BatchMultiOpening::Mk(rows, _proof) = b;
        store(Lists::Node::Cons(BatchOpening::Mk(list_lookup(rows, q)), batch_views_at(rest, q))) } ,
    }
  }
  fn step_views_at(ss: List<CommitPhaseMultiStep>, q: Field) -> List<CommitPhaseProofStep> {
    match load(ss) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(s, rest) => {
        let CommitPhaseMultiStep::Mk(la, sibs, _proof) = s;
        store(Lists::Node::Cons(CommitPhaseProofStep::Mk(la, list_lookup(sibs, q)), step_views_at(rest, q))) } ,
    }
  }
  fn query_views(bs: List<BatchMultiOpening>, ss: List<CommitPhaseMultiStep>,
      q: Field, n: Field) -> List<QueryProof> {
    match n {
      0 => {  store(Lists::Node::Nil) } ,
      _ => {  store(Lists::Node::Cons(QueryProof::Mk(batch_views_at(bs, q), step_views_at(ss, q)),
             query_views(bs, ss, q + 1, n - 1))) } ,
    }
  }

  fn verify_input_multi(bs: List<BatchMultiOpening>, indices: List<List<Field>>,
      s1c: MerkleCap, s2c: MerkleCap, qc: MerkleCap, prep_commit: MerkleCap,
      prep_opt: PreprocessedOpt, prep_indices: List<OptIdx>, log_degrees: List<U8>,
      num_circuits: Field, log_blowup: Field, log_gmax: Field) -> Field {
    let hall = heights_all(log_degrees, log_blowup, num_circuits, 0);
    let BatchMultiOpening::Mk(s1rows, s1proof) = list_lookup(bs, 0);
    let BatchMultiOpening::Mk(s2rows, s2proof) = list_lookup(bs, 1);
    let BatchMultiOpening::Mk(qrows, qproof) = list_lookup(bs, 2);
    assert_eq!(mmcs_verify_multi(s1c, s1rows, hall, indices, s1proof, log_gmax), 1);
    assert_eq!(mmcs_verify_multi(s2c, s2rows, hall, indices, s2proof, log_gmax), 1);
    assert_eq!(mmcs_verify_multi(qc, qrows, hall, indices, qproof, log_gmax), 1);
    match prep_opt {
      PreprocessedOpt::NoPreprocessed => {  1 } ,
      PreprocessedOpt::SomePreprocessed(_round) => {
        let BatchMultiOpening::Mk(prows, pproof) = list_lookup(bs, 3);
        let ph = heights_prep(log_degrees, log_blowup, prep_indices, num_circuits, 0);
        let lp = heights_max(ph);
        let pindices = drop_index_bits(indices, log_gmax - lp);
        mmcs_verify_multi(prep_commit, prows, ph, pindices, pproof, lp) } ,
    }
  }
  fn drop_index_bits(indices: List<List<Field>>, n: Field) -> List<List<Field>> {
    match load(indices) {
      Lists::Node::Nil => {  indices } ,
      Lists::Node::Cons(bits, rest) => {
        store(Lists::Node::Cons(list_drop(bits, n), drop_index_bits(rest, n))) } ,
    }
  }
  fn rows_at_round(rows: List<List<List<U64>>>, r: Field) -> List<List<List<U64>>> {
    match load(rows) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(qrows, rest) => {
        store(Lists::Node::Cons(store(Lists::Node::Cons(list_lookup(qrows, r), store(Lists::Node::Nil))),
          rows_at_round(rest, r))) } ,
    }
  }
  fn verify_commit_multi(steps: List<CommitPhaseMultiStep>, comms: List<MerkleCap>,
      all_rows: List<List<List<U64>>>, indices: List<List<Field>>, r: Field,
      log_cur: Field) -> Field {
    match load(steps) {
      Lists::Node::Nil => {  Fields::is_zero(list_length(comms)) } ,
      Lists::Node::Cons(s, srest) => {
        let &Lists::Node::Cons(c, crest) = comms;
        let CommitPhaseMultiStep::Mk(la, sibs, proof) = s;
        assert_eq!(UInt8::to_field(la), 1);
        assert_eq!(list_length(sibs), list_length(indices));
        let next_indices = drop_index_bits(indices, 1);
        let lh = log_cur - 1;
        assert_eq!(mmcs_verify_multi(c, rows_at_round(all_rows, r),
          store(Lists::Node::Cons(lh, store(Lists::Node::Nil))), next_indices, proof, lh), 1);
        verify_commit_multi(srest, crest, all_rows, next_indices, r + 1, lh) } ,
    }
  }

  fn pcs_fri_verify(post_zeta_input: ByteStream, stage1: OpenedRound, stage2: OpenedRound,
      q_opened: OpenedRound, prep_opt: PreprocessedOpt, opening: FriProof,
      s1c: MerkleCap, s2c: MerkleCap, qc: MerkleCap, prep_commit: MerkleCap,
      prep_indices: List<OptIdx>, log_degrees: List<U8>,
      zeta: Ext, num_circuits: Field, log_blowup: Field, num_queries: Field, commit_pow_bits: Field,
      query_pow_bits: Field) -> Field {
    let FriProof::Mk(commit_phase_commits, pw, input_openings, commit_phase_openings,
      final_poly, qpw) = opening;
    let num_rounds = list_length(commit_phase_commits);

    assert_eq!(Fields::is_zero(list_length(pw) - num_rounds), 1);
    assert_eq!(list_length(input_openings), 3 + prep_count(prep_opt));
    assert_eq!(Fields::is_zero(list_length(commit_phase_openings) - num_rounds), 1);
    assert_eq!(list_length(final_poly), 1);

    let obs = round_onto(stage1, round_onto(stage2, round_onto(q_opened,
      prep_onto(prep_opt, store(Lists::Node::Nil)))));
    let input = list_concat(post_zeta_input, obs);

    let (a0, a1, input, _oa) = ch_sample_ext(input, store(Lists::Node::Nil));
    let alpha = [gl_val(a0), gl_val(a1)];

    let (betas, input) = pcs_betas(input, commit_phase_commits, pw, commit_pow_bits);
    let input = list_concat(input, ext_row_onto(final_poly, store(Lists::Node::Nil)));
    let input = obs_log_arities(input, commit_phase_commits);

    let (input, output) = pcs_check_witness(input, qpw, query_pow_bits);

    let log_gmax = num_rounds + log_blowup;

    assert_eq!(UInt32::less_than_fields(log_gmax, 33), 1);
    let indices = sample_query_indices(input, output, num_queries, log_gmax);
    assert_eq!(verify_input_multi(input_openings, indices, s1c, s2c, qc,
      prep_commit, prep_opt, prep_indices, log_degrees, num_circuits, log_blowup, log_gmax), 1);
    let query_proofs = query_views(input_openings, commit_phase_openings, 0, num_queries);
    let fri_rows = query_loop(input, output, query_proofs, alpha, stage1, stage2, q_opened,
      prep_opt, s1c, s2c, qc, prep_commit, prep_indices, log_degrees, zeta,
      num_circuits, log_blowup, log_gmax, betas, commit_phase_commits, final_poly, num_rounds);
    verify_commit_multi(commit_phase_openings, commit_phase_commits, fri_rows, indices, 0, log_gmax)
  }

  fn ext_is_zero(e: Ext) -> Field {
    Fields::is_zero(e[0]) * Fields::is_zero(e[1])
  }

  fn b8_onto(b: [U8; 8], tail: ByteStream) -> ByteStream {
    store(Lists::Node::Cons(b[0], store(Lists::Node::Cons(b[1], store(Lists::Node::Cons(b[2],
    store(Lists::Node::Cons(b[3], store(Lists::Node::Cons(b[4], store(Lists::Node::Cons(b[5],
    store(Lists::Node::Cons(b[6], store(Lists::Node::Cons(b[7], tail))))))))))))))))
  }

  fn digest_onto(d: Digest, tail: ByteStream) -> ByteStream {
    b8_onto(d[0], b8_onto(d[1], b8_onto(d[2], b8_onto(d[3], tail))))
  }

  fn cap_onto(cap: MerkleCap, tail: ByteStream) -> ByteStream {
    match load(cap) {
      Lists::Node::Nil => {  tail } ,
      Lists::Node::Cons(d, rest) => {  digest_onto(load(d), cap_onto(rest, tail)) } ,
    }
  }

  fn log_degrees_onto(lds: List<U8>, tail: ByteStream) -> ByteStream {
    match load(lds) {
      Lists::Node::Nil => {  tail } ,
      Lists::Node::Cons(ld, rest) => {
        b8_onto([ld, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0], log_degrees_onto(rest, tail)) } ,
    }
  }

  fn rev_onto(l: ByteStream, acc: ByteStream) -> ByteStream {
    match load(l) {
      Lists::Node::Nil => {  acc } ,
      Lists::Node::Cons(b, rest) => {  rev_onto(rest, store(Lists::Node::Cons(b, acc))) } ,
    }
  }

  fn ch_sample8(input: ByteStream, output: ByteStream) -> ([U8; 8], ByteStream, ByteStream) {
    match load(output) {
      Lists::Node::Nil => {

        let h = Blake3::hash(input);
        let fwd = b3_flatten_onto(h, store(Lists::Node::Nil));
        let rev = rev_onto(fwd, store(Lists::Node::Nil));
        let &Lists::Node::Cons(b0, r1) = rev;
        let &Lists::Node::Cons(b1, r2) = r1;
        let &Lists::Node::Cons(b2, r3) = r2;
        let &Lists::Node::Cons(b3, r4) = r3;
        let &Lists::Node::Cons(b4, r5) = r4;
        let &Lists::Node::Cons(b5, r6) = r5;
        let &Lists::Node::Cons(b6, r7) = r6;
        let &Lists::Node::Cons(b7, r8) = r7;
        ([b0, b1, b2, b3, b4, b5, b6, b7], fwd, r8) } ,
      Lists::Node::Cons(b0, r1) => {
        let &Lists::Node::Cons(b1, r2) = r1;
        let &Lists::Node::Cons(b2, r3) = r2;
        let &Lists::Node::Cons(b3, r4) = r3;
        let &Lists::Node::Cons(b4, r5) = r4;
        let &Lists::Node::Cons(b5, r6) = r5;
        let &Lists::Node::Cons(b6, r7) = r6;
        let &Lists::Node::Cons(b7, r8) = r7;
        ([b0, b1, b2, b3, b4, b5, b6, b7], input, r8) } ,
    }
  }

  fn ch_sample_field(input: ByteStream, output: ByteStream) -> ([U8; 8], ByteStream, ByteStream) {
    let (raw, i1, o1) = ch_sample8(input, output);
    match gl_lt_p(raw) {
      1 => {  (raw, i1, o1) } ,
      _ => {  ch_sample_field(i1, o1) } ,
    }
  }

  fn ch_sample_ext(input: ByteStream, output: ByteStream) -> ([U8; 8], [U8; 8], ByteStream, ByteStream) {
    let (c0, i0, o0) = ch_sample_field(input, output);
    let (c1, i1, o1) = ch_sample_field(i0, o0);
    (c0, c1, i1, o1)
  }

  fn cons8(d: [Field; 8], tail: List<Field>) -> List<Field> {
    store(Lists::Node::Cons(d[0], store(Lists::Node::Cons(d[1], store(Lists::Node::Cons(d[2],
    store(Lists::Node::Cons(d[3], store(Lists::Node::Cons(d[4], store(Lists::Node::Cons(d[5],
    store(Lists::Node::Cons(d[6], store(Lists::Node::Cons(d[7], tail))))))))))))))))
  }

  fn take_bits(bits: List<Field>, n: Field) -> List<Field> {
    match n {
      0 => {  store(Lists::Node::Nil) } ,
      _ => {
        let &Lists::Node::Cons(b, rest) = bits;
        store(Lists::Node::Cons(b, take_bits(rest, n - 1))) } ,
    }
  }
  fn ch_sample_bits(input: ByteStream, output: ByteStream, n: Field)
      -> (List<Field>, ByteStream, ByteStream) {
    let (bytes, i1, o1) = ch_sample8(input, output);
    let bits =
      cons8(UInt8::bit_decomposition(bytes[0]),
      cons8(UInt8::bit_decomposition(bytes[1]),
      cons8(UInt8::bit_decomposition(bytes[2]),
      cons8(UInt8::bit_decomposition(bytes[3]), store(Lists::Node::Nil)))));
    (take_bits(bits, n), i1, o1)
  }

  fn snoc_b8(input: ByteStream, b: [U8; 8]) -> ByteStream {
    list_concat(input, b8_onto(b, store(Lists::Node::Nil)))
  }

  fn snoc_cap(input: ByteStream, cap: MerkleCap) -> ByteStream {
    list_concat(input, cap_onto(cap, store(Lists::Node::Nil)))
  }

  fn accs_onto(accs: List<Ext>, tail: ByteStream) -> ByteStream {
    match load(accs) {
      Lists::Node::Nil => {  tail } ,
      Lists::Node::Cons(e, rest) => {  b8_onto(gl_to_bytes(e[0]), b8_onto(gl_to_bytes(e[1]), accs_onto(rest, tail))) } ,
    }
  }

  fn seed_tag_onto(tail: ByteStream) -> ByteStream {
    store(Lists::Node::Cons(UInt8::BYTE_109, store(Lists::Node::Cons(UInt8::BYTE_117, store(Lists::Node::Cons(UInt8::BYTE_108,
    store(Lists::Node::Cons(UInt8::BYTE_116, store(Lists::Node::Cons(UInt8::BYTE_105, store(Lists::Node::Cons(UInt8::BYTE_45,
    store(Lists::Node::Cons(UInt8::BYTE_115, store(Lists::Node::Cons(UInt8::BYTE_116, store(Lists::Node::Cons(UInt8::BYTE_97,
    store(Lists::Node::Cons(UInt8::BYTE_114, store(Lists::Node::Cons(UInt8::BYTE_107, store(Lists::Node::Cons(UInt8::BYTE_47,
    store(Lists::Node::Cons(UInt8::BYTE_118, store(Lists::Node::Cons(UInt8::BYTE_48,
    tail))))))))))))))))))))))))))))
  }

  fn limbs_onto(ls: List<U64>, tail: ByteStream) -> ByteStream {
    match load(ls) {
      Lists::Node::Nil => {  tail } ,
      Lists::Node::Cons(l, rest) => {  b8_onto(l, limbs_onto(rest, tail)) } ,
    }
  }

  fn opt_commit_cap(commit: OptCommit) -> MerkleCap {
    match commit {
      OptCommit::NoCommit => {  store(Lists::Node::Nil) } ,
      OptCommit::SomeCommit(c) => {  c } ,
    }
  }

  fn active_onto(active: List<Field>, tail: ByteStream) -> ByteStream {
    match load(active) {
      Lists::Node::Nil => {  tail } ,
      Lists::Node::Cons(b, rest) => {
        b8_onto([UInt8::from_field(b), UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0, UInt8::BYTE_0],
                active_onto(rest, tail)) } ,
    }
  }

  fn ext_exp_pow2(e: Ext, k: Field) -> Ext {
    match k {
      0 => {  e } ,
      _ => {  ext_exp_pow2(eg_mul(e, e), k - 1) } ,
    }
  }

  fn two_adic_gen(bits: Field) -> Goldilocks {
    match bits {
      0  => {  1 } ,
      32 => {  1753635133440165772 } ,
      _  => {
        let g = two_adic_gen(bits + 1);
        g * g } ,
    }
  }

  fn trace_vanishing(zeta: Ext, l: Field) -> Ext {
    eg_sub(ext_exp_pow2(zeta, l), [1, 0])
  }

  fn pow2(l: Field) -> Field {
    match l {
      0 => {  1 } ,
      _ => {  2 * pow2(l - 1) } ,
    }
  }

  fn trace_selectors(zeta: Ext, l: Field) -> (Ext, Ext, Ext, Ext) {
    let zh = trace_vanishing(zeta, l);
    let ginv = gl_inverse(two_adic_gen(l));
    let is_first = eg_div(zh, eg_sub(zeta, [1, 0]));
    let is_last = eg_div(zh, eg_sub(zeta, [ginv, 0]));
    let is_trans = eg_sub(zeta, [ginv, 0]);
    let inv_van = eg_inverse(zh);
    (is_first, is_last, is_trans, inv_van)
  }

  fn ood_fold(acc: Ext, alpha: Ext, x: Ext) -> Ext {
    eg_add(eg_mul(acc, alpha), x)
  }

  fn from_ext_basis(c0: Ext, c1: Ext) -> Ext {
    eg_add(c0, eg_mul(c1, [0, 1]))
  }

  fn reconstruct_ext_row(raw: List<Ext>) -> List<Ext> {
    match load(raw) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(c0, t1) => {
        let Lists::Node::Cons(c1, t2) = load(t1);
        store(Lists::Node::Cons(from_ext_basis(c0, c1), reconstruct_ext_row(t2))) } ,
    }
  }

  fn eval_at(nodes: List<SysNode>, i: Field,
      main: List<Ext>, main_next: List<Ext>, prep: List<Ext>, prep_next: List<Ext>,
      s2: List<Ext>, s2next: List<Ext>, publics: List<Ext>,
      isf: Ext, isl: Ext, ist: Ext) -> Ext {
    let nd = list_lookup(nodes, i);
    match nd {
      SysNode::Const(c) => {  [c, 0] } ,
      SysNode::Var(src, off, idx) => {

        let sel = src + src + off;
        match sel {
          0 => {  list_lookup(prep, idx) } ,
          1 => {  list_lookup(prep_next, idx) } ,
          2 => {  list_lookup(main, idx) } ,
          3 => {  list_lookup(main_next, idx) } ,
          4 => {  list_lookup(s2, idx) } ,
          _ => {  list_lookup(s2next, idx) } ,
        } } ,
      SysNode::Public(idx) => {  list_lookup(publics, idx) } ,
      SysNode::IsFirstRow => {  isf } ,
      SysNode::IsLastRow => {  isl } ,
      SysNode::IsTransition => {  ist } ,
      SysNode::Add(a, b) => {
        eg_add(eval_at(nodes, a, main, main_next, prep, prep_next, s2, s2next, publics, isf, isl, ist),
               eval_at(nodes, b, main, main_next, prep, prep_next, s2, s2next, publics, isf, isl, ist)) } ,
      SysNode::Sub(a, b) => {
        eg_sub(eval_at(nodes, a, main, main_next, prep, prep_next, s2, s2next, publics, isf, isl, ist),
               eval_at(nodes, b, main, main_next, prep, prep_next, s2, s2next, publics, isf, isl, ist)) } ,
      SysNode::Mul(a, b) => {
        eg_mul(eval_at(nodes, a, main, main_next, prep, prep_next, s2, s2next, publics, isf, isl, ist),
               eval_at(nodes, b, main, main_next, prep, prep_next, s2, s2next, publics, isf, isl, ist)) } ,
      SysNode::Neg(a) => {
        eg_neg(eval_at(nodes, a, main, main_next, prep, prep_next, s2, s2next, publics, isf, isl, ist)) } ,
    }
  }

  fn fold_roots(acc: Ext, alpha: Ext, zeros: List<Field>, nodes: List<SysNode>,
      main: List<Ext>, main_next: List<Ext>, prep: List<Ext>, prep_next: List<Ext>,
      s2: List<Ext>, s2next: List<Ext>, publics: List<Ext>,
      isf: Ext, isl: Ext, ist: Ext) -> Ext {
    match load(zeros) {
      Lists::Node::Nil => {  acc } ,
      Lists::Node::Cons(z, rest) => {
        let v = eval_at(nodes, z, main, main_next, prep, prep_next, s2, s2next, publics, isf, isl, ist);
        fold_roots(ood_fold(acc, alpha, v), alpha, rest, nodes,
                   main, main_next, prep, prep_next, s2, s2next, publics, isf, isl, ist) } ,
    }
  }

  fn pair_mul(a0: Ext, a1: Ext, b0: Ext, b1: Ext) -> (Ext, Ext) {
    (eg_add(eg_mul(a0, b0), eg_mul([7, 0], eg_mul(a1, b1))),
     eg_add(eg_mul(a0, b1), eg_mul(a1, b0)))
  }

  fn logup_fingerprint(args: List<Field>, g0: Ext, g1: Ext, nodes: List<SysNode>,
      main: List<Ext>, main_next: List<Ext>, prep: List<Ext>, prep_next: List<Ext>,
      s2: List<Ext>, s2next: List<Ext>, publics: List<Ext>,
      isf: Ext, isl: Ext, ist: Ext) -> (Ext, Ext) {
    match load(args) {
      Lists::Node::Nil => {  ([0, 0], [0, 0]) } ,
      Lists::Node::Cons(a, rest) => {
        let (f0, f1) = logup_fingerprint(rest, g0, g1, nodes,
          main, main_next, prep, prep_next, s2, s2next, publics, isf, isl, ist);
        let (m0, m1) = pair_mul(f0, f1, g0, g1);
        let av = eval_at(nodes, a, main, main_next, prep, prep_next, s2, s2next,
                         publics, isf, isl, ist);
        (eg_add(m0, av), m1) } ,
    }
  }

  fn logup_steps_fold(acc: Ext, alpha: Ext, lks: List<SysLookup>, j: Field, lcount: Field,
      g: Field, rem: Field, k: Field, p0: Ext, p1: Ext, r0: Ext, r1: Ext,
      inj0: Ext, inj1: Ext, b0: Ext, b1: Ext, g0: Ext, g1: Ext,
      nodes: List<SysNode>,
      main: List<Ext>, main_next: List<Ext>, prep: List<Ext>, prep_next: List<Ext>,
      s2: List<Ext>, s2next: List<Ext>, publics: List<Ext>,
      isf: Ext, isl: Ext, ist: Ext) -> Ext {
    match load(lks) {
      Lists::Node::Nil => {  acc } ,
      Lists::Node::Cons(lk, rest) => {
        let SysLookup::Mk(mid, args) = lk;
        let (f0, f1) = logup_fingerprint(args, g0, g1, nodes,
          main, main_next, prep, prep_next, s2, s2next, publics, isf, isl, ist);
        let m0 = eg_add(f0, b0);
        let m1 = eg_add(f1, b1);
        let mv = eval_at(nodes, mid, main, main_next, prep, prep_next, s2, s2next,
                         publics, isf, isl, ist);

        let (rm0, rm1) = pair_mul(r0, r1, m0, m1);
        let nr0 = eg_add(rm0, eg_mul(mv, p0));
        let nr1 = eg_add(rm1, eg_mul(mv, p1));
        let (np0, np1) = pair_mul(p0, p1, m0, m1);
        match (j + 1 - lcount) {
          0 => {

            let s0 = list_lookup(s2, g + g);
            let s1 = list_lookup(s2, g + g + 1);
            let t0 = eg_add(list_lookup(s2next, 0), inj0);
            let t1 = eg_add(list_lookup(s2next, 1), inj1);
            let (c0, c1) = pair_mul(np0, np1, eg_sub(t0, s0), eg_sub(t1, s1));
            ood_fold(ood_fold(acc, alpha, eg_sub(c0, nr0)), alpha, eg_sub(c1, nr1)) } ,
          _ => {  match rem - 1 {
            0 => {

              let s0 = list_lookup(s2, g + g);
              let s1 = list_lookup(s2, g + g + 1);
              let t0 = list_lookup(s2, g + g + 2);
              let t1 = list_lookup(s2, g + g + 3);
              let (c0, c1) = pair_mul(np0, np1, eg_sub(t0, s0), eg_sub(t1, s1));
              let acc1 = ood_fold(ood_fold(acc, alpha, eg_sub(c0, nr0)), alpha,
                                  eg_sub(c1, nr1));
              logup_steps_fold(acc1, alpha, rest, j + 1, lcount,
                g + 1, k, k, [1, 0], [0, 0], [0, 0], [0, 0],
                inj0, inj1, b0, b1, g0, g1, nodes,
                main, main_next, prep, prep_next, s2, s2next, publics, isf, isl, ist) } ,
            _ => {

              logup_steps_fold(acc, alpha, rest, j + 1, lcount,
                g, rem - 1, k, np0, np1, nr0, nr1,
                inj0, inj1, b0, b1, g0, g1, nodes,
                main, main_next, prep, prep_next, s2, s2next, publics, isf, isl, ist) } ,
          } } ,
        } } ,
    }
  }

  fn ood_composition(nodes: List<SysNode>, zeros: List<Field>, lks: List<SysLookup>,
      k: Field,
      main: List<Ext>, main_next: List<Ext>, prep: List<Ext>, prep_next: List<Ext>,
      s2: List<Ext>, s2next: List<Ext>, publics: List<Ext>,
      lch: Ext, fch: Ext, accp: Ext, naccp: Ext,
      isf: Ext, isl: Ext, ist: Ext, alpha: Ext, inorm: Field) -> Ext {
    let base = fold_roots([0, 0], alpha, zeros, nodes,
               main, main_next, prep, prep_next, s2, s2next, publics, isf, isl, ist);

    let b0 = [lch[0], 0]; let b1 = [lch[1], 0];
    let g0 = [fch[0], 0]; let g1 = [fch[1], 0];
    let a0 = [accp[0], 0]; let a1 = [accp[1], 0];
    let na0 = [naccp[0], 0]; let na1 = [naccp[1], 0];

    let inj0 = eg_mul(isl, eg_mul(eg_sub(na0, a0), [inorm, 0]));
    let inj1 = eg_mul(isl, eg_mul(eg_sub(na1, a1), [inorm, 0]));
    match load(lks) {

      Lists::Node::Nil => {
        let acc = ood_fold(base, alpha,
          eg_add(eg_sub(list_lookup(s2next, 0), list_lookup(s2, 0)), inj0));
        ood_fold(acc, alpha,
          eg_add(eg_sub(list_lookup(s2next, 1), list_lookup(s2, 1)), inj1)) } ,
      Lists::Node::Cons(_h, _t) => {
        logup_steps_fold(base, alpha, lks, 0, list_length(lks),
          0, k, k, [1, 0], [0, 0], [0, 0], [0, 0], inj0, inj1,
          b0, b1, g0, g1, nodes,
          main, main_next, prep, prep_next, s2, s2next, publics, isf, isl, ist) } ,
    }
  }

  fn build_publics(lch: Ext, fch: Ext, accp: Ext, naccp: Ext) -> List<Ext> {
    store(Lists::Node::Cons([lch[0], 0], store(Lists::Node::Cons([lch[1], 0],
    store(Lists::Node::Cons([fch[0], 0], store(Lists::Node::Cons([fch[1], 0],
    store(Lists::Node::Cons([accp[0], 0], store(Lists::Node::Cons([accp[1], 0],
    store(Lists::Node::Cons([naccp[0], 0], store(Lists::Node::Cons([naccp[1], 0],
    store(Lists::Node::Nil)))))))))))))))))
  }

  fn quotient_eval(slices: List<Ext>, zeta_pow_n: Ext, pow: Ext) -> Ext {
    match load(slices) {
      Lists::Node::Nil => {  [0, 0] } ,
      Lists::Node::Cons(c, rest) => {
        eg_add(eg_mul(pow, c), quotient_eval(rest, zeta_pow_n, eg_mul(pow, zeta_pow_n))) } ,
    }
  }

  fn quotient_degree_of(md: Field) -> Field {
    match md {
      0 => {  1 } , 1 => {  1 } , 2 => {  1 } ,
      3 => {  2 } ,
      4 => {  4 } , 5 => {  4 } ,
      6 => {  8 } , 7 => {  8 } , 8 => {  8 } , 9 => {  8 } ,
      10 => {  16 } , 11 => {  16 } , 12 => {  16 } , 13 => {  16 } , 14 => {  16 } , 15 => {  16 } , 16 => {  16 } , 17 => {  16 } ,
      _ => {  32 } ,
    }
  }

  fn ood_prep_rows(prep_opt: PreprocessedOpt, oi: OptIdx) -> (List<Ext>, List<Ext>) {
    match oi {
      OptIdx::NoIdx => {  (store(Lists::Node::Nil), store(Lists::Node::Nil)) } ,
      OptIdx::SomeIdx(j) => {
        match prep_opt {
          PreprocessedOpt::NoPreprocessed => {  (store(Lists::Node::Nil), store(Lists::Node::Nil)) } ,
          PreprocessedOpt::SomePreprocessed(round) => {
            let pr = list_lookup(round, j);
            (list_lookup(pr, 0), list_lookup(pr, 1)) } ,
        } } ,
    }
  }

  fn ood_loop(circuits: List<SysCircuit>, prep_indices: List<OptIdx>,
      log_degrees: List<U8>, accs: List<Ext>,
      stage1: OpenedRound, stage2: OpenedRound, prep_opt: PreprocessedOpt,
      q_opened: OpenedRound, i: Field, accp: Ext,
      lch: Ext, fch: Ext, alpha: Ext, zeta: Ext) -> Field {
    match load(circuits) {
      Lists::Node::Nil => {  1 } ,
      Lists::Node::Cons(circ, rest) => {
        let SysCircuit::Mk(nodes, _node_count, zeros, md, lks, k, mw, pw, s2w) = circ;

        let ld8 = list_lookup(log_degrees, i);
        assert_eq!(UInt8::less_than(ld8, UInt8::BYTE_32), 1);
        let l = UInt8::to_field(ld8);
        let qd = quotient_degree_of(md);
        let naccp = list_lookup(accs, i);
        let s1 = list_lookup(stage1, i);
        let main = list_lookup(s1, 0);
        let main_next = list_lookup(s1, 1);
        let s2 = list_lookup(stage2, i);

        let s2row = list_lookup(s2, 0);
        let s2next = list_lookup(s2, 1);
        let (prep, prep_next) = ood_prep_rows(prep_opt, list_lookup(prep_indices, i));

        assert_eq!(Fields::is_zero(list_length(main) - mw), 1);
        assert_eq!(Fields::is_zero(list_length(main_next) - mw), 1);
        assert_eq!(Fields::is_zero(list_length(s2row) - s2w), 1);
        assert_eq!(Fields::is_zero(list_length(s2next) - s2w), 1);
        assert_eq!(Fields::is_zero(list_length(prep) - pw), 1);
        assert_eq!(Fields::is_zero(list_length(prep_next) - pw), 1);
        let (isf, isl, ist, invv) = trace_selectors(zeta, l);
        let publics = build_publics(lch, fch, accp, naccp);
        let inorm = gl_inverse(pow2(l) * two_adic_gen(l));
        let comp = ood_composition(nodes, zeros, lks, k,
                                   main, main_next, prep, prep_next, s2row, s2next,
                                   publics, lch, fch, accp, naccp,
                                   isf, isl, ist, alpha, inorm);

        let slices = reconstruct_ext_row(list_lookup(list_lookup(q_opened, i), 0));
        assert_eq!(Fields::is_zero(list_length(slices) - qd), 1);
        let quot = quotient_eval(slices, ext_exp_pow2(zeta, l), [1, 0]);
        assert_eq!(eg_eq(eg_mul(comp, invv), quot), 1);
        ood_loop(rest, prep_indices, log_degrees, accs, stage1, stage2, prep_opt,
                 q_opened, i + 1, naccp, lch, fch, alpha, zeta) } ,
    }
  }

  fn fingerprint_vals(fch: Ext, vals: List<U64>) -> Ext {
    match load(vals) {
      Lists::Node::Nil => {  [0, 0] } ,
      Lists::Node::Cons(v, rest) => {
        eg_add([gl_val(v), 0], eg_mul(fch, fingerprint_vals(fch, rest))) } ,
    }
  }

  fn claims_acc(acc: Ext, claims: List<List<U64>>, lch: Ext, fch: Ext) -> Ext {
    match load(claims) {
      Lists::Node::Nil => {  acc } ,
      Lists::Node::Cons(c, rest) => {
        let msg = eg_add(lch, fingerprint_vals(fch, c));
        claims_acc(eg_add(acc, eg_inverse(msg)), rest, lch, fch) } ,
    }
  }

  fn assert_bits(l: List<Field>) -> Field {
    match load(l) {
      Lists::Node::Nil => {  1 } ,
      Lists::Node::Cons(b, rest) => {
        assert_eq!(b * (b - 1), 0);
        assert_bits(rest) } ,
    }
  }

  fn select_active_circuits(circuits: List<SysCircuit>, active: List<Field>) -> List<SysCircuit> {
    match load(circuits) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(c, crest) => {
        let &Lists::Node::Cons(b, arest) = active;
        match b {
          0 => {  select_active_circuits(crest, arest) } ,
          _ => {  store(Lists::Node::Cons(c, select_active_circuits(crest, arest))) } ,
        } } ,
    }
  }

  fn select_active_prep(prep_indices: List<OptIdx>, active: List<Field>) -> List<OptIdx> {
    match load(prep_indices) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(p, prest) => {
        let &Lists::Node::Cons(b, arest) = active;
        match b {
          0 => {  select_active_prep(prest, arest) } ,
          _ => {  store(Lists::Node::Cons(p, select_active_prep(prest, arest))) } ,
        } } ,
    }
  }

  fn count_onto(n: Field, tail: ByteStream) -> ByteStream {
    b8_onto(gl_to_bytes(n), tail)
  }

  fn claims_onto(claims: List<List<U64>>, tail: ByteStream) -> ByteStream {
    count_onto(list_length(claims), claims_onto_each(claims, tail))
  }
  fn claims_onto_each(claims: List<List<U64>>, tail: ByteStream) -> ByteStream {
    match load(claims) {
      Lists::Node::Nil => {  tail } ,
      Lists::Node::Cons(c, rest) => {
        count_onto(list_length(c), limbs_onto(c, claims_onto_each(rest, tail))) } ,
    }
  }

  fn header_onto(h: ShardHeader, tail: ByteStream) -> ByteStream {
    let ShardHeader::Mk(active, cap, lds, claims) = h;
    active_onto(active,
      cap_onto(cap,
        count_onto(list_length(lds),
          log_degrees_onto(lds, claims_onto(claims, tail)))))
  }
  fn headers_onto(hs: List<ShardHeader>, tail: ByteStream) -> ByteStream {
    match load(hs) {
      Lists::Node::Nil => {  tail } ,
      Lists::Node::Cons(h, rest) => {  header_onto(h, headers_onto(rest, tail)) } ,
    }
  }

  fn messages_onto(ms: List<BatchMessage>, tail: ByteStream) -> ByteStream {
    count_onto(list_length(ms), messages_onto_each(ms, tail))
  }
  fn messages_onto_each(ms: List<BatchMessage>, tail: ByteStream) -> ByteStream {
    match load(ms) {
      Lists::Node::Nil => {  tail } ,
      Lists::Node::Cons(m, rest) => {
        let BatchMessage::Mk(args, mult) = m;
        count_onto(list_length(args),
          limbs_onto(args, b8_onto(mult, messages_onto_each(rest, tail)))) } ,
    }
  }

  fn batch_fiat_shamir(tlimbs: List<U64>, prep: MerkleCap, headers: List<ShardHeader>,
      messages: List<BatchMessage>) -> (Ext, Ext, ByteStream) {
    let input = messages_onto(messages, store(Lists::Node::Nil));
    let input = headers_onto(headers, input);
    let input = count_onto(list_length(headers), input);
    let input = cap_onto(prep, input);
    let input = limbs_onto(tlimbs, input);
    let input = seed_tag_onto(input);
    let (l0, l1, input, _ol) = ch_sample_ext(input, store(Lists::Node::Nil));
    let input = list_concat(input, b8_onto(l0, b8_onto(l1, store(Lists::Node::Nil))));
    let (f0, f1, input, _of) = ch_sample_ext(input, store(Lists::Node::Nil));
    let input = list_concat(input, b8_onto(f0, b8_onto(f1, store(Lists::Node::Nil))));
    ([gl_val(l0), gl_val(l1)], [gl_val(f0), gl_val(f1)], input)
  }

  fn shard_fiat_shamir(input: ByteStream, shard: Field, s2: MerkleCap, q: MerkleCap,
      accs: List<Ext>) -> (Ext, Ext, ByteStream) {
    let input = snoc_b8(input, gl_to_bytes(shard));
    let input = snoc_cap(input, s2);
    let input = list_concat(input, accs_onto(accs, store(Lists::Node::Nil)));
    let (a0, a1, input, _oa) = ch_sample_ext(input, store(Lists::Node::Nil));
    let input = snoc_cap(input, q);
    let (z0, z1, zinput, _oz) = ch_sample_ext(input, store(Lists::Node::Nil));
    ([gl_val(a0), gl_val(a1)], [gl_val(z0), gl_val(z1)], zinput)
  }

  fn assert_same_bits(a: List<Field>, b: List<Field>) -> Field {
    match load(a) {
      Lists::Node::Nil => {
        let Lists::Node::Nil = load(b);
        1 } ,
      Lists::Node::Cons(x, ra) => {
        let Lists::Node::Cons(y, rb) = load(b);
        assert_eq!(x, y);
        assert_same_bits(ra, rb) } ,
    }
  }
  fn assert_same_u8s(a: List<U8>, b: List<U8>) -> Field {
    match load(a) {
      Lists::Node::Nil => {
        let Lists::Node::Nil = load(b);
        1 } ,
      Lists::Node::Cons(x, ra) => {
        let Lists::Node::Cons(y, rb) = load(b);
        assert_eq!(UInt8::to_field(x), UInt8::to_field(y));
        assert_same_u8s(ra, rb) } ,
    }
  }
  fn assert_same_limbs(a: List<U64>, b: List<U64>) -> Field {
    match load(a) {
      Lists::Node::Nil => {
        let Lists::Node::Nil = load(b);
        1 } ,
      Lists::Node::Cons(x, ra) => {
        let Lists::Node::Cons(y, rb) = load(b);
        assert_eq!(UInt64::eq(x, y), 1);
        assert_same_limbs(ra, rb) } ,
    }
  }
  fn assert_same_claims(a: List<List<U64>>, b: List<List<U64>>) -> Field {
    match load(a) {
      Lists::Node::Nil => {
        let Lists::Node::Nil = load(b);
        1 } ,
      Lists::Node::Cons(x, ra) => {
        let Lists::Node::Cons(y, rb) = load(b);
        assert_eq!(assert_same_limbs(x, y), 1);
        assert_same_claims(ra, rb) } ,
    }
  }
  fn assert_same_cap(a: MerkleCap, b: MerkleCap) -> Field {
    match load(a) {
      Lists::Node::Nil => {
        let Lists::Node::Nil = load(b);
        1 } ,
      Lists::Node::Cons(d, ra) => {
        let Lists::Node::Cons(e, rb) = load(b);
        let x = load(d);
        let y = load(e);
        assert_eq!(UInt64::eq(x[0], y[0]), 1);
        assert_eq!(UInt64::eq(x[1], y[1]), 1);
        assert_eq!(UInt64::eq(x[2], y[2]), 1);
        assert_eq!(UInt64::eq(x[3], y[3]), 1);
        assert_same_cap(ra, rb) } ,
    }
  }

  fn last_acc(accs: List<Ext>) -> Ext {
    let Lists::Node::Cons(e, rest) = load(accs);
    match load(rest) {
      Lists::Node::Nil => {  e } ,
      _ => {  last_acc(rest) } ,
    }
  }

  fn messages_acc(acc: Ext, ms: List<BatchMessage>, lch: Ext, fch: Ext) -> Ext {
    match load(ms) {
      Lists::Node::Nil => {  acc } ,
      Lists::Node::Cons(m, rest) => {
        let BatchMessage::Mk(args, mult) = m;
        let msg = eg_add(lch, fingerprint_vals(fch, args));
        let term = eg_mul(eg_inverse(msg), [gl_val(mult), 0]);
        messages_acc(eg_add(acc, term), rest, lch, fch) } ,
    }
  }

  fn log_degree_ok(ld: U8) -> Field {
    match UInt8::to_field(ld) {
      0 => {  1 } , 1 => {  1 } , 2 => {  1 } , 3 => {  1 } , 4 => {  1 } , 5 => {  1 } , 6 => {  1 } , 7 => {  1 } , 8 => {  1 } ,
      9 => {  1 } , 10 => {  1 } , 11 => {  1 } , 12 => {  1 } , 13 => {  1 } , 14 => {  1 } , 15 => {  1 } , 16 => {  1 } ,
      17 => {  1 } , 18 => {  1 } , 19 => {  1 } , 20 => {  1 } , 21 => {  1 } , 22 => {  1 } , 23 => {  1 } , 24 => {  1 } ,
      25 => {  1 } , 26 => {  1 } , 27 => {  1 } , 28 => {  1 } , 29 => {  1 } , 30 => {  1 } , 31 => {  1 } , 32 => {  1 } ,
      _ => {  0 } ,
    }
  }
  fn assert_log_degrees_ok(lds: List<U8>) -> Field {
    match load(lds) {
      Lists::Node::Nil => {  1 } ,
      Lists::Node::Cons(ld, rest) => {
        assert_eq!(log_degree_ok(ld), 1);
        assert_log_degrees_ok(rest) } ,
    }
  }

  fn count_ones(bits: List<Field>) -> Field {
    match load(bits) {
      Lists::Node::Nil => {  0 } ,
      Lists::Node::Cons(b, rest) => {  b + count_ones(rest) } ,
    }
  }

  fn assert_shard_count_ok(k: Field) -> Field {
    assert_eq!(Fields::is_zero(k), 0);
    let b = gl_to_bytes(k);
    assert_eq!(UInt8::to_field(b[3]) + UInt8::to_field(b[4]) + UInt8::to_field(b[5]) + UInt8::to_field(b[6]) + UInt8::to_field(b[7]), 0);
    let hi = UInt8::to_field(b[2]);
    assert_eq!(hi * (hi - 1), 0);
    assert_eq!(hi * (UInt8::to_field(b[0]) + UInt8::to_field(b[1])), 0);
    1
  }

  fn three_limbs(args: List<U64>) -> (U64, U64, U64) {
    let Lists::Node::Cons(a, r1) = load(args);
    let Lists::Node::Cons(b, r2) = load(r1);
    let Lists::Node::Cons(c, r3) = load(r2);
    let Lists::Node::Nil = load(r3);
    (a, b, c)
  }

  fn le_step(xi: U8, yi: U8, rest: Field) -> Field {
    UInt8::less_than(xi, yi) + Fields::is_zero(UInt8::to_field(xi) - UInt8::to_field(yi)) * rest
  }

  fn bytes8_le(x: [U8; 8], y: [U8; 8]) -> Field {
    le_step(x[7], y[7], le_step(x[6], y[6], le_step(x[5], y[5],
      le_step(x[4], y[4], le_step(x[3], y[3], le_step(x[2], y[2],
        le_step(x[1], y[1], le_step(x[0], y[0], 1))))))))
  }

  fn assert_closure_pairs(ms: List<BatchMessage>, prev_w: Field, prev_b: Field) -> Field {
    match load(ms) {
      Lists::Node::Nil => {  1 } ,
      Lists::Node::Cons(pull, rest1) => {
        let Lists::Node::Cons(push, rest) = load(rest1);
        let BatchMessage::Mk(pargs, pmult) = pull;
        let BatchMessage::Mk(qargs, qmult) = push;
        assert_eq!(gl_val(pmult) + 1, 0);
        assert_eq!(gl_val(qmult), 1);
        let (pc, pw, pa) = three_limbs(pargs);
        let (qc, qw, qb) = three_limbs(qargs);
        assert_eq!(gl_val(pc), 16);
        assert_eq!(gl_val(qc), 16);
        let w = gl_val(pw);
        assert_eq!(gl_val(qw), w);
        let a = gl_val(pa);
        let b = gl_val(qb);
        assert_eq!(bytes8_le(gl_to_bytes(a), gl_to_bytes(b)), 1);

        let same_w = Fields::is_zero(w - prev_w);
        let w_up = 1 - bytes8_le(gl_to_bytes(w), gl_to_bytes(prev_w));
        assert_eq!(
          w_up + same_w * bytes8_le(gl_to_bytes(prev_b), gl_to_bytes(a)), 1);
        assert_closure_pairs(rest, w, b) } ,
    }
  }

  fn verify_shard(sys: Sys, header: ShardHeader, shard: Field, proof: Proof,
      input: ByteStream, lch: Ext, fch: Ext) -> Ext {
    let Sys::Mk(params, _tlimbs, circuits, commit, prep_indices) = sys;
    let SysParams::Mk(log_blowup, cap_height, log_final_poly_len,
                     max_log_arity, num_queries, commit_pow_bits,
                     query_pow_bits) = params;
    assert_eq!(cap_height, 0);
    assert_eq!(log_final_poly_len, 0);
    assert_eq!(max_log_arity, 1);
    let ShardHeader::Mk(h_active, h_cap, h_lds, h_claims) = header;
    let Proof::Mk(active, commitments, accs, log_degrees, opening,
                 q_opened, prep_opt, stage1, stage2) = proof;
    let num_circuits = list_length(accs);
    assert_eq!(Fields::is_zero(num_circuits), 0);
    assert_eq!(list_length(stage1), num_circuits);
    assert_eq!(list_length(stage2), num_circuits);
    assert_eq!(list_length(q_opened), num_circuits);
    assert_eq!(assert_bits(active), 1);
    assert_eq!(Fields::is_zero(list_length(active) - list_length(circuits)), 1);
    let acirc = select_active_circuits(circuits, active);
    let aprep = select_active_prep(prep_indices, active);
    assert_eq!(Fields::is_zero(list_length(acirc) - list_length(accs)), 1);
    let Commitments::Mk(s1c, s2c, qc) = commitments;
    assert_eq!(assert_same_bits(h_active, active), 1);
    assert_eq!(assert_same_cap(h_cap, s1c), 1);
    assert_eq!(assert_same_u8s(h_lds, log_degrees), 1);
    assert_eq!(assert_log_degrees_ok(log_degrees), 1);
    assert_eq!(count_ones(active), list_length(log_degrees));
    let prep_cap = opt_commit_cap(commit);
    let (alpha, zeta, post_zeta_input) = shard_fiat_shamir(input, shard, s2c, qc, accs);
    let acc0 = claims_acc([0, 0], h_claims, lch, fch);
    let _ood = ood_loop(acirc, aprep, log_degrees, accs, stage1, stage2,
             prep_opt, q_opened, 0, acc0, lch, fch, alpha, zeta);
    assert_eq!(pcs_fri_verify(post_zeta_input, stage1, stage2, q_opened, prep_opt, opening,
      s1c, s2c, qc, prep_cap, aprep, log_degrees, zeta,
      list_length(acirc), log_blowup, num_queries, commit_pow_bits,
      query_pow_bits), 1);
    last_acc(accs)
  }

  fn verify_shards(sys: Sys, headers: List<ShardHeader>, proofs: List<Proof>, shard: Field,
      input: ByteStream, lch: Ext, fch: Ext, acc: Ext) -> Ext {
    match load(headers) {
      Lists::Node::Nil => {
        let Lists::Node::Nil = load(proofs);
        acc } ,
      Lists::Node::Cons(h, hrest) => {
        let Lists::Node::Cons(p, prest) = load(proofs);
        let r = verify_shard(sys, h, shard, p, input, lch, fch);
        verify_shards(sys, hrest, prest, shard + 1, input, lch, fch, eg_add(acc, r)) } ,
    }
  }

  fn batch_claims(headers: List<ShardHeader>) -> List<List<U64>> {
    match load(headers) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(h, rest) => {
        let ShardHeader::Mk(_active, _cap, _lds, claims) = h;
        list_concat(claims, batch_claims(rest)) } ,
    }
  }

  fn verify_batch(sys: Sys, batch: Batch) -> List<List<U64>> {
    let Batch::Mk(headers, messages, proofs) = batch;
    assert_eq!(assert_shard_count_ok(list_length(headers)), 1);
    assert_eq!(list_length(proofs), list_length(headers));
    assert_eq!(assert_closure_pairs(messages, 0, 0), 1);
    let Sys::Mk(_params, tlimbs, _circuits, commit, _prep_indices) = sys;
    let prep_cap = opt_commit_cap(commit);
    let (lch, fch, input) = batch_fiat_shamir(tlimbs, prep_cap, headers, messages);
    let acc = messages_acc([0, 0], messages, lch, fch);
    let total = verify_shards(sys, headers, proofs, 0, input, lch, fch, acc);
    assert_eq!(ext_is_zero(total), 1);
    batch_claims(headers)
  }

  fn verify_batch_at(sys: Sys, idx: Field, len: Field, claims: List<List<U64>>) -> Field {
    let (batch, stop) = read_batch(idx);
    assert_eq!(stop, idx + len);
    let found = verify_batch(sys, batch);
    assert_eq!(assert_same_claims(found, claims), 1);
    1
  }

  fn read_claims(stream: ByteStream) -> (List<List<U64>>, ByteStream) {
    let (n, s) = read_count(stream);
    read_claims_n(s, n)
  }
  fn read_claims_n(stream: ByteStream, n: Field) -> (List<List<U64>>, ByteStream) {
    match n {
      0 => {  (store(Lists::Node::Nil), stream) } ,
      _ => {
        let (c, s) = read_one_claim(stream);
        let (rest, s2) = read_claims_n(s, n - 1);
        (store(Lists::Node::Cons(c, rest)), s2) } ,
    }
  }
  fn read_one_claim(stream: ByteStream) -> (List<U64>, ByteStream) {
    let (m, s) = read_count(stream);
    read_claim_vals_n(s, m)
  }
  fn read_claim_vals_n(stream: ByteStream, n: Field) -> (List<U64>, ByteStream) {
    match n {
      0 => {  (store(Lists::Node::Nil), stream) } ,
      _ => {
        let (x, s) = read_u64(stream);
        let (rest, s2) = read_claim_vals_n(s, n - 1);
        (store(Lists::Node::Cons(x, rest)), s2) } ,
    }
  }

  fn aggr_read_byte(stream: ByteStream) -> (U8, ByteStream) {
    let Lists::Node::Cons(byte, rest) = load(stream);
    (byte, rest)
  }

  fn aggr_read_address(stream: ByteStream) -> (Addr, ByteStream) {
    let Lists::Node::Cons(b0, s) = load(stream);
    let Lists::Node::Cons(b1, s) = load(s);
    let Lists::Node::Cons(b2, s) = load(s);
    let Lists::Node::Cons(b3, s) = load(s);
    let Lists::Node::Cons(b4, s) = load(s);
    let Lists::Node::Cons(b5, s) = load(s);
    let Lists::Node::Cons(b6, s) = load(s);
    let Lists::Node::Cons(b7, s) = load(s);
    let Lists::Node::Cons(b8, s) = load(s);
    let Lists::Node::Cons(b9, s) = load(s);
    let Lists::Node::Cons(b10, s) = load(s);
    let Lists::Node::Cons(b11, s) = load(s);
    let Lists::Node::Cons(b12, s) = load(s);
    let Lists::Node::Cons(b13, s) = load(s);
    let Lists::Node::Cons(b14, s) = load(s);
    let Lists::Node::Cons(b15, s) = load(s);
    let Lists::Node::Cons(b16, s) = load(s);
    let Lists::Node::Cons(b17, s) = load(s);
    let Lists::Node::Cons(b18, s) = load(s);
    let Lists::Node::Cons(b19, s) = load(s);
    let Lists::Node::Cons(b20, s) = load(s);
    let Lists::Node::Cons(b21, s) = load(s);
    let Lists::Node::Cons(b22, s) = load(s);
    let Lists::Node::Cons(b23, s) = load(s);
    let Lists::Node::Cons(b24, s) = load(s);
    let Lists::Node::Cons(b25, s) = load(s);
    let Lists::Node::Cons(b26, s) = load(s);
    let Lists::Node::Cons(b27, s) = load(s);
    let Lists::Node::Cons(b28, s) = load(s);
    let Lists::Node::Cons(b29, s) = load(s);
    let Lists::Node::Cons(b30, s) = load(s);
    let Lists::Node::Cons(b31, s) = load(s);
    (store([b0, b1, b2, b3, b4, b5, b6, b7,
            b8, b9, b10, b11, b12, b13, b14, b15,
            b16, b17, b18, b19, b20, b21, b22, b23,
            b24, b25, b26, b27, b28, b29, b30, b31]), s)
  }

  fn aggr_put_address(addr: Addr, rest: ByteStream) -> ByteStream {
    let a = load(addr);
    let s31 = store(Lists::Node::Cons(a[31], rest));
    let s30 = store(Lists::Node::Cons(a[30], s31));
    let s29 = store(Lists::Node::Cons(a[29], s30));
    let s28 = store(Lists::Node::Cons(a[28], s29));
    let s27 = store(Lists::Node::Cons(a[27], s28));
    let s26 = store(Lists::Node::Cons(a[26], s27));
    let s25 = store(Lists::Node::Cons(a[25], s26));
    let s24 = store(Lists::Node::Cons(a[24], s25));
    let s23 = store(Lists::Node::Cons(a[23], s24));
    let s22 = store(Lists::Node::Cons(a[22], s23));
    let s21 = store(Lists::Node::Cons(a[21], s22));
    let s20 = store(Lists::Node::Cons(a[20], s21));
    let s19 = store(Lists::Node::Cons(a[19], s20));
    let s18 = store(Lists::Node::Cons(a[18], s19));
    let s17 = store(Lists::Node::Cons(a[17], s18));
    let s16 = store(Lists::Node::Cons(a[16], s17));
    let s15 = store(Lists::Node::Cons(a[15], s16));
    let s14 = store(Lists::Node::Cons(a[14], s15));
    let s13 = store(Lists::Node::Cons(a[13], s14));
    let s12 = store(Lists::Node::Cons(a[12], s13));
    let s11 = store(Lists::Node::Cons(a[11], s12));
    let s10 = store(Lists::Node::Cons(a[10], s11));
    let s9 = store(Lists::Node::Cons(a[9], s10));
    let s8 = store(Lists::Node::Cons(a[8], s9));
    let s7 = store(Lists::Node::Cons(a[7], s8));
    let s6 = store(Lists::Node::Cons(a[6], s7));
    let s5 = store(Lists::Node::Cons(a[5], s6));
    let s4 = store(Lists::Node::Cons(a[4], s5));
    let s3 = store(Lists::Node::Cons(a[3], s4));
    let s2 = store(Lists::Node::Cons(a[2], s3));
    let s1 = store(Lists::Node::Cons(a[1], s2));
    store(Lists::Node::Cons(a[0], s1))
  }

  fn aggr_pack_address(addr: Addr) -> [Field; 8] {
    let a = load(addr);
    [b3_pack_w(UInt32::from_bytes([a[0], a[1], a[2], a[3]])),
     b3_pack_w(UInt32::from_bytes([a[4], a[5], a[6], a[7]])),
     b3_pack_w(UInt32::from_bytes([a[8], a[9], a[10], a[11]])),
     b3_pack_w(UInt32::from_bytes([a[12], a[13], a[14], a[15]])),
     b3_pack_w(UInt32::from_bytes([a[16], a[17], a[18], a[19]])),
     b3_pack_w(UInt32::from_bytes([a[20], a[21], a[22], a[23]])),
     b3_pack_w(UInt32::from_bytes([a[24], a[25], a[26], a[27]])),
     b3_pack_w(UInt32::from_bytes([a[28], a[29], a[30], a[31]]))]
  }

  fn aggr_node_hash(left: Addr, right: Addr) -> Addr {
    let tail = aggr_put_address(left,
      aggr_put_address(right, store(Lists::Node::Nil)));
    Blake3::bytes_to_addr(store(Lists::Node::Cons(UInt8::BYTE_1, tail)))
  }

  fn aggr_leaf_hash(addr: Addr) -> Addr {
    let tail = aggr_put_address(addr, store(Lists::Node::Nil));
    Blake3::bytes_to_addr(store(Lists::Node::Cons(UInt8::BYTE_0, tail)))
  }

  fn aggr_pack_be4(a: U8, b: U8, c: U8, d: U8) -> Field {
    ((UInt8::to_field(a) * 256 + UInt8::to_field(b)) * 256 + UInt8::to_field(c)) * 256
      + UInt8::to_field(d)
  }

  fn aggr_address_order(a: Addr, b: Addr) -> Field {
    let av = load(a);
    let bv = load(b);
    let aw0 = aggr_pack_be4(av[0], av[1], av[2], av[3]);
    let bw0 = aggr_pack_be4(bv[0], bv[1], bv[2], bv[3]);
    match aw0 - bw0 {
      0 => {
        let aw1 = aggr_pack_be4(av[4], av[5], av[6], av[7]);
        let bw1 = aggr_pack_be4(bv[4], bv[5], bv[6], bv[7]);
        match aw1 - bw1 {
          0 => {
            let aw2 = aggr_pack_be4(av[8], av[9], av[10], av[11]);
            let bw2 = aggr_pack_be4(bv[8], bv[9], bv[10], bv[11]);
            match aw2 - bw2 {
              0 => {
                let aw3 = aggr_pack_be4(av[12], av[13], av[14], av[15]);
                let bw3 = aggr_pack_be4(bv[12], bv[13], bv[14], bv[15]);
                match aw3 - bw3 {
                  0 => {
                    let aw4 = aggr_pack_be4(av[16], av[17], av[18], av[19]);
                    let bw4 = aggr_pack_be4(bv[16], bv[17], bv[18], bv[19]);
                    match aw4 - bw4 {
                      0 => {
                        let aw5 = aggr_pack_be4(av[20], av[21], av[22], av[23]);
                        let bw5 = aggr_pack_be4(bv[20], bv[21], bv[22], bv[23]);
                        match aw5 - bw5 {
                          0 => {
                            let aw6 = aggr_pack_be4(av[24], av[25], av[26], av[27]);
                            let bw6 = aggr_pack_be4(bv[24], bv[25], bv[26], bv[27]);
                            match aw6 - bw6 {
                              0 => {
                                let aw7 = aggr_pack_be4(av[28], av[29], av[30], av[31]);
                                let bw7 = aggr_pack_be4(bv[28], bv[29], bv[30], bv[31]);
                                match aw7 - bw7 {
                                  0 => {  1 } ,
                                  _ => {  match UInt32::less_than_fields(aw7, bw7) { 1 => {  0 } , _ => {  2 } , } } ,
                                } } ,
                              _ => {  match UInt32::less_than_fields(aw6, bw6) { 1 => {  0 } , _ => {  2 } , } } ,
                            } } ,
                          _ => {  match UInt32::less_than_fields(aw5, bw5) { 1 => {  0 } , _ => {  2 } , } } ,
                        } } ,
                      _ => {  match UInt32::less_than_fields(aw4, bw4) { 1 => {  0 } , _ => {  2 } , } } ,
                    } } ,
                  _ => {  match UInt32::less_than_fields(aw3, bw3) { 1 => {  0 } , _ => {  2 } , } } ,
                } } ,
              _ => {  match UInt32::less_than_fields(aw2, bw2) { 1 => {  0 } , _ => {  2 } , } } ,
            } } ,
          _ => {  match UInt32::less_than_fields(aw1, bw1) { 1 => {  0 } , _ => {  2 } , } } ,
        } } ,
      _ => {  match UInt32::less_than_fields(aw0, bw0) { 1 => {  0 } , _ => {  2 } , } } ,
    }
  }

  fn aggr_assert_strict_sorted(leaves: List<Addr>) -> () {
    match load(leaves) {
      Lists::Node::Nil => {  () } ,
      Lists::Node::Cons(a, rest) => {
        match load(rest) {
          Lists::Node::Nil => {  () } ,
          Lists::Node::Cons(b, _) => {
            assert_eq!(aggr_address_order(a, b), 0,
              "aggr: tree leaves are not strictly sorted");
            aggr_assert_strict_sorted(rest) } ,
        } } ,
    }
  }

  fn aggr_parse_tree_body(stream: ByteStream) -> (List<Addr>, ByteStream) {
    let (tag, rest) = aggr_read_byte(stream);
    match UInt8::to_field(tag) {
      0 => {
        let (addr, stop) = aggr_read_address(rest);
        (store(Lists::Node::Cons(addr, store(Lists::Node::Nil))), stop) } ,
      1 => {  (store(Lists::Node::Nil), rest) } ,
      2 => {
        let (left, s2) = aggr_parse_tree_body(rest);
        let (right, stop) = aggr_parse_tree_body(s2);
        (list_concat(left, right), stop) } ,
    }
  }

  fn aggr_leaf_hashes(leaves: List<Addr>) -> List<Addr> {
    match load(leaves) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(addr, rest) => {
        store(Lists::Node::Cons(aggr_leaf_hash(addr), aggr_leaf_hashes(rest))) } ,
    }
  }

  fn aggr_pair_hashes(nodes: List<Addr>) -> List<Addr> {
    match load(nodes) {
      Lists::Node::Nil => {  store(Lists::Node::Nil) } ,
      Lists::Node::Cons(left, rest) => {
        match load(rest) {
          Lists::Node::Nil => {
            let zero = store([UInt8::BYTE_0; 32]);
            store(Lists::Node::Cons(aggr_node_hash(left, zero), store(Lists::Node::Nil))) } ,
          Lists::Node::Cons(right, tail) => {
            store(Lists::Node::Cons(aggr_node_hash(left, right), aggr_pair_hashes(tail))) } ,
        } } ,
    }
  }

  fn aggr_reduce_hashes(nodes: List<Addr>) -> Addr {
    let Lists::Node::Cons(root, rest) = load(nodes);
    match load(rest) {
      Lists::Node::Nil => {  root } ,
      _ => {  aggr_reduce_hashes(aggr_pair_hashes(nodes)) } ,
    }
  }

  fn aggr_canonical_root(leaves: List<Addr>) -> Addr {
    aggr_reduce_hashes(aggr_leaf_hashes(leaves))
  }

  fn aggr_load_canonical_tree(root: Addr) -> List<Addr> {
    let raw = load(root);
    let (idx, len) = hint::<(Field, Field)>("stark.io.address", (5, Blake3::address_to_fields(raw)));
    let bytes = read_byte_stream(5, idx, len);
    let (tag, body) = aggr_read_byte(bytes);
    assert_eq!(UInt8::to_field(tag), 226, "aggr: tree has the wrong Ixon tag");
    let (leaves, stop) = aggr_parse_tree_body(body);
    let Lists::Node::Nil = load(stop);
    assert_eq!(Lists::is_empty(leaves), 0,
      "aggr: a present tree must contain at least one leaf");

    aggr_assert_strict_sorted(leaves);
    let expected = aggr_canonical_root(leaves);
    assert_eq!(address_eq(expected, root), 1,
      "aggr: tree leaves do not reproduce the canonical root");
    leaves
  }

  fn aggr_load_optional_tree(root: Option<Addr>) -> List<Addr> {
    match root {
      Option::None => {  store(Lists::Node::Nil) } ,
      Option::Some(addr) => {  aggr_load_canonical_tree(addr) } ,
    }
  }

  fn aggr_assert_same_list(left: List<Addr>, right: List<Addr>) -> () {
    match (load(left), load(right)) {
      (Lists::Node::Nil, Lists::Node::Nil) => {  () } ,
      (Lists::Node::Cons(a, ar), Lists::Node::Cons(b, br)) => {
        assert_eq!(address_eq(a, b), 1, "aggr: set element mismatch");
        aggr_assert_same_list(ar, br) } ,
    }
  }

  fn aggr_assert_union(left: List<Addr>, right: List<Addr>,
      output: List<Addr>) -> () {
    match (load(left), load(right)) {
      (Lists::Node::Nil, _) => {  aggr_assert_same_list(right, output) } ,
      (_, Lists::Node::Nil) => {  aggr_assert_same_list(left, output) } ,
      (Lists::Node::Cons(a, ar), Lists::Node::Cons(b, br)) => {
        let Lists::Node::Cons(o, or) = load(output);
        match aggr_address_order(a, b) {
          0 => {
            assert_eq!(address_eq(a, o), 1, "aggr: subject union mismatch");
            aggr_assert_union(ar, right, or) } ,
          1 => {
            assert_eq!(address_eq(a, o), 1, "aggr: subject union mismatch");
            aggr_assert_union(ar, br, or) } ,
          _ => {
            assert_eq!(address_eq(b, o), 1, "aggr: subject union mismatch");
            aggr_assert_union(left, br, or) } ,
        } } ,
    }
  }

  fn aggr_next_assumption(left: List<Addr>, right: List<Addr>)
      -> AggrNextAssumption {
    match (load(left), load(right)) {
      (Lists::Node::Nil, Lists::Node::Nil) => {  AggrNextAssumption::Done } ,
      (Lists::Node::Cons(a, ar), Lists::Node::Nil) => {
        AggrNextAssumption::More(a, ar, right) } ,
      (Lists::Node::Nil, Lists::Node::Cons(b, br)) => {
        AggrNextAssumption::More(b, left, br) } ,
      (Lists::Node::Cons(a, ar), Lists::Node::Cons(b, br)) => {
        match aggr_address_order(a, b) {
          0 => {  AggrNextAssumption::More(a, ar, right) } ,
          1 => {  AggrNextAssumption::More(a, ar, br) } ,
          _ => {  AggrNextAssumption::More(b, left, br) } ,
        } } ,
    }
  }

  fn aggr_seek_subject(target: Addr, subjects: List<Addr>)
      -> (Field, List<Addr>) {
    match load(subjects) {
      Lists::Node::Nil => {  (0, subjects) } ,
      Lists::Node::Cons(subject, rest) => {
        match aggr_address_order(subject, target) {
          0 => {  aggr_seek_subject(target, rest) } ,
          1 => {  (1, rest) } ,
          _ => {  (0, subjects) } ,
        } } ,
    }
  }

  fn aggr_assert_difference(left: List<Addr>, right: List<Addr>,
      subjects: List<Addr>, output: List<Addr>) -> () {
    match aggr_next_assumption(left, right) {
      AggrNextAssumption::Done => {
        let Lists::Node::Nil = load(output);
        () } ,
      AggrNextAssumption::More(candidate, left_rest, right_rest) => {
        let (discharged, subject_rest) = aggr_seek_subject(candidate, subjects);
        match discharged {
          1 => {  aggr_assert_difference(left_rest, right_rest, subject_rest, output) } ,
          _ => {
            let Lists::Node::Cons(actual, output_rest) = load(output);
            assert_eq!(address_eq(candidate, actual), 1,
              "aggr: outstanding assumption mismatch");
            aggr_assert_difference(left_rest, right_rest, subject_rest, output_rest) } ,
        } } ,
    }
  }

  fn aggr_fold_path(hash: Addr, remaining: Field, stream: ByteStream)
      -> (Addr, ByteStream) {
    match remaining {
      0 => {  (hash, stream) } ,
      _ => {
        let (side, s1) = aggr_read_byte(stream);
        assert_eq!(UInt8::less_than(side, UInt8::BYTE_2), 1,
          "aggr structural: path side must be 0 or 1");
        let (sibling, s2) = aggr_read_address(s1);
        let parent = match UInt8::to_field(side) {
          0 => {  aggr_node_hash(sibling, hash) } ,
          _ => {  aggr_node_hash(hash, sibling) } ,
        };
        aggr_fold_path(parent, remaining - 1, s2) } ,
    }
  }

  fn aggr_discharge_choice(candidate: Addr, root: Addr) -> Field {
    let (idx, len) = hint::<(Field, Field)>("stark.io.address", (6, Blake3::address_to_fields(load(candidate))));
    let bytes = read_byte_stream(6, idx, len);
    let (choice, rest) = aggr_read_byte(bytes);
    assert_eq!(UInt8::less_than(choice, UInt8::BYTE_2), 1,
      "aggr structural: discharge choice must be 0 or 1");
    match UInt8::to_field(choice) {
      0 => {
        let Lists::Node::Nil = load(rest);
        0 } ,
      _ => {
        let (count, path) = aggr_read_byte(rest);
        assert_eq!(UInt8::less_than(count, UInt8::BYTE_65), 1,
          "aggr structural: Merkle path exceeds 64 steps");
        let (actual, stop) = aggr_fold_path(aggr_leaf_hash(candidate),
          UInt8::to_field(count), path);
        let Lists::Node::Nil = load(stop);
        assert_eq!(address_eq(actual, root), 1,
          "aggr structural: assumption path does not reach subject root");
        1 } ,
    }
  }

  fn aggr_assert_structural_difference(left: List<Addr>, right: List<Addr>,
      subject_root: Addr, output: List<Addr>) -> () {
    match aggr_next_assumption(left, right) {
      AggrNextAssumption::Done => {
        let Lists::Node::Nil = load(output);
        () } ,
      AggrNextAssumption::More(candidate, left_rest, right_rest) => {
        match aggr_discharge_choice(candidate, subject_root) {
          1 => {  aggr_assert_structural_difference(left_rest, right_rest,
            subject_root, output) } ,
          _ => {
            let Lists::Node::Cons(actual, output_rest) = load(output);
            assert_eq!(address_eq(candidate, actual), 1,
              "aggr structural: outstanding assumption mismatch");
            aggr_assert_structural_difference(left_rest, right_rest,
              subject_root, output_rest) } ,
        } } ,
    }
  }

  fn aggr_get_opt_address(stream: ByteStream) -> (Option<Addr>, ByteStream) {
    let (tag, rest) = aggr_read_byte(stream);
    match UInt8::to_field(tag) {
      0 => {  (Option::None, rest) } ,
      1 => {
        let (addr, stop) = aggr_read_address(rest);
        (Option::Some(addr), stop) } ,
    }
  }

  fn aggr_parse_check_env(bytes: ByteStream) -> (Addr, Option<Addr>) {

    let (tag, s) = aggr_read_byte(bytes);
    assert_eq!(UInt8::to_field(tag), 229, "aggr: claim is not CheckEnv");
    let (format, s) = aggr_read_byte(s);
    assert_eq!(UInt8::to_field(format), 4, "aggr: unsupported object format");
    let (validator, s) = aggr_read_byte(s);
    assert_eq!(UInt8::to_field(validator), 1, "aggr: wrong validator identity");
    let (root, s2) = aggr_read_address(s);
    let (assumptions, stop) = aggr_get_opt_address(s2);
    let Lists::Node::Nil = load(stop);
    (root, assumptions)
  }

  fn aggr_load_preimage(digest: [Field; 8]) -> ByteStream {
    let (idx, len) = hint::<(Field, Field)>("stark.io.digest", digest);
    let bytes = read_byte_stream(4, idx, len);
    assert_eq!(b3_pack(Blake3::hash(bytes)), digest,
      "aggr: claim preimage digest mismatch");
    bytes
  }

  fn aggr_claim_field(claim: List<U64>, index: Field) -> Field {
    gl_val(list_lookup(claim, index))
  }

  fn aggr_claim_digest(claim: List<U64>, start: Field) -> [Field; 8] {
    [aggr_claim_field(claim, start),
     aggr_claim_field(claim, start + 1),
     aggr_claim_field(claim, start + 2),
     aggr_claim_field(claim, start + 3),
     aggr_claim_field(claim, start + 4),
     aggr_claim_field(claim, start + 5),
     aggr_claim_field(claim, start + 6),
     aggr_claim_field(claim, start + 7)]
  }

  fn aggr_assert_digest(actual: [Field; 8], expected: [Field; 8]) -> () {
    assert_eq!(actual[0], expected[0]);
    assert_eq!(actual[1], expected[1]);
    assert_eq!(actual[2], expected[2]);
    assert_eq!(actual[3], expected[3]);
    assert_eq!(actual[4], expected[4]);
    assert_eq!(actual[5], expected[5]);
    assert_eq!(actual[6], expected[6]);
    assert_eq!(actual[7], expected[7]);
    ()
  }

  fn aggr_only_claim(claims: List<List<U64>>) -> List<U64> {
    let Lists::Node::Cons(claim, rest) = load(claims);
    let Lists::Node::Nil = load(rest);
    claim
  }

  fn aggr_load_sys(kind: Field, ixvm_vk_digest: [Field; 8], self_vk_digest: [Field; 8])
      -> Sys {

    let (sidx, slen) = hint::<(Field, Field)>("stark.io.info", (1, kind));
    let sbytes = read_byte_stream(1, sidx, slen);
    let digest = b3_pack(Blake3::hash(sbytes));
    match kind {
      0 => {
        aggr_assert_digest(digest, ixvm_vk_digest) } ,
      _ => {
        aggr_assert_digest(digest, self_vk_digest) } ,
    };
    let (sys, srest) = read_system(sbytes);
    let Lists::Node::Nil = load(srest);
    sys
  }

  fn aggr_verify_child(sys: Sys, key: Field) -> List<List<U64>> {
    let (idx, len) = hint::<(Field, Field)>("stark.io.info", (0, key));
    let (cidx, clen) = hint::<(Field, Field)>("stark.io.info", (2, key));
    let cbytes = read_byte_stream(2, cidx, clen);
    let (claims, crest) = read_claims(cbytes);
    let Lists::Node::Nil = load(crest);
    assert_eq!(verify_batch_at(sys, idx, len, claims), 1);
    claims
  }

  fn aggr_child_check_env_digest(kind: Field, key: Field,
      ixvm_vk_digest: [Field; 8], self_vk_digest: [Field; 8],
      verify_idx: Field, aggr_idx: Field, allowed_digest: [Field; 8]) -> [Field; 8] {
    let sys = aggr_load_sys(kind, ixvm_vk_digest, self_vk_digest);
    let claim = aggr_only_claim(aggr_verify_child(sys, key));
    assert_eq!(aggr_claim_field(claim, 0), 1,
      "aggr: child has the wrong claim channel");
    match kind {
      0 => {
        assert_eq!(list_length(claim), 10,
          "aggr: LegacyIxVM child must expose a 10-word verify_claim claim");
        assert_eq!(aggr_claim_field(claim, 1), verify_idx,
          "aggr: LegacyIxVM child has the wrong entrypoint");
        aggr_claim_digest(claim, 2) } ,
      _ => {
        assert_eq!(list_length(claim), 18,
          "aggr: recursive child must expose an 18-word ix_aggr claim");
        assert_eq!(aggr_claim_field(claim, 1), aggr_idx,
          "aggr: recursive child has the wrong entrypoint");
        aggr_assert_digest(aggr_claim_digest(claim, 2), allowed_digest);
        aggr_claim_digest(claim, 10) } ,
    }
  }

  fn aggr_wrap(kind: Field, ixvm_vk_digest: [Field; 8], self_vk_digest: [Field; 8],
      verify_idx: Field, aggr_idx: Field, allowed_digest: [Field; 8],
      out_claim_digest: [Field; 8]) -> () {
    let child = aggr_child_check_env_digest(kind, 0,
      ixvm_vk_digest, self_vk_digest, verify_idx, aggr_idx, allowed_digest);
    aggr_assert_digest(child, out_claim_digest)
  }

  fn aggr_pair(left_kind: Field, right_kind: Field,
      ixvm_vk_digest: [Field; 8], self_vk_digest: [Field; 8],
      verify_idx: Field, aggr_idx: Field, allowed_digest: [Field; 8],
      out_claim_digest: [Field; 8]) -> () {
    let left_digest = aggr_child_check_env_digest(left_kind, 0,
      ixvm_vk_digest, self_vk_digest, verify_idx, aggr_idx, allowed_digest);
    let right_digest = aggr_child_check_env_digest(right_kind, 1,
      ixvm_vk_digest, self_vk_digest, verify_idx, aggr_idx, allowed_digest);
    let (left_root, left_asm) =
      aggr_parse_check_env(aggr_load_preimage(left_digest));
    let (right_root, right_asm) =
      aggr_parse_check_env(aggr_load_preimage(right_digest));

    let (oidx, olen) = hint::<(Field, Field)>("stark.io.info", (2, 2));
    let output_bytes = read_byte_stream(2, oidx, olen);
    assert_eq!(b3_pack(Blake3::hash(output_bytes)), out_claim_digest,
      "aggr: output claim digest mismatch");
    let (output_root, output_asm) = aggr_parse_check_env(output_bytes);

    let left_subjects = aggr_load_canonical_tree(left_root);
    let right_subjects = aggr_load_canonical_tree(right_root);
    let left_assumptions = aggr_load_optional_tree(left_asm);
    let right_assumptions = aggr_load_optional_tree(right_asm);
    let output_subjects = aggr_load_canonical_tree(output_root);
    let output_assumptions = aggr_load_optional_tree(output_asm);

    aggr_assert_union(left_subjects, right_subjects, output_subjects);
    aggr_assert_difference(left_assumptions, right_assumptions,
      output_subjects, output_assumptions);
    ()
  }

  fn aggr_pair_structural(left_kind: Field, right_kind: Field,
      ixvm_vk_digest: [Field; 8], self_vk_digest: [Field; 8],
      verify_idx: Field, aggr_idx: Field, allowed_digest: [Field; 8],
      out_claim_digest: [Field; 8]) -> () {
    let left_digest = aggr_child_check_env_digest(left_kind, 0,
      ixvm_vk_digest, self_vk_digest, verify_idx, aggr_idx, allowed_digest);
    let right_digest = aggr_child_check_env_digest(right_kind, 1,
      ixvm_vk_digest, self_vk_digest, verify_idx, aggr_idx, allowed_digest);
    let (left_root, left_asm) =
      aggr_parse_check_env(aggr_load_preimage(left_digest));
    let (right_root, right_asm) =
      aggr_parse_check_env(aggr_load_preimage(right_digest));

    let (oidx, olen) = hint::<(Field, Field)>("stark.io.info", (2, 2));
    let output_bytes = read_byte_stream(2, oidx, olen);
    assert_eq!(b3_pack(Blake3::hash(output_bytes)), out_claim_digest,
      "aggr structural: output claim digest mismatch");
    let (output_root, output_asm) = aggr_parse_check_env(output_bytes);

    let expected_root = aggr_node_hash(left_root, right_root);
    assert_eq!(address_eq(output_root, expected_root), 1,
      "aggr structural: output subject root is not nodeHash(left, right)");

    let left_assumptions = aggr_load_optional_tree(left_asm);
    let right_assumptions = aggr_load_optional_tree(right_asm);
    let output_assumptions = aggr_load_optional_tree(output_asm);
    aggr_assert_structural_difference(left_assumptions, right_assumptions,
      output_root, output_assumptions);
    ()
  }

  fn aggr_parse_range(bytes: ByteStream) -> (Addr, U64, U64, Ext) {
    let (tag, s) = aggr_read_byte(bytes);
    assert_eq!(UInt8::to_field(tag), 82, "aggr range: statement has the wrong tag");
    let (d, s2) = aggr_read_address(s);
    let (lo, s3) = read_u64(s2);
    let (hi, s4) = read_u64(s3);
    let (r0, s5) = read_u64(s4);
    let (r1, stop) = read_u64(s5);
    let Lists::Node::Nil = load(stop);
    (d, lo, hi, [gl_val(r0), gl_val(r1)])
  }

  fn aggr_read_digest(s: ByteStream) -> (DigestP, ByteStream) {
    let (a, s1) = read_u64(s);
    let (b, s2) = read_u64(s1);
    let (c, s3) = read_u64(s2);
    let (d, s4) = read_u64(s3);
    (store([a, b, c, d]), s4)
  }
  fn aggr_read_cap_n(s: ByteStream, n: Field) -> (MerkleCap, ByteStream) {
    match n {
      0 => {  (store(Lists::Node::Nil), s) } ,
      _ => {
        let (x, s1) = aggr_read_digest(s);
        let (rest, s2) = aggr_read_cap_n(s1, n - 1);
        (store(Lists::Node::Cons(x, rest)), s2) } ,
    }
  }
  fn aggr_read_bits_n(s: ByteStream, n: Field) -> (List<Field>, ByteStream) {
    match n {
      0 => {  (store(Lists::Node::Nil), s) } ,
      _ => {
        let (b, s1) = aggr_read_byte(s);
        let (rest, s2) = aggr_read_bits_n(s1, n - 1);
        (store(Lists::Node::Cons(UInt8::to_field(b), rest)), s2) } ,
    }
  }
  fn aggr_read_bytes_n(s: ByteStream, n: Field) -> (List<U8>, ByteStream) {
    match n {
      0 => {  (store(Lists::Node::Nil), s) } ,
      _ => {
        let (b, s1) = aggr_read_byte(s);
        let (rest, s2) = aggr_read_bytes_n(s1, n - 1);
        (store(Lists::Node::Cons(b, rest)), s2) } ,
    }
  }
  fn aggr_read_header(s: ByteStream) -> (ShardHeader, ByteStream) {
    let (na, s1) = read_count(s);
    let (active, s2) = aggr_read_bits_n(s1, na);
    let (nc, s3) = read_count(s2);
    let (cap, s4) = aggr_read_cap_n(s3, nc);
    let (nl, s5) = read_count(s4);
    let (lds, s6) = aggr_read_bytes_n(s5, nl);
    let (claims, s7) = read_claims(s6);
    (ShardHeader::Mk(active, cap, lds, claims), s7)
  }
  fn aggr_read_headers_n(s: ByteStream, n: Field) -> (List<ShardHeader>, ByteStream) {
    match n {
      0 => {  (store(Lists::Node::Nil), s) } ,
      _ => {
        let (h, s1) = aggr_read_header(s);
        let (rest, s2) = aggr_read_headers_n(s1, n - 1);
        (store(Lists::Node::Cons(h, rest)), s2) } ,
    }
  }
  fn aggr_read_message(s: ByteStream) -> (BatchMessage, ByteStream) {
    let (args, s1) = read_one_claim(s);
    let (mult, s2) = read_u64(s1);
    (BatchMessage::Mk(args, mult), s2)
  }
  fn aggr_read_messages_n(s: ByteStream, n: Field) -> (List<BatchMessage>, ByteStream) {
    match n {
      0 => {  (store(Lists::Node::Nil), s) } ,
      _ => {
        let (m, s1) = aggr_read_message(s);
        let (rest, s2) = aggr_read_messages_n(s1, n - 1);
        (store(Lists::Node::Cons(m, rest)), s2) } ,
    }
  }

  fn aggr_load_preamble(key: Field, d: Addr) -> (List<ShardHeader>, List<BatchMessage>) {
    let (idx, len) = hint::<(Field, Field)>("stark.io.info", (0, key));
    let bytes = read_byte_stream(0, idx, len);
    assert_eq!(address_eq(Blake3::bytes_to_addr(bytes), d), 1,
      "aggr range: preamble does not hash to the statement's batch digest");
    let (nh, s1) = read_count(bytes);
    let (headers, s2) = aggr_read_headers_n(s1, nh);
    let (nm, s3) = read_count(s2);
    let (messages, stop) = aggr_read_messages_n(s3, nm);
    let Lists::Node::Nil = load(stop);
    (headers, messages)
  }

  fn aggr_batch_challenges(sys: Sys, headers: List<ShardHeader>,
      messages: List<BatchMessage>) -> (Ext, Ext, ByteStream) {
    let Sys::Mk(_params, tlimbs, _circuits, commit, _prep_indices) = sys;
    let prep_cap = opt_commit_cap(commit);
    batch_fiat_shamir(tlimbs, prep_cap, headers, messages)
  }

  fn aggr_verify_range(sys: Sys, headers: List<ShardHeader>, i: Field, shard: Field,
      n: Field, input: ByteStream, lch: Ext, fch: Ext, acc: Ext) -> (Ext, Field) {
    match n {
      0 => {  (acc, i) } ,
      _ => {
        let Lists::Node::Cons(h, hrest) = load(headers);
        let (p, j) = read_proof(i);
        let r = verify_shard(sys, h, shard, p, input, lch, fch);
        aggr_verify_range(sys, hrest, j, shard + 1, n - 1, input, lch, fch,
          eg_add(acc, r)) } ,
    }
  }

  fn aggr_output_range(out_claim_digest: [Field; 8]) -> (Addr, U64, U64, Ext) {
    let (oidx, olen) = hint::<(Field, Field)>("stark.io.info", (2, 2));
    let output_bytes = read_byte_stream(2, oidx, olen);
    assert_eq!(b3_pack(Blake3::hash(output_bytes)), out_claim_digest,
      "aggr range: output statement digest mismatch");
    aggr_parse_range(output_bytes)
  }

  fn aggr_child_range(key: Field, ixvm_vk_digest: [Field; 8], self_vk_digest: [Field; 8],
      verify_idx: Field, aggr_idx: Field, allowed_digest: [Field; 8])
      -> (Addr, U64, U64, Ext) {
    let digest = aggr_child_check_env_digest(1, key,
      ixvm_vk_digest, self_vk_digest, verify_idx, aggr_idx, allowed_digest);
    aggr_parse_range(aggr_load_preimage(digest))
  }

  fn aggr_range_leaf(ixvm_vk_digest: [Field; 8], self_vk_digest: [Field; 8],
      out_claim_digest: [Field; 8]) -> () {
    let sys = aggr_load_sys(0, ixvm_vk_digest, self_vk_digest);
    let (d, lo_limb, hi_limb, r) = aggr_output_range(out_claim_digest);
    let (headers, messages) = aggr_load_preamble(0, d);
    let (lch, fch, input) = aggr_batch_challenges(sys, headers, messages);
    assert_eq!(bytes8_le(lo_limb, hi_limb), 1,
      "aggr range: the range ends before it starts");
    let lo = UInt64::to_field(lo_limb);
    let n = UInt64::to_field(hi_limb) - lo;
    let (pidx, plen) = hint::<(Field, Field)>("stark.io.info", (0, 1));
    let (count, j) = read_count_at(pidx);
    assert_eq!(count, n, "aggr range: proof count differs from the range");
    let (total, stop) = aggr_verify_range(sys, list_drop(headers, lo), j, lo,
      n, input, lch, fch, [0, 0]);
    assert_eq!(stop, pidx + plen, "aggr range: trailing bytes after the proofs");
    assert_eq!(eg_eq(total, r), 1,
      "aggr range: residual sum differs from the statement");
    ()
  }

  fn aggr_range_join(ixvm_vk_digest: [Field; 8], self_vk_digest: [Field; 8],
      verify_idx: Field, aggr_idx: Field, allowed_digest: [Field; 8],
      out_claim_digest: [Field; 8]) -> () {
    let (ld, llo, lhi, lr) = aggr_child_range(0,
      ixvm_vk_digest, self_vk_digest, verify_idx, aggr_idx, allowed_digest);
    let (rd, rlo, rhi, rr) = aggr_child_range(1,
      ixvm_vk_digest, self_vk_digest, verify_idx, aggr_idx, allowed_digest);
    let (d, lo, hi, r) = aggr_output_range(out_claim_digest);
    assert_eq!(address_eq(ld, rd), 1,
      "aggr range: children verify different batches");
    assert_eq!(address_eq(d, ld), 1,
      "aggr range: output names a different batch than the children");
    assert_eq!(UInt64::to_field(lhi), UInt64::to_field(rlo),
      "aggr range: children are not adjacent");
    assert_eq!(UInt64::to_field(lo), UInt64::to_field(llo),
      "aggr range: output starts elsewhere than the left child");
    assert_eq!(UInt64::to_field(hi), UInt64::to_field(rhi),
      "aggr range: output ends elsewhere than the right child");
    assert_eq!(eg_eq(eg_add(lr, rr), r), 1,
      "aggr range: output residual is not the children's sum");
    ()
  }

  fn aggr_range_root(ixvm_vk_digest: [Field; 8], self_vk_digest: [Field; 8],
      verify_idx: Field, aggr_idx: Field, allowed_digest: [Field; 8],
      out_claim_digest: [Field; 8]) -> () {
    let (d, lo, hi, r) = aggr_child_range(0,
      ixvm_vk_digest, self_vk_digest, verify_idx, aggr_idx, allowed_digest);
    let sys = aggr_load_sys(0, ixvm_vk_digest, self_vk_digest);
    let (headers, messages) = aggr_load_preamble(1, d);
    let k = list_length(headers);
    assert_eq!(assert_shard_count_ok(k), 1);
    assert_eq!(UInt64::to_field(lo), 0,
      "aggr range: root range does not start at shard 0");
    assert_eq!(UInt64::to_field(hi), k,
      "aggr range: root range does not end at the last shard");
    assert_eq!(assert_closure_pairs(messages, 0, 0), 1);
    let (lch, fch, _input) = aggr_batch_challenges(sys, headers, messages);
    let total = messages_acc(r, messages, lch, fch);
    assert_eq!(ext_is_zero(total), 1, "aggr range: the batch does not balance");
    let claim = aggr_only_claim(batch_claims(headers));
    assert_eq!(list_length(claim), 10,
      "aggr range: batch must carry a 10-word verify_claim claim");
    assert_eq!(aggr_claim_field(claim, 0), 1,
      "aggr range: batch claim has the wrong channel");
    assert_eq!(aggr_claim_field(claim, 1), verify_idx,
      "aggr range: batch claim has the wrong entrypoint");
    aggr_assert_digest(aggr_claim_digest(claim, 2), out_claim_digest)
  }

  fn ix_aggr(allowed_digest: [Field; 8], out_claim_digest: [Field; 8]) -> () {

    let (aidx, alen) = hint::<(Field, Field)>("stark.io.info", (3, 0));
    assert_eq!(alen, 80,
      "aggr: allowed blob must be exactly 80 bytes");
    let allowed_bytes = read_byte_stream(3, aidx, alen);
    assert_eq!(b3_pack(Blake3::hash(allowed_bytes)), allowed_digest,
      "aggr: allowed blob digest mismatch");
    let (ixvm_digest_addr, as1) = aggr_read_address(allowed_bytes);
    let (verify_idx_limb, as2) = read_u64(as1);
    let (self_digest_addr, as3) = aggr_read_address(as2);
    let (aggr_idx_limb, astop) = read_u64(as3);
    let Lists::Node::Nil = load(astop);
    let ixvm_vk_digest = aggr_pack_address(ixvm_digest_addr);
    let self_vk_digest = aggr_pack_address(self_digest_addr);
    let verify_idx = UInt64::to_field(verify_idx_limb);
    let aggr_idx = UInt64::to_field(aggr_idx_limb);

    let (hidx, hlen) = hint::<(Field, Field)>("stark.io.info", (6, 0));
    assert_eq!(hlen, 1, "aggr: shape hint must be exactly one byte");
    let hint = read_byte_stream(6, hidx, hlen);
    let (shape, hstop) = aggr_read_byte(hint);
    let Lists::Node::Nil = load(hstop);
    match UInt8::to_field(shape) {
      0 => {  aggr_wrap(0, ixvm_vk_digest, self_vk_digest,
        verify_idx, aggr_idx, allowed_digest, out_claim_digest) } ,
      1 => {  aggr_wrap(1, ixvm_vk_digest, self_vk_digest,
        verify_idx, aggr_idx, allowed_digest, out_claim_digest) } ,
      2 => {  aggr_pair(0, 0, ixvm_vk_digest, self_vk_digest,
        verify_idx, aggr_idx, allowed_digest, out_claim_digest) } ,
      3 => {  aggr_pair(0, 1, ixvm_vk_digest, self_vk_digest,
        verify_idx, aggr_idx, allowed_digest, out_claim_digest) } ,
      4 => {  aggr_pair(1, 0, ixvm_vk_digest, self_vk_digest,
        verify_idx, aggr_idx, allowed_digest, out_claim_digest) } ,
      5 => {  aggr_pair(1, 1, ixvm_vk_digest, self_vk_digest,
        verify_idx, aggr_idx, allowed_digest, out_claim_digest) } ,
      6 => {  aggr_pair_structural(0, 0, ixvm_vk_digest, self_vk_digest,
        verify_idx, aggr_idx, allowed_digest, out_claim_digest) } ,
      7 => {  aggr_pair_structural(0, 1, ixvm_vk_digest, self_vk_digest,
        verify_idx, aggr_idx, allowed_digest, out_claim_digest) } ,
      8 => {  aggr_pair_structural(1, 0, ixvm_vk_digest, self_vk_digest,
        verify_idx, aggr_idx, allowed_digest, out_claim_digest) } ,
      9 => {  aggr_pair_structural(1, 1, ixvm_vk_digest, self_vk_digest,
        verify_idx, aggr_idx, allowed_digest, out_claim_digest) } ,
      10 => {  aggr_range_leaf(ixvm_vk_digest, self_vk_digest, out_claim_digest) } ,
      11 => {  aggr_range_join(ixvm_vk_digest, self_vk_digest,
        verify_idx, aggr_idx, allowed_digest, out_claim_digest) } ,
      12 => {  aggr_range_root(ixvm_vk_digest, self_vk_digest,
        verify_idx, aggr_idx, allowed_digest, out_claim_digest) } ,
    }
  }
inline fn store<T>(value: T) -> &T { &value }
inline fn load<T>(pointer: &T) -> T { *pointer }
}
