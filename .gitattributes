# Generated files: GitHub collapses them in diffs and leaves them out of the
# language statistics. Each is regenerated by the tool named above it; CI checks
# the codegen and the trace bundle against their generators (`--check`).

# Aiur codegen of the IxVM, ix_aggr and multi-stark programs (`ix codegen`)
crates/ixvm-codegen/src/aiur_ixvm.rs linguist-generated=true
crates/ixvm-codegen/src/aiur_ix_aggr.rs linguist-generated=true
crates/ixvm-codegen/src/aiur_multi_stark.rs linguist-generated=true

# Trace writers, CUDA units and their manifest (`ix codegen --trace-bundle`)
crates/aiur/src/trace_codegen/programs/ixvm.rs linguist-generated=true
crates/aiur/src/trace_codegen/programs/ixvm_cuda.rs linguist-generated=true
crates/aiur/src/trace_codegen/programs/ix_aggr.rs linguist-generated=true
crates/aiur/src/trace_codegen/programs/ix_aggr_cuda.rs linguist-generated=true
crates/aiur/src/trace_codegen/programs/multi_stark.rs linguist-generated=true
crates/aiur/src/trace_codegen/programs/multi_stark_cuda.rs linguist-generated=true
crates/aiur/cuda/generated/production/** linguist-generated=true

# Trace-codegen test fixtures (`lake exe trace-fixtures`)
crates/aiur/src/trace_codegen/tests/generated.rs linguist-generated=true
crates/aiur/src/trace_codegen/tests/generated_cuda.rs linguist-generated=true
crates/aiur/src/trace_codegen/tests/blake3.rs linguist-generated=true
crates/aiur/src/trace_codegen/tests/blake3_cuda.rs linguist-generated=true
crates/aiur/cuda/generated/blake3.cu linguist-generated=true
crates/aiur/cuda/generated/fixtures.cu linguist-generated=true

# AuxGen's frozen reference outputs; the decoder beside them is hand-written
Tests/Ix/AuxGen/Reference/*.lean linguist-generated=true
Tests/Ix/AuxGen/Reference/JsonTable.lean -linguist-generated

# The default role table, its evidence and the Ixon prelude (`kernel-pin-gen`)
IxC/Kernel/Ixon/RoleData.lean linguist-generated=true

# The compiler's non-canonical record (the `twins` suite's re-record mode)
Tests/Ix/Compile/NonCanonicalDefault.lean linguist-generated=true
