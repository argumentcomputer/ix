theorem seedEq : Rng.seeded (config.seed + 7) = r0 := by decide +kernel

theorem epoch0 : shuffle (List.range config.trainSize) r0 = (perm0, r1) := by decide +kernel
theorem batches0 : chunk config.batch perm0 config.trainSize = schedule0 := by decide +kernel

theorem epoch1 : shuffle (List.range config.trainSize) r1 = (perm1, r2) := by decide +kernel
theorem batches1 : chunk config.batch perm1 config.trainSize = schedule1 := by decide +kernel

/-- The schedule, composed epoch by epoch from its parts given as hypotheses. -/
theorem fromEpochs (hs : Rng.seeded (config.seed + 7) = r0)
    (e0 : shuffle (List.range config.trainSize) r0 = (perm0, r1))
    (c0 : chunk config.batch perm0 config.trainSize = schedule0)
    (e1 : shuffle (List.range config.trainSize) r1 = (perm1, r2))
    (c1 : chunk config.batch perm1 config.trainSize = schedule1)
    : config.schedule = schedule0 ++ schedule1 := by
  have he : config.epochs = 2 := rfl
  rw [schedule_eq_go, he, hs]
  simp only [schedule_go_succ, schedule_go_zero, List.append_nil, e0, c0, e1, c1]

theorem scheduleEq : config.schedule = schedule0 ++ schedule1 :=
  fromEpochs seedEq epoch0 batches0 epoch1 batches1

theorem initEq : config.init Triage.spec = w0 := by
  decide +kernel

theorem chunk0 : schedule0.foldl (config.stepFn Triage.spec examplesOutput) w0 = w1 := by
  decide +kernel

theorem chunk1 : schedule1.foldl (config.stepFn Triage.spec examplesOutput) w1 = w2 := by
  decide +kernel

/-- The run, composed from its parts. The parts are hypotheses, so checking this proof never
evaluates the run: it only rewrites. -/
theorem fromChunks
    (hex : (config.data Triage.spec).map Triage.spec.example = examplesOutput)
    (hs : config.schedule = schedule0 ++ schedule1)
    (hi : config.init Triage.spec = w0)
    (h0 : schedule0.foldl (config.stepFn Triage.spec examplesOutput) w0 = w1)
    (h1 : schedule1.foldl (config.stepFn Triage.spec examplesOutput) w1 = w2)
    : train Triage.spec config = w2 := by
  simp only [train, hex, hs, hi, List.foldl_append, h0, h1]

/-- The model is exactly the specified training result. Checking it only matches the parts'
statements against `fromChunks`'s hypotheses. -/
theorem trainingCertified : train Triage.spec config = w2 :=
  fromChunks examplesEq scheduleEq initEq chunk0 chunk1

def trainedOutput : Model := w2

