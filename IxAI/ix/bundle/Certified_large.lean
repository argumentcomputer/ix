/-- The run, composed from its parts. The parts are hypotheses, so checking this proof never
evaluates the run: it only rewrites. -/
theorem fromChunks
    (hex : (config.data Triage.spec).map Triage.spec.example = examplesOutput)
    (hs : config.schedule = schedule0 ++ schedule1 ++ schedule2 ++ schedule3 ++ schedule4 ++ schedule5 ++ schedule6 ++ schedule7 ++ schedule8 ++ schedule9)
    (hi : config.init Triage.spec = w0)
    (h0 : schedule0.foldl (config.stepFn Triage.spec examplesOutput) w0 = w1)
    (h1 : schedule1.foldl (config.stepFn Triage.spec examplesOutput) w1 = w2)
    (h2 : schedule2.foldl (config.stepFn Triage.spec examplesOutput) w2 = w3)
    (h3 : schedule3.foldl (config.stepFn Triage.spec examplesOutput) w3 = w4)
    (h4 : schedule4.foldl (config.stepFn Triage.spec examplesOutput) w4 = w5)
    (h5 : schedule5.foldl (config.stepFn Triage.spec examplesOutput) w5 = w6)
    (h6 : schedule6.foldl (config.stepFn Triage.spec examplesOutput) w6 = w7)
    (h7 : schedule7.foldl (config.stepFn Triage.spec examplesOutput) w7 = w8)
    (h8 : schedule8.foldl (config.stepFn Triage.spec examplesOutput) w8 = w9)
    (h9 : schedule9.foldl (config.stepFn Triage.spec examplesOutput) w9 = w10)
    : train Triage.spec config = w10 := by
  show config.schedule.foldl (config.stepFn Triage.spec ((config.data Triage.spec).map Triage.spec.example))
    (config.init Triage.spec) = _
  rw [hex, hs, hi]
  simp only [List.foldl_append]
  rw [h0, h1, h2, h3, h4, h5, h6, h7, h8, h9]

/-- The model is exactly the specified training result. Checking it only matches the parts'
statements against `fromChunks`'s hypotheses. -/
theorem trainingCertified : train Triage.spec config = w10 :=
  fromChunks examplesEq scheduleEq initEq chunk0 chunk1 chunk2 chunk3 chunk4 chunk5 chunk6 chunk7 chunk8 chunk9

