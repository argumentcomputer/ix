/-- The schedule, composed epoch by epoch from its parts given as hypotheses. -/
theorem fromEpochs (hs : Rng.seeded (config.seed + 7) = r0)
    (e0 : shuffle (List.range config.trainSize) r0 = (perm0, r1))
    (c0 : chunk config.batch perm0 config.trainSize = schedule0)
    (e1 : shuffle (List.range config.trainSize) r1 = (perm1, r2))
    (c1 : chunk config.batch perm1 config.trainSize = schedule1)
    (e2 : shuffle (List.range config.trainSize) r2 = (perm2, r3))
    (c2 : chunk config.batch perm2 config.trainSize = schedule2)
    (e3 : shuffle (List.range config.trainSize) r3 = (perm3, r4))
    (c3 : chunk config.batch perm3 config.trainSize = schedule3)
    (e4 : shuffle (List.range config.trainSize) r4 = (perm4, r5))
    (c4 : chunk config.batch perm4 config.trainSize = schedule4)
    (e5 : shuffle (List.range config.trainSize) r5 = (perm5, r6))
    (c5 : chunk config.batch perm5 config.trainSize = schedule5)
    (e6 : shuffle (List.range config.trainSize) r6 = (perm6, r7))
    (c6 : chunk config.batch perm6 config.trainSize = schedule6)
    (e7 : shuffle (List.range config.trainSize) r7 = (perm7, r8))
    (c7 : chunk config.batch perm7 config.trainSize = schedule7)
    (e8 : shuffle (List.range config.trainSize) r8 = (perm8, r9))
    (c8 : chunk config.batch perm8 config.trainSize = schedule8)
    (e9 : shuffle (List.range config.trainSize) r9 = (perm9, r10))
    (c9 : chunk config.batch perm9 config.trainSize = schedule9)
    : config.schedule = schedule0 ++ schedule1 ++ schedule2 ++ schedule3 ++ schedule4 ++ schedule5 ++ schedule6 ++ schedule7 ++ schedule8 ++ schedule9 := by
  have he : config.epochs = 10 := rfl
  have g0 : Config.schedule.go config 10 r0 = schedule0 ++ Config.schedule.go config 9 r1 := by
    rw [schedule_go_succ config 9 r0, e0]
    simp only [c0]
  have g1 : Config.schedule.go config 9 r1 = schedule1 ++ Config.schedule.go config 8 r2 := by
    rw [schedule_go_succ config 8 r1, e1]
    simp only [c1]
  have g2 : Config.schedule.go config 8 r2 = schedule2 ++ Config.schedule.go config 7 r3 := by
    rw [schedule_go_succ config 7 r2, e2]
    simp only [c2]
  have g3 : Config.schedule.go config 7 r3 = schedule3 ++ Config.schedule.go config 6 r4 := by
    rw [schedule_go_succ config 6 r3, e3]
    simp only [c3]
  have g4 : Config.schedule.go config 6 r4 = schedule4 ++ Config.schedule.go config 5 r5 := by
    rw [schedule_go_succ config 5 r4, e4]
    simp only [c4]
  have g5 : Config.schedule.go config 5 r5 = schedule5 ++ Config.schedule.go config 4 r6 := by
    rw [schedule_go_succ config 4 r5, e5]
    simp only [c5]
  have g6 : Config.schedule.go config 4 r6 = schedule6 ++ Config.schedule.go config 3 r7 := by
    rw [schedule_go_succ config 3 r6, e6]
    simp only [c6]
  have g7 : Config.schedule.go config 3 r7 = schedule7 ++ Config.schedule.go config 2 r8 := by
    rw [schedule_go_succ config 2 r7, e7]
    simp only [c7]
  have g8 : Config.schedule.go config 2 r8 = schedule8 ++ Config.schedule.go config 1 r9 := by
    rw [schedule_go_succ config 1 r8, e8]
    simp only [c8]
  have g9 : Config.schedule.go config 1 r9 = schedule9 ++ Config.schedule.go config 0 r10 := by
    rw [schedule_go_succ config 0 r9, e9]
    simp only [c9]
  rw [schedule_eq_go, he, hs, g0, g1, g2, g3, g4, g5, g6, g7, g8, g9, schedule_go_zero, List.append_nil]
  simp only [List.append_assoc]

theorem scheduleEq : config.schedule = schedule0 ++ schedule1 ++ schedule2 ++ schedule3 ++ schedule4 ++ schedule5 ++ schedule6 ++ schedule7 ++ schedule8 ++ schedule9 :=
  fromEpochs seedEq epoch0 batches0 epoch1 batches1 epoch2 batches2 epoch3 batches3 epoch4 batches4 epoch5 batches5 epoch6 batches6 epoch7 batches7 epoch8 batches8 epoch9 batches9

