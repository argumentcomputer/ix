+// `IxAIGpu.transposeK` of a `rows × cols` matrix, both positive.
+void transpose(const i64* src, int rows, int cols, i64* dst) {
+  long long tiles = ((long long)rows + kTransposeTile - 1) / kTransposeTile *
+                    (((long long)cols + kTransposeTile - 1) / kTransposeTile);
+  transpose_kernel<<<(unsigned)tiles, kWarpsPerBlock * kLanes>>>(src, rows, cols, dst);
+}
