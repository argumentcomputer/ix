+// Capture the step with the batch `n` values already staged, as `g->graph` for `key`. False if the
+// step cannot be captured (`capture_aborted`) or on a CUDA error, recorded in `last_error`.
+bool capture_step(IxaiGpu* g, int B, i64 lr, size_t n, const IxaiGpuGraphKey& key) {
+  if (!ok(cudaStreamBeginCapture(g->stream, cudaStreamCaptureModeThreadLocal))) return false;
+  g->capturing = true;
+  g->capture_aborted = false;
+  ok(cudaMemcpyAsync(g->in, g->staged, n * sizeof(i64), cudaMemcpyHostToDevice, g->stream));
+  enqueue_step(g, B, lr);
+  g->capturing = false;
+  cudaGraph_t graph = nullptr;
+  bool good = ok(cudaStreamEndCapture(g->stream, &graph)) && !g->capture_aborted && last_error == cudaSuccess;
+  cudaGraphExec_t exec = nullptr;
+  if (good) good = ok(cudaGraphInstantiate(&exec, graph, 0));
+  if (graph) cudaGraphDestroy(graph);
+  if (!good) return false;
+  if (g->graph) cudaGraphExecDestroy(g->graph);
+  g->graph = exec;
+  g->graph_key = key;
+  for (int i = 0; i < kGemms; i++) g->graph_measured[i] = g->measured[i];
+  return true;
+}
