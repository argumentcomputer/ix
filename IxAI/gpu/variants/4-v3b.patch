+// `IxAIGpu.gpuStep ⟨5⟩ ⟨lr⟩ m batch` on the device's model, with the batch's inputs `x` (B×I) and
+// targets `t` (B×O). Returns 0, 1 if a fixed-width bound was violated (the model is then invalid),
+// or -1 on a CUDA error. An empty batch leaves the model unchanged, as `Model.step` does.
+int ixai_gpu_step(IxaiGpu* g, const i64* x, const i64* t, int n_batch, i64 lr) {
+  begin();
+  g->tensor_gemms = 0;
+  g->kernel_ms = 0;
+  if (n_batch < 0 || n_batch > g->max_batch) return -1;
+  g->last_batch = n_batch;
+  if (n_batch == 0) return 0;
+  const int I = g->n_in, O = g->n_out, B = n_batch;
+  const size_t nx = (size_t)B * I, nt = (size_t)B * O;
+  if (!host_buffer(x, nx * sizeof(i64)) || !host_buffer(t, nt * sizeof(i64))) return -1;
+  place_keys(g, B);
+  g->x = g->in;
+  g->t = g->in + nx;
+  cudaStream_t st = g->stream;
+  // The previous step ended with the stream idle, so no copy still reads the staging buffer.
+  const bool staged = nx + nt <= g->staged_length;
+  if (staged) {
+    if (nx) memcpy(g->staged, x, nx * sizeof(i64));
+    if (nt) memcpy(g->staged + nx, t, nt * sizeof(i64));
+  }
+  IxaiGpuGraphKey key{B, g->path, lr, {}, g->planes_a, g->planes_b};
+  for (int i = 0; i < kGemms; i++) key.limbs[i][0] = g->limbs[i][0], key.limbs[i][1] = g->limbs[i][1];
+  bool replay = staged && g->graph && same_key(key, g->graph_key);
+  if (!replay && staged && g->has_last_key && same_key(key, g->last_key)) {
+    replay = capture_step(g, B, lr, nx + nt, key);
+    if (!replay && last_error != cudaSuccess) return -1;
+  }
+  g->last_key = key;
+  g->has_last_key = true;
