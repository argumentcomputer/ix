+// Enqueue a step's work after its upload: clear the status, run the kernels, download the status.
+void enqueue_step(IxaiGpu* g, int B, i64 lr) {
+  const int I = g->n_in, H = g->n_hidden, O = g->n_out;
   cudaStream_t st = g->stream;
+  for (bool& m : g->measured) m = false;
+  ok(cudaMemsetAsync(g->status, 0, sizeof(IxaiGpuStatus), st));
+  // An external record is a node of a captured graph rather than an edge between streams.
+  ok(cudaEventRecordWithFlags(g->start, st, cudaEventRecordExternal));
   int* flag = &g->status->flag;
   const long long BH = (long long)B * H, BO = (long long)B * O;
   if (H > 0) {
