+
+// A null host buffer is rejected, as `cudaMemcpy` rejects it, before a host copy reads it.
+bool host_buffer(const void* p, size_t bytes) { return bytes == 0 || p || ok(cudaErrorInvalidValue); }
+
+// Upload a batch, `x` (`nx` values) then `t` (`nt` values), into `in`.
+bool upload_batch(IxaiGpu* g, const i64* x, size_t nx, const i64* t, size_t nt) {
+  if (!host_buffer(x, nx * sizeof(i64)) || !host_buffer(t, nt * sizeof(i64))) return false;
+  if (nx + nt <= g->staged_length) {
+    if (nx) memcpy(g->staged, x, nx * sizeof(i64));
+    if (nt) memcpy(g->staged + nx, t, nt * sizeof(i64));
+    return ok(cudaMemcpyAsync(g->in, g->staged, (nx + nt) * sizeof(i64), cudaMemcpyHostToDevice, g->stream));
+  }
+  return ok(cudaMemcpyAsync(g->in, x, nx * sizeof(i64), cudaMemcpyHostToDevice, g->stream)) &&
+         ok(cudaMemcpyAsync(g->in + nx, t, nt * sizeof(i64), cudaMemcpyHostToDevice, g->stream));
 }
 
