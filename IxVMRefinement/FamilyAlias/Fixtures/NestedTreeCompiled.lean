        (⟨aliases ++ pre⟩ : Env .anon).find? k = none → Ix.Kernel.Model.HasModel env₂ k) := by
  obtain ⟨env₂, -, hd, -⟩ := famStep_of_check record_ok
  exact ⟨env₂, hd,
    fullDeclInv_famStep (aliasGroup_of_check group_ok) pin_ok
