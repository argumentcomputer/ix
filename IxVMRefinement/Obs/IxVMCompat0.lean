/-- The evaluation paths of `IxVMCompat::audit_div`: one constructor per combination of selected arms. -/
inductive «IxVMCompat::audit_div».Path (x_a x_b x_expected_q x_expected_r : SourceValue F) (h : Heap F) (r : SourceValue F) (h' : Heap F)
    (calls : List (Call F)) : Prop where
  | run
      (m2 : Heap F) (cs12 : List (Call F)) (x_q : SourceValue F) (x_r : SourceValue F) (v55 : SourceValue F) (m58 : Heap F) (cs66 : List (Call F)) (v103 : SourceValue F) (m106 : Heap F) (cs114 : List (Call F))
      (ev14 : ObsFn W "KernelKlimbs::klimbs_div_mod" [x_a, x_b] h (.tuple [x_q, x_r]) m2 cs12)
      (ev68 : ObsFn W "KernelLevels::klimbs_eq" [x_q, x_expected_q] m2 v55 m58 cs66)
      (heq91 : (v55 : SourceValue F) = (.field 1))
      (ev116 : ObsFn W "KernelLevels::klimbs_eq" [x_r, x_expected_r] m58 v103 m106 cs114)
      (heq139 : (v103 : SourceValue F) = (.field 1))
      (he142 : r = (.tuple []))
      (he143 : h' = m106)
      (hc144 : calls = ((⟨"KernelKlimbs::klimbs_div_mod", [x_a, x_b], h⟩ : Call F) :: (cs12 ++ ((⟨"KernelLevels::klimbs_eq", [x_q, x_expected_q], m2⟩ : Call F) :: (cs66 ++ ((⟨"KernelLevels::klimbs_eq", [x_r, x_expected_r], m58⟩ : Call F) :: cs114))))))

