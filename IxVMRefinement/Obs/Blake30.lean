/-- The evaluation paths of `Blake3::compress_layer`: one constructor per combination of selected arms. -/
inductive «Blake3::compress_layer».Path (x_layer : SourceValue F) (h : Heap F) (r : SourceValue F) (h' : Heap F)
    (calls : List (Call F)) : Prop where
  | Nil
      (x_rest : SourceValue F) (x_digest : SourceValue F)
      (ld11 : loadValue h x_layer = .ok (.construct "Blake3::LayerNode" "Push" [x_rest, x_digest]))
      (ld37 : loadValue h x_rest = .ok (.construct "Blake3::LayerNode" "Nil" []))
      (he46 : r = x_digest)
      (he47 : h' = h)
      (hc48 : calls = [])
  | other_None
      (x_rest : SourceValue F) (x_digest : SourceValue F) (v26 : SourceValue F) (m54 : Heap F) (cs64 : List (Call F)) (x_new_merkle : SourceValue F) (cs122 : List (Call F))
      (ld11 : loadValue h x_layer = .ok (.construct "Blake3::LayerNode" "Push" [x_rest, x_digest]))
      (ld37 : loadValue h x_rest = .ok v26)
      (hne49 : ∀ vs : List (SourceValue F), vs.length = 0 → (v26 : SourceValue F) ≠ .construct "Blake3::LayerNode" "Nil" vs)
      (ev66 : ObsFn W "Blake3::next_layer" [x_rest, x_digest, (.field 1)] h (.tuple [(.construct "Blake3::MaybeDigest" "None" []), x_new_merkle]) m54 cs64)
      (ev124 : ObsFn W "Blake3::compress_layer" [x_new_merkle] m54 r h' cs122)
      (hc133 : calls = ((⟨"Blake3::next_layer", [x_rest, x_digest, (.field 1)], h⟩ : Call F) :: (cs64 ++ ((⟨"Blake3::compress_layer", [x_new_merkle], m54⟩ : Call F) :: cs122))))
  | other_Some
      (x_rest : SourceValue F) (x_digest : SourceValue F) (v26 : SourceValue F) (m54 : Heap F) (cs64 : List (Call F)) (x_new_merkle : SourceValue F) (x_last_141 : SourceValue F) (cs150 : List (Call F)) (m155 : Heap F)
      (ld11 : loadValue h x_layer = .ok (.construct "Blake3::LayerNode" "Push" [x_rest, x_digest]))
      (ld37 : loadValue h x_rest = .ok v26)
      (hne49 : ∀ vs : List (SourceValue F), vs.length = 0 → (v26 : SourceValue F) ≠ .construct "Blake3::LayerNode" "Nil" vs)
      (ev66 : ObsFn W "Blake3::next_layer" [x_rest, x_digest, (.field 1)] h (.tuple [(.construct "Blake3::MaybeDigest" "Some" [x_last_141]), x_new_merkle]) m54 cs64)
      (hm163 : m155 = (m54 ++ [(.construct "Blake3::LayerNode" "Push" [x_new_merkle, x_last_141])]))
      (ev152 : ObsFn W "Blake3::compress_layer" [(.ptr (.enum "Blake3::LayerNode") (m54).length)] m155 r h' cs150)
      (hc183 : calls = ((⟨"Blake3::next_layer", [x_rest, x_digest, (.field 1)], h⟩ : Call F) :: (cs64 ++ ((⟨"Blake3::compress_layer", [(.ptr (.enum "Blake3::LayerNode") (m54).length)], m155⟩ : Call F) :: cs150))))

