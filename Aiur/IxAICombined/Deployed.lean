/-- The configuration the card is computed under is the one the training run certifies. -/
theorem config_eq : config = IxAIAiur.fullConfig := rfl

/-- The deployed model is in the range in which a model is determined by its field encoding
(`IxAICombined.eq_of_encModel_eq`), so a run that ends at this model's encoding ends at this
model. -/
theorem trainedOutput_ok : IxAIStep.Fixed.TrainSpec.modelOkB trainedOutput = true := by
  decide +kernel

def cardOutput : IxAICore.Card :=
  (IxAICore.Card.mk (@List.cons IxAICore.QuestionCard (IxAICore.QuestionCard.mk "valid" (nat_lit 158) (nat_lit 200) (Int.ofNat (nat_lit 15416)) (Int.ofNat (nat_lit 4814))) (@List.cons IxAICore.QuestionCard (IxAICore.QuestionCard.mk "head" (nat_lit 112) (nat_lit 200) (Int.ofNat (nat_lit 28158)) (Int.ofNat (nat_lit 4648))) (@List.cons IxAICore.QuestionCard (IxAICore.QuestionCard.mk "coverage" (nat_lit 136) (nat_lit 200) (Int.ofNat (nat_lit 22984)) (Int.ofNat (nat_lit 4998))) (@List.nil IxAICore.QuestionCard)))))

/-- The card is exactly the specified evaluation of the model. -/
theorem cardCertified : card Triage.spec config trainedOutput = cardOutput := by decide +kernel

theorem decision0 : Triage.act ⟨200⟩ trainedOutput (IxAICore.Formula.imp (IxAICore.Formula.atom 0) (IxAICore.Formula.atom 0)) = IxAICore.Triage.Action.defer := by decide +kernel

theorem decision1 : Triage.act ⟨200⟩ trainedOutput (IxAICore.Formula.imp (IxAICore.Formula.and (IxAICore.Formula.atom 0) (IxAICore.Formula.atom 1)) (IxAICore.Formula.atom 1)) = IxAICore.Triage.Action.defer := by decide +kernel

theorem decision2 : Triage.act ⟨200⟩ trainedOutput (IxAICore.Formula.imp (IxAICore.Formula.atom 0) (IxAICore.Formula.atom 1)) = IxAICore.Triage.Action.defer := by decide +kernel

theorem decision3 : Triage.act ⟨200⟩ trainedOutput (IxAICore.Formula.and (IxAICore.Formula.atom 2) IxAICore.Formula.top) = IxAICore.Triage.Action.defer := by decide +kernel

/-- The deployed system never publishes a false formula. -/
theorem deployedPublishSound (f : Formula) (h : Triage.act ⟨200⟩ trainedOutput f = .publish) :
    f.valid = true :=
  Triage.act_publish_sound _ _ f h

/-- The deployed system publishes only formulas its model is confident about. -/
theorem deployedPublishConfident (f : Formula) (h : Triage.act ⟨200⟩ trainedOutput f = .publish) :
    Triage.confidence trainedOutput f ≥ 200 :=
  Triage.act_publish_confident _ _ f h

/-- The deployed system defers exactly when its model is not confident. -/
theorem deployedDeferIff (f : Formula) :
    Triage.act ⟨200⟩ trainedOutput f = .defer ↔ Triage.confidence trainedOutput f < 200 :=
  Triage.act_defer_iff _ _ f

end IxAICombined.Deployed
