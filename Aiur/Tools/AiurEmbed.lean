import Aiur.Modules.Frontend

/-! # `aiur_embed`: Aiur module source text to embedded Lean syntax

Converts `.aiur` module source text to the body of an `aiur⟦ … ⟧` block (see
`Aiur.Modules.Frontend.embedded`), and checks that the result lowers to the same
module program as the text does through the string frontend.

```
lake exe aiur/aiur_embed into   FILE.lean SOURCE.aiur
lake exe aiur/aiur_embed new    FILE.lean SOURCE.aiur NAMESPACE NAME [DOC]
lake exe aiur/aiur_embed body   SOURCE.aiur
```

`into` replaces the block of an existing Lean file, from its `aiur⟦` line to
the last `⟧`, keeping everything around it. `new` writes a Lean file that
defines `NAMESPACE.NAME : Aiur.Modules.Program Nat`. `body` prints the block's
contents. Each fails, writing nothing, unless the embedded body parses and
lowers to the program the source text does.

The conversion is lexical. Comments become Lean comments, block labels `'l`
become `@l`, and a space separates characters that Lean would otherwise read as
a comment opener (two dashes, or a slash and a dash), a two-character operator (`&&`, `**`), or a
decimal literal running into a member (`p.0 .f`). A leading
`// Generated by …` line is dropped. -/
namespace Aiur.Embed
open Lean

private inductive Mode where
  | code
  | line
  | block (depth : Nat)
  | string (escaped : Bool)

private def isIdChar (c : Char) : Bool := c.isAlphanum || c == '_'

/-- The body of an `aiur⟦ … ⟧` block for `.aiur` source text. -/
def convert (source : String) : Except String String := do
  let source := source.replace "\r" ""
  let lines := source.splitOn "\n"
  let lines := match lines with
    | first :: rest => if first.startsWith "// Generated by" then rest else lines
    | [] => []
  let src := ("\n".intercalate lines).toList.toArray
  let at? (i : Nat) : Char := src.getD i '\x00'
  let mut out : Array Char := #[]
  let mut mode := Mode.code
  let mut i := 0
  while i < src.size do
    let c := at? i
    let n := at? (i + 1)
    match mode with
    | .string escaped =>
      out := out.push c
      mode := if escaped then .string false else if c == '\\' then .string true
        else if c == '"' then .code else .string false
      i := i + 1
    | .line =>
      out := if c == '\t' then out ++ #[' ', ' '] else out.push c
      if c == '\n' then mode := .code
      i := i + 1
    | .block depth =>
      if c == '/' && n == '*' then
        out := out ++ #['/', '-']; mode := .block (depth + 1); i := i + 2
      else if c == '*' && n == '/' then
        out := out ++ #['-', '/']; mode := if depth == 1 then .code else .block (depth - 1); i := i + 2
      else if (c == '-' && n == '/') || (c == '/' && n == '-') then
        out := out ++ #[c, ' ']; i := i + 1
      else
        out := if c == '\t' then out ++ #[' ', ' '] else out.push c; i := i + 1
    | .code =>
      if c == '/' && n == '/' then
        out := out ++ #['-', '-']; mode := .line; i := i + 2
      else if c == '/' && n == '*' then
        out := out ++ #['/', '-']; mode := .block 1; i := i + 2
      else if c == '"' then
        out := out.push c; mode := .string false; i := i + 1
      else if c == '\'' then
        out := out.push '@'; i := i + 1
      else if c == '@' then
        throw s!"unexpected '@' at character {i}; source labels are written 'name"
      else if c == '\t' then
        out := out ++ #[' ', ' ']; i := i + 1
      else if (c == '-' || c == '/') && n == '-' || (c == '&' && n == '&') || (c == '*' && n == '*') then
        out := out ++ #[c, ' ']; i := i + 1
      else if c.isDigit && !(i > 0 && isIdChar (at? (i - 1))) then
        -- A number token. Lean reads `0.f` as a decimal literal and fails.
        let mut j := i
        while j < src.size && (at? j).isDigit do
          out := out.push (at? j); j := j + 1
        if at? j == '.' && ((at? (j + 1)).isAlpha || at? (j + 1) == '_') then out := out.push ' '
        i := j
      else
        out := out.push c; i := i + 1
  match mode with
  | .string _ => throw "unterminated string"
  | .block _ => throw "unterminated block comment"
  | _ => pure ()
  let text := String.ofList out.toList
  let lines := (text.splitOn "\n").map (·.trimAsciiEnd.toString)
  let lines := lines.dropWhile (·.isEmpty) |>.reverse |>.dropWhile (·.isEmpty) |>.reverse
  return "\n".intercalate lines

/-- Lower `body` as an embedded block lowers it (`ofBlockText`). -/
def lowerBody (env : Lean.Environment) (body : String) : Except String (Aiur.Modules.Program Nat) :=
  Aiur.Modules.Frontend.ofBlockText env body

/-- Convert `source` and check that both forms lower to the same program. -/
def convertChecked (env : Lean.Environment) (source : String) : Except String String := do
  let body ← convert source
  let expected ← (Aiur.Modules.Frontend.parse env source).mapError (s!"source: {·}")
  let actual ← (lowerBody env body).mapError (s!"converted: {·}")
  unless expected == actual do throw "the converted body lowers to a different program"
  return body

/-- A Lean file defining `ns.name` as the block `body`. `doc` is the module
docstring's text, by default a title naming the definition. -/
def newFile (ns name doc body : String) : String :=
  s!"import Aiur.Modules.Frontend

/-! {doc} -/

namespace {ns}

def {name} : Aiur.Modules.Program Nat := aiur⟦
{body}
⟧

end {ns}
"

/-- Replace the contents of the `aiur⟦ … ⟧` block in `file`. -/
def replaceBody (file body : String) : Except String String := do
  let lines := file.splitOn "\n"
  let some start := lines.findIdx? (·.trimAsciiEnd.toString.endsWith "aiur⟦")
    | throw "no line ending in `aiur⟦`"
  let some stop := (lines.zipIdx.filter fun (l, _) => l.trimAscii.toString == "⟧").getLast?.map Prod.snd
    | throw "no closing `⟧` line"
  unless start < stop do throw "the closing `⟧` precedes `aiur⟦`"
  return "\n".intercalate (lines.take (start + 1) ++ [body] ++ lines.drop stop)

unsafe def main (args : List String) : IO UInt32 := do
  let usage := "usage: aiur_embed into FILE.lean SOURCE.aiur | new FILE.lean SOURCE.aiur NAMESPACE NAME [DOC] | body SOURCE.aiur"
  initSearchPath (← findSysroot)
  enableInitializersExecution
  let env ← importModules (loadExts := true) #[{module := `Aiur.Modules.Frontend}] {} 0
  let run (source : System.FilePath) : IO String := do
    IO.ofExcept ((convertChecked env (← IO.FS.readFile source)).mapError (s!"{source}: {·}"))
  match args with
  | ["body", source] => IO.println (← run source)
  | ["into", file, source] =>
    let body ← run source
    IO.FS.writeFile file (← IO.ofExcept (replaceBody (← IO.FS.readFile file) body))
    IO.eprintln s!"wrote {file}"
  | "new" :: file :: source :: ns :: name :: doc =>
    let doc := doc.headD s!"# `{ns}.{name}`"
    IO.FS.writeFile file (newFile ns name doc (← run source))
    IO.eprintln s!"wrote {file}"
  | _ => IO.eprintln usage; return 2
  return 0

end Aiur.Embed

unsafe def main (args : List String) : IO UInt32 := Aiur.Embed.main args
