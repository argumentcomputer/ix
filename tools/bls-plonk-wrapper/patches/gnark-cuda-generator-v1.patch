+func (s *instance) beginStageV1() time.Time {
+	if s.stageObserver == nil { return time.Time{} }
+	return time.Now()
+}
+
+func (s *instance) endStageV1(stage, phase string, start time.Time, failed bool) {
+	if s.stageObserver == nil { return }
+	s.stageObserver.callback(StageEventV1{Stage: stage, Phase: phase,
+		Start: start.Sub(s.stageOrigin), End: time.Since(s.stageOrigin), Failed: failed})
+}
+
+func (s *instance) observeTaskV1(stage string, fn func() error) func() error {
+	if s.stageObserver == nil { return fn }
+	return func() (err error) {
+		start := s.beginStageV1()
+		defer func() { s.endStageV1(stage, "task", start, err != nil) }()
+		return fn()
+	}
+}
+
+func (s *instance) waitStageV1(stage string, ready <-chan struct{}) (err error) {
+	start := s.beginStageV1()
+	defer func() { s.endStageV1(stage, "wait", start, err != nil) }()
+	select {
+	case <-s.ctx.Done():
+		return errContextDone
+	case <-ready:
+		return nil
+	}
 }
 
