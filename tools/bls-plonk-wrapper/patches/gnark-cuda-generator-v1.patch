+// AcceleratorFeatureFlagsV1 selects operations before a proof mutates its polynomials.
+type AcceleratorFeatureFlagsV1 uint64
+
+const (
+	AcceleratorFeatureMSMV1 AcceleratorFeatureFlagsV1 = 1 << iota
+	AcceleratorFeatureToCanonicalV1
+	AcceleratorFeatureNumeratorV1
+	AcceleratorFeatureQuotientV1
+)
+
+const legacyAcceleratorFeaturesV1 = AcceleratorFeatureMSMV1 | AcceleratorFeatureToCanonicalV1 | AcceleratorFeatureNumeratorV1
+const allAcceleratorFeaturesV1 = legacyAcceleratorFeaturesV1 | AcceleratorFeatureQuotientV1
+
+// AcceleratorFeaturesV1 optionally selects accelerated operations. FeaturesV1
+// is called exactly once per Prove; its result is frozen for that proof.
+// Implementations must make this method safe for concurrent proofs.
+type AcceleratorFeaturesV1 interface {
+	FeaturesV1() AcceleratorFeatureFlagsV1
+}
+
+// QuotientAcceleratorV1 computes H after division by X^N-1 and the inverse FFT.
+// Its result has Domain1.Cardinality coefficients in Canonical/Regular form.
+// Every nonblinding input must be restored to Canonical/Regular on Domain0;
+// blinding polynomials must remain unchanged. The corresponding feature bit
+// must be set explicitly; implementing this interface alone does not enable it.
+type QuotientAcceleratorV1 interface {
+	ComputeQuotientV1(*NumeratorInput) (*iop.Polynomial, error)
+}
+
+type acceleratorState struct {
+	implementation Accelerator
+	features       AcceleratorFeatureFlagsV1
+	quotient       QuotientAcceleratorV1
+}
+
+// StageEventV1 is a monotonic wall-clock interval relative to proof initialization.
+// Task spans include dependency waits and nested compute spans. Compute spans may
+// include backend queueing; overlapping intervals must not be summed.
+type StageEventV1 struct {
+	Stage, Phase string
+	Start, End time.Duration
+	Failed bool
+}
+
+type stageObserverStateV1 struct { callback func(StageEventV1) }
+
+// SetStageObserverV1 installs a runtime-only diagnostic callback. Prove freezes
+// the callback at entry. It may be called concurrently and must not panic or
+// block. Passing nil disables observation; key serialization is unchanged.
+func (pk *ProvingKey) SetStageObserverV1(observer func(StageEventV1)) {
+	if observer == nil { pk.stageObserver.Store(nil); return }
+	pk.stageObserver.Store(&stageObserverStateV1{callback: observer})
+}
+
+// proofKey snapshots runtime dispatch while retaining the immutable key arrays.
+// Concurrent SetAccelerator calls cannot change an already-started proof.
+func (pk *ProvingKey) proofKey() (*ProvingKey, error) {
+	view := &ProvingKey{Kzg: pk.Kzg, KzgLagrange: pk.KzgLagrange, Vk: pk.Vk}
+	view.stageObserver.Store(pk.stageObserver.Load())
+	configured := pk.accelerator.Load()
+	if configured == nil {
+		return view, nil
+	}
+	features := legacyAcceleratorFeaturesV1
+	if selectable, ok := configured.implementation.(AcceleratorFeaturesV1); ok {
+		features = selectable.FeaturesV1()
+	}
+	if features & ^allAcceleratorFeaturesV1 != 0 {
+		return nil, fmt.Errorf("unsupported accelerator feature bits: %#x", features & ^allAcceleratorFeaturesV1)
+	}
+	state := &acceleratorState{implementation: configured.implementation, features: features}
+	if features&AcceleratorFeatureQuotientV1 != 0 {
+		var ok bool
+		state.quotient, ok = configured.implementation.(QuotientAcceleratorV1)
+		if !ok {
+			return nil, errors.New("quotient feature requires QuotientAcceleratorV1")
+		}
+	}
+	view.accelerator.Store(state)
+	return view, nil
+}
+
+func (pk *ProvingKey) accelerated(feature AcceleratorFeatureFlagsV1) bool {
+	state := pk.accelerator.Load()
+	return state != nil && state.features&feature != 0
+}
