+func TestAcceleratorV1CapabilitiesAreFrozen(t *testing.T) {
+	pk := new(ProvingKey)
+	legacy := new(testAcceleratorV1)
+	pk.SetAccelerator(legacy)
+	view, err := pk.proofKey()
+	if err != nil || view.accelerator.Load().features != legacyAcceleratorFeaturesV1 {
+		t.Fatalf("legacy accelerator: %v", err)
+	}
+	selective := &testSelectiveAcceleratorV1{testAcceleratorV1: new(testAcceleratorV1)}
+	selective.flags.Store(uint64(AcceleratorFeatureMSMV1))
+	pk.SetAccelerator(selective)
+	view, err = pk.proofKey()
+	if err != nil {
+		t.Fatal(err)
+	}
+	selective.flags.Store(uint64(AcceleratorFeatureNumeratorV1))
+	pk.SetAccelerator(nil)
+	if !view.accelerated(AcceleratorFeatureMSMV1) || view.accelerated(AcceleratorFeatureNumeratorV1) || selective.featureCalls.Load() != 1 {
+		t.Fatal("feature selection changed after proof entry")
+	}
+	if pk.Accelerator() != nil || view.Accelerator() != selective {
+		t.Fatal("proof view did not retain its selected accelerator")
+	}
+	plain, err := pk.proofKey()
+	if err != nil || plain.Accelerator() != nil {
+		t.Fatalf("CPU view: %v", err)
+	}
+	pk.SetAccelerator(legacy)
+	if plain.Accelerator() != nil {
+		t.Fatal("CPU proof acquired a later accelerator")
+	}
+}
