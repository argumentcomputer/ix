+type testAcceleratorV1 struct {
+	msm, canonical, numerator atomic.Int32
+	failure                   AcceleratorFeatureFlagsV1
+}
+
+var testAcceleratorFailureV1 = errors.New("accelerator sentinel failure")
+
+func (a *testAcceleratorV1) MultiExp(bases []curve.G1Affine, scalars []fr.Element) (curve.G1Affine, error) {
+	a.msm.Add(1)
+	if a.failure == AcceleratorFeatureMSMV1 {
+		return curve.G1Affine{}, testAcceleratorFailureV1
+	}
+	var result curve.G1Affine
+	_, err := result.MultiExp(bases, scalars, ecc.MultiExpConfig{})
+	return result, err
+}
+
+func (a *testAcceleratorV1) ToCanonical(domain *fft.Domain, p *iop.Polynomial) error {
+	a.canonical.Add(1)
+	if a.failure == AcceleratorFeatureToCanonicalV1 {
+		return testAcceleratorFailureV1
+	}
+	p.ToCanonical(domain).ToRegular()
+	return nil
+}
+
+func (a *testAcceleratorV1) ComputeNumerator(in *NumeratorInput) (*iop.Polynomial, error) {
+	a.numerator.Add(1)
+	if a.failure == AcceleratorFeatureNumeratorV1 {
+		return nil, testAcceleratorFailureV1
+	}
+	return testNumeratorReferenceV1(in)
+}
+
+type testSelectiveAcceleratorV1 struct {
+	*testAcceleratorV1
+	flags        atomic.Uint64
+	featureCalls atomic.Int32
+}
+
+func (a *testSelectiveAcceleratorV1) FeaturesV1() AcceleratorFeatureFlagsV1 {
+	a.featureCalls.Add(1)
+	return AcceleratorFeatureFlagsV1(a.flags.Load())
+}
+
+type testFusedAcceleratorV1 struct {
+	*testSelectiveAcceleratorV1
+	quotient atomic.Int32
+	corrupt  func(*NumeratorInput, *iop.Polynomial)
+}
+
+func (a *testFusedAcceleratorV1) ComputeQuotientV1(in *NumeratorInput) (*iop.Polynomial, error) {
+	a.quotient.Add(1)
+	if a.failure == AcceleratorFeatureQuotientV1 {
+		return nil, testAcceleratorFailureV1
+	}
+	numerator, err := testNumeratorReferenceV1(in)
+	if err != nil {
+		return nil, err
+	}
+	result, err := divideByZH(numerator, [2]*fft.Domain{in.Domain0, in.Domain1}, new(ProvingKey))
+	if err == nil && a.corrupt != nil {
+		a.corrupt(in, result)
+	}
+	return result, err
+}
+
+// The reference uses the unchanged CPU numerator and waits for its restoration
+// goroutine. Completed Qk is unused by CPU proving but is part of the adapter's
+// restoration contract, so it is restored explicitly as well.
+func testNumeratorReferenceV1(in *NumeratorInput) (*iop.Polynomial, error) {
+	s := &instance{
+		ctx: context.Background(), domain0: in.Domain0, domain1: in.Domain1,
+		proof: &Proof{Bsb22Commitments: make([]curve.G1Affine, len(in.Qcp))},
+		x:     make([]*iop.Polynomial, id_Qci+2*len(in.Qcp)),
+		bp:    []*iop.Polynomial{in.Bl, in.Br, in.Bo, in.Bz},
+		alpha: in.Alpha, beta: in.Beta, gamma: in.Gamma,
+		chQk: make(chan struct{}), chRestoreLRO: make(chan struct{}),
+	}
+	copy(s.x, []*iop.Polynomial{
+		in.L, in.R, in.O, in.Z, in.Z.ShallowClone().Shift(1),
+		in.Ql, in.Qr, in.Qm, in.Qo, in.Qk, in.S1, in.S2, in.S3,
+	})
+	for i := range in.Qcp {
+		s.x[id_Qci+2*i], s.x[id_Qci+2*i+1] = in.Qcp[i], in.Pi[i]
+	}
+	close(s.chQk)
+	result, err := s.computeNumerator()
+	if err != nil {
+		return nil, err
+	}
+	<-s.chRestoreLRO
+	rho := in.Domain1.Cardinality / in.Domain0.Cardinality
+	var scale fr.Element
+	scale.Exp(in.Domain1.Generator, new(big.Int).SetUint64(rho-1))
+	scale.Mul(&scale, &in.Domain1.FrMultiplicativeGen).Inverse(&scale)
+	in.Qk.ToCanonical(in.Domain0).ToRegular()
+	scalePowers(in.Qk, scale)
+	return result, nil
+}
