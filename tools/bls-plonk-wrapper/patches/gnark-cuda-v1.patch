+type acceleratorCircuitV1 struct {
+	Public frontend.Variable `gnark:",public"`
+	Secret frontend.Variable
+	Commit bool `gnark:"-"`
+}
+
+func (c *acceleratorCircuitV1) Define(api frontend.API) error {
+	x := c.Secret
+	for i := 0; i < 4; i++ {
+		x = api.Mul(x, c.Secret)
+	}
+	api.AssertIsEqual(x, c.Public)
+	if c.Commit {
+		challenge, err := api.(frontend.Committer).Commit(c.Secret)
+		if err != nil {
+			return err
+		}
+		api.AssertIsDifferent(challenge, 0)
+	}
+	return nil
+}
