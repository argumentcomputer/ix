+	var failure StageEventV1
+	failed := &instance{ctx: ctx, stageOrigin: time.Now(),
+		stageObserver: &stageObserverStateV1{callback: func(event StageEventV1) { failure = event }}}
+	if err := failed.waitStageV1("cancelled", make(chan struct{})); !errors.Is(err, errContextDone) {
+		t.Fatalf("cancelled dependency wait: %v", err)
+	}
+	if failure.Stage != "cancelled" || failure.Phase != "wait" || !failure.Failed || failure.Start < 0 || failure.End < failure.Start {
+		t.Fatalf("invalid failed wait event: %+v", failure)
+	}
+}
+
+func TestStageObserverV1ProofIntervals(t *testing.T) {
+	ccs, err := frontend.Compile(ecc.BN254.ScalarField(), scs.NewBuilder, &acceleratorCircuitV1{Commit: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	n := ecc.NextPowerOfTwo(uint64(ccs.GetNbConstraints() + ccs.GetNbPublicVariables()))
+	srs, err := kzg.NewSRS(n+3, big.NewInt(7))
+	if err != nil {
+		t.Fatal(err)
+	}
+	lagrange, err := kzg.ToLagrangeG1(srs.Pk.G1[:n])
+	if err != nil {
+		t.Fatal(err)
+	}
+	pk, vk, err := Setup(ccs.(*cs.SparseR1CS), *srs, kzg.SRS{Pk: kzg.ProvingKey{G1: lagrange}, Vk: srs.Vk})
+	if err != nil {
+		t.Fatal(err)
+	}
+	w, err := frontend.NewWitness(&acceleratorCircuitV1{Public: 32, Secret: 2}, ecc.BN254.ScalarField())
+	if err != nil {
+		t.Fatal(err)
+	}
+	public, err := w.Public()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var lock sync.Mutex
+	var once sync.Once
+	var events []StageEventV1
+	pk.SetStageObserverV1(func(event StageEventV1) {
+		once.Do(func() { pk.SetStageObserverV1(nil) })
+		lock.Lock()
+		defer lock.Unlock()
+		events = append(events, event)
+	})
+	started := time.Now()
+	proof, err := Prove(ccs.(*cs.SparseR1CS), pk, w)
+	elapsed := time.Since(started)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := Verify(proof, vk, public.Vector().(fr.Vector)); err != nil {
+		t.Fatal(err)
+	}
+	if len(events) == 0 || events[len(events)-1].Stage != "prove" {
+		t.Fatal("missing final proof interval")
+	}
+	phases := make(map[string]bool)
+	computed := make(map[string]StageEventV1)
+	for _, event := range events {
+		if event.Failed || event.Start < 0 || event.End < event.Start || event.End > elapsed {
+			t.Fatalf("invalid proof interval: %+v", event)
+		}
+		phases[event.Phase] = true
+		if event.Phase == "compute" {
+			computed[event.Stage] = event
+		}
+	}
+	for _, phase := range []string{"task", "compute", "wait"} {
+		if !phases[phase] {
+			t.Fatalf("missing %s intervals", phase)
+		}
+	}
+	for _, stage := range []string{"initialization", "solver", "lro", "permutation", "z-commitment", "quotient-numerator", "quotient-division", "h-commitments", "evaluation-l", "evaluation-r", "evaluation-o", "linearization", "linearization-commitment", "z-opening", "batch-opening"} {
+		if _, ok := computed[stage]; !ok {
+			t.Fatalf("missing %s compute interval", stage)
+		}
+	}
+	if computed["solver"].End > computed["lro"].Start || computed["h-commitments"].End > computed["z-opening"].Start {
+		t.Fatal("stage timing violates proof dependencies")
+	}
+	count := len(events)
+	proof, err = Prove(ccs.(*cs.SparseR1CS), pk, w)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := Verify(proof, vk, public.Vector().(fr.Vector)); err != nil {
+		t.Fatal(err)
+	}
+	if len(events) != count {
+		t.Fatal("later proof retained a disabled observer")
+	}
+}
