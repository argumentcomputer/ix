+func TestAcceleratorV1ConcurrentSelection(t *testing.T) {
+	pk := new(ProvingKey)
+	a := new(testAcceleratorV1)
+	var wg sync.WaitGroup
+	for i := 0; i < 4; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < 64; j++ {
+				pk.SetAccelerator(a)
+				view, err := pk.proofKey()
+				if err != nil {
+					t.Error(err)
+				}
+				pk.SetAccelerator(nil)
+				if selected := view.Accelerator(); selected != nil && selected != a {
+					t.Error("unexpected accelerator snapshot")
+				}
+			}
+		}()
+	}
+	wg.Wait()
+}
