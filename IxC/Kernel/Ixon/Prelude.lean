import IxC.Kernel.Ixon.Reader
import IxC.Kernel.Ixon.RoleData
import IxC.Ixon.Canonical

/-! # The Ixon prelude and the default role table

Upstream con-leche's built-in prelude (`Frontend/Prelude.lean`, not carried here) is a
committed lean4export stream of twelve declarations, parsed at start-up and
put in front of every fold by `Frontend.preparePrelude`: the six basis
blocks `Eq`, `Nat`, `PUnit`, `Empty`, `False` and the quotient package (the
four `Quot` constants and `Quot.sound`), plus `And` (for the stuck-major
rescue) and `Bool` (which the certified `Nat` operations' certificate
statements are spelled over). Here the same twelve declarations come from the
Ixon records of the compiled Init: `RoleData.prelude` holds those records'
canonical bytes, keyed by address (the inductive blocks, their projection
records and their recursor records, the four quotient records and the
`Quot.sound` axiom), generated by `Benchmarks/Kernel/PinGen.lean` from
`.lake/envs/initstd.ixe`. They are decoded by the canonical decoder and read
by the same reader as every stream, under the role table the stream is read
under (`preludeFor`), so the prelude goes through no other parser and its
constants get the stream's role keys. A stream that declares any of them is
checked on its own record (`preparePrelude` moves the stream's copy to the
front); the prelude's copy fills in only where the stream has none.

**The default role table** (`defaultTable`, `RoleData.table`) is the table
of the compiled Init that `kernel-pin-gen` generated and verified through the
fold, with its evidence: the theorem records of
`IxC/Kernel/PinGen/Certs.lean`, compiled and closed over the operations'
dependency cones (`RoleData.evidence`), and the blobs their literals reference
(`RoleData.blobs`). It is untrusted, for tests and the command line only: the
entry takes its table as input (`Ix.Kernel.Admission.checkBytes`), and every
theorem holds for every table. The evidence records back the store of every
reading behind the prelude's (`Prelude.evidence`, beside `Prelude.records`),
so a table that names them resolves them; they are never read as
declarations of their own. -/

namespace Ix.Kernel.Reader

open Ix.Kernel (ConstRef)

def addressOfHex (s : String) : Option Address := do
  let b ← bytesOfHex s
  pure ⟨b⟩

/-! ## The default role table -/

/-- The default table's binding section. -/
def defaultTableBytes : Except String ByteArray :=
  match bytesOfHex RoleData.table with
  | some b => pure b
  | none => throw "role table: bad bytes"

/-- The address the default table's section is committed under (BLAKE3 of
its bytes, computed by the generator). -/
def defaultTableAddress : Except String Address :=
  match addressOfHex RoleData.tableAddress with
  | some a => pure a
  | none => throw "role table: bad address"

/-- The default table, decoded canonically and checked for well-formedness.
A failure is a corrupted committed file. -/
def defaultTable : Except String Ix.Kernel.RoleTable := do
  let some t := Ix.Kernel.RoleTable.ofBytes (← defaultTableBytes)
    | throw "role table: not a canonical binding section"
  t.check.mapError (s!"role table: " ++ ·)
  pure t

/-! ## The prelude -/

/-- Generous per-record limits for the committed records. -/
def preludeMaxBytes : Nat := 1 <<< 24
def preludeMaxUnivNodes : Nat := 1 <<< 20

/-- Committed records, decoded canonically. -/
def decodeCommitted (what : String) (rows : Array (String × String)) :
    Except String (Array (Address × Ixon.Constant)) :=
  rows.mapM fun (hex, bytes) => do
    let some a := addressOfHex hex | throw s!"{what}: bad address {hex}"
    let some b := bytesOfHex bytes | throw s!"{what}: bad bytes at {hex}"
    let c ← (Ixon.Canonical.deConstant preludeMaxBytes preludeMaxUnivNodes b).mapError
      (s!"{what}: record {hex}: " ++ ·)
    pure (a, c)

/-- The committed prelude records, decoded canonically. -/
def preludeRecords : Except String (Array (Address × Ixon.Constant)) :=
  decodeCommitted "prelude" RoleData.prelude

/-- The default table's evidence records, decoded canonically. -/
def evidenceRecords : Except String (Array (Address × Ixon.Constant)) :=
  decodeCommitted "evidence" RoleData.evidence

/-- The blobs the evidence's literals reference. -/
def evidenceBlobs : Except String (List (Address × ByteArray)) :=
  RoleData.blobs.toList.mapM fun (hex, bytes) => do
    let some a := addressOfHex hex | throw s!"evidence blob: bad address {hex}"
    let some b := bytesOfHex bytes | throw s!"evidence blob: bad bytes at {hex}"
    pure (a, b)

/-- The prelude: its records, the evidence records backing every reading
beside them (never read as declarations of their own), the blobs behind the
stream's, its declarations, and the reader state after them (the stream's
reading continues from it). -/
structure Prelude (md : Mode) where
  records : Array (Address × Ixon.Constant) := #[]
  evidence : Array (Address × Ixon.Constant) := #[]
  blobs : List (Address × ByteArray) := []
  ix : Ix.Kernel.Frontend.PreludeIx md := {}
  state : State md := {}

instance : Inhabited (Prelude md) := ⟨{}⟩

/-- The reader context of `records` under the role table `t`, with the
fallback store `fallback` and fallback blobs `fallbackBlobs`: the bound
addresses resolve against both stores (`bindingsOf`).

`reconstruct store` gives the addresses of the projection records the input
omits (`Admission.projectionAddress`, under the entry's hash); without it a
block member with no projection record among the records declines.

The store is `storeOf records (storeOf fallback)` with both maps built here,
once: `storeOf` partially applied would rebuild its map at every lookup (it
is compiled at its full arity), which makes reading quadratic in the number
of records (the 99,346 records of Init+Std do not finish reading in ten
minutes that way; built once, they read in 14 s). -/
def contextOf (t : Ix.Kernel.RoleTable) (records : Array (Address × Ixon.Constant))
    (blobs : List (Address × ByteArray)) (fallback : Array (Address × Ixon.Constant) := #[])
    (fallbackBlobs : List (Address × ByteArray) := [])
    (hint : ConstRef Address → Option Ix.Kernel.ReducibilityHint := fun _ => none)
    (reconstruct : Store → ConstRef Address → Option Address := fun _ _ => none) : Ctx md :=
  let m := recordMap records
  let fm := recordMap fallback
  let store : Store := fun a => m[a]? <|> (fm[a]? <|> none)
  let blobMap : Std.HashMap Address ByteArray :=
    (blobs ++ fallbackBlobs).foldl (fun m (a, b) => if m.contains a then m else m.insert a b) {}
  let known : Std.HashSet Address := records.foldl (fun s (a, _) => s.insert a) {}
  let all := records ++ fallback.filter (fun (a, _) => !known.contains a)
  contextWith store (blobMap[·]?) t all hint (reconstruct store)

/-- Read prelude records under a role table, with `extra` records and blobs
backing the store (the evidence). -/
def readPrelude (t : Ix.Kernel.RoleTable) (records : Array (Address × Ixon.Constant))
    (extra : Array (Address × Ixon.Constant) := #[]) (extraBlobs : List (Address × ByteArray) := []) :
    Except String (Prelude md) := do
  let cx := contextOf t records [] extra extraBlobs
  match readRecords cx {} records with
  | .ok (state, decls) => pure ⟨records, extra, extraBlobs, ⟨decls⟩, state⟩
  | .error (e, i) => throw s!"prelude record {i}: {e}"

/-- The committed prelude, read under the role table `t`, with the default
evidence backing the store. -/
def preludeFor (t : Ix.Kernel.RoleTable) : Except String (Prelude md) := do
  readPrelude t (← preludeRecords) (← evidenceRecords) (← evidenceBlobs)

/-- The committed prelude under the default table. A failure is a corrupted
committed file; the entry reports it rather than running with an empty
prelude. -/
def builtinPrelude : Except String (Prelude md) := do
  preludeFor (← defaultTable)

end Ix.Kernel.Reader
