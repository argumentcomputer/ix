      (hne49 : ∀ vs : List (SourceValue F), vs.length = 0 → (v26 : SourceValue F) ≠ .construct "Blake3::LayerNode" "Nil" vs)
      (ev66 : ObsFn W "Blake3::next_layer" [x_rest, x_digest, (.field 1)] h (.tuple [(.construct "Blake3::MaybeDigest" "None" []), x_new_merkle]) m54 cs64)
