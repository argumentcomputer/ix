    (calls : List (Call F)) : Prop where
  | Nil
      (x_rest : SourceValue F) (x_digest : SourceValue F)
      (ld11 : loadValue h x_layer = .ok (.construct "Blake3::LayerNode" "Push" [x_rest, x_digest]))
      (ld37 : loadValue h x_rest = .ok (.construct "Blake3::LayerNode" "Nil" []))
      (he46 : r = x_digest)
      (he47 : h' = h)
      (hc48 : calls = [])
  | other_None
      (x_rest : SourceValue F) (x_digest : SourceValue F) (v26 : SourceValue F) (m54 : Heap F) (cs64 : List (Call F)) (x_new_merkle : SourceValue F) (cs122 : List (Call F))
