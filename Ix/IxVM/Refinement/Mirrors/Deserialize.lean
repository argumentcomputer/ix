/-- The mirror of `UInt64::is_zero`. -/
def «UInt64::is_zero» : Nat → Heap F → SourceValue F → Option (SourceValue F × Heap F)
  | 0, _, _ => none
  | k + 1, h, x_x =>
    if x_x = Value.tuple [(.field 0), (.field 0), (.field 0), (.field 0), (.field 0), (.field 0), (.field 0), (.field 0)] then
      some ((.field 1), h)
    else
      some ((.field 0), h)

/-- Every derivation of `UInt64::is_zero` is a run of its mirror. -/
abbrev «UInt64::is_zero».Complete : Prop :=
  ∀ {x_x : SourceValue F} {h h' : Heap F} {r : SourceValue F},
    EvalFn W "UInt64::is_zero" [x_x] h r h' → ∃ k0, ∀ k ≥ k0, «UInt64::is_zero» k h x_x = some (r, h')

