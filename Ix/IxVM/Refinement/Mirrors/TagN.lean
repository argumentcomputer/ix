/-- The mirror of `IxonDeserialize::get_u64_le`. -/
def «IxonDeserialize::get_u64_le» : Nat → Heap F → SourceValue F → SourceValue F → Option (SourceValue F × Heap F)
  | 0, _, _, _ => none
  | k + 1, h, x_stream, x_num_bytes =>
    if x_num_bytes = .field 0 then
      (do
        let (v9, h10) ← some ((.tuple (List.replicate 8 (.field 0)) : SourceValue F), h)
        some ((.tuple [v9, x_stream] : SourceValue F), h10))
    else
      (do
        let (v0, h1) ← match loadValue h x_stream with
          | .ok z => some (z, h)
          | .error _ => none
        match v0 with
          | .construct e8 "Cons" [x_byte, x_s] =>
            if e8 = constructorName [] (.named "Lists::Node" [.field]) then
              (do
                let (v2, h3) ← (do
                  let (v4, h5) ← match evalBinOp .sub x_num_bytes (.field 1) with
                    | .ok z => some (z, h1)
                    | .error _ => none
                  «IxonDeserialize::get_u64_le» k h5 x_s v4)
                match v2 with
                  | .tuple [x_rest_bytes, x_s2] =>
                    match x_rest_bytes with
                      | .tuple [x_r0, x_r1, x_r2, x_r3, x_r4, x_r5, x_r6, _] =>
                        (do
                          let (v6, h7) ← some ((.tuple [x_byte, x_r0, x_r1, x_r2, x_r3, x_r4, x_r5, x_r6] : SourceValue F), h3)
                          some ((.tuple [v6, x_s2] : SourceValue F), h7))
                      | _ => none
                  | _ => none)
            else none
          | _ => none)

/-- Every derivation of `IxonDeserialize::get_u64_le` is a run of its mirror. -/
abbrev «IxonDeserialize::get_u64_le».Complete : Prop :=
  ∀ {x_stream x_num_bytes : SourceValue F} {h h' : Heap F} {r : SourceValue F},
    EvalFn W "IxonDeserialize::get_u64_le" [x_stream, x_num_bytes] h r h' → ∃ k0, ∀ k ≥ k0, «IxonDeserialize::get_u64_le» k h x_stream x_num_bytes = some (r, h')

