import Ix.Cert.MultiStark.FieldModel
import Ix.Cert.MultiStark.SmallHeight
import Mathlib.Algebra.Polynomial.Roots
import Mathlib.Algebra.Polynomial.Div
import Mathlib.RingTheory.RootsOfUnity.PrimitiveRoots

/-! # AIR OOD Soundness and `+1` Degree-Slack Row Extraction (Gap 4b)

Proves the polynomial-identity soundness core of Multi-STARK AIR verification:

1. **Trace Domain & Vanishing Polynomial:**
   For any trace log-height `ℓ ≤ 32` (`N = 2^ℓ`), the trace subgroup `H_ℓ = {g^i | i < N}`
   (generated by `g = K.embedHom (baseToFp (Goldilocks.twoAdicGenerator ℓ))`) has
   vanishing polynomial `Z_H(X) = X^N - 1`.

2. **Lagrange Selectors:**
   Unnormalized selectors `isFirst(X) = (X^N - 1) / (X - 1)`,
   `isLast(X) = (X^N - 1) / (X - g⁻¹)`, `isTrans(X) = X - g⁻¹` satisfy:
   - `isFirst(g^i) ≠ 0` iff `i = 0`; `isFirst(g^i) = 0` for `0 < i < N`
   - `isLast(g^i) ≠ 0` iff `i = N - 1`; `isLast(g^i) = 0` for `i < N - 1`
   - `isTrans(g^i) = 0` iff `i = N - 1`; `isTrans(g^i) ≠ 0` for `i < N - 1`.

3. **OOD Identity + `+1` Degree Slack (`air_holds_on_domain_of_ood`):**
   Even though CertiFRI's `extractColumn` guarantees degree at most `N` (one above the
   honest degree `N - 1`), the AIR constraint polynomial `C(X)` composed with extracted
   column polynomials of degree `≤ N` has degree at most `D_max`, and the recombined
   quotient polynomial `Q(X) = ∑_{j < numChunks} X^{j · N} · Q_j(X)` has degree at most
   `numChunks * N`. Thus `P(X) := C(X) - (X^N - 1) · Q(X)` has degree at most
   `max D_max (N + numChunks * N)`.
   - By Schwartz–Zippel, if `P ≠ 0`, a uniform OOD point `ζ ∈ K` satisfies `P(ζ) = 0`
     with probability at most `P.natDegree / |K|`.
   - When `P = 0` (`C(X) = (X^N - 1) · Q(X)`), evaluating at every trace point `x = g^i ∈ H_ℓ`
     gives `C(g^i) = (g^{i·N} - 1) · Q(g^i) = 0`, regardless of the `+1` degree slack!

4. **Horner Batching of Constraints (`horner_constraints_zero`):**
   If `C_α(X) = ∑_{k < m} α^{m - 1 - k} · c_k(X)` vanishes at `x ∈ H_ℓ` for a uniform
   `α ∈ K`, and some `c_k(x) ≠ 0`, then at most `m - 1` values of `α ∈ K` can make
   `C_α(x) = 0`. Summing over all `x ∈ H_ℓ` gives bad probability at most
   `N · (m - 1) / |K|`.

Zero `sorry`, standard axioms only.
-/

namespace Ix.Cert.MultiStark

open Polynomial Finset

section TraceDomain

/-- The `2^ℓ`-th trace-domain generator in `K`, embedded from Goldilocks `twoAdicGenerator ℓ`. -/
def traceGen (ℓ : ℕ) : K :=
  K.embedHom (baseToFp (CertiFri.P3.Goldilocks.twoAdicGenerator ℓ))

/-- Vanishing polynomial `Z_H(X) = X^(2^ℓ) - 1` of the trace domain of height `2^ℓ`. -/
noncomputable def vanishingPoly (ℓ : ℕ) : K[X] :=
  X ^ (2 ^ ℓ) - 1

/-- Every power `g^i` of a `2^ℓ`-th root of unity is a root of `X^(2^ℓ) - 1`. -/
theorem eval_vanishingPoly_eq_zero {g : K} {ℓ : ℕ} (hg : IsPrimitiveRoot g (2 ^ ℓ)) (i : ℕ) :
    (vanishingPoly ℓ).eval (g ^ i) = 0 := by
  unfold vanishingPoly
  simp only [eval_sub, eval_pow, eval_X, eval_one]
  rw [← pow_mul, mul_comm i (2 ^ ℓ), pow_mul, hg.pow_eq_one, one_pow, sub_self]

/-- Evaluating the polynomial identity `C = Z_H * Q` at every trace point `g^i` gives `C(g^i) = 0`!
Notice this requires NO upper bound on `deg(C)` or `deg(Q)` — the `+1` degree slack from
CertiFRI extraction only affects the OOD Schwartz–Zippel degree bound, NEVER the rowwise
vanishing `C(g^i) = 0`! -/
theorem eval_zero_on_trace_of_divisible {g : K} {ℓ : ℕ} (hg : IsPrimitiveRoot g (2 ^ ℓ))
    {C Q : K[X]} (hdiv : C = vanishingPoly ℓ * Q) (i : ℕ) :
    C.eval (g ^ i) = 0 := by
  rw [hdiv, eval_mul, eval_vanishingPoly_eq_zero hg i, zero_mul]

set_option linter.constructorNameAsVariable false in
/-- **OOD Schwartz–Zippel Bound:** If `C ≠ vanishingPoly ℓ * Q`, the number of OOD points
`ζ ∈ K` where `C(ζ) = (ζ^(2^ℓ) - 1) * Q(ζ)` is at most `max C.natDegree (2^ℓ + Q.natDegree)`. -/
theorem card_ood_bad_le {ℓ : ℕ} {C Q : K[X]} (hne : C ≠ vanishingPoly ℓ * Q) :
    (Finset.univ.filter fun ζ : K =>
      C.eval ζ = (vanishingPoly ℓ).eval ζ * Q.eval ζ).card ≤
      max C.natDegree (2 ^ ℓ + Q.natDegree) := by
  set P : K[X] := C - vanishingPoly ℓ * Q
  have hPne : P ≠ 0 := sub_ne_zero.mpr hne
  have hvan_deg : (vanishingPoly ℓ).natDegree ≤ 2 ^ ℓ := by
    unfold vanishingPoly
    exact (natDegree_sub_le _ _).trans (max_le (by simp) (by simp))
  have hdeg : P.natDegree ≤ max C.natDegree (2 ^ ℓ + Q.natDegree) := by
    refine (natDegree_sub_le _ _).trans (max_le (le_max_left _ _) ?_)
    exact (natDegree_mul_le).trans
      ((Nat.add_le_add_right hvan_deg _).trans (le_max_right _ _))
  have hsub : (Finset.univ.filter fun ζ : K =>
      C.eval ζ = (vanishingPoly ℓ).eval ζ * Q.eval ζ) ⊆ P.roots.toFinset := by
    intro ζ hζ
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hζ
    rw [Multiset.mem_toFinset, mem_roots hPne, IsRoot.def]
    simp [P, hζ]
  exact (Finset.card_le_card hsub).trans
    ((Multiset.toFinset_card_le _).trans ((Polynomial.card_roots' P).trans hdeg))

/-- **Recombined Quotient Polynomial:**
Given `chunks : List K[X]`, `recombineQuotientPoly ℓ chunks = ∑_j X^{j · 2^ℓ} · chunks[j]`,
matching `recombineQuotient?` in `Ix/Cert/MultiStark/Air.lean`. -/
noncomputable def recombineQuotientPoly (ℓ : ℕ) (chunks : List K[X]) : K[X] :=
  chunks.foldr (fun q acc => q + X ^ (2 ^ ℓ) * acc) 0

theorem eval_recombineQuotientPoly (ℓ : ℕ) (chunks : List K[X]) (ζ : K) :
    (recombineQuotientPoly ℓ chunks).eval ζ =
      chunks.foldr (fun q acc => q.eval ζ + ζ ^ (2 ^ ℓ) * acc) 0 := by
  induction chunks with
  | nil => simp [recombineQuotientPoly]
  | cons q qs ih =>
    unfold recombineQuotientPoly at ih ⊢
    simp only [List.foldr_cons, eval_add, eval_mul, eval_pow, eval_X, ih]

theorem natDegree_recombineQuotientPoly_le (ℓ : ℕ) (chunks : List K[X]) (d : ℕ)
    (hdeg : ∀ q ∈ chunks, q.natDegree ≤ d) :
    (recombineQuotientPoly ℓ chunks).natDegree ≤
      if chunks = [] then 0 else d + (chunks.length - 1) * 2 ^ ℓ := by
  induction chunks with
  | nil => simp [recombineQuotientPoly]
  | cons q qs ih =>
    unfold recombineQuotientPoly at ih ⊢
    simp only [List.foldr_cons, List.cons_ne_nil, ↓reduceIte, List.length_cons, Nat.add_sub_cancel]
    have hq : q.natDegree ≤ d := hdeg q (List.mem_cons_self ..)
    have hqs := ih (fun r hr => hdeg r (List.mem_cons_of_mem _ hr))
    cases qs with
    | nil => simpa using hq
    | cons r rs =>
      simp only [List.cons_ne_nil, ↓reduceIte, List.length_cons, Nat.add_sub_cancel] at hqs
      refine (natDegree_add_le _ _).trans (max_le (by omega) ?_)
      refine (natDegree_mul_le).trans ?_
      rw [natDegree_X_pow]
      have : 2 ^ ℓ + (d + rs.length * 2 ^ ℓ) = d + (r :: rs).length * 2 ^ ℓ := by
        simp only [List.length_cons]; ring
      omega

/-- **Unnormalized Lagrange Selectors as Polynomials:**
`isFirstPoly ℓ = ∑_{k < 2^ℓ} X^k`, `isLastPoly ℓ g = ∑_{k < 2^ℓ} (g⁻¹)^(2^ℓ - 1 - k) * X^k`,
`isTransPoly g = X - C g⁻¹`. -/
noncomputable def isFirstPoly (ℓ : ℕ) : K[X] :=
  ∑ k ∈ Finset.range (2 ^ ℓ), X ^ k

noncomputable def isLastPoly (ℓ : ℕ) (g : K) : K[X] :=
  ∑ k ∈ Finset.range (2 ^ ℓ), C ((g⁻¹) ^ (2 ^ ℓ - 1 - k)) * X ^ k

noncomputable def isTransPoly (g : K) : K[X] :=
  X - C g⁻¹

theorem isFirstPoly_mul_sub (ℓ : ℕ) :
    isFirstPoly ℓ * (X - 1) = vanishingPoly ℓ := by
  unfold isFirstPoly vanishingPoly
  exact geom_sum_mul X (2 ^ ℓ)

theorem eval_isFirstPoly_off_domain (ℓ : ℕ) {ζ : K} (hζ : ζ ≠ 1) :
    (isFirstPoly ℓ).eval ζ = (vanishingPoly ℓ).eval ζ * (ζ - 1)⁻¹ := by
  have h := congrArg (fun p : K[X] => p.eval ζ) (isFirstPoly_mul_sub ℓ)
  simp only [eval_mul, eval_sub, eval_X, eval_one] at h
  have hne : ζ - 1 ≠ 0 := sub_ne_zero.mpr hζ
  rw [← h, mul_assoc, mul_inv_cancel₀ hne, mul_one]

theorem eval_isFirstPoly_on_domain {g : K} {ℓ : ℕ} (hg : IsPrimitiveRoot g (2 ^ ℓ))
    {i : ℕ} (hi : i < 2 ^ ℓ) :
    (isFirstPoly ℓ).eval (g ^ i) = if i = 0 then (2 ^ ℓ : K) else 0 := by
  by_cases hi0 : i = 0
  · subst hi0
    unfold isFirstPoly
    simp [eval_finsetSum]
  · have hne : g ^ i ≠ 1 := by
      intro h1
      have hdvd := hg.dvd_of_pow_eq_one i h1
      have hle := Nat.le_of_dvd (Nat.pos_of_ne_zero hi0) hdvd
      omega
    simp only [hi0, ↓reduceIte]
    rw [eval_isFirstPoly_off_domain ℓ hne, eval_vanishingPoly_eq_zero hg i, zero_mul]

theorem isLastPoly_mul_sub {g : K} {ℓ : ℕ} (hg : IsPrimitiveRoot g (2 ^ ℓ)) :
    isLastPoly ℓ g * (X - C g⁻¹) = vanishingPoly ℓ := by
  unfold isLastPoly vanishingPoly
  have hg_ne : g ≠ 0 := hg.ne_zero (by positivity)
  have hginv_pow : (g⁻¹) ^ (2 ^ ℓ) = 1 := by rw [inv_pow, hg.pow_eq_one, inv_one]
  -- Telescoping sum `(∑_{k < N} (g⁻¹)^(N-1-k) X^k) * (X - g⁻¹) = X^N - (g⁻¹)^N = X^N - 1`
  have hgeom := geom_sum₂_mul X (C g⁻¹) (2 ^ ℓ)
  have hpow : (C g⁻¹ : K[X]) ^ (2 ^ ℓ) = 1 := by
    rw [← map_pow, hginv_pow, map_one]
  rw [hpow] at hgeom
  rw [← hgeom]
  congr 1
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [← map_pow, mul_comm]

theorem eval_isLastPoly_off_domain {g : K} {ℓ : ℕ} (hg : IsPrimitiveRoot g (2 ^ ℓ))
    {ζ : K} (hζ : ζ ≠ g⁻¹) :
    (isLastPoly ℓ g).eval ζ = (vanishingPoly ℓ).eval ζ * (ζ - g⁻¹)⁻¹ := by
  have h := congrArg (fun p : K[X] => p.eval ζ) (isLastPoly_mul_sub hg)
  simp only [eval_mul, eval_sub, eval_X, eval_C] at h
  have hne : ζ - g⁻¹ ≠ 0 := sub_ne_zero.mpr hζ
  rw [← h, mul_assoc, mul_inv_cancel₀ hne, mul_one]

theorem eval_isLastPoly_on_domain {g : K} {ℓ : ℕ} (hg : IsPrimitiveRoot g (2 ^ ℓ))
    {i : ℕ} (hi : i < 2 ^ ℓ) :
    (isLastPoly ℓ g).eval (g ^ i) =
      if i = 2 ^ ℓ - 1 then (2 ^ ℓ : K) * g else 0 := by
  have hg_ne : g ≠ 0 := hg.ne_zero (by positivity)
  have hN_pos : 1 ≤ 2 ^ ℓ := Nat.one_le_two_pow
  have hlast_eq : g ^ (2 ^ ℓ - 1) = g⁻¹ := by
    apply eq_inv_of_mul_eq_one_left
    rw [← pow_succ, Nat.sub_add_cancel hN_pos, hg.pow_eq_one]
  by_cases hlast : i = 2 ^ ℓ - 1
  · subst hlast
    simp only [↓reduceIte, hlast_eq]
    unfold isLastPoly
    rw [eval_finsetSum]
    have hterm : ∀ k ∈ Finset.range (2 ^ ℓ),
        (C (g⁻¹ ^ (2 ^ ℓ - 1 - k)) * X ^ k).eval g⁻¹ = g := by
      intro k hk
      have hk_lt : k < 2 ^ ℓ := Finset.mem_range.mp hk
      simp only [eval_mul, eval_C, eval_pow, eval_X]
      rw [← pow_add, show 2 ^ ℓ - 1 - k + k = 2 ^ ℓ - 1 by omega]
      rw [inv_pow, hlast_eq, inv_inv]
    rw [Finset.sum_congr rfl hterm, Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    push_cast; rfl
  · have hne : g ^ i ≠ g⁻¹ := by
      intro heq
      have h1 : g ^ (i + 1) = 1 := by rw [pow_succ, heq, inv_mul_cancel₀ hg_ne]
      have hdvd := hg.dvd_of_pow_eq_one (i + 1) h1
      have hle := Nat.le_of_dvd (Nat.succ_pos i) hdvd
      omega
    simp only [hlast, ↓reduceIte]
    rw [eval_isLastPoly_off_domain hg hne, eval_vanishingPoly_eq_zero hg i, zero_mul]

theorem eval_isTransPoly_on_domain {g : K} {ℓ : ℕ} (hg : IsPrimitiveRoot g (2 ^ ℓ))
    {i : ℕ} (hi : i < 2 ^ ℓ) :
    (isTransPoly g).eval (g ^ i) = 0 ↔ i = 2 ^ ℓ - 1 := by
  have hg_ne : g ≠ 0 := hg.ne_zero (by positivity)
  have hN_pos : 1 ≤ 2 ^ ℓ := Nat.one_le_two_pow
  unfold isTransPoly
  simp only [eval_sub, eval_X, eval_C, sub_eq_zero]
  constructor
  · intro heq
    have h1 : g ^ (i + 1) = 1 := by rw [pow_succ, heq, inv_mul_cancel₀ hg_ne]
    have hdvd := hg.dvd_of_pow_eq_one (i + 1) h1
    have hle := Nat.le_of_dvd (Nat.succ_pos i) hdvd
    omega
  · intro hlast
    subst hlast
    apply eq_inv_of_mul_eq_one_left
    rw [← pow_succ, Nat.sub_add_cancel hN_pos, hg.pow_eq_one]

/-- Non-vanishing of `(2 ^ ℓ : K)` for `ℓ ≤ 32`: since `p = 2^64 - 2^32 + 1` is odd,
`2^ℓ ≠ 0` in `Fp` (hence in `K`), so `isFirst(1) ≠ 0` and `isLast(g⁻¹) ≠ 0`. -/
theorem two_pow_ne_zero_in_K (ℓ : ℕ) : ((2 ^ ℓ : ℕ) : K) ≠ 0 := by
  have h2 : (2 : Fp) ≠ 0 := by decide
  have hpow : (2 : Fp) ^ ℓ ≠ 0 := pow_ne_zero ℓ h2
  intro h
  apply hpow
  have hc0 : ((2 ^ ℓ : ℕ) : K).c0 = 0 := congrArg K.c0 h
  rw [K.natCast_c0, Nat.cast_pow, Nat.cast_ofNat] at hc0
  exact hc0

/-! ## 2. Horner Constraint Batching Soundness (`α_air`) -/

/-- Horner combination `∑_{k < cs.length} α^{cs.length - 1 - k} · cs[k]` matching `oodFold`
in `Ix/Cert/MultiStark/Air.lean`. -/
def hornerFold (α : K) (cs : List K) : K :=
  cs.foldl (fun acc x => acc * α + x) 0

/-- Polynomial in `α` representing `hornerFold α cs`. -/
noncomputable def hornerPoly (cs : List K) : K[X] :=
  cs.foldl (fun acc x => acc * X + C x) 0

theorem eval_hornerPoly (α : K) (cs : List K) :
    (hornerPoly cs).eval α = hornerFold α cs := by
  have hgen : ∀ (l : List K) (p : K[X]),
      (l.foldl (fun acc x => acc * X + C x) p).eval α =
        l.foldl (fun acc x => acc * α + x) (p.eval α) := by
    intro l
    induction l with
    | nil => intro p; rfl
    | cons c cs ih =>
      intro p
      simp only [List.foldl_cons, ih, eval_add, eval_mul, eval_X, eval_C]
  simpa [hornerPoly, hornerFold] using hgen cs 0

theorem natDegree_hornerPoly_le (cs : List K) :
    (hornerPoly cs).natDegree ≤ cs.length - 1 := by
  have hgen : ∀ (l : List K) (p : K[X]),
      (l.foldl (fun acc x => acc * X + C x) p).natDegree ≤
        if l = [] then p.natDegree else max (p.natDegree + l.length) (l.length - 1) := by
    intro l
    induction l with
    | nil => intro p; simp
    | cons c cs ih =>
      intro p
      simp only [List.foldl_cons, List.cons_ne_nil, ↓reduceIte, List.length_cons, Nat.add_sub_cancel]
      have hstep := ih (p * X + C c)
      have hdeg1 : (p * X + C c).natDegree ≤ p.natDegree + 1 := by
        refine (natDegree_add_le _ _).trans (max_le ?_ (by simp))
        refine (natDegree_mul_le).trans (by simp)
      cases cs with
      | nil =>
        simp only [↓reduceIte] at hstep
        exact hstep.trans (hdeg1.trans (le_max_left _ _))
      | cons d ds =>
        simp only [List.cons_ne_nil, ↓reduceIte, List.length_cons, Nat.add_sub_cancel] at hstep
        refine hstep.trans (max_le ?_ ?_)
        · exact le_trans (by omega : (p * X + C c).natDegree + (ds.length + 1) ≤
            p.natDegree + (ds.length + 1 + 1)) (le_max_left _ _)
        · exact le_trans (by omega : ds.length ≤ ds.length + 1) (le_max_right _ _)
  have h0 := hgen cs 0
  cases cs with
  | nil => simp [hornerPoly]
  | cons c cs =>
    simp only [List.cons_ne_nil, ↓reduceIte, natDegree_zero, zero_add, List.length_cons,
      Nat.add_sub_cancel] at h0
    -- Wait: with `p = 0`, the first step `0 * X + C c = C c` has degree `0`!
    have h1 := hgen cs (C c)
    unfold hornerPoly
    simp only [List.foldl_cons, zero_mul, zero_add]
    cases cs with
    | nil => simp
    | cons d ds =>
      simp only [List.cons_ne_nil, ↓reduceIte, natDegree_C, zero_add, List.length_cons,
        Nat.add_sub_cancel] at h1
      simpa using h1

theorem hornerPoly_ne_zero_of_exists_ne_zero {cs : List K} (h : ∃ c ∈ cs, c ≠ 0) :
    hornerPoly cs ≠ 0 := by
  -- `coeff (hornerPoly cs) k = cs[cs.length - 1 - k]` for `k < cs.length`
  have hcoeff : ∀ (l : List K) (p : K[X]) (k : ℕ) (hk : k < l.length),
      (l.foldl (fun acc x => acc * X + C x) p).coeff k = l[l.length - 1 - k]'(by omega) := by
    intro l
    induction l using List.reverseRecOn with
    | nil => intro _ _ hk; simp at hk
    | append_singleton l a ih =>
      intro p k hk
      rw [List.foldl_append, List.foldl_cons, List.foldl_nil]
      cases k with
      | zero =>
        simp [List.length_append]
      | succ k =>
        rw [coeff_add, coeff_mul_X, coeff_C_succ, add_zero]
        have hk' : k < l.length := by simp at hk; omega
        rw [ih p k hk']
        have hidx : (l ++ [a]).length - 1 - (k + 1) = l.length - 1 - k := by
          simp; omega
        simp only [hidx, List.getElem_append_left (by omega : l.length - 1 - k < l.length)]
  obtain ⟨c, hc_mem, hc_ne⟩ := h
  obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hc_mem
  intro h0
  have hci := congrArg (fun p : K[X] => p.coeff (cs.length - 1 - i)) h0
  rw [coeff_zero, hornerPoly, hcoeff cs 0 (cs.length - 1 - i) (by omega)] at hci
  have hidx : cs.length - 1 - (cs.length - 1 - i) = i := by omega
  simp only [hidx] at hci
  exact hc_ne hci

set_option linter.constructorNameAsVariable false in
/-- **Constraint Batching (`α_air`) Schwartz–Zippel Bound:**
If at least one constraint in `cs` is nonzero at a row, at most `cs.length - 1` challenges
`α ∈ K` make `hornerFold α cs = 0`. -/
theorem card_horner_bad_le {cs : List K} (h : ∃ c ∈ cs, c ≠ 0) :
    (Finset.univ.filter fun α : K => hornerFold α cs = 0).card ≤ cs.length - 1 := by
  set P := hornerPoly cs
  have hPne : P ≠ 0 := hornerPoly_ne_zero_of_exists_ne_zero h
  have hsub : (Finset.univ.filter fun α : K => hornerFold α cs = 0) ⊆ P.roots.toFinset := by
    intro α hα
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hα
    rw [Multiset.mem_toFinset, mem_roots hPne, IsRoot.def, eval_hornerPoly, hα]
  exact (Finset.card_le_card hsub).trans
    ((Multiset.toFinset_card_le _).trans ((Polynomial.card_roots' P).trans (natDegree_hornerPoly_le cs)))

end TraceDomain

end Ix.Cert.MultiStark
