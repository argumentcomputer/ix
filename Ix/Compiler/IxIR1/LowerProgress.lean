    runOp_extern_value_progress
      (sourceCtx := sourceCtx) (ctx := ctx) (cur := cur)
      (resultWorld := resultWorld) havs.resolveAtoms hprogress hvalue
      hlookup href hlength hsource hvalueGraphs hownExtern
  refine ⟨fuel, store, result, hrun, ?_⟩
  refine ⟨⟨envRoots, result, houtput.bump result, ?_,
    hresultGraph, hrestGraph, hownAfter⟩, hslots.bump result⟩
  apply AValRealizes.slot
  · simp [VEnv.bump]
  · simp [VEnv.bump, VEnv.rel]

