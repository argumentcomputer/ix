      sourceResult) :
    LowerResultValueProgress funRel recSelfRel ctx cur
      input output.bump sourceInput sourceOutput sourceResult resultWorld
      (emit ∘ emitOp
        (.extern address (avs.map (·.toAtom output)).toArray))
      (.slotA output.depth) := by
  refine
    { toLowerResultValueSound :=
        hargs.toLowerArgsValueSound.extern_graph hvalue hlookup href hlength
          hsource
