    (hborrowSucc := fun hexpr =>
      lowerBorrowValueSettlesWithin_succ hexpr)
    (hspineOne := lowerSpineValueSettlesWithin_one)
    (hspineSucc := by
      intro fuel hprevSpine hprevExpr hpriorArgs hpriorRest hprevRest
