/-- Under-applied constructor references progress through wrapper synthesis
and partial-application allocation. -/
theorem lowerSpine_ref_ctor_partial_run_value_progress_within
    {sourceCtx : IxIR0.Ctx} {src : IxIR0.Env} {ambient : LowSt}
