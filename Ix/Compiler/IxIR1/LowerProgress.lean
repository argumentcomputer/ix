      input output sourceInput sourceOutput sourceArgs
      (List.replicate avs.length .shared) emit avs)
    (hprogress : ExternProgressContract funRel sourceCtx ctx)
    (hvalue : ExternValueContract funRel sourceCtx ctx)
    (hlookup : sourceCtx.env address = some (.extern arity))
    (href : SourceRefValue sourceCtx address sourceFunction)
    (hlength : sourceArgs.length = arity)
