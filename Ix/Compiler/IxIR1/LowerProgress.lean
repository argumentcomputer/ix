def LowerEValueProgressesWithin (funRel : Sim.FunctionRel)
    (recSelfRel : RecSelfRel) (sourceCtx : IxIR0.Ctx)
    (ctx : Ctx) (cur : FnDef) (src : IxIR0.Env)
    (ambient : LowSt) (fuel : Nat) : Prop :=
  ∀ {input output : VEnv} {world : Owned} {expr : IxIR0.Expr}
      {sourceEnv : List IxIR0.Value} {sourceFuel : Nat}
      {sourceValue : IxIR0.Value} {state finalState : LowSt}
      {emit : Emit} {av : AVal},
    IxIR0.eval sourceCtx sourceFuel sourceEnv expr = .ok sourceValue →
    (lowerE src fuel input world expr).run state =
      .ok (output, emit, av) finalState →
    ExtraExtends finalState ambient →
    SelfProgressAvailable funRel recSelfRel sourceCtx ctx cur input →
    LowerResultValueProgress funRel recSelfRel ctx cur input output
      sourceEnv sourceEnv sourceValue world emit av

