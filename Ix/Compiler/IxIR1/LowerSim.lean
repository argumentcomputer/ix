        (ctx := ctx) (cur := cur) (fuel := fuel)
        hav.resolveAtom hshared hvalue hown
    have hpair : (middle, value) = (store', result) :=
      Except.ok.inj (heval.symm.trans hrun)
    cases hpair
    have hΓmiddle : VEnvValueGraph funRel recSelfRel store' Γ'
