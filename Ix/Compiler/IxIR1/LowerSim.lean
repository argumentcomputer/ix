    OpSound ctx cur (.fetch atom index) pre (fun _ _ => False) := by
  intro fuel store env store' result _ hrun
  cases hstable <;> cases fuel with
  | zero => simp [runOp] at hrun
  | succ fuel =>
      rw [runOp.eq_def] at hrun
      simp [resolveAtom, bindOk] at hrun

