private theorem lower_var_shared_borrow_value_sound_at
    {funRel : Sim.FunctionRel} {recSelfRel : RecSelfRel}
    {ctx : Ctx} {cur : FnDef} {limit : Nat} {Γ : VEnv}
    {sourceEnv : List IxIR0.Value} {sourceValue : IxIR0.Value}
