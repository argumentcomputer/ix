      | ctor hfield => exact (hsound hwithin).projectSlotKept hfield
      | erased => exact (hsound hwithin).projectSlotKeptErased)
    (hslotReleased := fun hsound hwithin => by
      cases hproject with
      | ctor hfield => exact (hsound hwithin).projectSlotReleased hfield
      | erased => exact (hsound hwithin).projectSlotReleasedErased)
