    (hownership : FnOwnershipContractBelow ctx cur worlds limit)
    (hvalue : FnValueContractBelow funRel sourceCtx ctx cur worlds
      sourceFunction limit)
    (hsource : SourceApplies sourceCtx sourceFunction sourceArgs
      sourceResult) :
    LowerResultValueSoundBelow funRel recSelfRel ctx cur limit
      input output.bump sourceInput sourceOutput sourceResult cur.result
      (emit ∘ emitOp
        (.callSelf (avs.map (·.toAtom output)).toArray))
      (.slotA output.depth) := by
  refine
    { toLowerResultSoundBelow :=
        hargs.toLowerArgsSoundBelow.callSelf_owned hownership
      graphEmits := ?_ }
  intro sourceRest rest slots
  apply EmitSoundBelow.comp (hargs.graphEmits sourceRest rest slots)
  apply OpSoundBelow.emit
  intro fuel store env store' result hfuel hpre hrun
  obtain ⟨⟨envRoots, values, houtput, havs, hvalueGraphs,
      hrestGraph, hown⟩, hslots⟩ := hpre
  have henvFrame : Sim.RootsGraph funRel store
      (entrySourceRoots output.entries sourceOutput) envRoots :=
    houtput.entries.rootsGraphExact
  have hcombinedFrame : Sim.RootsGraph funRel store
      (entrySourceRoots output.entries sourceOutput ++ sourceRest)
