theorem discard_const_arg_value_below
    {funRel : Sim.FunctionRel} {recSelfRel : RecSelfRel}
    {ctx : Ctx} {cur : FnDef} {limit : Nat} {Γ : VEnv}
    {sourceEnv : List IxIR0.Value} {source : IxIR0.Value}
