/-- Premise-free bounded lambda semantics. A graph-realizable input supplies
the required source/logical length; otherwise the graph transformer is
vacuous while the bounded ownership proof remains meaningful. -/
theorem lowerE_lam_run_value_sound_any_below
    {funRel : Sim.FunctionRel} {recSelfRel : RecSelfRel}
    {ctx : Ctx} {cur : FnDef} {limit : Nat} {src : IxIR0.Env}
