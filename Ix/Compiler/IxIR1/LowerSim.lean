        (value :: env)[Γ.bump.rel Γ.depth]? = some value := by
      simp [VEnv.bump, VEnv.rel]
    obtain ⟨before, after, hroots, hentries⟩ :=
      hΓbump.entries.holdAt hentryBump hnewBound hnewSlot
