                (List.replicate arity .shared) sourceFunction limit := by
            intro hrel
            simpa [harity] using hself.value (by simpa [harity] using hrel)
          have hbuilt := hprefix.callSelf_entry_graph hentry hsourceHead
            hownership hvalue hprefixApply
          simpa [hself.result] using hbuilt
        · have hmismatch : prefixAVals.length ≠ cur.arity := by
            intro heq
            exact harity (havsLength.symm.trans heq)
          simpa [hself.result] using
            hprefix.callSelf_arity_mismatch_graph
