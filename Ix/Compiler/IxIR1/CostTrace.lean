/-- A projection fetch known to be impossible closes any remaining suffix.
The fetch itself is ownership-free; the unreachable tail may consume the
source retain candidate without producing a target run. -/
theorem falseAfterProjectionFetch_profileFundedEmitStateRunSound
    {ctx : Ctx} {cur : FnDef} {op : Op} {tail : Emit}
    {pre post : StatePred}
    (hfalse : OpSound ctx cur op pre (fun _ _ => False))
