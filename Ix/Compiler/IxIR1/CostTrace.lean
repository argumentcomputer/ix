    (hhead : sourceInput[index]? = some sourceFunction)
    (hownership : Sim.FnOwnershipContract ctx cur worlds)
    (hvalue : recSelfRel sourceFunction arity →
      FnValueContract funRel sourceCtx ctx cur worlds sourceFunction)
    (hcost : recSelfRel sourceFunction arity →
      ∃ sourceAddress,
        FnProfileContract funRel sourceCtx ctx sourceAddress cur worlds
          sourceFunction)
    (hsource : SourceAppliesProfile sourceCtx sourceFunction sourceArgs
      sourceResult callProfile)
    (hnonempty : sourceArgs ≠ []) :
