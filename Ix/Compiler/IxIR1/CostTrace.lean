      sourceResult applyProfile)
    (hterminalWorld : args.length ≤ count → cur.result = resultWorld)
    (hoverWorld : count < args.length → cur.result = .shared)
    (hrun : (knownCall src (fuel + 1) input (.callSelf ·) count
      argWorlds resultWorld args).run state =
