      input output sourceInput sourceOutput .erased .shared
      (emit ∘ (_root_.id : Emit)) (.constA .erased) := by
    simpa [Function.comp_def] using
      hsound.toLowerBorrowValueSound.returnErased
  have hsuffix : ∀ sourceRest rest slots,
      ProfileFundedEmitStateRunSound ctx cur (_root_.id : Emit)
