theorem LowerResultProfileSoundBelow.closeCost
    {funRel : Sim.FunctionRel} {recSelfRel : RecSelfRel}
    {ctx : Ctx} {cur : FnDef} {limit : Nat}
    {input output : VEnv} {sourceInput sourceOutput : List IxIR0.Value}
