    LowerResultProfileSound funRel recSelfRel ctx cur input output
      sourceEnv sourceEnv (.clos uses sourceEnv body) world emit value
      (IxIR0.DynamicCost.tick .evalLam +
        IxIR0.DynamicCost.retain sourceEnv.length) := by
  have huuEq :
      (Ixon.Owned.unique == Ixon.Owned.unique) = true := by decide
  have hsuEq :
      (Ixon.Owned.shared == Ixon.Owned.unique) = false := by decide
