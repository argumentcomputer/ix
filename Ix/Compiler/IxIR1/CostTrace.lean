    ProfileFundedEmitStateRunSound ctx cur (emitOp op ∘ tail) pre post
      (IxIR0.DynamicCost.tick .evalProj +
        IxIR0.DynamicCost.retain 1) :=
  ProfileFundedEmitStateRunSound.comp
    (ProfileFundedEmitStateRunSound.localZero
      (profile := IxIR0.DynamicCost.tick .evalProj) hfalse hlocal)
    (ProfileFundedEmitStateRunSound.ofFalse
      (emit := tail) (profile := IxIR0.DynamicCost.retain 1))

