        sourceResult cur.result (.slotA output.depth) sourceRest rest slots)
      (argsProfile + callProfile) :=
    ProfileFundedEmitStateRunSound.comp
      (hargs.profileEmits sourceRest rest slots)
      (callSelf_graph_profile_op hownership (hvalue hself) hcost
        hentryProfile)
