/-- A repeated shared variable use couples its semantic retain step with the
paired `(0,2)` cost of `dup`, under any source profile that funds that pair. -/
theorem lower_held_retain_profile_sound_of_funding
    {funRel : Sim.FunctionRel} {recSelfRel : RecSelfRel}
    {ctx : Ctx} {cur : FnDef} {input : VEnv}
    {sourceEnv : List IxIR0.Value} {sourceValue : IxIR0.Value}
    {index abs remaining newRemaining : Nat} {uses : Ixon.Uses}
    {profile : SourceProfile}
    (hsource : sourceEnv[index]? = some sourceValue)
    (hworld : worldOfUses uses = .shared)
    (hentry : input.entries[index]? =
      some (.slot abs remaining uses true))
