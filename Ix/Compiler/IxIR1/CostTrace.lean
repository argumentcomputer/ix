          (sourceProfileOwnershipAllowance
            (IxIR0.DynamicCost.retain captures.length +
              IxIR0.DynamicCost.tick .evalLam))
          (sourceProfileOwnershipAllowance
            (IxIR0.DynamicCost.tick .evalLam +
              IxIR0.DynamicCost.retain sourceEnv.length)) := by
        simp [OwnershipAllowanceLE, sourceProfileOwnershipAllowance,
          IxIR0.DynamicCost.retain, IxIR0.DynamicCost.tick]
        omega
