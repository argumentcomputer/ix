/-
  Resource profile sources for `ix compile --profile`.

  A profile source written by hand binds explicit assumptions (choices,
  interfaces, shareable types, case behavior, limits). Two kinds of directive
  are generated by the compiler from the compiled closure instead, because
  their soundness rests on facts about Lean's own declarations rather than on
  an author's claim:

  * `case NAME` binds a case definition — a `casesOn` or a matcher, as Lean
    records them — whose alternatives the consumer evaluates by need. Every
    other definition, however match-shaped its body, is an ordinary call.
  * `equation NAME THEOREM` binds an unfolding equation; `ix compile
    --equations` adds one for every `f.eq_def` it realized (`Ix.Compile.
    Equations.realize`), so only Lean's own unfolding theorem of `f` is ever
    bound, never an author's theorem about `f`.
-/
module
public import Lean.AuxRecursor
public import Lean.Meta.Match.MatcherInfo
public import Lean.Compiler.ExternAttr
public import Lean.Compiler.ImplementedByAttr
public import Lean.Compiler.Old
public import Ix.Compile.SourceContract.Registry
public import Ix.Compile.Equations

public section

namespace Ix.Compile.ResourceProfile

open Lean

/-- Directives the compiler generates; a hand-written source may not use them.
`generated` ends the written source: the native parser accepts `case` and
`equation` only after it (second review R2-4). -/
def generatedDirectives : List String := ["case", "equation", "generated"]

/-- A character the text of a directive may contain: printable ASCII or a
tab (Rust `profile_from_source` enforces the same). -/
def directiveChar (c : Char) : Bool := c == '\t' || (' ' ≤ c && c ≤ '~')

/-- The directive text of each line of a profile source, as the native
parser reads it: lines split at `\n`, one trailing `\r` dropped, the text
before `#`. -/
def directiveLines (source : String) : List String :=
  (source.splitOn "\n").map fun line =>
    let chars := line.toList
    let chars := if chars.getLast? == some '\r' then chars.dropLast else chars
    (String.ofList (chars.takeWhile (· != '#')))

/-- The words of each directive line of a profile source: `#` starts a
comment, words are separated by spaces or tabs, exactly as the native parser
splits them (a source with any other character in a directive is rejected by
`checkWritten` and by the native parser). Empty lines are dropped. -/
def directives (source : String) : List (List String) :=
  (directiveLines source).filterMap fun text =>
    match ((text.map fun c => if c == '\t' then ' ' else c).splitOn " ").filter (!·.isEmpty) with
    | [] => none
    | words => some words

/-- Whether a profile source asks for case behavior (`cases`). -/
def hasCases (source : String) : Bool :=
  (directives source).any (· == ["cases"])

/-- Reject a hand-written source that uses a generated directive, or whose
directives contain a character other than printable ASCII and tabs (a
vertical tab, a form feed or a no-break space must not hide a directive
from one of the two tokenizers, second review R2-4). -/
def checkWritten (source : String) : Except String Unit := do
  for text in directiveLines source do
    if let some c := text.toList.find? (!directiveChar ·) then
      throw s!"resource profile source: character U+{String.ofList (Nat.toDigits 16 c.toNat)} \
        in a directive: only printable ASCII, spaces and tabs are allowed"
  for words in directives source do
    if let some word := words.head? then
      if generatedDirectives.contains word then
        throw s!"resource profile source: `{word}` directives are generated by `ix compile`, \
          not written in a profile"

/-- Whether the code that runs for a declaration is not its Lean body, so
that the body is only a model: a native implementation (`@[extern]`,
`@[implemented_by]`), an `opaque` (its value is an inhabitant the compiler
never runs; a `partial def` is one, compiled from its `_unsafe_rec` twin),
or any other non-definition with an `_unsafe_rec` twin (second review
R2-2). A *definition* with an `_unsafe_rec` twin (structural or well-founded
recursion) is not native: annotated, it is admitted only through its bound
unfolding equation (`checkRecursion`), which is what the consumer runs. -/
def native (env : Lean.Environment) (name : Lean.Name) : Bool :=
  isExtern env name || (Compiler.getImplementedBy? env name).isSome ||
    match env.find? name with
    | some (.opaqueInfo _) => true
    | some (.defnInfo _) => false
    | _ => env.contains (Compiler.mkUnsafeRecName name)

/-- The case definitions of a closure: every `casesOn` and matcher Lean
records, excluding any declaration with a native implementation, whose Lean
body is only a model. -/
def caseDefinitions (env : Lean.Environment) (names : List Lean.Name) : Array Lean.Name :=
  names.toArray.filter fun name =>
    (isCasesOnRecursor env name || Meta.isMatcherCore env name) && !native env name

/-- Whether a declaration carries a source contract (registered or written). -/
def annotated (env : Lean.Environment) (name : Lean.Name) (info : Lean.ConstantInfo) : Bool :=
  (Ix.Compile.sourceContractExtension.getState env).contains name ||
    Ix.Compile.sourceHasAnnotations info

/-- The names a profile source admits as assumptions (`assume`, `choice`,
`interface`). -/
def assumed (source : String) : List String :=
  (directives source).filterMap fun
    | "assume" :: name :: _ | "choice" :: name :: _ | "interface" :: name :: _ => some name
    | _ => none

/-- A declaration with a native implementation and a resource contract is
admitted only as an explicit assumption of the profile (`source`; `none` is
the standard profile, which assumes nothing): its contract cannot be checked
against the model body, so callers rely on it as stated. -/
def checkNative (source : Option String) (env : Lean.Environment)
    (constants : List (Lean.Name × Lean.ConstantInfo)) : Except String Unit := do
  let admitted := (source.map assumed).getD []
  for (name, info) in constants do
    if native env name && annotated env name info && !admitted.contains (toString name) then
      throw s!"resource profile: `{name}` has a native implementation (@[extern], \
        @[implemented_by], an opaque or partial definition) and a resource contract; its Lean \
        body is only a model, so the contract must be an explicit profile assumption \
        (assume {name})"

/-- Whether a constant is an auxiliary of a kernel recursion encoding:
`brecOn`/`binductionOn` (structural recursion), `WellFounded.fix` and its
variants, or a definition's `_unary`/`_binary`/`_mutual`/`_f` auxiliary. -/
def recursionAuxiliary : Lean.Name → Bool
  | .str p s =>
    s == "brecOn" || s == "binductionOn" || s == "_unary" || s == "_binary" ||
      s == "_mutual" || s == "_f" ||
      (p.getRoot == `WellFounded && (s == "fix" || s == "fixF"))
  | _ => false

/-- Review R2-3: an annotated recursive definition — one Lean realizes an
unfolding theorem for, or whose kernel body references a recursion
auxiliary (`recursionAuxiliary`) — is admitted only when resource admission
checks it through a bound unfolding equation (`bound`: the definitions the
compile binds an `equation` directive for, under `ix compile --equations
--profile FILE`), or when the profile admits it as an explicit assumption
(`assume`/`choice`/`interface`). Its kernel body (`brecOn`, `WellFounded.fix`
with unchecked `_f`/`_unary` auxiliaries) is not what a consumer runs, so it
is never the checked path. `source` is the profile source (`none`: the
standard profile, which binds no equation and assumes nothing, so every
annotated recursive definition is refused). Returns the definitions that
must appear among the checked pairs after the compile. -/
def checkRecursion (source : Option String) (env : Lean.Environment)
    (constants : List (Lean.Name × Lean.ConstantInfo)) (bound : List Lean.Name) :
    IO (Except String (List Lean.Name)) := do
  let admitted := (source.map assumed).getD []
  let annotatedDefinitions := constants.filterMap fun (name, info) =>
    match info with
    | .defnInfo _ => if annotated env name info then some (name, info) else none
    | _ => none
  if annotatedDefinitions.isEmpty then return .ok []
  let (_, realized, failed) ← Ix.Compile.Equations.realize env (annotatedDefinitions.map (·.1))
  let mut required := []
  for (name, info) in annotatedDefinitions do
    let recursive := realized.any (·.definition == name) || failed.any (·.1 == name) ||
      info.value!.getUsedConstants.any recursionAuxiliary
    unless recursive do continue
    if admitted.contains (toString name) then continue
    unless bound.contains name do
      return .error s!"resource profile: `{name}` is an annotated recursive definition; it is \
        admitted only when checked through its unfolding equation (ix compile --equations \
        --profile FILE) or assumed by the profile (assume {name}), never through its kernel \
        encoding"
    required := name :: required
  return .ok required.reverse

/-- The profile source the native compiler receives: the hand-written source,
then a `generated` line ending it, then, when it asks for case behavior, a
`case` directive for every case definition of the closure (`ix compile
--equations` appends its `equation` directives after these). -/
def build (source : String) (env : Lean.Environment) (constants : List (Lean.Name × Lean.ConstantInfo)) :
    Except String String := do
  checkWritten source
  checkNative (some source) env constants
  -- `generated` ends the written source; only generated directives follow.
  let mut text := source ++ "\ngenerated\n"
  if hasCases source then
    for name in caseDefinitions env (constants.map (·.1)) do
      text := text ++ s!"case {name}\n"
  return text

end Ix.Compile.ResourceProfile
