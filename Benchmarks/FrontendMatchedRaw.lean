import Benchmarks.FrontendRaw
import Benchmarks.FrontendMatchedData

/-! Extension of the bounded raw frontend with complete alpha-canonical
constant payloads, including generated record auxiliaries and the fixed prelude.
Expected payloads are only used by the comparator; user/generated declarations
are constructed from the parsed source. Differential tests vary names, record
arities, bodies and declaration order. This is not a general Ix frontend or an
Ixon compiler, and does not implement the full ElabClaim commitment pipeline. -/
namespace FrontendMatchedRaw

def implementation := ⟦
  enum WNode { Num(G), Text(ByteStream), Tree(G, List‹&WNode›) }
  type W = &WNode
  fn w_num(n: G) -> W { store(WNode.Num(n)) }
  fn w_text(s: ByteStream) -> W { store(WNode.Text(s)) }
  fn w_node(n: G, xs: List‹W›) -> W { store(WNode.Tree(n, xs)) }
  fn w_nil() -> W { w_node(0, store(ListNode.Nil)) }
  fn w_child(parent: W, part: ByteStream) -> W { w2(21, parent, w_text(part)) }
  fn w_simple(part: ByteStream) -> W { w_child(w0(20), part) }
  fn w_full(ns: ByteStream, n: ByteStream) -> W { w_child(w_simple(ns), n) }
  fn w_var(i: G) -> W { w1(0, w_num(i)) }
  fn w_level(n: G) -> W { match n { 0 => w0(0), _ => w1(1, w_level(n - 1)), } }
  fn w_sort(n: G) -> W { w1(1, w_level(n)) }
  fn w_const(n: W, us: W) -> W { w2(2, n, us) }
  fn w_app(f: W, x: W) -> W { w2(3, f, x) }
  fn w_apps(f: W, xs: List‹W›) -> W {
    match load(xs) { ListNode.Nil => f, ListNode.Cons(x, rest) => w_apps(w_app(f, x), rest), }
  }
  fn w_bind(kind: G, bi: G, dom: W, body: W) -> W { w3(kind, w_num(bi), dom, body) }
  fn w_pi(bi: G, dom: W, body: W) -> W { w_bind(5, bi, dom, body) }
  fn w_lam(bi: G, dom: W, body: W) -> W { w_bind(4, bi, dom, body) }
  fn w_eq(a: W, b: W) -> G {
    match load(a) {
      WNode.Num(n) => match load(b) { WNode.Num(m) => r_num_eq(n,m), _ => 0, },
      WNode.Text(s) => match load(b) { WNode.Text(t) => r_word_eq(s,t), _ => 0, },
      WNode.Tree(n, xs) => match load(b) {
        WNode.Tree(m, ys) => r_num_eq(n,m) * w_list_eq(xs,ys), _ => 0,
      },
    }
  }
  fn w_list_eq(xs: List‹W›, ys: List‹W›) -> G {
    match load(xs) {
      ListNode.Nil => list_is_empty(ys),
      ListNode.Cons(x,xs) => match load(ys) {
        ListNode.Nil => 0, ListNode.Cons(y,ys) => w_eq(x,y) * w_list_eq(xs,ys),
      },
    }
  }
  fn w_name_bytes(n: W) -> ByteStream {
    let WNode.Tree(tag, xs) = load(n);
    match tag {
      20 => store(ListNode.Nil),
      21 => let parent = list_lookup(xs,0);
        let WNode.Text(s) = load(list_lookup(xs,1));
        let p = w_name_bytes(parent);
        match list_is_empty(p) {
          1 => s, 0 => list_concat(p, store(ListNode.Cons(46u8,s))),
        },
      -- Names generated by this benchmark/prelude contain no numeric components.
    }
  }
  fn w_less(a: ByteStream, b: ByteStream) -> G {
    match load(a) {
      ListNode.Nil => 1 - list_is_empty(b),
      ListNode.Cons(x,xs) => match load(b) {
        ListNode.Nil => 0,
        ListNode.Cons(y,ys) => match to_field(x) - to_field(y) {
          0 => w_less(xs,ys), _ => u32_less_than(to_field(x),to_field(y)),
        },
      },
    }
  }
  fn w_entry_name(e: W) -> ByteStream {
    let WNode.Tree(_, xs) = load(e); w_name_bytes(list_lookup(xs,0))
  }
  fn w_insert(e: W, es: List‹W›) -> List‹W› {
    match load(es) {
      ListNode.Nil => store(ListNode.Cons(e,es)),
      ListNode.Cons(x,xs) => match w_less(w_entry_name(e),w_entry_name(x)) {
        1 => store(ListNode.Cons(e,es)),
        0 => store(ListNode.Cons(x,w_insert(e,xs))),
      },
    }
  }
  fn w_sort_entries(es: List‹W›) -> List‹W› {
    match load(es) { ListNode.Nil => es,
      ListNode.Cons(x,xs) => w_insert(x,w_sort_entries(xs)), }
  }
  fn w_merge(a: List‹W›, b: List‹W›) -> List‹W› {
    match load(a) {
      ListNode.Nil => b,
      ListNode.Cons(x,xs) => match load(b) {
        ListNode.Nil => a,
        ListNode.Cons(y,ys) => match w_less(w_entry_name(x),w_entry_name(y)) {
          1 => store(ListNode.Cons(x,w_merge(xs,b))),
          0 => store(ListNode.Cons(y,w_merge(a,ys))),
        },
      },
    }
  }
  fn w_contract(kind: G, flags: G, unique: G, e: W) -> W {
    match flags + unique {
      0 => e,
      _ =>
        let bits = match flags { 0 => 7, 2 => 3, 3 => 1, };
        let code = bits + kind * 16 * (1 - unique);
        let key = w_child(w_simple(w_word_ix()), w_word_contract());
        let version = w2(0, key, w1(3,w_num(3)));
        let kd = w2(0, w_child(key,w_word_kind()), w1(3,w_num(kind)));
        let cd = w2(0, w_child(key,w_word_code()), w1(3,w_num(code)));
        w2(9, w3(0,version,kd,cd), e),
    }
  }
  fn w_eq_level(a: RC) -> W {
    match load(a) { RCore.Universe(n) => w_level(n+1), _ => w_level(1), }
  }
  fn w_or(a: G, b: G) -> G { a + b - a*b }
  fn w_occurs(e: RC, index: G) -> G {
    match load(e) {
      RCore.Universe(_) => 0, RCore.Const(_) => 0,
      RCore.Var(i) => r_num_eq(i,index),
      RCore.App(f,x) => w_or(w_occurs(f,index),w_occurs(x,index)),
      RCore.Pi(_,_,_,a,b) => w_or(w_occurs(a,index),w_occurs(b,index+1)),
      RCore.Lam(_,_,a,b) => w_or(w_occurs(a,index),w_occurs(b,index+1)),
      RCore.Let(t,v,b) => w_or(w_or(w_occurs(t,index),w_occurs(v,index)),w_occurs(b,index+1)),
      RCore.RecTy(a) => w_occurs(a,index),
      RCore.Ctor(a,xs) => w_or(w_occurs(a,index),w_occurs_list(xs,index)),
      RCore.Proj(_,x) => w_occurs(x,index),
      RCore.Equality(a,l,r) => w_or(w_or(w_occurs(a,index),w_occurs(l,index)),w_occurs(r,index)),
      RCore.Refl(a,l) => w_or(w_occurs(a,index),w_occurs(l,index)),
    }
  }
  fn w_occurs_list(xs: List‹RC›, index: G) -> G {
    match load(xs) { ListNode.Nil => 0,
      ListNode.Cons(x,rest) => w_or(w_occurs(x,index),w_occurs_list(rest,index)), }
  }
  fn w_core(e: RC, ns: ByteStream, rn: W) -> W {
    match load(e) {
      RCore.Universe(n) => w_sort(n), RCore.Var(i) => w_var(i),
      RCore.Const(n) => w_const(w_full(ns,n),w_nil()),
      RCore.App(f,x) => w_app(w_core(f,ns,rn),w_core(x,ns,rn)),
      RCore.Pi(bi,flags,ru,a,b) => w_contract(1,flags,ru,
        w_pi(bi,w_core(a,ns,rn),w_core(b,ns,rn))),
      RCore.Lam(bi,flags,a,b) => w_contract(0,flags,0,
        w_lam(bi,w_core(a,ns,rn),w_core(b,ns,rn))),
      RCore.Let(t,v,b) => w4(6,w_num(1-w_occurs(b,0)),w_core(t,ns,rn),w_core(v,ns,rn),w_core(b,ns,rn)),
      RCore.RecTy(a) => w_app(w_const(rn,w_nil()),w_core(a,ns,rn)),
      RCore.Ctor(a,xs) => w_apps(w_app(w_const(w_child(rn,r_word_mk()),w_nil()),
        w_core(a,ns,rn)), w_core_list(xs,ns,rn)),
      RCore.Proj(i,x) => w3(10,rn,w_num(i),w_core(x,ns,rn)),
      RCore.Equality(a,l,r) => w_app(w_app(w_app(
        w_const(w_simple(r_word_equality()),w1(0,w_eq_level(a))),w_core(a,ns,rn)),
        w_core(l,ns,rn)),w_core(r,ns,rn)),
      RCore.Refl(a,l) => w_app(w_app(w_const(w_child(w_simple(r_word_equality()),
        w_word_refl()),w1(0,w_eq_level(a))),w_core(a,ns,rn)),w_core(l,ns,rn)),
    }
  }
  fn w_core_list(xs: List‹RC›, ns: ByteStream, rn: W) -> List‹W› {
    match load(xs) { ListNode.Nil => store(ListNode.Nil),
      ListNode.Cons(x,xs) => store(ListNode.Cons(w_core(x,ns,rn),w_core_list(xs,ns,rn))), }
  }
  fn w_user_entries(es: List‹REntry›, ns: ByteStream, rn: W) -> List‹W› {
    match load(es) {
      ListNode.Nil => store(ListNode.Nil),
      ListNode.Cons(REntry.Mk(kind,n,t,v),rest) =>
        let name = w_full(ns,n);
        let t = w_core(t,ns,rn);
        let v = w_core(v,ns,rn);
        let entry = match kind {
          0 => w7(101,name,w_nil(),t,v,w1(2,w_num(1)),w_num(0),w1(0,name)),
          1 => w5(102,name,w_nil(),t,v,w1(0,name)),
        };
        store(ListNode.Cons(entry,w_user_entries(rest,ns,rn))),
    }
  }
  fn w_rec_type(rn: W, a: W) -> W { w_app(w_const(rn,w_nil()),a) }
  fn w_motive_level() -> W { w1(4,w_simple(w_word_u_motive())) }
  fn w_motive_params() -> W { w1(0,w_simple(w_word_u_motive())) }
  fn w_motive_dom(rn: W) -> W { w_pi(0,w_rec_type(rn,w_var(0)),w1(1,w_motive_level())) }
  fn w_fields(kind: G, remaining: G, offset: G, body: W) -> W {
    match remaining {
      0 => body,
      _ => w_bind(kind,0,w_var(offset),w_fields(kind,remaining-1,offset+1,body)),
    }
  }
  fn w_var_args(f: W, remaining: G) -> W {
    match remaining { 0 => f, _ => w_var_args(w_app(f,w_var(remaining-1)),remaining-1), }
  }
  fn w_minor(rn: W, fields: G, offset: G) -> W {
    let ctor = w_var_args(w_app(w_const(w_child(rn,r_word_mk()),w_nil()),
      w_var(offset+fields)),fields);
    w_fields(5,fields,offset,w_app(w_var(offset+fields-1),ctor))
  }
  fn w_abbrev(name: W, params: W, t: W, v: W) -> W {
    w7(101,name,params,t,v,w0(1),w_num(0),w1(0,name))
  }
  fn w_rec_on(rn: W, n: G, cases: G) -> W {
    let dom = w_minor(rn,n,2);
    let t = w_pi(1,w_sort(1),w_pi(1,w_motive_dom(rn),
      w_pi(0,w_rec_type(rn,w_var(1)),w_pi(0,dom,w_app(w_var(2),w_var(1))))));
    let minor = match cases {
      0 => w_var(0),
      1 => w_fields(4,n,3,w_var_args(w_var(n),n)),
    };
    let call = w_app(w_app(w_app(w_app(w_const(w_child(rn,w_word_rec()),
      w1(0,w_motive_level())),w_var(3)),w_var(2)),minor),w_var(1));
    let v = w_lam(1,w_sort(1),w_lam(1,w_motive_dom(rn),
      w_lam(0,w_rec_type(rn,w_var(1)),w_lam(0,dom,call))));
    let suffix = match cases { 0 => w_word_recon(), 1 => w_word_caseson(), };
    w_abbrev(w_child(rn,suffix),w_motive_params(),t,v)
  }
  fn w_projections(rn: W, fields: List‹ByteStream›, idx: G) -> List‹W› {
    match load(fields) {
      ListNode.Nil => store(ListNode.Nil),
      ListNode.Cons(f,rest) =>
        let t = w_pi(1,w_sort(1),w_pi(0,w_rec_type(rn,w_var(0)),w_var(1)));
        let v = w_lam(1,w_sort(1),w_lam(0,w_rec_type(rn,w_var(0)),w3(10,rn,w_num(idx),w_var(0))));
        store(ListNode.Cons(w_abbrev(w_child(rn,f),w_nil(),t,v),w_projections(rn,rest,idx+1))),
    }
  }
  fn w_record_entries(rn: W, fields: List‹ByteStream›) -> List‹W› {
    let n = list_length(fields);
    let mk = w_child(rn,r_word_mk());
    let ind = w11(105,rn,w_nil(),w_pi(0,w_sort(1),w_sort(1)),w_num(1),w_num(0),
      w1(0,rn),w1(0,mk),w_num(0),w_num(0),w_num(0),w_num(0));
    let ct = w_pi(1,w_sort(1),w_fields(5,n,0,w_rec_type(rn,w_var(n))));
    let ctor = w8(106,mk,w_nil(),ct,rn,w_num(0),w_num(1),w_num(n),w_num(0));
    let minor = w_minor(rn,n,1);
    let rt = w_pi(1,w_sort(1),w_pi(1,w_motive_dom(rn),w_pi(0,minor,
      w_pi(0,w_rec_type(rn,w_var(2)),w_app(w_var(2),w_var(0))))));
    let rule = w_lam(0,w_sort(1),w_lam(0,w_motive_dom(rn),w_lam(0,minor,
      w_fields(4,n,2,w_var_args(w_var(n),n)))));
    let rec = w11(107,w_child(rn,w_word_rec()),w_motive_params(),rt,w1(0,rn),
      w_num(1),w_num(0),w_num(1),w_num(1),w1(0,w3(0,mk,w_num(n),rule)),w_num(0),w_num(0));
    let it = w_pi(1,w_sort(1),w_pi(0,w_rec_type(rn,w_var(0)),w_const(w_simple(w_word_nat()),w_nil())));
    let iv = w_lam(1,w_sort(1),w_lam(0,w_rec_type(rn,w_var(0)),w1(7,w_num(0))));
    let idx = w_abbrev(w_child(rn,w_word_ctoridx()),w_nil(),it,iv);
    let xs = w_projections(rn,fields,0);
    let xs = store(ListNode.Cons(idx,xs));
    let xs = store(ListNode.Cons(w_rec_on(rn,n,1),xs));
    let xs = store(ListNode.Cons(w_rec_on(rn,n,0),xs));
    store(ListNode.Cons(ind,store(ListNode.Cons(ctor,store(ListNode.Cons(rec,xs))))))
  }
  fn w_parse(src: ByteStream) -> RModule {
    let (ns, ts) = r_name(r_expect(r_lex(src), 300));
    let (name, ts) = r_name(r_expect(ts, 302));
    let (param, ts) = r_name(r_expect(ts, 40));
    let ts = r_expect(r_expect(r_expect(ts, 58), 306), 41);
    let ts = r_expect(r_expect(r_expect(ts, 58), 306), 303);
    let (fields, ts) = r_record_fields(ts, param);
    let ListNode.Cons(_, _) = load(fields);
    let (decls, ts) = r_declarations(ts);
    let (endName, ts) = r_name(r_expect(ts, 301));
    -- Upstream ignores the optional end name; preserve that behavior.
    let ts = r_expect(ts, 0);
    let ListNode.Nil = load(ts);
    RModule.Mk(ns, RRecord.Mk(name, fields), decls)
  }
  fn w_elaborate(src: ByteStream) -> W {
    let m = w_parse(src);
    let RModule.Mk(ns,RRecord.Mk(n,fields),_) = m;
    let rn = w_full(ns,n);
    let es = r_elaborate(m);
    let declarations = list_concat(w_record_entries(rn,fields),w_user_entries(es,ns,rn));
    w_node(0,w_merge(w_seed(),w_sort_entries(declarations)))
  }
  fn matched_export(digest: [U8;32]) -> W {
    w_elaborate(r_source(digest))
  }
  pub fn matched_frontend(digest: [U8;32]) -> G {
    let actual = w_elaborate(r_source(digest));
    assert_eq!(w_eq(actual,w_expected()),1,"full constant environment mismatch");
    1
  }
⟧

def toplevel : Except String Aiur.Source.Toplevel := do
  let tl ← (Aiur.Library.core.merge Aiur.Library.byteStream).mapError toString
  let tl ← (tl.merge Aiur.Library.blake3).mapError toString
  let tl ← (tl.merge FrontendRawBench.frontend).mapError toString
  let tl ← (tl.merge implementation).mapError toString
  let tl ← (tl.merge FrontendMatchedData.aiurData).mapError toString
  return tl.prune [`matched_frontend, `matched_export]
end FrontendMatchedRaw
