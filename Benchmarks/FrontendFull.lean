import Ix.Frontend
import Benchmarks.FrontendRepresentative

/-! Full repository ElabClaim predicate, including source/syntax hashing,
Ixon compilation, and serialized-environment hashing. Kernel admission is a
separate CheckEnv claim and is not included in this computation.
The three public commitments below are generated by the upstream frontend.
-/
namespace FrontendFull
def sourceAddr : Address := ⟨⟨#[119, 119, 134, 192, 59, 186, 35, 189, 135, 48, 221, 255, 111, 72, 71, 33, 75, 199, 45, 33, 239, 24, 91, 79, 143, 18, 207, 49, 214, 242, 53, 116]⟩⟩
def syntaxAddr : Address := ⟨⟨#[180, 50, 225, 239, 46, 57, 91, 135, 42, 211, 159, 207, 42, 124, 156, 36, 84, 110, 138, 17, 168, 126, 254, 182, 104, 244, 11, 178, 157, 94, 139, 232]⟩⟩
def envAddr : Address := ⟨⟨#[175, 67, 11, 46, 51, 136, 190, 32, 49, 208, 220, 109, 212, 177, 251, 194, 68, 123, 100, 23, 239, 129, 127, 142, 193, 136, 46, 177, 250, 127, 18, 225]⟩⟩
def claim : Ix.ElabClaim := { ctx := default, sourceAddr, syntaxAddr, envAddr }
def check (src : String) : Bool :=
  match Ix.Frontend.verifyElabClaimPure claim src with
  | .ok result => result
  | .error _ => false
def input : Bool := check FrontendRepresentative.sourceText
end FrontendFull
