/-- The mini tier's root modules (fixtures + spine + Mathlib + FLT). -/
def catalogMiniRootModules : Array Lean.Name := #[
    `Cli,
    `LeanSearchClient,
    `Plausible,
    `ProofWidgets,
    `Qq,
    `FixtureB,
    `Batteries,
    `Aesop,
