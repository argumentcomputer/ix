module

public import Benchmarks.TruthMinesSpec.Validate

@[expose] public section

namespace TruthMinesSpec

/-! Deterministic projections of the typed records into the nested corpus
workspace `Benchmarks/TruthMines/` and into `ix catalog` inputs. The rendered
strings are the whole contract: `lake exe truthmines gen` writes them,
`gen --check` (and the fast `truthmines-spec` suite) asserts byte-idempotence
against the files on disk. `lake-manifest.json` is Lake's own lockfile, ported
once and thereafter maintained by Lake — it is pin-checked against the
records, not rendered. -/

def workspaceDir : System.FilePath := "Benchmarks" / "TruthMines"

def workspaceLakefilePath : System.FilePath := workspaceDir / "lakefile.lean"

def workspaceToolchainPath : System.FilePath := workspaceDir / "lean-toolchain"

def workspaceManifestPath : System.FilePath := workspaceDir / "lake-manifest.json"

def generatedHeader : String :=
  "/- GENERATED by `lake exe truthmines gen` from `Benchmarks.TruthMinesSpec`; \
do not edit. -/"

def renderRequire (spec : PackageSpec) : String :=
  match spec.source with
  | .local path => s!"require «{spec.lakeName}» from \"{path}\""
  | .git source =>
    let base := s!"require «{spec.lakeName}» from git \"{source.url}\" @ \"{source.rev}\""
    match source.subdir? with
    | some subdir => s!"{base} / \"{subdir}\""
    | none => base

/-- The workspace `lakefile.lean`: the admitted requires in admission-spec
(dependency) order, the catalog root modules, and the `catalogOleans`
default target — fetch every root `.olean` without ever combining the
unqualified environments into one Lake library (colliding source names must
never meet before `ix catalog` qualifies them). -/
def renderWorkspaceLakefile
    (specs : Array PackageSpec := catalog)
    (admission : CatalogSpecProjection := catalogSpec) : String :=
  let requires := admittedInSpecOrder specs admission |>.map renderRequire
  let roots := admission.rootModules.map fun root =>
    s!"    `{root.toString (escape := true)}"
  String.intercalate "\n" ([
    generatedHeader,
    "import Lake",
    "",
    "open Lake DSL",
    "open System",
    "",
    "package truthmines where",
    "  version := v!\"0.1.0\"",
    "  leanOptions := #[⟨`warningAsError, false⟩]",
    ""
  ] ++ requires.toList ++ [
    "",
    "/-- Every catalog root module, in admission-spec order. These are the",
    "modules `ix catalog` loads: it imports each member's roots with ix's own",
    "Lean runtime, so all Lake has to do is make the `.olean`s exist; Lake",
    "computes their transitive closure itself. -/",
    "def catalogRootModules : Array Lean.Name := #["
  ] ++ [String.intercalate ",\n" roots.toList] ++ [
    "]",
    "",
    "/-- Build every catalog root `.olean`. This is the whole Lean-side build:",
    "the union environment is assembled by `ix catalog`, in one process, from",
    "these artifacts. -/",
    "@[default_target]",
    "target catalogOleans : Unit := do",
    "  let jobs ← catalogRootModules.mapM fun moduleName => do",
    "    let some sourceModule ← findModule? moduleName",
    "      | error s!\"catalog root module `{moduleName}` is not in the workspace\"",
    "    sourceModule.olean.fetch",
    "  (Job.collectArray jobs \"catalog root oleans\").mapM fun _ => return ()",
    ""
  ])

/-- The workspace toolchain is ix's own — derived, never authored. -/
def renderWorkspaceToolchain : String := expectedToolchain ++ "\n"

/-- The `ix catalog --spec` JSON for the admission spec. Rendered to a temp
file at invocation time; the typed records stay the only checked-in
representation. -/
def renderSpecJson (admission : CatalogSpecProjection := catalogSpec) : String :=
  (Lean.Json.mkObj [
    ("prefix", Lean.Json.str (admission.catalogPrefix.toString (escape := false))),
    ("libs", Lean.Json.arr <| admission.libs.map fun lib =>
      Lean.Json.mkObj [
        ("qualifier", Lean.Json.str (lib.qualifier.toString (escape := false))),
        ("roots", Lean.Json.arr <| lib.roots.map fun root =>
          Lean.Json.str (root.toString (escape := false))) ]) ]).pretty

/-- Full-hex pins recorded per package name, for cross-checking Lake's
lockfile against the records. -/
def recordPins (specs : Array PackageSpec := catalog)
    (admission : CatalogSpecProjection := catalogSpec) :
    Array (String × String) :=
  admittedInSpecOrder specs admission |>.filterMap fun spec =>
    match spec.source with
    | .git source => some (spec.lakeName, source.rev)
    | .local _ => none

end TruthMinesSpec
