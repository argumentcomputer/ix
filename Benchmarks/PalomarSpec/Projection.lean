module

public import Benchmarks.PalomarSpec.Validate

@[expose] public section

namespace PalomarSpec

/-- Palomar entries intentionally build in separate workspaces: nearly every
project owns modules named `Challenge` and `Solution`. The anonymous `.ixe`
pieces are the composition boundary, so no source-module collision is needed. -/
def workspaceDir : System.FilePath := "Benchmarks" / "Palomar"

def coreWorkspaceDir : System.FilePath := workspaceDir / "Core"

def entryWorkspaceDir (entry : Entry) : System.FilePath :=
  workspaceDir / "Entries" / entry.qualifier.toString (escape := false)

def entryDriverPath (entry : Entry) : System.FilePath :=
  entryWorkspaceDir entry / "Driver.lean"

def entryManifestPath (entry : Entry) : System.FilePath :=
  entryWorkspaceDir entry / "lake-manifest.json"

def generatedHeader : String :=
  "/- GENERATED by `lake exe palomar gen` from `Benchmarks.PalomarSpec`; \
do not edit. -/"

def tomlGeneratedHeader : String :=
  "# GENERATED by `lake exe palomar gen` from `Benchmarks.PalomarSpec`; do not edit."

/-- The common compatibility spine made available to every isolated wrapper.
The projects retain their exact upstream commit and metadata, while their
verified solution is elaborated on ix's Lean/Mathlib version because `.olean`
files loaded by `ix compile` must match ix's runtime. -/
def compatibilityNames : Array String := #[
  "mathlib", "plausible", "LeanSearchClient", "importGraph",
  "proofwidgets", "aesop", "Qq", "batteries", "Cli"
]

def expectedToolchain : String := s!"leanprover/lean4:v{Lean.versionString}"

def compatibilityMathlibUrl : String :=
  "https://github.com/leanprover-community/mathlib4"

def compatibilityMathlibRevision : String :=
  "db584cd6d46c92f209a44c0f1c829460d327499d"

def renderCoreLakefile : String :=
  String.intercalate "\n" [
    tomlGeneratedHeader,
    "name = \"PalomarCore\"",
    "version = \"0.1.0\"",
    "",
    "[[require]]",
    "name = \"mathlib\"",
    s!"git = \"{compatibilityMathlibUrl}\"",
    s!"rev = \"{compatibilityMathlibRevision}\"",
    ""
  ]

def renderEntryLakefile (entry : Entry) : String :=
  let q := entry.qualifier.toString (escape := false)
  let rootRequire := [
    "[[require]]",
    s!"name = \"{q}\"",
    s!"git = \"{entry.source.url}\"",
    s!"rev = \"{entry.source.rev}\""
  ] ++ match entry.source.subdir? with
    | some subdir => [s!"subDir = \"{subdir}\""]
    | none => []
  let compatibilityRequires := compatibilityNames.toList.flatMap fun name => [
    "",
    "[[require]]",
    s!"name = \"{name}\"",
    s!"path = \"../../Core/.lake/packages/{name}\""
  ]
  String.intercalate "\n" ([
    tomlGeneratedHeader,
    s!"name = \"{q}Workspace\"",
    "version = \"0.1.0\"",
    s!"packagesDir = \"../../.lake/packages/{q}\"",
    "defaultTargets = [\"Driver\"]",
    "",
    "[[lean_lib]]",
    "name = \"Driver\"",
    "roots = [\"Driver\"]",
    ""
  ] ++ rootRequire ++ compatibilityRequires ++ [""])

def renderEntryDriver (entry : Entry) : String :=
  s!"{generatedHeader}\nimport {entry.solutionModule.toString (escape := false)}\n"

def renderToolchain : String := expectedToolchain ++ "\n"

structure GeneratedFile where
  path : System.FilePath
  content : String

def generatedFiles : Array GeneratedFile :=
  #[ { path := coreWorkspaceDir / "lakefile.toml", content := renderCoreLakefile },
     { path := coreWorkspaceDir / "lean-toolchain", content := renderToolchain } ] ++
  catalog.flatMap fun entry => #[
    { path := entryWorkspaceDir entry / "lakefile.toml",
      content := renderEntryLakefile entry },
    { path := entryWorkspaceDir entry / "lean-toolchain",
      content := renderToolchain },
    { path := entryDriverPath entry,
      content := renderEntryDriver entry }
  ]

def findGeneratedFile? (path : System.FilePath) : Option GeneratedFile :=
  generatedFiles.find? (·.path == path)

end PalomarSpec
