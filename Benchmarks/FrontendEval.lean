/-!
Frontend execution experiments: interpreted Lean through `Claim.eval`, direct
Aiur, and supplemental native Lean. The interpreted path assumes the compiled
implementation's dependency frontier and role binding. Compilation, witness
construction, execution, and estimated FFT work are reported separately.
No separate kernel/resource admission is measured. No STARK is generated by
default; `--prove` applies only to the direct Aiur cases.

Usage:
  lake build bench-frontend-eval
  lake env .lake/build/bin/bench-frontend-eval all 3
  lake env .lake/build/bin/bench-frontend-eval direct 3 --prove
  lake env .lake/build/bin/bench-frontend-eval representative 1
  lake env .lake/build/bin/bench-frontend-eval raw 3 --prove
  lake env .lake/build/bin/bench-frontend-eval matched-direct 5 --prove
  lake env .lake/build/bin/bench-frontend-eval matched-native 5
  lake env .lake/build/bin/bench-frontend-eval full-native 5
  lake env .lake/build/bin/bench-frontend-eval full-host

The interpreted `matched-eval` case failed during execution under both 256 and
448 GiB virtual-memory caps; it did not reach proving. `matched` runs direct
Aiur followed by that expensive interpreted case. `full-eval` additionally
measures the full upstream ElabClaim predicate; no completed run is recorded.

The identity cases `parse`, `elab`, and `hinted` use the upstream test's focused
parser environment; `default` uses the standard parser environment. Those cases
disable prelude seeding because the source only needs Type. `representative`
uses the default parser and seeded core prelude on Fixtures/FrontendPair.ix.
`elab` and `hinted` compare the actual type and body,
not merely the presence of the resulting declaration. `parse` measures only
parsing and a declaration-count check. FFT costs are the repository's unpadded
work estimates, not measured proving time; dynamic cost excludes Bytes1/Bytes2.

The representative 319-byte fixture exercises a namespace, homogeneous record,
implicit/grouped binders, a forward reference, projections, let, record literals,
Eq/by rfl, and ownership metadata. `raw` checks a custom core subset.
`matched-direct` extends it with all 11 user/generated declarations and the
115-constant prelude, checking every alpha-canonical constant payload and
authenticating the source. Binder names and cached hashes are omitted.
It does NOT compile Ixon or compute syntax/serialized-environment commitments.
`full-native` and `full-eval` cover those additional stages; there is no full
direct Aiur counterpart yet. Native timings are not IxVM timings.

FrontendResults.json, FrontendRepresentativeResults.json and
FrontendRawResults.json preserve earlier measurement snapshots and their
original file hashes. FrontendExecutionResults.json records the expanded
workload, allocation failures and supplemental native runs. These boundaries
must not be mixed into a full-frontend speedup claim. Generated proof/VK/claim
files live under .lake/frontend-benchmark and are not checked in.
-/

namespace FrontendEvalBench

open Ix.Frontend Ix.Frontend.Parser Ix.Frontend.Elab
open IxVM.ClaimHarness

def sourceText : String := "def id (x : Type) : Type := x"

-- The same focused grammar environment as the upstream kernel-reduction test.
def parserEnv : IxParserEnv :=
  { tokens := Trie.ofSymbols ["(", ")", ":", ":="]
    keywords := (Trie.empty.insert "def" true).insert "Type" true
    operators := [] }

def expectedType : Ix.Expr :=
  Expr.mkForallE (Name.simple "x") (Expr.mkSort (Level.mkSucc Level.mkZero))
    (Expr.mkSort (Level.mkSucc Level.mkZero)) .default

def expectedValue : Ix.Expr :=
  Expr.mkLam (Name.simple "x") (Expr.mkSort (Level.mkSucc Level.mkZero))
    (Expr.mkBVar 0) .default

def correctEnv (env : IxElabEnv) : Bool :=
  match env.find? (Name.simple "id") with
  | some (.defnInfo d) => d.cnst.type == expectedType && d.value == expectedValue
  | _ => false

def parseCheck (src : String) : Bool :=
  match parseModuleWithEnv src "<bench>" parserEnv with
  | .ok (stx, _) => (Syntax.getArgs stx).size == 1
  | .error _ => false

def elabCheck (src : String) : Bool :=
  match do
    let (stx, _) ← parseModuleWithEnv src "<bench>" parserEnv
    elabModuleSyntax stx IxElabEnv.empty false
  with
  | .ok env => correctEnv env
  | .error _ => false

def hints : ElabHints := ElabHints.empty.insert {
  fullName := Name.simple "id", «type» := expectedType, value? := some expectedValue
}

def hintedCheck (src : String) : Bool :=
  match do
    let (stx, _) ← parseModuleWithEnv src "<bench>" parserEnv
    elabModuleWithHints stx hints IxElabEnv.empty false
  with
  | .ok env => correctEnv env
  | .error _ => false

def controlInput : Bool := true
def parseInput : Bool := parseCheck sourceText
def elabInput : Bool := elabCheck sourceText
def hintedInput : Bool := hintedCheck sourceText
def defaultInput : Bool :=
  match do
    let (stx, _) ← parseModuleWithEnv sourceText "<bench>" defaultParserEnv
    elabModuleSyntax stx IxElabEnv.empty false
  with
  | .ok env => correctEnv env
  | .error _ => false
def accepted : Bool := true

def emit (s : String) : IO Unit := do
  IO.println s
  (← IO.getStdout).flush

def report (label : String) (compiled : Aiur.CompiledToplevel)
    (shapes : Array Aiur.CircuitShape) (counts : Array Aiur.QueryCount)
    (elapsedNs : Nat) : IO Unit := do
  let stats := Aiur.computeStats compiled counts shapes
  let rows := counts.foldl (fun n c => n + c.uniqueRows) 0
  let hits := counts.foldl (fun n c => n + c.totalHits) 0
  let dynamicCost := stats.circuits.foldl (fun n c =>
    if c.name == "Bytes1" || c.name == "Bytes2" then n else n + c.fftCost) 0.0
  emit s!"RESULT case={label} exec_ns={elapsedNs} unique_rows={rows} total_hits={hits} fft_cost={stats.totalFftCost} dynamic_fft_cost={dynamicCost}"
  for c in stats.circuits[:10] do
    emit s!"  circuit={c.name} rows={c.height} width={c.width} fft_cost={c.fftCost}"

def directWitness (src : String) : Array Aiur.G × Aiur.IOBuffer :=
  let bytes := src.toUTF8
  let digest := (Address.blake3 bytes).hash.data.map Aiur.G.ofUInt8
  (digest, (default : Aiur.IOBuffer).extend 0 digest (bytes.data.map Aiur.G.ofUInt8))

def runDirect (repetitions : Nat) (prove : Bool) : IO Unit := do
  let tl ← IO.ofExcept FrontendDirectBench.toplevel
  let compiled ← IO.ofExcept tl.compile
  let system := Aiur.AiurSystem.build compiled.bytecode
    Aiur.defaultCommitmentParameters Aiur.defaultFriParameters
  let shapes := system.circuitShapes
  let some funIdx := compiled.getFuncIdx `direct_frontend
    | throw (IO.userError "direct_frontend missing")
  -- Differential checks on the supported grammar, including name resolution,
  -- token boundaries, trailing tokens, and malformed signatures.
  let corpus := [sourceText,
    "def id(y:Type):Type:=y", "\n def id ( value_1 : Type ) : Type := value_1\n",
    "def id (x : Type) : Type := y", "def id (x : Type) : Type := x x",
    "def other (x : Type) : Type := x", "defid(x:Type):Type:=x",
    "def id (x : Prop) : Type := x", "def id (Type : Type) : Type := Type",
    "def id (x : Type) : Type :=", "def id (x : Type) Type := x", ""]
  for src in corpus do
    let (input, witness) := directWitness src
    let actual := match compiled.bytecode.execute funIdx input witness with
      | .ok (out, _, _) => out == #[1]
      | .error _ => false
    unless actual == elabCheck src do
      throw (IO.userError s!"direct/Lean disagreement on {repr src}: direct={actual}")
  -- Reusing the honest digest with modified source bytes must fail.
  let (input, _) := directWitness sourceText
  let badWitness := (default : Aiur.IOBuffer).extend 0 input
    ((sourceText ++ " ").toUTF8.data.map Aiur.G.ofUInt8)
  if (compiled.bytecode.execute funIdx input badWitness).isOk then
    throw (IO.userError "direct frontend accepted a forged source digest")
  let nonBytes := (sourceText.toUTF8.data.map Aiur.G.ofUInt8)
    |>.modify 0 (· + 256) |>.modify 1 (· - 1)
  let badRange := (default : Aiur.IOBuffer).extend 0 input nonBytes
  if (compiled.bytecode.execute funIdx input badRange).isOk then
    throw (IO.userError "direct frontend accepted non-byte source cells")
  emit s!"DIRECT_CHECKS differential_cases={corpus.length} forged_digest=rejected non_bytes=rejected"
  let (input, witness) := directWitness sourceText
  let some hashIdx := compiled.getFuncIdx `direct_hash
    | throw (IO.userError "direct_hash missing")
  let start ← IO.monoNanosNow
  let (_, _, counts) ← IO.ofExcept (compiled.bytecode.execute hashIdx input witness)
  let stop ← IO.monoNanosNow
  report "direct-hash" compiled shapes counts (stop - start)
  for _ in [:repetitions] do
    let start ← IO.monoNanosNow
    let (out, _, counts) ← IO.ofExcept (compiled.bytecode.execute funIdx input witness)
    let stop ← IO.monoNanosNow
    unless out == #[1] do throw (IO.userError "direct frontend rejected source")
    report "direct" compiled shapes counts (stop - start)
  if prove then
    let start ← IO.monoMsNow
    let (claim, proof, _) ← IO.ofExcept (system.prove funIdx input witness)
    let proveMs := (← IO.monoMsNow) - start
    let start ← IO.monoMsNow
    let _ ← IO.ofExcept (system.verify claim proof)
    emit s!"PROOF case=direct prove_ms={proveMs} verify_ms={(← IO.monoMsNow) - start} bytes={proof.toBytes.size}"

def rawCorpus : List (String × String) := Id.run do
  let src := FrontendRepresentative.sourceText
  let theoremText := "theorem swap_fst {α : Type} (a b : α) :\n    Eq (swap (Pair.mk a b)).fst b := by\n  rfl\n\n"
  let triple := "namespace N\nstructure Triple (T : Type) : Type where\n  first : T\n  second : T\n  third : T\ntheorem rot_first {T : Type} (a b c : T) : Eq (rotate (Triple.mk a b c)).first b := by rfl\ndef rotate {T : Type} (p : Triple T) : Triple T := { third := p.first, first := p.second, second := p.third }\nend N"
  let single := "namespace N\nstructure Box (T : Type) : Type where\n  value : T\ndef extract {T : Type} (p : Box T) : T := p.value\ntheorem extract_value {T : Type} (x : T) : Eq (extract (Box.mk x)) x := by rfl\nend N"
  return [
    ("fixture", src),
    ("whitespace", src.replace " " "\t"),
    ("ascii-binders", src.replace "α" "T"),
    ("greek-binders", src.replace "α" "β"),
    ("renamed-local", (src.replace "(p :" "(q :").replace "p." "q."),
    ("split-binders", src.replace "(a b : α)" "(a : α) (b : α)"),
    ("record-order", src.replace "{ fst := p.snd, snd := x }" "{ snd := x, fst := p.snd }"),
    ("dependency-order", (src.replace theoremText "").replace "end Demo" (theoremText ++ "end Demo")),
    ("renamed-namespace", src.replace "Demo" "Example"),
    ("renamed-record", src.replace "Pair" "Duo"),
    ("renamed-fields", (src.replace "fst" "left").replace "snd" "right"),
    ("renamed-definition", src.replace "swap" "flip"),
    ("extra-definition", src.replace "end Demo"
      "def identity {α : Type} (x : α) : α := x\nend Demo"),
    ("other-true-theorem", src.replace ").fst b := by" ").snd a := by"),
    ("double-swap", src.replace "(swap (Pair.mk a b)).fst b" "(swap (swap (Pair.mk a b))).fst a"),
    ("nested-let", src.replace "let x := p.fst;" "let y := p; let x := y.fst;"),
    ("shadowed-let", src.replace "let x := p.fst;" "let p := p; let x := p.fst;"),
    ("one-field", single),
    ("three-fields", triple),
    ("three-fields-false-theorem", triple.replace ").first b :=" ").first a :="),
    ("unique-only-contract", src.replace "!1 x" "! x"),
    ("missing-result-contract", src.replace ") : ! α" ") : α"),
    ("missing-contract", src.replace "(!1 x : α) : ! α" "(x : α) : α"),
    ("different-body", src.replace "snd := x" "snd := p.snd"),
    ("false-theorem", src.replace ").fst b := by" ").fst a := by"),
    ("unbound-local", src.replace "snd := x" "snd := z"),
    ("unknown-field", src.replace "p.fst" "p.missing"),
    ("duplicate-field", src.replace "snd := x" "fst := x"),
    ("missing-field", src.replace ", snd := x" ""),
    ("ill-typed-field", src.replace "snd := x" "snd := Pair.mk x x"),
    ("trailing-token", src ++ "x"),
    ("missing-assignment", src.replace "let x :=" "let x :"),
    ("cycle", src.replace "let x := p.fst;\n  { fst := p.snd, snd := x }" "swap p"),
    ("mutual-cycle", (src.replace "let x := p.fst;\n  { fst := p.snd, snd := x }" "other p").replace
      "end Demo" "def other {α : Type} (p : Pair α) : Pair α := swap p\nend Demo")]

def runRaw (repetitions : Nat) (prove : Bool) : IO Unit := do
  let start ← IO.monoMsNow
  let tl ← IO.ofExcept FrontendRawBench.toplevel
  let compiled ← IO.ofExcept tl.compile
  let system := Aiur.AiurSystem.build compiled.bytecode
    Aiur.defaultCommitmentParameters Aiur.defaultFriParameters
  let shapes := system.circuitShapes
  emit s!"RAW_SYSTEM ms={(← IO.monoMsNow) - start} circuits={shapes.size}"
  let some funIdx := compiled.getFuncIdx `raw_frontend | throw (IO.userError "raw_frontend missing")
  let some validateIdx := compiled.getFuncIdx `raw_validate | throw (IO.userError "raw_validate missing")
  let some parseIdx := compiled.getFuncIdx `raw_parse | throw (IO.userError "raw_parse missing")
  let some hashIdx := compiled.getFuncIdx `raw_hash | throw (IO.userError "raw_hash missing")
  for (label, src) in rawCorpus do
    let (input, witness) := directWitness src
    let hostValid := (FrontendRepresentative.elaborate src).isOk
    let hostExpected := FrontendRepresentative.elabCheck src
    for (name, idx, expected) in [("validate", validateIdx, hostValid),
        ("expected-output", funIdx, hostExpected),
        ("parse", parseIdx, FrontendRepresentative.parseCheck src)] do
      let result := compiled.bytecode.execute idx input witness
      let actual := match result with | .ok (out, _, _) => out == #[1] | .error _ => false
      unless actual == expected do
        let details := match result with | .ok _ => "accepted" | .error e => e
        throw (IO.userError s!"raw/Lean disagreement: {label}/{name}: raw={actual}, Lean={expected}; {details}")
    emit s!"RAW_CHECK case={label} valid={hostValid} expected_output={hostExpected}"
  let src := FrontendRepresentative.sourceText
  let (input, witness) := directWitness src
  let badDigest := (default : Aiur.IOBuffer).extend 0 input
    ((src ++ " ").toUTF8.data.map Aiur.G.ofUInt8)
  let nonBytes := (src.toUTF8.data.map Aiur.G.ofUInt8) |>.modify 0 (· + 256) |>.modify 1 (· - 1)
  let badRange := (default : Aiur.IOBuffer).extend 0 input nonBytes
  for (label, bad) in [("forged-digest", badDigest), ("non-bytes", badRange)] do
    for idx in [hashIdx, parseIdx, validateIdx, funIdx] do
      if (compiled.bytecode.execute idx input bad).isOk then
        throw (IO.userError s!"raw accepted {label}")
  emit s!"RAW_CHECKS differential_cases={rawCorpus.length} forged_digest=rejected non_bytes=rejected"
  -- Deliberately stricter checks are reported separately from parity tests.
  -- `lean_accepts` refers only to frontend elaboration, not kernel validation.
  for (label, strict) in [
      ("namespace-mismatch", src.replace "end Demo" "end Other"),
      ("duplicate-declaration", src.replace "end Demo"
        "def keep {α : Type} (x : α) : α := x\nend Demo"),
      ("bad-universe", src.replace "end Demo"
        "theorem bad : Eq (Pair.mk Type Type).fst Type := by rfl\nend Demo"),
      ("non-proposition-theorem", src.replace "def keep" "theorem keep"),
      ("empty-module-outside-subset", "")] do
    let (strictInput, strictWitness) := directWitness strict
    if (compiled.bytecode.execute validateIdx strictInput strictWitness).isOk then
      throw (IO.userError s!"raw accepted {label}")
    emit s!"RAW_STRICT_CHECK case={label} raw_accepts=false lean_accepts={(FrontendRepresentative.elaborate strict).isOk}"
  for (label, idx) in [("raw-hash", hashIdx), ("raw-parse", parseIdx), ("raw-elab", funIdx)] do
    for _ in [:repetitions] do
      let start ← IO.monoNanosNow
      let (out, _, counts) ← IO.ofExcept (compiled.bytecode.execute idx input witness)
      let stop ← IO.monoNanosNow
      unless out == #[1] do throw (IO.userError s!"wrong {label} output")
      report label compiled shapes counts (stop - start)
  if prove then
    let start ← IO.monoMsNow
    let (claim, proof, _) ← IO.ofExcept (system.prove funIdx input witness)
    let proveMs := (← IO.monoMsNow) - start
    let start ← IO.monoMsNow
    let _ ← IO.ofExcept (system.verify claim proof)
    emit s!"PROOF case=raw-elab prove_ms={proveMs} verify_ms={(← IO.monoMsNow) - start} bytes={proof.toBytes.size}"

def runMatchedRaw (repetitions : Nat) (prove : Bool) : IO Unit := do
  let tl ← IO.ofExcept FrontendMatchedRaw.toplevel
  let start ← IO.monoMsNow
  let compiled ← IO.ofExcept tl.compile
  let system := Aiur.AiurSystem.build compiled.bytecode
    Aiur.defaultCommitmentParameters Aiur.defaultFriParameters
  let shapes := system.circuitShapes
  emit s!"MATCHED_SYSTEM ms={(← IO.monoMsNow) - start} circuits={shapes.size}"
  let some idx := compiled.getFuncIdx `matched_frontend | throw (IO.userError "matched_frontend missing")
  let decls ← IO.ofExcept (tl.mkDecls.mapError toString)
  let corpus := rawCorpus ++ [("namespace-end-compatibility",
    FrontendRepresentative.sourceText.replace "end Demo" "end Other")]
  let mut validSources := 0
  for (label, src) in corpus do
    -- Compare actual complete output, including outputs unlike the fixture.
    -- This catches hard-coded record names, arities, fields and recursor rules.
    let valid ← try FrontendMatchedTests.checkOutput decls src
      catch e => throw (IO.userError s!"{label}: {e}")
    if valid then validSources := validSources + 1
    let (input, witness) := directWitness src
    let result := compiled.bytecode.execute idx input witness
    let actual := match result with | .ok (out, _, _) => out == #[1] | .error _ => false
    let expected := FrontendMatched.check src (Address.blake3 src.toUTF8)
    unless actual == expected do
      throw (IO.userError s!"matched predicate disagreement on {label}: raw={actual}, Lean={expected}")
    emit s!"MATCHED_CHECK case={label} output_or_rejection_agreement=passed valid_source={valid} accepted={actual}"
  let src := FrontendRepresentative.sourceText
  let (input, witness) := directWitness src
  let forged := (default : Aiur.IOBuffer).extend 0 input ((src ++ " ").toUTF8.data.map Aiur.G.ofUInt8)
  let cells := (src.toUTF8.data.map Aiur.G.ofUInt8) |>.modify 0 (· + 256) |>.modify 1 (· - 1)
  let nonbytes := (default : Aiur.IOBuffer).extend 0 input cells
  for bad in [forged, nonbytes] do
    if (compiled.bytecode.execute idx input bad).isOk then
      throw (IO.userError "matched source authentication failed")
  if FrontendMatched.check (src ++ " ") FrontendMatchedData.sourceDigest then
    throw (IO.userError "Lean source authentication failed")
  emit s!"MATCHED_CHECKS cases={corpus.length} valid_sources={validSources} rejected_sources={corpus.length-validSources} constants=126 generated_user_constants=11 prelude_constants=115 forged_digest=rejected non_bytes=rejected"
  let cp := Aiur.defaultCommitmentParameters
  let fp := Aiur.defaultFriParameters
  emit s!"MATCHED_PARAMETERS log_blowup={cp.logBlowup} num_queries={fp.numQueries} query_pow_bits={fp.queryProofOfWorkBits} commit_pow_bits={fp.commitProofOfWorkBits} max_log_arity={fp.maxLogArity} log_final_poly_len={fp.logFinalPolyLen} cap_height={cp.capHeight}"
  for _ in [:repetitions] do
    let start ← IO.monoNanosNow
    let (out, _, counts) ← IO.ofExcept (compiled.bytecode.execute idx input witness)
    let stop ← IO.monoNanosNow
    unless out == #[1] do throw (IO.userError "matched raw output")
    report "matched-direct" compiled shapes counts (stop - start)
  if prove then
    let start ← IO.monoMsNow
    let (claim, proof, _) ← IO.ofExcept (system.prove idx input witness)
    let proveMs := (← IO.monoMsNow) - start
    let start ← IO.monoMsNow
    let _ ← IO.ofExcept (system.verify claim proof)
    let verifyMs := (← IO.monoMsNow) - start
    let proofBytes := proof.toBytes
    let path := ".lake/frontend-benchmark/matched-direct.proof"
    IO.FS.createDirAll ".lake/frontend-benchmark"
    IO.FS.writeBinFile path proofBytes
    IO.FS.writeBinFile ".lake/frontend-benchmark/matched-direct.vk" system.vkBytes
    IO.FS.writeFile ".lake/frontend-benchmark/matched-direct.claim.json"
      (Lean.toJson (claim.map fun g => g.val.toNat)).compress
    let decoded ← IO.ofExcept (Aiur.Proof.ofBytesChecked (← IO.FS.readBinFile path))
    let _ ← IO.ofExcept (system.verify claim decoded)
    emit s!"PROOF case=matched-direct prove_ms={proveMs} verify_ms={verifyMs} bytes={proofBytes.size} saved={path} roundtrip_verified=true"

-- Runtime file input keeps the native benchmark from reducing a closed fixture
-- to a cached result. Each iteration invokes the full predicate afresh.
def runNative (full : Bool) (repetitions : Nat) : IO Unit := do
  let src ← IO.FS.readFile "Benchmarks/Fixtures/FrontendPair.ix"
  let label := if full then "full-native" else "matched-native"
  let check := if full then FrontendFull.check else
    fun src => FrontendMatched.check src FrontendMatchedData.sourceDigest
  unless check src do throw (IO.userError s!"{label} warm-up rejected source")
  unless !(check (src ++ " ")) do throw (IO.userError s!"{label} accepted wrong source digest")
  for i in [:repetitions] do
    let start ← IO.monoNanosNow
    let accepted := check src
    let elapsed := (← IO.monoNanosNow) - start
    unless accepted do throw (IO.userError s!"{label} rejected source")
    emit s!"NATIVE case={label} iteration={i+1} exec_ns={elapsed} accepted=true"

def run (args : List String) : IO Unit := do
  let selected := args.headD "all"
  if selected == "full-host" then
    IO.FS.createDirAll ".lake/frontend-benchmark"
    let start ← IO.monoMsNow
    let (claim, stx, env, ixe) ← IO.ofExcept
      (Ix.Frontend.mkElabClaimFromSource FrontendRepresentative.sourceText)
    FrontendFullExport.write stx ixe
    let bytes ← IO.ofExcept (Ixon.serEnv ixe)
    emit s!"FULL_HOST ms={(← IO.monoMsNow)-start} constants={env.constOrder.length} ixon_constants={ixe.consts.size} bytes={bytes.size}"
    emit s!"FULL_DIGESTS source={claim.sourceAddr} syntax={claim.syntaxAddr} env={claim.envAddr}"
    IO.FS.writeBinFile ".lake/frontend-benchmark/full.ixe" bytes
    IO.FS.writeFile ".lake/frontend-benchmark/full-digests.json" (Lean.Json.mkObj [
      ("source",Lean.toJson (claim.sourceAddr.hash.data.map UInt8.toNat)),
      ("syntax",Lean.toJson (claim.syntaxAddr.hash.data.map UInt8.toNat)),
      ("env",Lean.toJson (claim.envAddr.hash.data.map UInt8.toNat))]).compress
    return
  let repetitions := (args[1]?.bind String.toNat?).getD 1
  unless repetitions > 0 do throw (IO.userError "repetitions must be positive")
  if selected == "matched-native" || selected == "full-native" then
    runNative (selected == "full-native") repetitions
    return
  if selected == "matched" || selected == "matched-direct" then
    runMatchedRaw repetitions (args.contains "--prove")
    if selected == "matched-direct" then return
  let selected := if selected == "matched" then "matched-eval" else selected
  if selected == "raw" then
    runRaw repetitions (args.contains "--prove")
    return
  if selected == "direct" then
    runDirect repetitions (args.contains "--prove")
    return
  let representative := selected.startsWith "representative" || selected == "matched-eval" || selected == "full-eval"
  let cases : List (String × Lean.Name) := [
    ("control", ``controlInput), ("parse", ``parseInput),
    ("elab", ``elabInput), ("hinted", ``hintedInput), ("default", ``defaultInput),
    ("representative-parse", ``FrontendRepresentative.parseInput),
    ("representative-elab", ``FrontendRepresentative.elabInput),
    ("matched-eval", ``FrontendMatched.input), ("full-eval", ``FrontendFull.input)]
  let cases := cases.filter fun (label, _) => selected == label ||
    (selected == "all" && !label.startsWith "representative" && !label.startsWith "matched" && !label.startsWith "full") ||
    (selected == "representative" && label.startsWith "representative")
  unless !cases.isEmpty do throw (IO.userError "unknown benchmark case")
  let src := if representative then FrontendRepresentative.sourceText else sourceText
  emit s!"source={repr src} bytes={src.utf8ByteSize} repetitions={repetitions}"
  if representative then
    for mutant in [src.replace "snd := x" "snd := p.snd",
        src.replace "(!1 x : α) : ! α" "(x : α) : α",
        src.replace ").fst b := by" ").fst a := by"] do
      if FrontendRepresentative.elabCheck mutant then
        throw (IO.userError "representative output check accepted a mutated program")
    emit "REPRESENTATIVE_CHECKS wrong_body=rejected missing_contract=rejected false_theorem=rejected"
  let checks := if selected == "full-eval" then [("full-eval", FrontendFull.check)]
    else if selected == "matched-eval" then [("matched-eval", fun src =>
      FrontendMatched.check src FrontendMatchedData.sourceDigest)]
    else if representative then
      [("representative-parse", FrontendRepresentative.parseCheck),
       ("representative-elab", FrontendRepresentative.elabCheck)]
    else [("parse", parseCheck), ("elab", elabCheck), ("hinted", hintedCheck)]
  for (label, check) in checks do
    let start ← IO.monoNanosNow
    unless check src do throw (IO.userError s!"host {label} rejected source")
    let stop ← IO.monoNanosNow
    emit s!"HOST case={label} ns={stop - start}"
  if args.contains "--host-only" then return
  emit "Building IxVM system..."
  let start ← IO.monoMsNow
  let tl ← IO.ofExcept (IxVM.ixVM.mapError toString)
  let compiled ← IO.ofExcept tl.compile
  let compiled ← IO.ofExcept (compiled.groupFunctions IxVM.functionGroups)
  let system := Aiur.AiurSystem.build compiled.bytecode
    Aiur.defaultCommitmentParameters Aiur.defaultFriParameters
  let shapes := system.circuitShapes
  emit s!"SYSTEM ms={(← IO.monoMsNow) - start} circuits={shapes.size}"
  let leanEnv ← get_env!
  let start ← IO.monoMsNow
  emit "Compiling frontend dependency closure to Ixon..."
  let env ← loadSharedIxonEnv (cases.toArray.map Prod.snd ++ #[``accepted] ++ synthesizedPrimNames) leanEnv
  emit s!"CLOSURE ms={(← IO.monoMsNow) - start} constants={env.consts.size}"
  let output ← lookupAddr env ``accepted
  let some funIdx := compiled.getFuncIdx `verify_claim
    | throw (IO.userError "verify_claim missing")
  for (label, name) in cases do
    let input ← lookupAddr env name
    let (baseClaim, trees) ← IO.ofExcept (shardCheckEnvClaimTrees env #[input])
    let .checkEnv ctx _ asm := baseClaim
      | throw (IO.userError "expected checkEnv frontier")
    let claim := Ix.Claim.eval { ctx with bindingAssumed := true } input output asm
    let start ← IO.monoMsNow
    let witness ← IO.ofExcept (buildClaimWitness env claim trees)
    emit s!"WITNESS case={label} ms={(← IO.monoMsNow) - start} input={input} output={output}"
    for i in [:repetitions] do
      emit s!"Executing {label}, iteration {i + 1}..."
      let start ← IO.monoNanosNow
      let (result, _, counts) ← IO.ofExcept
        (compiled.bytecode.execute funIdx witness.input witness.inputIOBuffer)
      let stop ← IO.monoNanosNow
      unless result.isEmpty do throw (IO.userError "unexpected verify_claim output")
      report label compiled shapes counts (stop - start)

end FrontendEvalBench

def main (args : List String) : IO Unit := FrontendEvalBench.run args
