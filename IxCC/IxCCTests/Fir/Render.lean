import IxCC.Anf.Syntax

/-! Anf programs as Lean source, for the kernel artifacts of the Phase 1
lowerings: `tests-fir --render-artifacts` prints
`IxCCTests/Fir/Artifacts.lean`, the pipeline's final Anf program of
each bench-k1 entry, which `IxCCTests.Fir.KernelEval` lowers to Cfg
inside the kernel and `tests-fir` compares with the live pipeline (so the
artifacts cannot go stale). Keys and contracts are rendered exactly. -/

namespace IxCCTests.Fir.Render

open IxCC

def list (xs : List String) : String := "[" ++ ", ".intercalate xs ++ "]"

def paren (s : String) : String := s!"({s})"

/-- A value's `repr` on one line (structure-instance fields must not start
left of the first field). -/
def flat {α : Type} [Repr α] (x : α) : String := (repr x).pretty 1000000

def optKey : Option Key.CtorKey → String
  | some k => s!"(some {paren (flat k)})"
  | none => "none"

def atom : Anf.Atom → String
  | .var i => s!"(.var {i})"
  | .lit (.nat n) => s!"(.lit (.nat {n}))"
  | .lit (.str s) => s!"(.lit (.str {flat s}))"
  | .box => ".box"

def atoms (as : List Anf.Atom) : String := list (as.map atom)

mutual

partial def exp : Anf.Exp → String
  | .bind c b e => s!"(.bind {paren (flat c)} {bind b} {exp e})"
  | .join n r b e => s!"(.join {n} {r} {exp b} {exp e})"
  | .jump j as => s!"(.jump {j} {atoms as})"
  | .case x alts d =>
    let as := alts.map fun | .mk k n b => s!".mk {paren (flat k)} {n} {exp b}"
    let dd := match d with
      | some e => s!"(some {exp e})"
      | none => "none"
    s!"(.case {atom x} {list as} {dd})"
  | .ret a => s!"(.ret {atom a})"
  | .tick e => s!"(.tick {exp e})"
  | .trap => ".trap"

partial def bind : Anf.Bind → String
  | .atom a => s!"(.atom {atom a})"
  | .con c as => s!"(.con {paren (flat c)} {atoms as})"
  | .proj c i x => s!"(.proj {paren (flat c)} {i} {atom x})"
  | .prim p as => s!"(.prim .{p.name} {atoms as})"
  | .glob g => s!"(.glob {g})"
  | .call g as => s!"(.call {g} {atoms as})"
  | .app f as => s!"(.app {atom f} {atoms as})"
  | .fn ps b => s!"(.fn {flat ps} {exp b})"

end

/-- An `Anf.Program` term. -/
def program (P : Anf.Program) : String :=
  let gs := P.globalList.map fun (g, gd) =>
    s!"    ({g}, \{\n      key := {flat gd.key},\n" ++
    s!"      ps := {flat gd.ps},\n      result := {flat gd.result},\n" ++
    s!"      body := {exp gd.body} })"
  let cs := P.ctors.map fun c =>
    s!"\{ key := {paren (flat c.key)}, tag := {c.tag}, arity := {c.arity} }"
  s!"  \{ globals := Src.NatMap.ofList [\n{",\n".intercalate gs}],\n    size := {P.size},\n" ++
  s!"    roots := {P.roots},\n    ctors := {list cs},\n" ++
  s!"    known := \{ natZero := {optKey P.known.natZero}, natSucc := {optKey P.known.natSucc}, " ++
  s!"boolFalse := {optKey P.known.boolFalse}, boolTrue := {optKey P.known.boolTrue} } }"

/-- The artifact module. -/
def module (entries : List (String × Anf.Program)) : String :=
  "import IxCC.Anf.Syntax\n\n" ++
  "/-! The pipeline's final Anf program of each bench-k1 entry, the input of the\n" ++
  "Phase 1 lowerings in the kernel (`IxCCTests.Fir.KernelEval`). Generated by\n" ++
  "`lake exe tests-fir --render-artifacts`; `tests-fir` checks it against the live\n" ++
  "pipeline. Do not edit. -/\n\n" ++
  "namespace IxCCTests.Fir.Artifacts\n\nopen IxCC\n\n" ++
  "set_option maxRecDepth 100000\n\n" ++
  String.join (entries.map fun (name, P) => s!"def {name} : Anf.Program :=\n{program P}\n\n") ++
  "end IxCCTests.Fir.Artifacts\n"

end IxCCTests.Fir.Render
