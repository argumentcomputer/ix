/-! The long sessions of `Machines.echo` (`fixtures/corpus/phase1-machines`)
and the transcripts Lean's interpreter printed for them.

The arguments are drawn from a fixed alphabet (printable ASCII without the
space, and six characters of two to four UTF-8 bytes) by a fixed linear
congruential generator, so each session's argument block has at least 600
bytes and the process makes more than 1,200 calls of the step. The
transcripts are the oracle driver's, from the family's directory:

```sh
lake exe tests-exe --session-lines | lean -Dlinter.all=false --run src/Machines.lean
```

which prints, per session, standard output and standard error in hex, the exit
status and the number of calls, tab-separated (`transcripts` below, in the
same order). Lean's interpreter shares no code with IxCC, its compiler or the
shell, and the platform model in the driver is written there in plain Lean,
apart from the model `IxCC.Exe.Machine.runFor`. -/

namespace IxCCTests.Exe.MachineSessions

/-- The alphabet: `!` to `~`, then `é`, `ü`, `λ`, `∀`, `→` and an emoji. -/
def alphabet : Array String :=
  ((List.range 94).map fun i => String.singleton (Char.ofNat (33 + i))).toArray ++
    #["é", "ü", "λ", "∀", "→", "😀"]

/-- `length` characters from seed `seed`. -/
def word (seed length : Nat) : String := Id.run do
  let mut x := seed
  let mut out := ""
  for _ in List.range length do
    x := (x * 6364136223846793005 + 1442695040888963407) % 2 ^ 64
    out := out ++ alphabet[(x / 2 ^ 33) % alphabet.size]!
  return out

/-- The sessions' argument lists: three arguments of 220 characters, and one
of 640. -/
def sessions : List (List String) :=
  [[word 1 220, word 2 220, word 3 220], [word 7 640]]

/-- The oracle driver's input. -/
def oracleLines : List String :=
  sessions.map fun args => " ".intercalate ("session" :: "Machines.echo" :: args)

/-- What the oracle printed, per session: standard output and standard error in
hex, the status, the number of calls. -/
def transcripts : List (String × String × Nat × Nat) :=
  [("",
    "0a0a0a", 213, 1535),
   ("",
    "0a", 202, 1432)]


end IxCCTests.Exe.MachineSessions
