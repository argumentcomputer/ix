/-! ## Pins from a role binding

The stated mapping from the certified kernel's roles (`Ix.Kernel.Role`) to the
identities IxCC pins. Each identity with a role takes the address the table
binds to it; one the table does not bind has no pin. `KernelFront.pinsOfTable`
applies it to the table the kernel admitted. -/

/-- The `Known` identities and their roles. -/
def knownRoles : List (String × Ix.Kernel.Role) :=
  [ ("Nat", .nat), ("Nat.zero", .natZero), ("Nat.succ", .natSucc), ("Nat.rec", .natRec),
    ("Bool", .bool), ("Bool.true", .boolTrue), ("Bool.false", .boolFalse), ("Eq", .eq),
    ("Decidable.isFalse", .decidableIsFalse), ("Decidable.isTrue", .decidableIsTrue) ]

/-- The primitive operations and their roles. -/
def primRoles : List (PrimOp × Ix.Kernel.Role) :=
  [ (.add, .natAdd), (.sub, .natSub), (.mul, .natMul), (.div, .natDiv), (.mod, .natMod),
    (.pow, .natPow), (.gcd, .natGcd), (.beq, .natBeq), (.ble, .natBle), (.land, .natLand),
    (.lor, .natLor), (.xor, .natXor), (.shiftLeft, .natShiftLeft),
    (.shiftRight, .natShiftRight), (.pred, .natPred) ]

/-- The standard axioms and their roles. -/
def stdAxiomRoles : List (String × Ix.Kernel.Role) :=
  [ ("propext", .propext), ("Quot.sound", .quotSound), ("Classical.choice", .choice) ]

/-- The primitive pinned at `a`, if any. -/
def primAt? (pins : Pins) (a : Ixon.Address) : Option PrimOp :=
  let n := addrNat a
  (pins.prims.find? (·.2 == n)).map (·.1)

/-! ## Resolving and checking the pinned identities -/

/-- Resolve the pinned constants present in a program, against its pins
(which it keeps). -/
def known (p : Program) : Known :=
  let pins := p.known.pins
  let at_ := fun (pin : Option Nat) => pin.bind fun n => p.lookup (addrOfNat n)
  { nat := at_ pins.nat, natZero := at_ pins.natZero, natSucc := at_ pins.natSucc
    natRec := at_ pins.natRec, bool := at_ pins.bool, boolTrue := at_ pins.boolTrue
    boolFalse := at_ pins.boolFalse, eq := at_ pins.eq, decIsFalse := at_ pins.decIsFalse
    decIsTrue := at_ pins.decIsTrue, pins }

theorem known_pins (p : Program) : (known p).pins = p.known.pins := rfl

/-- A `Known` entry names the constant pinned at `pin` (or is absent); an
entry without a pin names nothing. -/
def knownAt (p : Program) (pin : Option Nat) : Option CId → Bool
  | some c =>
    match pin with
    | some n => c < p.size && addrNat (p.addr c) == n
    | none => false
  | none => true

/-- Every constant `p.known` names is the one its pins name (kernel-evaluable;
the recheck path's check of what `known` resolved). -/
def knownOk (p : Program) : Bool :=
  let k := p.known
  let pins := k.pins
  knownAt p pins.nat k.nat && knownAt p pins.natZero k.natZero &&
  knownAt p pins.natSucc k.natSucc && knownAt p pins.natRec k.natRec &&
  knownAt p pins.bool k.bool && knownAt p pins.boolTrue k.boolTrue &&
  knownAt p pins.boolFalse k.boolFalse && knownAt p pins.eq k.eq &&
  knownAt p pins.decIsFalse k.decIsFalse && knownAt p pins.decIsTrue k.decIsTrue

end IxCC.Src.Pinned
