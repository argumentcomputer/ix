{
  "format": "ixcc/corpus/1",
  "family": "ownership",
  "description": "The ownership and usage-annotation suite, Phase 1 part (MT.7): each annotated program ix accepts, written with ix's contract syntax, with its plain twin (the annotated source with the contract atoms deleted), and the plain-only erasure and allocation fixtures. tests-own pairs the twins; ix's verdicts on the annotated sources it rejects are in verdicts.json.",
  "tier": "required",
  "phase": 1,
  "directory": "fixtures/ownership",
  "source_root": "fixtures/ownership/src",
  "lean": {
    "version": "4.34.1",
    "interpret": {
      "args": [
        "lean",
        "-Dlinter.all=false",
        "--run",
        "{src}",
        "{args}"
      ],
      "stdin": [
        "lean",
        "-Dlinter.all=false",
        "--run",
        "{src}",
        "<",
        "{ROOT ARGS lines}"
      ]
    }
  },
  "producer": {
    "ix": "the ix of this repository: lake build ix at the repository root, in its dev shell (not a Nix build)",
    "ix_version": "4.34.1|0.0.1",
    "anonymous": [
      "ix",
      "compile",
      "--no-build",
      "--consts",
      "{consts}",
      "--equations",
      "--anon",
      "--out",
      "{ixe}",
      "--equations-out",
      "{equations}",
      "{src}"
    ],
    "named": [
      "ix",
      "compile",
      "--no-build",
      "--consts",
      "{consts}",
      "--equations",
      "--out",
      "{named}",
      "--equations-out",
      "{named-equations}",
      "{src}"
    ],
    "address": [
      "ix",
      "addr-of",
      "--ixe",
      "{named}",
      "{name}"
    ]
  },
