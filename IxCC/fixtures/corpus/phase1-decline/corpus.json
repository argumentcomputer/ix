{
  "format": "ixcc/corpus/1",
  "family": "phase1-decline",
  "description": "The Phase 1 decline corpus (phase1.md MT.4): real Lean programs outside the Phase 1 fragment, each declined with its exact stage and code (closures, strings, six parameters, erasure and admission declines, the alloc.fallback wrong decline), and roots whose exported symbols collide when compiled together (stacking.symbols).",
  "tier": "required",
  "phase": 1,
  "directory": "fixtures/corpus/phase1-decline",
  "source_root": "fixtures/corpus/phase1-decline/src",
  "lean": {
    "version": "4.34.1",
    "interpret": {
      "args": [
        "lean",
        "-Dlinter.all=false",
        "--run",
        "{src}",
        "{args}"
      ],
      "stdin": [
        "lean",
        "-Dlinter.all=false",
        "--run",
        "{src}",
        "<",
        "{ROOT ARGS lines}"
      ]
    }
  },
  "producer": {
    "ix": "the ix of this repository: lake build ix at the repository root, in its dev shell (not a Nix build)",
    "ix_version": "4.34.1|0.0.1",
    "anonymous": [
      "ix",
      "compile",
      "--no-build",
      "--consts",
      "{consts}",
      "--equations",
      "--anon",
      "--out",
      "{ixe}",
      "--equations-out",
      "{equations}",
      "{src}"
    ],
    "named": [
      "ix",
      "compile",
      "--no-build",
      "--consts",
      "{consts}",
      "--equations",
      "--out",
      "{named}",
      "--equations-out",
      "{named-equations}",
      "{src}"
    ],
    "address": [
      "ix",
      "addr-of",
      "--ixe",
      "{named}",
      "{name}"
    ]
  },
