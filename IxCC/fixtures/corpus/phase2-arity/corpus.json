{
  "format": "ixcc/corpus/1",
  "family": "phase2-arity",
  "description": "Roots whose compiled arity is not their declared parameter count (docs/closures-design.md, Proof obligation): stored values with fewer or more leading lambdas than the type shows, erased leading parameters, a result type that is a definition of a function type, and table entries that change a root's arity. Not yet a registered family: the P8 end-to-end test reads it outside the production pipeline.",
  "tier": "required",
  "phase": 2,
  "directory": "fixtures/corpus/phase2-arity",
  "source_root": "fixtures/corpus/phase2-arity/src",
  "lean": {
    "version": "4.34.1",
    "interpret": {
      "args": [
        "lean",
        "-Dlinter.all=false",
        "--run",
        "{src}",
        "{args}"
      ],
      "stdin": [
        "lean",
        "-Dlinter.all=false",
        "--run",
        "{src}",
        "<",
        "{ROOT ARGS lines}"
      ]
    }
  },
  "producer": {
    "ix": "the ix of this repository: lake build ix at the repository root, in its dev shell (not a Nix build)",
    "ix_version": "4.34.1|0.0.1",
    "anonymous": [
      "ix",
      "compile",
      "--no-build",
      "--consts",
      "{consts}",
      "--equations",
      "--anon",
      "--out",
      "{ixe}",
      "--equations-out",
      "{equations}",
      "{src}"
    ],
    "named": [
      "ix",
      "compile",
      "--no-build",
      "--consts",
      "{consts}",
      "--equations",
      "--out",
      "{named}",
      "--equations-out",
      "{named-equations}",
      "{src}"
    ],
    "address": [
      "ix",
      "addr-of",
      "--ixe",
      "{named}",
      "{name}"
    ]
  },
