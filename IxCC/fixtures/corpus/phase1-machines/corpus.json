{
  "format": "ixcc/corpus/1",
  "family": "phase1-machines",
  "description": "Numeric state machines (standalone executables, X2): the IxccExe library (IxCC/lib/IxccExe.lean, verbatim at the head of the source) with fib as an executable whose parsing and rendering are Lean, first order and through a closure, the identity, a request outside the interface, and the session machine echo. Each root is a step Nat -> Nat -> Nat whose result packs the next state and a request.",
  "tier": "required",
  "phase": 1,
  "directory": "fixtures/corpus/phase1-machines",
  "source_root": "fixtures/corpus/phase1-machines/src",
  "lean": {
    "version": "4.34.1",
    "interpret": {
      "args": [
        "lean",
        "-Dlinter.all=false",
        "--run",
        "{src}",
        "{args}"
      ],
      "stdin": [
        "lean",
        "-Dlinter.all=false",
        "--run",
        "{src}",
        "<",
        "{ROOT ARGS lines}"
      ]
    }
  },
  "producer": {
    "ix": "the ix of this repository: lake build ix at the repository root, in its dev shell (not a Nix build)",
    "ix_version": "4.34.1|0.0.1",
    "anonymous": [
      "ix",
      "compile",
      "--no-build",
      "--consts",
      "{consts}",
      "--equations",
      "--anon",
      "--out",
      "{ixe}",
      "--equations-out",
      "{equations}",
      "{src}"
    ],
    "named": [
      "ix",
      "compile",
      "--no-build",
      "--consts",
      "{consts}",
      "--equations",
      "--out",
      "{named}",
      "--equations-out",
      "{named-equations}",
      "{src}"
    ],
    "address": [
      "ix",
      "addr-of",
      "--ixe",
      "{named}",
      "{name}"
    ]
  },
