{
  "format": "ixcc/corpus/1",
  "family": "phase2-closures",
  "description": "Higher-order workloads for P8 (docs/closures-design.md, Exit criteria): a closure that grows each iteration, dictionary-passing polymorphic recursion, a StateT-over-Except loop (with the library's bind, declined by register allocation, and with a bind written for the stack, within seven parameters), partial and over-application through a stored closure, and a fuel-indexed record of closures. Compiled through the closures step (the roots' entries and P8).",
  "tier": "required",
  "phase": 2,
  "directory": "fixtures/corpus/phase2-closures",
  "source_root": "fixtures/corpus/phase2-closures/src",
  "lean": {
    "version": "4.34.1",
    "interpret": {
      "args": [
        "lean",
        "-Dlinter.all=false",
        "--run",
        "{src}",
        "{args}"
      ],
      "stdin": [
        "lean",
        "-Dlinter.all=false",
        "--run",
        "{src}",
        "<",
        "{ROOT ARGS lines}"
      ]
    }
  },
  "producer": {
    "ix": "the ix of this repository: lake build ix at the repository root, in its dev shell (not a Nix build)",
    "ix_version": "4.34.1|0.0.1",
    "anonymous": [
      "ix",
      "compile",
      "--no-build",
      "--consts",
      "{consts}",
      "--equations",
      "--anon",
      "--out",
      "{ixe}",
      "--equations-out",
      "{equations}",
      "{src}"
    ],
    "named": [
      "ix",
      "compile",
      "--no-build",
      "--consts",
      "{consts}",
      "--equations",
      "--out",
      "{named}",
      "--equations-out",
      "{named-equations}",
      "{src}"
    ],
    "address": [
      "ix",
      "addr-of",
      "--ixe",
      "{named}",
      "{name}"
    ]
  },
