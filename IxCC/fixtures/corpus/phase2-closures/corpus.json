  "phase": 2,
  "directory": "fixtures/corpus/phase2-closures",
  "source_root": "fixtures/corpus/phase2-closures/src",
  "lean": {
    "version": "4.34.1",
    "interpret": {
      "args": [
        "lean",
        "-Dlinter.all=false",
        "--run",
        "{src}",
        "{args}"
      ],
      "stdin": [
        "lean",
        "-Dlinter.all=false",
        "--run",
        "{src}",
        "<",
        "{ROOT ARGS lines}"
      ]
    }
  },
