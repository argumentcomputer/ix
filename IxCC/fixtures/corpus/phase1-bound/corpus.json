      "args": [
        "lean",
        "-Dlinter.all=false",
        "--run",
        "{src}",
        "{args}"
      ],
      "stdin": [
        "lean",
        "-Dlinter.all=false",
        "--run",
        "{src}",
        "<",
        "{ROOT ARGS lines}"
      ]
    }
  },
