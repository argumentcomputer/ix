  "phase": 1,
  "directory": "fixtures/corpus/grounding",
  "source_root": "fixtures/corpus/grounding/src",
  "lean": {
    "version": "4.34.1",
    "interpret": {
      "args": [
        "lean",
        "-Dlinter.all=false",
        "--run",
        "{src}",
        "{args}"
      ],
      "stdin": [
        "lean",
        "-Dlinter.all=false",
        "--run",
        "{src}",
        "<",
        "{ROOT ARGS lines}"
      ]
    }
  },
  "producer": {
    "ix": "the ix of this repository: lake build ix at the repository root, in its dev shell (not a Nix build)",
    "ix_version": "4.34.1|0.0.1",
    "anonymous": [
      "ix",
      "compile",
      "--no-build",
      "--consts",
      "{consts}",
      "--equations",
      "--anon",
      "--out",
      "{ixe}",
      "--equations-out",
      "{equations}",
      "{src}"
    ],
    "named": [
      "ix",
      "compile",
      "--no-build",
      "--consts",
      "{consts}",
      "--equations",
      "--out",
      "{named}",
      "--equations-out",
      "{named-equations}",
      "{src}"
    ],
    "address": [
      "ix",
      "addr-of",
      "--ixe",
      "{named}",
      "{name}"
    ]
  },
