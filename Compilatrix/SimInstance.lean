import Compilatrix.EraseValidator
import Compilatrix.IxIR1.LowerStateSim
import Compilatrix.IxIR0.Mono

/-!
# The first theorem, applied

`erasure_sim` instantiated on a real program: `add 2̂ 3̂` over the
hand-written Nat store (the same shapes as the reference-evaluator
and differential suites). This file closes the loop between the
theorem and the executable pass:

- the proof-producing validator runs `Erase.eraseProgram`, checks a
  dependency-ordered coverage plan against that exact output, and
  returns a reusable database of `Covered` witnesses;
- `Covered` / `RecMember` / `RulesRel` / `PErase` derivations are
  generated by checked computation for every address and expression
  the program touches — including both recursor rules (`recurS`, the
  guarded ghost application, and the rule mask);
- the exact IxIR₁ `lowerAllAction` output is traced back to those source
  declarations and its lifted lambda, then sealed into source, generated,
  and higher-order application ownership contracts;
- the Ixon source run is pinned by an executable `#guard`, while `addSim`
  remains the general hypothesis-driven erasure theorem;
- the erased `add` run and the exact compiled IxIR₁ main are additionally
  certified by kernel-checked computation/trace lemmas, yielding a concrete
  `SemanticForwardSimulation` whose result realizes `5̂` through
  `ValueGraph`;
- a second fixture stores a definition behind a valid sharing table, runs the
  sharing-aware program and expression validators, and instantiates
  `erasure_sim_inlineSharing_closed`.
- a two-parameter `Pair.mk` fixture certifies the executable constructor drop
  spine and a projection from the resulting value.
- a one-parameter List-shaped fixture certifies a parameterized recursor,
  including its ghost parameter slot and a two-field constructor rule.
- a one-index family certifies a complete pre-major recursor spine whose
  source-only index is dropped before both evaluators fire on the major.

If any relation clause failed to cover what the eraser actually
emits, this file would not elaborate.
-/

namespace Compilatrix.SimInstance

open Compilatrix.Ixon (Uses Recursor RecursorRule MutConst Constant
  ConstantInfo)
open Compilatrix.Sim

private def addrOf (n : UInt8) : Ixon.Address :=
  Ixon.Address.replicate n

private def aNatBlock := addrOf 0x10
private def aNat := addrOf 0x11
private def aZero := addrOf 0x12
private def aSucc := addrOf 0x13
private def aNatRec := addrOf 0x14
private def aAdd := addrOf 0x15

/-! ## The source store (the reference-evaluator suite's shapes) -/

private def natInd : Compilatrix.Ixon.Inductive :=
  { isUnsafe := false, lvls := 0, params := 0, indices := 0
    typ := .sort 0
    ctors := #[
      { isUnsafe := false, lvls := 0, cidx := 0, params := 0, fields := 0
        typ := .recur 0 #[] },
      { isUnsafe := false, lvls := 0, cidx := 1, params := 0, fields := 1
        typ := .all .many .shared (.recur 0 #[]) (.recur 0 #[]) }] }

private def natRec : Recursor :=
  { k := false, isUnsafe := false, lvls := 1, params := 0, indices := 0
    motives := 1, minors := 2, typ := .sort 0
    rules := #[
      { fields := 0
        rhs := .lam .many (.sort 0) (.lam .many (.sort 0)
          (.lam .many (.sort 0) (.var 1))) },
      { fields := 1
        rhs := .lam .many (.sort 0) (.lam .many (.sort 0)
          (.lam .many (.sort 0) (.lam .many (.recur 0 #[])
            (.app (.app (.var 1) (.var 0))
              (.app (.app (.app (.app (.recur 1 #[0]) (.var 3)) (.var 2))
                (.var 1)) (.var 0)))))) }] }

private def cNatBlock : Constant :=
  { info := .muts #[.indc natInd, .recr natRec]
    sharing := #[], refs := #[], univs := #[.var 0] }

private def prjConst (info : ConstantInfo) : Constant :=
  { info, sharing := #[], refs := #[], univs := #[] }

private def cNat := prjConst (.iPrj { idx := 0, block := aNatBlock })
private def cZero :=
  prjConst (.cPrj { idx := 0, cidx := 0, block := aNatBlock })
private def cSucc :=
  prjConst (.cPrj { idx := 0, cidx := 1, block := aNatBlock })
private def cNatRec := prjConst (.rPrj { idx := 1, block := aNatBlock })

/-- `fun m n => Nat.rec.{1} (fun _ => Nat) m (fun k ih => succ ih) n` —
refs: 0 = Nat, 1 = zero, 2 = succ, 3 = Nat.rec. -/
private def cAdd : Constant :=
  { info := .defn
      { kind := .defn, safety := .safe, lvls := 0
        typ := .all .many .shared (.ref 0 #[])
          (.all .many .shared (.ref 0 #[]) (.ref 0 #[]))
        value := .lam .many (.ref 0 #[]) (.lam .many (.ref 0 #[])
          (.app (.app (.app (.app (.ref 3 #[0])
            (.lam .many (.ref 0 #[]) (.ref 0 #[])))
            (.var 1))
            (.lam .many (.ref 0 #[]) (.lam .many (.ref 0 #[])
              (.app (.ref 2 #[]) (.var 0)))))
            (.var 0))) }
    sharing := #[], refs := #[aNat, aZero, aSucc, aNatRec]
    univs := #[.succ .zero] }

private def storeL : List (Ixon.Address × Constant) :=
  [(aNatBlock, cNatBlock), (aNat, cNat), (aZero, cZero), (aSucc, cSucc),
   (aNatRec, cNatRec), (aAdd, cAdd)]

private def resolver : Ixon.Address → Option Constant := fun a =>
  (storeL.find? (fun p => p.1 == a)).map (·.2)

private def ectxI : Ixon.Eval.EvalCtx :=
  { resolve := resolver, natBlock := some aNatBlock }

/-! ## The erased environment, pinned to the executable pass -/

/-- Expected erasure of the successor rule's body. -/
private def succRuleBody' : IxIR0.Expr :=
  .app (.app (.var 1) (.var 0))
    (.app (.app (.app (.app (.var 4) .erased) (.var 2)) (.var 1))
      (.var 0))

/-- Expected erasure of `add`'s body: motive ghosted to `◻`, the
recursor referenced by address, the minor's lambdas kept. -/
private def addBody' : IxIR0.Expr :=
  .lam .many (.lam .many
    (.app
      (.app (.app (.app (.ref aNatRec) .erased) (.var 1))
        (.lam .many (.lam .many (.app (.ref aSucc) (.var 0)))))
      (.var 0)))

private def maNat := Erase.memberAddr aNatBlock 0
private def maNatRec := Erase.memberAddr aNatBlock 1

private def erasedList : List (Ixon.Address × IxIR0.Decl) :=
  [(maNat, .defn .shared .erased),
   (maNatRec, .recursor 3 true #[
     { fields := 0, rhs := .var 1 },
     { fields := 1, rhs := succRuleBody' }]),
   (aNat, .defn .shared .erased),
   (aZero, .ctor 0 0),
   (aSucc, .ctor 1 1),
   (aNatRec, .defn .shared (.ref maNatRec)),
   (aAdd, .defn .shared addBody')]

private def coverageOrder : List Ixon.Address :=
  [aZero, aSucc, aNatRec, aAdd]

-- This is both the executable-erasure equality check and the environment
-- adequacy check: success contains four kernel-checked `Covered` proofs.
#guard (match EraseValidator.certifyProgram ectxI storeL coverageOrder
    1000 1000 with
  | .ok cert => cert.target == erasedList && cert.coverage.length == 4
  | .error _ => false)

-- The schedule is a real certificate obligation: `add` cannot be checked
-- before the recursor and constructor facts its body references.
#guard (match EraseValidator.certifyProgram ectxI storeL [aAdd] 1000 1000 with
  | .error (.relation "reference lacks a Covered certificate") => true
  | _ => false)

private def ienv : IxIR0.Env := IxIR0.Env.ofList erasedList

private def ictxI : IxIR0.Ctx := { env := ienv }

/-! ## The program -/

/-- Evaluation frame: refs 0 = add, 1 = zero, 2 = succ. -/
private def testFI : Ixon.Eval.Frame :=
  { refs := #[aAdd, aZero, aSucc] }

private def natE : Nat → Ixon.Expr
  | 0 => .ref 1 #[]
  | n + 1 => .app (.ref 2 #[]) (natE n)

private def natE' : Nat → IxIR0.Expr
  | 0 => .ref aZero
  | n + 1 => .app (.ref aSucc) (natE' n)

private def addE : Ixon.Expr :=
  .app (.app (.ref 0 #[]) (natE 2)) (natE 3)

private def addE' : IxIR0.Expr :=
  .app (.app (.ref aAdd) (natE' 2)) (natE' 3)

/-! ## Generated coverage certificates -/

private theorem covZero : Covered ectxI ictxI aZero :=
  by
    apply EraseValidator.covered_of_validate (db := []) (fuel := 100)
    decide

private theorem covSucc : Covered ectxI ictxI aSucc :=
  by
    apply EraseValidator.covered_of_validate (db := []) (fuel := 100)
    decide

private theorem covNatRec : Covered ectxI ictxI aNatRec :=
  by
    apply EraseValidator.covered_of_validate (db := []) (fuel := 100)
    decide

private def addCoverage : EraseValidator.CoverageDB ectxI ictxI :=
  [{ address := aNatRec, covered := covNatRec },
   { address := aSucc, covered := covSucc }]

private theorem covAdd : Covered ectxI ictxI aAdd :=
  by
    apply EraseValidator.covered_of_validate
      (db := addCoverage) (fuel := 100)
    decide

/-! ## The instance -/

private def mainCoverage : EraseValidator.CoverageDB ectxI ictxI :=
  [{ address := aAdd, covered := covAdd },
   { address := aZero, covered := covZero },
   { address := aSucc, covered := covSucc }]

private def coverMain : EraseValidator.CoverOracle ectxI ictxI :=
  mainCoverage.oracle

private theorem addEDer : PErase ectxI ictxI none testFI.refs
    testFI.selfMuts testFI.selfAddr [] addE addE' :=
  by
    apply EraseValidator.related_of_validateExpr
      (cover := coverMain) (fuel := 100)
    decide

private def mainTables : Erase.ETables :=
  { refs := testFI.refs, selfMuts := testFI.selfMuts }

-- The proof-producing validator runs the executable eraser itself and
-- returns a `PErase` witness for that exact output, not a parallel fixture.
#guard (match EraseValidator.certifyExpr ectxI ictxI coverMain none
    mainTables testFI.selfAddr [] addE 100 100 with
  | .ok cert => cert.target == addE'
  | .error _ => false)

/-- **The first theorem, applied**: whenever the source `add 2̂ 3̂`
terminates (it does — the `#guard` below witnesses the hypothesis
executably; the fueled interpreters are well-founded definitions, so
runs are compiler facts, not kernel `rfl`s), its erasure terminates
under the IxIR₀ semantics with a related value. The content is the
coverage derivation `addEDer`: it elaborates only because the
relation covers exactly what the executable eraser emits. -/
theorem addSim {fuel : Nat} {v : Ixon.Eval.Value}
    (hev : Ixon.Eval.eval ectxI fuel testFI [] addE = .ok v) :
    ∃ fuel' v', IxIR0.eval ictxI fuel' [] addE' = .ok v' ∧
      ValRel ectxI ictxI v v' :=
  erasure_sim_closed hev addEDer

-- The hypothesis is inhabited: the source run computes `5̂`…
private def srcNatOf? : Nat → Ixon.Eval.Value → Option Nat
  | 0, _ => none
  | _, .ctorV _ _ 0 [] => some 0
  | f + 1, .ctorV _ _ 1 [v] => (srcNatOf? f v).map (· + 1)
  | _, _ => none

#guard (match Ixon.Eval.eval ectxI 1000 testFI [] addE with
  | .ok v => srcNatOf? 100 v == some 5
  | .error _ => false)

-- …and the erased run computes `5̂` on the target evaluator. The guard is
-- address-sensitive: every successor cell must carry the `succ`
-- constructor-projection address and the base cell the `zero` one — the
-- same source-pinned addresses `ValRel.ctorV`'s `CtorAddr` premise demands
-- (a wrong-family eraser would flunk this executably).
#guard (match IxIR0.eval ictxI 1000 [] addE' with
  | .ok (.ctor a5 1 [.ctor a4 1 [.ctor a3 1 [.ctor a2 1 [.ctor a1 1
      [.ctor a0 0 []]]]]]) =>
    a5 == aSucc && a4 == aSucc && a3 == aSucc && a2 == aSucc &&
      a1 == aSucc && a0 == aZero
  | _ => false)

/-! ## IxIR₁ compiler ownership-contract instance -/

section IxIR1CompilerContracts

open Compilatrix.IxIR1.LowerSim

@[simp] private theorem addrOf_eq_iff (left right : UInt8) :
    addrOf left = addrOf right ↔ left = right := by
  constructor
  · intro h
    have hget := congrArg
      (fun address : Ixon.Address => address.get ⟨0, by decide⟩) h
    simpa [addrOf] using hget
  · intro h
    subst right
    rfl

@[simp] private theorem memberAddr_ne_addrOf (idx : Nat) (byte : UInt8)
    (hne : byte ≠ 0x10) :
    Erase.memberAddr aNatBlock idx ≠ addrOf byte := by
  intro h
  have hget := congrArg
    (fun address : Ixon.Address => address.get ⟨0, by decide⟩) h
  have heq : (0x10 : UInt8) = byte := by
    simpa [aNatBlock, addrOf] using hget
  exact hne heq.symm

@[simp] private theorem addrOf_ne_synthAddr_zero (byte : UInt8)
    (hne : byte ≠ 0xFE) :
    addrOf byte ≠ IxIR1.Lower.synthAddr 0 := by
  intro h
  have hget := congrArg
    (fun address : Ixon.Address => address.get ⟨0, by decide⟩) h
  have heq : byte = 0xFE := by
    simpa [addrOf, IxIR1.Lower.synthAddr] using hget
  exact hne heq

@[simp] private theorem memberAddr_ne_synthAddr_zero (idx : Nat) :
    Erase.memberAddr aNatBlock idx ≠ IxIR1.Lower.synthAddr 0 := by
  intro h
  have hget := congrArg
    (fun address : Ixon.Address => address.get ⟨0, by decide⟩) h
  have heq : (0x10 : UInt8) = 0xFE := by
    simpa [aNatBlock, addrOf, IxIR1.Lower.synthAddr] using hget
  revert heq
  decide

@[simp] private theorem maNat_ne_maNatRec : maNat ≠ maNatRec := by
  intro h
  have hget := congrArg
    (fun address : Ixon.Address => address.get ⟨24, by decide⟩) h
  simp only [maNat, maNatRec, Erase.memberAddr_get,
    aNatBlock, addrOf, Ixon.Address.get_replicate] at hget
  revert hget
  decide

@[simp] private theorem memberAddr_zero_ne_one :
    Erase.memberAddr aNatBlock 0 ≠ Erase.memberAddr aNatBlock 1 := by
  simpa [maNat, maNatRec] using maNat_ne_maNatRec

@[simp] private theorem estateMapGet_run {error state result : Type}
    (f : state → result) (initial : state) :
    EStateM.run (f <$> (get : EStateM error state state)) initial =
      .ok (f initial) initial := by
  rfl

@[simp] private theorem estateMapModify_run {error state result : Type}
    (f : PUnit → result) (update : state → state) (initial : state) :
    EStateM.run (f <$> (modify update : EStateM error state PUnit)) initial =
      .ok (f ⟨⟩) (update initial) := by
  rfl

private theorem envOfList_some_mem {l : List (Ixon.Address × IxIR0.Decl)}
    {address : Ixon.Address} {source : IxIR0.Decl}
    (hsrc : IxIR0.Env.ofList l address = some source) :
    ∃ item ∈ l, item.1 = address ∧ item.2 = source := by
  unfold IxIR0.Env.ofList at hsrc
  cases hfind : l.find? (fun item => item.1 == address) with
  | none => simp [hfind] at hsrc
  | some item =>
    have hmember := List.mem_of_find?_eq_some hfind
    have hmatch := List.find?_some hfind
    simp only [hfind, Option.map_some, Option.some.injEq] at hsrc
    exact ⟨item, hmember, Ixon.Address.eq_of_beq hmatch, hsrc⟩

private theorem targetEnv_some_mem {l : List (Ixon.Address × IxIR1.Decl)}
    {address : Ixon.Address} {decl : IxIR1.Decl}
    (hsrc : IxIR1.Env.ofList l address = some decl) :
    ∃ item ∈ l, item.1 = address ∧ item.2 = decl := by
  unfold IxIR1.Env.ofList at hsrc
  cases hfind : l.find? (fun item => item.1 == address) with
  | none => simp [hfind] at hsrc
  | some item =>
    have hmember := List.mem_of_find?_eq_some hfind
    have hmatch := List.find?_some hfind
    simp only [hfind, Option.map_some, Option.some.injEq] at hsrc
    exact ⟨item, hmember, Ixon.Address.eq_of_beq hmatch, hsrc⟩

private theorem ienv_cases {address : Ixon.Address} {source : IxIR0.Decl}
    (hsrc : ienv address = some source) :
    (address = maNat ∧ source = .defn .shared .erased) ∨
    (address = maNatRec ∧ source = .recursor 3 true #[
      { fields := 0, rhs := .var 1 },
      { fields := 1, rhs := succRuleBody' }]) ∨
    (address = aNat ∧ source = .defn .shared .erased) ∨
    (address = aZero ∧ source = .ctor 0 0) ∨
    (address = aSucc ∧ source = .ctor 1 1) ∨
    (address = aNatRec ∧ source = .defn .shared (.ref maNatRec)) ∨
    (address = aAdd ∧ source = .defn .shared addBody') := by
  obtain ⟨item, hmember, haddress, hsource⟩ :=
    envOfList_some_mem (l := erasedList) hsrc
  simp only [erasedList, List.mem_cons] at hmember
  rcases hmember with h | h | h | h | h | h | h
  all_goals cases h
  all_goals simp_all

private def addAction :=
  IxIR1.Lower.lowerAllAction erasedList addE' .shared 100

private def addTargetDecls : List (Ixon.Address × IxIR1.Decl) :=
  match addAction.run {} with
  | .ok (decls, _) _ => decls
  | .error _ _ => []

private def addMainCode : IxIR1.Code :=
  match addAction.run {} with
  | .ok (_, code) _ => code
  | .error _ _ => .ret .erased

private def addFinalState : IxIR1.Lower.LowSt :=
  match addAction.run {} with
  | .ok _ state | .error _ state => state

private def addTargetCtx : IxIR1.Ctx :=
  { decls := IxIR1.Env.ofList addTargetDecls }

private def addExpectedLiftedDef : IxIR1.FnDef :=
  ⟨2, .shared,
    .letOp (.drop (.var 1))
      (.letOp (.alloc .shared (IxIR1.Lower.ctorIdOf aSucc 1) #[.var 1])
        (.ret (.var 0)))⟩

private def declOwnershipShape : IxIR1.Decl → Option (Nat × Ixon.Owned)
  | .fn d => some (d.arity, d.result)
  | .extern _ => none

private def targetOwnershipShapes
    (decls : List (Ixon.Address × IxIR1.Decl)) :=
  decls.map fun item => (item.1, declOwnershipShape item.2)

private theorem targetOwnershipShapes_addresses
    (decls : List (Ixon.Address × IxIR1.Decl)) :
    (targetOwnershipShapes decls).map Prod.fst = decls.map Prod.fst := by
  simp [targetOwnershipShapes, List.map_map, Function.comp_def]

/-- One kernel-reduced summary of the concrete lowering run. All subsequent
layout facts project from this theorem instead of re-running the compiler or
trusting native code generation. -/
private theorem addAction_facts :
    match addAction.run {} with
    | .ok (decls, _) state =>
      state.extra =
          [(IxIR1.Lower.synthAddr 0, .fn addExpectedLiftedDef)] ∧
        state.wrappers = [] ∧ state.fresh = 1 ∧
        targetOwnershipShapes decls =
          [(maNat, some (0, .shared)),
           (maNatRec, some (4, .shared)),
           (aNat, some (0, .shared)),
           (aNatRec, some (0, .shared)),
           (aAdd, some (2, .shared)),
           (IxIR1.Lower.synthAddr 0, some (2, .shared))]
    | .error _ _ => False := by
  simp [addAction, IxIR1.Lower.lowerAllAction, erasedList, addE', natE',
    succRuleBody', addBody', maNat, maNatRec, aNat, aZero, aSucc,
    aNatRec, aAdd, addExpectedLiftedDef, targetOwnershipShapes,
    declOwnershipShape, List.filterMapM, List.filterMapM.loop, List.filter,
    List.range, List.range.loop, IxIR1.Lower.lowerDecl,
    IxIR1.Lower.lowerFnBody, IxIR1.Lower.lowerRecursor,
    IxIR1.Lower.lowerRecursorRule, IxIR1.Lower.releaseSlots,
    IxIR1.Lower.parameterEntries, IxIR1.Lower.parameterDrops,
    IxIR1.Lower.lamUses, IxIR1.Lower.lamArity,
    IxIR1.Lower.stripLams, IxIR1.Lower.lowerE,
    IxIR1.Lower.countUses, IxIR1.Lower.recursorFieldRetains,
    IxIR1.Lower.applyRecursorFieldRetains,
    IxIR1.Lower.SlotDrop.offsetEntry, IxIR1.Lower.VEnv.setEntry,
    IxIR1.Lower.VEnv.bump, IxIR1.Lower.VEnv.rel,
    IxIR1.Lower.worldOfUses, IxIR1.Lower.requireResultWorld,
    IxIR1.Lower.lowerSpine, IxIR1.Lower.knownCall,
    IxIR1.Lower.lowerArgs, IxIR1.Lower.applyRest,
    IxIR1.Lower.lowerCaptures, IxIR1.Lower.lowerLam,
    IxIR1.Lower.freshAddr, IxIR1.Lower.pushExtra,
    IxIR1.Lower.papSafe, IxIR1.Lower.padWorlds,
    IxIR1.Lower.AVal.toAtom, IxIR1.Lower.emitOp,
    IxIR0.Env.ofList, bne]

private theorem targetEnv_lookup_of_mem_nodup
    {decls : List (Ixon.Address × IxIR1.Decl)}
    (hnodup : (decls.map Prod.fst).Nodup)
    {address : Ixon.Address} {decl : IxIR1.Decl}
    (hmember : (address, decl) ∈ decls) :
    IxIR1.Env.ofList decls address = some decl := by
  induction decls with
  | nil => simp at hmember
  | cons head tail ih =>
    rcases head with ⟨headAddress, headDecl⟩
    simp only [List.map_cons, List.nodup_cons] at hnodup
    simp only [List.mem_cons] at hmember
    cases hmember with
    | inl hhead =>
      cases hhead
      have hself : (address == address) = true := by
        change (address.hash.data == address.hash.data) = true
        exact (beq_iff_eq).mpr rfl
      simp [IxIR1.Env.ofList, hself]
    | inr htail =>
      have hne : headAddress ≠ address := by
        intro heq
        apply hnodup.1
        rw [heq]
        exact List.mem_map.mpr ⟨(address, decl), htail, rfl⟩
      have hbeq : (headAddress == address) = false := by
        cases heq : headAddress == address with
        | false => rfl
        | true => exact (hne (Ixon.Address.eq_of_beq heq)).elim
      simp only [IxIR1.Env.ofList, List.find?_cons, hbeq]
      exact ih hnodup.2 htail

private theorem sourceEnv_lookup_of_mem_nodup
    {decls : List (Ixon.Address × IxIR0.Decl)}
    (hnodup : (decls.map Prod.fst).Nodup)
    {address : Ixon.Address} {decl : IxIR0.Decl}
    (hmember : (address, decl) ∈ decls) :
    IxIR0.Env.ofList decls address = some decl := by
  induction decls with
  | nil => simp at hmember
  | cons head tail ih =>
    rcases head with ⟨headAddress, headDecl⟩
    simp only [List.map_cons, List.nodup_cons] at hnodup
    simp only [List.mem_cons] at hmember
    cases hmember with
    | inl hhead =>
      cases hhead
      have hself : (address == address) = true := by
        change (address.hash.data == address.hash.data) = true
        exact (beq_iff_eq).mpr rfl
      simp [IxIR0.Env.ofList, hself]
    | inr htail =>
      have hne : headAddress ≠ address := by
        intro heq
        apply hnodup.1
        rw [heq]
        exact List.mem_map.mpr ⟨(address, decl), htail, rfl⟩
      have hbeq : (headAddress == address) = false := by
        cases heq : headAddress == address with
        | false => rfl
        | true => exact (hne (Ixon.Address.eq_of_beq heq)).elim
      simp only [IxIR0.Env.ofList, List.find?_cons, hbeq]
      exact ih hnodup.2 htail

private def firstExtraFn : List (Ixon.Address × IxIR1.Decl) → IxIR1.FnDef
  | (_, .fn d) :: _ => d
  | _ => ⟨0, .shared, .ret .erased⟩

private def addLiftedDef : IxIR1.FnDef := firstExtraFn addFinalState.extra

private def SingletonFnAt (address : Ixon.Address) :
    List (Ixon.Address × IxIR1.Decl) → Prop
  | [(found, .fn _)] => found = address
  | _ => False

private def singletonFnAtB (address : Ixon.Address) :
    List (Ixon.Address × IxIR1.Decl) → Bool
  | [(found, .fn _)] => found == address
  | _ => false

private theorem singletonFnAt_of_beq {address : Ixon.Address}
    {extra : List (Ixon.Address × IxIR1.Decl)}
    (hshape : singletonFnAtB address extra = true) :
    SingletonFnAt address extra := by
  cases extra with
  | nil => simp [singletonFnAtB] at hshape
  | cons head rest =>
    rcases head with ⟨found, decl⟩
    cases rest with
    | nil =>
      cases decl with
      | extern arity => simp [singletonFnAtB] at hshape
      | fn d =>
        exact Ixon.Address.eq_of_beq (by
          simpa [singletonFnAtB] using hshape)
    | cons next tail => simp [singletonFnAtB] at hshape

private theorem eq_singletonFn_of_shape {address : Ixon.Address}
    {extra : List (Ixon.Address × IxIR1.Decl)}
    (hshape : SingletonFnAt address extra) :
    extra = [(address, .fn (firstExtraFn extra))] := by
  cases extra with
  | nil => simp [SingletonFnAt] at hshape
  | cons head rest =>
    rcases head with ⟨found, decl⟩
    cases rest with
    | nil =>
      cases decl with
      | extern arity => simp [SingletonFnAt] at hshape
      | fn d =>
        change found = address at hshape
        subst found
        rfl
    | cons next tail => simp [SingletonFnAt] at hshape

private theorem addAction_run : addAction.run {} =
    .ok (addTargetDecls, addMainCode) addFinalState := by
  have hfacts := addAction_facts
  cases hrun : addAction.run {} with
  | error error state => simp [hrun] at hfacts
  | ok result state =>
    rcases result with ⟨decls, code⟩
    simp [addTargetDecls, addMainCode, addFinalState, hrun]

private theorem addFinalState_extra : addFinalState.extra =
    [(IxIR1.Lower.synthAddr 0, .fn addLiftedDef)] := by
  have hfacts := addAction_facts
  rw [addAction_run] at hfacts
  have hextra := hfacts.1
  simpa [addLiftedDef, firstExtraFn, hextra] using hextra

private theorem addLiftedDef_eq_addExpected :
    addLiftedDef = addExpectedLiftedDef := by
  have hfacts := addAction_facts
  rw [addAction_run] at hfacts
  unfold addLiftedDef
  rw [hfacts.1]
  rfl

private theorem addTargetOwnershipShapes :
    targetOwnershipShapes addTargetDecls =
      [(maNat, some (0, .shared)),
       (maNatRec, some (4, .shared)),
       (aNat, some (0, .shared)),
       (aNatRec, some (0, .shared)),
       (aAdd, some (2, .shared)),
       (IxIR1.Lower.synthAddr 0, some (2, .shared))] := by
  have hfacts := addAction_facts
  rw [addAction_run] at hfacts
  exact hfacts.2.2.2

private theorem addTargetDecls_nodup :
    (addTargetDecls.map Prod.fst).Nodup := by
  have haddresses : addTargetDecls.map Prod.fst =
      [maNat, maNatRec, aNat, aNatRec, aAdd,
        IxIR1.Lower.synthAddr 0] := by
    rw [← targetOwnershipShapes_addresses]
    rw [addTargetOwnershipShapes]
    rfl
  rw [haddresses]
  simp [maNat, maNatRec, aNat, aNatRec, aAdd]

private theorem addLifted_lookup :
    addTargetCtx.decls (IxIR1.Lower.synthAddr 0) =
      some (.fn addLiftedDef) := by
  apply targetEnv_lookup_of_mem_nodup addTargetDecls_nodup
  apply IxIR1.LowerSim.lowerAllAction_extra_mem_result addAction_run
  rw [addFinalState_extra]
  simp

private theorem addTargetFn_of_shape
    {address : Ixon.Address} {arity : Nat} {result : Ixon.Owned}
    (hmember : (address, some (arity, result)) ∈
      [(maNat, some (0, .shared)),
       (maNatRec, some (4, .shared)),
       (aNat, some (0, .shared)),
       (aNatRec, some (0, .shared)),
       (aAdd, some (2, .shared)),
       (IxIR1.Lower.synthAddr 0, some (2, .shared))]) :
    ∃ d, addTargetCtx.decls address = some (.fn d) ∧
      d.arity = arity ∧ d.result = result := by
  have hmapped : (address, some (arity, result)) ∈
      targetOwnershipShapes addTargetDecls := by
    rw [addTargetOwnershipShapes]
    exact hmember
  unfold targetOwnershipShapes at hmapped
  obtain ⟨item, hitem, hshape⟩ := List.mem_map.mp hmapped
  rcases item with ⟨found, decl⟩
  dsimp only at hshape
  cases decl with
  | extern externArity => simp [declOwnershipShape] at hshape
  | fn d =>
    simp only [declOwnershipShape, Prod.mk.injEq,
      Option.some.injEq] at hshape
    obtain ⟨rfl, harity, hresult⟩ := hshape
    exact ⟨d, targetEnv_lookup_of_mem_nodup addTargetDecls_nodup hitem,
      harity, hresult⟩

private def targetFnAt (ctx : IxIR1.Ctx) (address : Ixon.Address) : IxIR1.FnDef :=
  match ctx.decls address with
  | some (.fn d) => d
  | _ => ⟨0, .shared, .ret .erased⟩

private def isFnAtB (ctx : IxIR1.Ctx) (address : Ixon.Address) : Bool :=
  match ctx.decls address with
  | some (.fn _) => true
  | _ => false

private theorem lookup_targetFnAt_of_isFnAtB {ctx : IxIR1.Ctx}
    {address : Ixon.Address} (hfn : isFnAtB ctx address = true) :
    ctx.decls address = some (.fn (targetFnAt ctx address)) := by
  cases hlookup : ctx.decls address with
  | none => simp [isFnAtB, hlookup] at hfn
  | some decl =>
    cases decl with
    | extern arity => simp [isFnAtB, hlookup] at hfn
    | fn d => simp [targetFnAt, hlookup]

private theorem addSourceLayout : SourceDeclLayout ienv addTargetCtx := by
  constructor
  · intro address source worlds result hsrc hsignature
    rcases ienv_cases hsrc with h | h | h | h | h | h | h
    · obtain ⟨rfl, rfl⟩ := h
      simp only [sourceCallableSignature, Option.some.injEq,
        Prod.mk.injEq] at hsignature
      obtain ⟨rfl, rfl⟩ := hsignature
      simpa [IxIR1.Lower.lamArity] using
        (addTargetFn_of_shape (address := maNat)
        (arity := 0) (result := .shared) (by simp))
    · obtain ⟨rfl, rfl⟩ := h
      simp only [sourceCallableSignature, Option.some.injEq,
        Prod.mk.injEq] at hsignature
      obtain ⟨rfl, rfl⟩ := hsignature
      simpa [IxIR1.Lower.lamArity] using
        (addTargetFn_of_shape (address := maNatRec)
        (arity := 4) (result := .shared) (by simp))
    · obtain ⟨rfl, rfl⟩ := h
      simp only [sourceCallableSignature, Option.some.injEq,
        Prod.mk.injEq] at hsignature
      obtain ⟨rfl, rfl⟩ := hsignature
      simpa [IxIR1.Lower.lamArity] using
        (addTargetFn_of_shape (address := aNat)
        (arity := 0) (result := .shared) (by simp))
    · obtain ⟨rfl, rfl⟩ := h
      simp [sourceCallableSignature] at hsignature
    · obtain ⟨rfl, rfl⟩ := h
      simp [sourceCallableSignature] at hsignature
    · obtain ⟨rfl, rfl⟩ := h
      simp only [sourceCallableSignature, Option.some.injEq,
        Prod.mk.injEq] at hsignature
      obtain ⟨rfl, rfl⟩ := hsignature
      simpa [IxIR1.Lower.lamArity] using
        (addTargetFn_of_shape (address := aNatRec)
        (arity := 0) (result := .shared) (by simp))
    · obtain ⟨rfl, rfl⟩ := h
      simp only [sourceCallableSignature, Option.some.injEq,
        Prod.mk.injEq] at hsignature
      obtain ⟨rfl, rfl⟩ := hsignature
      simpa [addBody', IxIR1.Lower.lamArity] using
        (addTargetFn_of_shape (address := aAdd)
        (arity := 2) (result := .shared) (by simp))
  · intro address arity hsrc
    rcases ienv_cases hsrc with h | h | h | h | h | h | h
    all_goals obtain ⟨rfl, h⟩ := h
    all_goals simp at h

private theorem addSourceAllShared : SourceAllShared ienv := by
  intro address source worlds result hsrc hsignature
  rcases ienv_cases hsrc with h | h | h | h | h | h | h
  all_goals obtain ⟨rfl, rfl⟩ := h
  all_goals
    simp [sourceCallableSignature, addBody']
      at hsignature
  all_goals obtain ⟨rfl, rfl⟩ := hsignature
  all_goals
    simp [IxIR1.Lower.lamUses, IxIR1.Lower.worldOfUses]

private theorem erasedList_nodup : (erasedList.map Prod.fst).Nodup := by
  simp [erasedList, maNat, maNatRec, aNat, aZero, aSucc, aNatRec, aAdd]

private theorem addTargetAddresses : addTargetDecls.map Prod.fst =
    [maNat, maNatRec, aNat, aNatRec, aAdd,
      IxIR1.Lower.synthAddr 0] := by
  rw [← targetOwnershipShapes_addresses]
  rw [addTargetOwnershipShapes]
  rfl

private theorem addExtraResultsShared : ExtraFnResultsShared addFinalState := by
  intro address d hmember
  rw [addFinalState_extra] at hmember
  simp only [List.mem_singleton, Prod.mk.injEq] at hmember
  obtain ⟨rfl, hdecl⟩ := hmember
  have hd := IxIR1.Decl.fn.inj hdecl
  subst d
  rw [addLiftedDef_eq_addExpected]
  rfl

private theorem addFnDeclCovered :
    FnDeclCovered ienv addTargetCtx addFinalState := by
  intro address d hdecl
  obtain ⟨item, hitem, hitemAddress, hitemDecl⟩ :=
    targetEnv_some_mem hdecl
  rcases item with ⟨itemAddress, itemDecl⟩
  dsimp only at hitemAddress hitemDecl
  subst address
  subst itemDecl
  have haddress : itemAddress ∈ addTargetDecls.map Prod.fst := by
    exact List.mem_map.mpr ⟨(itemAddress, .fn d), hitem, rfl⟩
  rw [addTargetAddresses] at haddress
  simp only [List.mem_cons] at haddress
  rcases haddress with h | h | h | h | h | h
  · subst itemAddress
    left
    refine ⟨.defn .shared .erased, [], .shared, ?_, rfl⟩
    exact sourceEnv_lookup_of_mem_nodup erasedList_nodup (by
      simp only [erasedList]
      exact List.mem_cons_self)
  · subst itemAddress
    left
    refine ⟨.recursor 3 true #[
        { fields := 0, rhs := .var 1 },
        { fields := 1, rhs := succRuleBody' }],
      List.replicate 4 .shared, .shared, ?_, rfl⟩
    exact sourceEnv_lookup_of_mem_nodup erasedList_nodup (by
      simp only [erasedList]
      exact List.mem_cons_of_mem _ List.mem_cons_self)
  · subst itemAddress
    left
    refine ⟨.defn .shared .erased, [], .shared, ?_, rfl⟩
    exact sourceEnv_lookup_of_mem_nodup erasedList_nodup (by
      simp only [erasedList]
      exact List.mem_cons_of_mem _
        (List.mem_cons_of_mem _ List.mem_cons_self))
  · subst itemAddress
    left
    refine ⟨.defn .shared (.ref maNatRec), [], .shared, ?_, rfl⟩
    exact sourceEnv_lookup_of_mem_nodup erasedList_nodup (by
      simp only [erasedList]
      exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _
        (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
          (List.mem_cons_of_mem _ List.mem_cons_self)))))
  · subst itemAddress
    left
    refine ⟨.defn .shared addBody',
      [.shared, .shared], .shared, ?_, ?_⟩
    · exact sourceEnv_lookup_of_mem_nodup erasedList_nodup (by
        simp only [erasedList]
        exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _
          (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
            (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
              List.mem_cons_self))))))
    · rfl
  · have h' : itemAddress = IxIR1.Lower.synthAddr 0 := by
      simpa using h
    subst itemAddress
    right
    have hd : d = addLiftedDef := by
      have heq : some (IxIR1.Decl.fn addLiftedDef) =
          some (IxIR1.Decl.fn d) :=
        addLifted_lookup.symm.trans hdecl
      exact (IxIR1.Decl.fn.inj (Option.some.inj heq)).symm
    subst d
    rw [addFinalState_extra]
    simp

private theorem addExtraRepresented :
    ExtraRepresented addTargetCtx addFinalState := by
  apply lowerAllAction_extraRepresented addAction_run
  intro address decl hmember
  apply targetEnv_lookup_of_mem_nodup addTargetDecls_nodup
  exact IxIR1.LowerSim.lowerAllAction_extra_mem_result addAction_run hmember

private theorem addLowerDecl_run
    {address : Ixon.Address} {source : IxIR0.Decl}
    {worlds : List Ixon.Owned} {result : Ixon.Owned}
    {d : IxIR1.FnDef}
    (hmember : (address, source) ∈ erasedList)
    (hsignature : sourceCallableSignature source = some (worlds, result))
    (hdecl : addTargetCtx.decls address = some (.fn d)) :
    ∃ initial final,
      (IxIR1.Lower.lowerDecl ienv 100 (address, source)).run initial =
          .ok (some (address, .fn d)) final ∧
        ExtraRepresented addTargetCtx final := by
  obtain ⟨initial, final, output, hrun, hextends, houtput⟩ :=
    lowerAllAction_decl_trace addAction_run hmember
  obtain ⟨generated, hgenerated⟩ :=
    lowerDecl_output_fn_of_callable hsignature hrun
  have htargetMember : (address, IxIR1.Decl.fn generated) ∈
      addTargetDecls := houtput _ hgenerated
  have hgeneratedDecl : addTargetCtx.decls address =
      some (.fn generated) :=
    targetEnv_lookup_of_mem_nodup addTargetDecls_nodup htargetMember
  have hd : generated = d := by
    have heq : some (IxIR1.Decl.fn generated) =
        some (IxIR1.Decl.fn d) := hgeneratedDecl.symm.trans hdecl
    exact IxIR1.Decl.fn.inj (Option.some.inj heq)
  subst generated
  refine ⟨initial, final, ?_, addExtraRepresented.of_extends hextends⟩
  rw [hgenerated] at hrun
  exact hrun

private theorem addDef_preservesAt
    {limit : Nat}
    (happly : IxIR1.Sim.ApplyOwnershipContractBelow addTargetCtx limit)
    (hdecls : SourceDeclContractsBelow ienv addTargetCtx limit)
    {address : Ixon.Address} {result : Ixon.Owned} {body : IxIR0.Expr}
    {d : IxIR1.FnDef}
    (_hsrc : ienv address = some (.defn result body))
    (hmember : (address, .defn result body) ∈ erasedList)
    (hadmissible : ParameterDropsAdmissible
      (IxIR1.Lower.lamUses body)
      (fun index => IxIR1.Lower.countUses index
        (IxIR1.Lower.stripLams body)))
    (hdecl : addTargetCtx.decls address = some (.fn d)) :
    IxIR1.Sim.FnOwnershipPreservesAt addTargetCtx d
      ((IxIR1.Lower.lamUses body).map IxIR1.Lower.worldOfUses) limit := by
  obtain ⟨initial, final, hrun, hrepresented⟩ :=
    addLowerDecl_run hmember (by rfl) hdecl
  exact lowerDecl_defn_preservesAt happly hdecls hadmissible hrun
    hrepresented

private theorem addRecursor_preservesAt
    {limit : Nat}
    (happly : IxIR1.Sim.ApplyOwnershipContractBelow addTargetCtx limit)
    (hdecls : SourceDeclContractsBelow ienv addTargetCtx limit)
    {address : Ixon.Address} {numArgs : Nat} {natLit : Bool}
    {rules : Array IxIR0.RecRule} {d : IxIR1.FnDef}
    (hsrc : ienv address = some (.recursor numArgs natLit rules))
    (hmember : (address, .recursor numArgs natLit rules) ∈ erasedList)
    (hdecl : addTargetCtx.decls address = some (.fn d)) :
    IxIR1.Sim.FnOwnershipPreservesAt addTargetCtx d
      (List.replicate (numArgs + 1) .shared) limit := by
  obtain ⟨initial, final, hrun, hrepresented⟩ :=
    addLowerDecl_run hmember (by rfl) hdecl
  obtain ⟨self, hselfDecl, harity, hself⟩ :=
    hdecls.recursorCurrentSelf hsrc
  have hd : self = d := by
    have heq : some (IxIR1.Decl.fn self) = some (IxIR1.Decl.fn d) :=
      hselfDecl.symm.trans hdecl
    exact IxIR1.Decl.fn.inj (Option.some.inj heq)
  subst self
  intro store store' args value rest hlength hown hcodeRun
  exact lowerDecl_recursor_preservesAt happly hdecls hself hrun
    hrepresented hlength hown hcodeRun

private theorem addSourceFnPreservesAt
    (limit : Nat)
    (happly : IxIR1.Sim.ApplyOwnershipContractBelow addTargetCtx limit)
    (hdecls : SourceDeclContractsBelow ienv addTargetCtx limit) :
    SourceFnPreservesAt ienv addTargetCtx limit := by
  intro address source worlds result d hsrc hsignature hdecl
  rcases ienv_cases hsrc with h | h | h | h | h | h | h
  · obtain ⟨rfl, rfl⟩ := h
    simp only [sourceCallableSignature, Option.some.injEq,
      Prod.mk.injEq] at hsignature
    obtain ⟨rfl, rfl⟩ := hsignature
    apply addDef_preservesAt happly hdecls (by
      exact sourceEnv_lookup_of_mem_nodup erasedList_nodup (by
        simp only [erasedList]
        exact List.mem_cons_self))
    · exact List.mem_cons_self
    · trivial
    · exact hdecl
  · obtain ⟨rfl, rfl⟩ := h
    simp only [sourceCallableSignature, Option.some.injEq,
      Prod.mk.injEq] at hsignature
    obtain ⟨rfl, rfl⟩ := hsignature
    apply addRecursor_preservesAt happly hdecls (by
      exact sourceEnv_lookup_of_mem_nodup erasedList_nodup (by
        simp only [erasedList]
        exact List.mem_cons_of_mem _ List.mem_cons_self))
    · exact List.mem_cons_of_mem _ List.mem_cons_self
    · exact hdecl
  · obtain ⟨rfl, rfl⟩ := h
    simp only [sourceCallableSignature, Option.some.injEq,
      Prod.mk.injEq] at hsignature
    obtain ⟨rfl, rfl⟩ := hsignature
    apply addDef_preservesAt happly hdecls (by
      exact sourceEnv_lookup_of_mem_nodup erasedList_nodup (by
        simp only [erasedList]
        exact List.mem_cons_of_mem _
          (List.mem_cons_of_mem _ List.mem_cons_self)))
    · exact List.mem_cons_of_mem _
        (List.mem_cons_of_mem _ List.mem_cons_self)
    · trivial
    · exact hdecl
  · obtain ⟨rfl, rfl⟩ := h
    simp [sourceCallableSignature] at hsignature
  · obtain ⟨rfl, rfl⟩ := h
    simp [sourceCallableSignature] at hsignature
  · obtain ⟨rfl, rfl⟩ := h
    simp only [sourceCallableSignature, Option.some.injEq,
      Prod.mk.injEq] at hsignature
    obtain ⟨rfl, rfl⟩ := hsignature
    apply addDef_preservesAt happly hdecls (by
      exact sourceEnv_lookup_of_mem_nodup erasedList_nodup (by
        simp only [erasedList]
        exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _
          (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
            (List.mem_cons_of_mem _ List.mem_cons_self))))))
    · exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _
        (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
          (List.mem_cons_of_mem _ List.mem_cons_self))))
    · trivial
    · exact hdecl
  · obtain ⟨rfl, rfl⟩ := h
    simp only [sourceCallableSignature, Option.some.injEq,
      Prod.mk.injEq] at hsignature
    obtain ⟨rfl, rfl⟩ := hsignature
    apply addDef_preservesAt happly hdecls (by
      exact sourceEnv_lookup_of_mem_nodup erasedList_nodup (by
        simp only [erasedList]
        exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _
          (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
            (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
              List.mem_cons_self)))))))
    · exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _
        (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
          (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
            List.mem_cons_self)))))
    · exact parameterDropsAdmissible_replicate_many 2 _
    · exact hdecl

private def addLiftedExpr : IxIR0.Expr :=
  .lam .many (.lam .many (.app (.ref aSucc) (.var 0)))

private def expectedLiftedDef : IxIR1.FnDef :=
  addExpectedLiftedDef

private def singletonVarB (expected : Nat) (args : Array IxIR1.Atom) : Bool :=
  match args.toList with
  | [.var index] => index == expected
  | _ => false

private theorem eq_singletonVar_of_matches {expected : Nat} {args : Array IxIR1.Atom}
    (h : singletonVarB expected args = true) : args = #[.var expected] := by
  cases hlist : args.toList with
  | nil => simp [singletonVarB, hlist] at h
  | cons atom rest =>
    cases rest with
    | nil =>
      cases atom <;> try {simp [singletonVarB, hlist] at h}
      case var index =>
        have hindex : index = expected := by
          apply beq_iff_eq.mp
          simpa [singletonVarB, hlist] using h
        subst index
        apply Array.toList_inj.mp
        simpa using hlist
    | cons next tail => simp [singletonVarB, hlist] at h

private def matchesAddLiftedBodyB : IxIR1.Code → Bool
  | .letOp (.drop (.var dropIndex))
      (.letOp (.alloc world cid args) (.ret (.var returnIndex))) =>
    dropIndex == 1 && (world == .shared &&
      (cid.block == aSucc && (cid.indIdx == 0 && (cid.cidx == 1 &&
        (singletonVarB 1 args && returnIndex == 0)))))
  | _ => false

private theorem eq_expectedLiftedBody_of_matches {body : IxIR1.Code}
    (h : matchesAddLiftedBodyB body = true) :
    body = expectedLiftedDef.body := by
  cases body with
  | ret atom => simp [matchesAddLiftedBodyB] at h
  | case scrut peel alts => simp [matchesAddLiftedBodyB] at h
  | letOp op rest =>
    cases op <;> try {simp [matchesAddLiftedBodyB] at h}
    case drop target =>
      cases target <;> try {simp [matchesAddLiftedBodyB] at h}
      case var dropIndex =>
        cases rest <;> try {simp [matchesAddLiftedBodyB] at h}
        case letOp op rest =>
          cases op <;> try {simp [matchesAddLiftedBodyB] at h}
          case alloc world cid args =>
            cases rest <;> try {simp [matchesAddLiftedBodyB] at h}
            case ret atom =>
              cases atom <;> try {simp [matchesAddLiftedBodyB] at h}
              case var returnIndex =>
                simp only [matchesAddLiftedBodyB] at h
                change (dropIndex == 1 && (world == .shared &&
                  (cid.block == aSucc && (cid.indIdx == 0 &&
                    (cid.cidx == 1 && (singletonVarB 1 args &&
                      returnIndex == 0)))))) = true at h
                have hsplit : (dropIndex == 1) = true ∧
                    (world == .shared &&
                      (cid.block == aSucc && (cid.indIdx == 0 &&
                        (cid.cidx == 1 && (singletonVarB 1 args &&
                          returnIndex == 0))))) = true := by
                  simpa only [Bool.and_eq_true] using h
                have hdrop := hsplit.1
                have hrest := hsplit.2
                have hsplit : (world == .shared) = true ∧
                    (cid.block == aSucc && (cid.indIdx == 0 &&
                      (cid.cidx == 1 && (singletonVarB 1 args &&
                        returnIndex == 0)))) = true := by
                  simpa only [Bool.and_eq_true] using hrest
                have hworld := hsplit.1
                have hrest := hsplit.2
                have hsplit : (cid.block == aSucc) = true ∧
                    (cid.indIdx == 0 && (cid.cidx == 1 &&
                      (singletonVarB 1 args && returnIndex == 0))) = true := by
                  simpa only [Bool.and_eq_true] using hrest
                have hblock := hsplit.1
                have hrest := hsplit.2
                have hsplit : (cid.indIdx == 0) = true ∧
                    (cid.cidx == 1 &&
                      (singletonVarB 1 args && returnIndex == 0)) = true := by
                  simpa only [Bool.and_eq_true] using hrest
                have hindIdx := hsplit.1
                have hrest := hsplit.2
                have hsplit : (cid.cidx == 1) = true ∧
                    (singletonVarB 1 args && returnIndex == 0) = true := by
                  simpa only [Bool.and_eq_true] using hrest
                have hcidx := hsplit.1
                have hrest := hsplit.2
                have hsplit : singletonVarB 1 args = true ∧
                    (returnIndex == 0) = true := by
                  simpa only [Bool.and_eq_true] using hrest
                have hargs := hsplit.1
                have hreturn := hsplit.2
                have hdrop' : dropIndex = 1 := beq_iff_eq.mp hdrop
                have hworld' : world = .shared := by
                  cases world with
                  | unique =>
                    have hfalse : ((.unique : Ixon.Owned) == .shared) =
                        false := by decide
                    rw [hfalse] at hworld
                    exact Bool.noConfusion hworld
                  | shared => rfl
                have hblock' : cid.block = aSucc :=
                  Ixon.Address.eq_of_beq hblock
                have hindIdx' : cid.indIdx = 0 := beq_iff_eq.mp hindIdx
                have hcidx' : cid.cidx = 1 := beq_iff_eq.mp hcidx
                have hcid' : cid = IxIR1.Lower.ctorIdOf aSucc 1 := by
                  rcases cid with ⟨block, indIdx, cidx⟩
                  simp only [IxIR1.Lower.ctorIdOf] at hblock' hindIdx' hcidx' ⊢
                  subst block
                  subst indIdx
                  subst cidx
                  rfl
                have hargs' : args = #[.var 1] :=
                  eq_singletonVar_of_matches hargs
                have hreturn' : returnIndex = 0 := beq_iff_eq.mp hreturn
                subst dropIndex
                subst world
                subst cid
                subst args
                subst returnIndex
                rfl

private def matchesAddLiftedDefB (d : IxIR1.FnDef) : Bool :=
  d.arity == 2 && (d.result == .shared && matchesAddLiftedBodyB d.body)

private theorem eq_expectedLiftedDef_of_matches {d : IxIR1.FnDef}
    (h : matchesAddLiftedDefB d = true) : d = expectedLiftedDef := by
  rcases d with ⟨arity, result, body⟩
  change (arity == 2 &&
    (result == .shared && matchesAddLiftedBodyB body)) = true at h
  have hsplit : (arity == 2) = true ∧
      (result == .shared && matchesAddLiftedBodyB body) = true := by
    simpa only [Bool.and_eq_true] using h
  have harity := hsplit.1
  have hrest := hsplit.2
  have hsplit : (result == .shared) = true ∧
      matchesAddLiftedBodyB body = true := by
    simpa only [Bool.and_eq_true] using hrest
  have hresult := hsplit.1
  have hbody := hsplit.2
  have harity' : arity = 2 := beq_iff_eq.mp harity
  have hresult' : result = .shared := by
    cases result with
    | unique =>
      have hfalse : ((.unique : Ixon.Owned) == .shared) = false := by
        decide
      rw [hfalse] at hresult
      exact Bool.noConfusion hresult
    | shared => rfl
  have hbody' : body = expectedLiftedDef.body :=
    eq_expectedLiftedBody_of_matches hbody
  subst arity
  subst result
  rw [hbody']
  rfl

private theorem addLiftedDef_eq_expected : addLiftedDef = expectedLiftedDef := by
  exact addLiftedDef_eq_addExpected

private def addLiftedAction :=
  IxIR1.Lower.lowerLam ienv 100 ({} : IxIR1.Lower.VEnv) addLiftedExpr

private def addLiftedOutput :
    IxIR1.Lower.VEnv × IxIR1.Lower.Emit × IxIR1.Lower.AVal :=
  match addLiftedAction.run {} with
  | .ok output _ => output
  | .error _ _ => ({}, id, .constA .erased)

private def addLiftedReplayState : IxIR1.Lower.LowSt :=
  match addLiftedAction.run {} with
  | .ok _ state | .error _ state => state

private theorem addLiftedAction_run_exact : addLiftedAction.run {} =
    .ok (⟨[], 1⟩,
      IxIR1.Lower.emitOp (.papp (IxIR1.Lower.synthAddr 0) #[]),
      .slotA 0)
      { extra := [(IxIR1.Lower.synthAddr 0, .fn expectedLiftedDef)],
        fresh := 1 } := by
  simp [addLiftedAction, addLiftedExpr, expectedLiftedDef,
    addExpectedLiftedDef, ienv,
    erasedList, maNat, maNatRec, aNat, aZero, aSucc, aNatRec, aAdd,
    IxIR1.Lower.lowerLam, IxIR1.Lower.lowerCaptures,
    IxIR1.Lower.lowerFnBody, IxIR1.Lower.releaseSlots,
    IxIR1.Lower.parameterEntries, IxIR1.Lower.parameterDrops,
    IxIR1.Lower.lamUses, IxIR1.Lower.lamArity,
    IxIR1.Lower.stripLams, IxIR1.Lower.lowerE,
    IxIR1.Lower.countUses, IxIR1.Lower.VEnv.setEntry,
    IxIR1.Lower.VEnv.bump, IxIR1.Lower.VEnv.rel,
    IxIR1.Lower.selectedEntriesFrom, IxIR1.Lower.worldOfUses,
    IxIR1.Lower.lowerSpine, IxIR1.Lower.knownCall,
    IxIR1.Lower.lowerArgs, IxIR1.Lower.applyRest,
    IxIR1.Lower.requireResultWorld, IxIR1.Lower.padWorlds,
    IxIR1.Lower.freshAddr, IxIR1.Lower.pushExtra,
    IxIR1.Lower.papSafe, IxIR1.Lower.AVal.toAtom,
    IxIR1.Lower.emitOp, List.filter, List.range, List.range.loop,
    IxIR0.Env.ofList, bne, EStateM.instMonad,
    EStateM.instMonadStateOf, EStateM.map, EStateM.get]

private theorem addLiftedAction_run : addLiftedAction.run {} =
    .ok addLiftedOutput addLiftedReplayState := by
  simp [addLiftedOutput, addLiftedReplayState, addLiftedAction_run_exact]

private def addLiftedReplayDef : IxIR1.FnDef :=
  firstExtraFn addLiftedReplayState.extra

private theorem addLiftedReplayState_extra : addLiftedReplayState.extra =
    [(IxIR1.Lower.synthAddr 0, .fn expectedLiftedDef)] := by
  simp [addLiftedReplayState, addLiftedAction_run_exact]

private theorem addLiftedReplayRepresented :
    ExtraRepresented addTargetCtx addLiftedReplayState := by
  constructor
  · intro address decl hmember
    rw [addLiftedReplayState_extra] at hmember
    simp only [List.mem_singleton, Prod.mk.injEq] at hmember
    obtain ⟨rfl, hdecl⟩ := hmember
    subst decl
    rw [← addLiftedDef_eq_expected]
    exact addLifted_lookup
  · intro memo hmember
    have hempty : addLiftedReplayState.wrappers = [] := by
      simp [addLiftedReplayState, addLiftedAction_run_exact]
    simp [hempty] at hmember

private theorem addLifted_preservesAt
    (limit : Nat)
    (happly : IxIR1.Sim.ApplyOwnershipContractBelow addTargetCtx limit)
    (hdecls : SourceDeclContractsBelow ienv addTargetCtx limit) :
    IxIR1.Sim.FnOwnershipPreservesAt addTargetCtx addLiftedDef
      (List.replicate 2 .shared) limit := by
  rcases houtput : addLiftedOutput with ⟨output, emit, value⟩
  have hrun : (IxIR1.Lower.lowerLam ienv 100
      ({} : IxIR1.Lower.VEnv) addLiftedExpr).run {} =
      .ok (output, emit, value) addLiftedReplayState := by
    simpa [addLiftedAction, houtput] using addLiftedAction_run
  have hgenerated := IxIR1.LowerSim.lowerLam_generatedFn_preservesAt
    happly hdecls (input := ({} : IxIR1.Lower.VEnv))
    (expr := addLiftedExpr) (state := ({} : IxIR1.Lower.LowSt))
    (finalState := addLiftedReplayState) (output := output)
    (emit := emit) (value := value)
    (by simp [addLiftedExpr, IxIR1.Lower.lamArity]) hrun
    addLiftedReplayRepresented
  have hgenerated' : ∃ address code,
      (address, .fn ⟨2, .shared, code⟩) ∈ addLiftedReplayState.extra ∧
      addTargetCtx.decls address = some (.fn ⟨2, .shared, code⟩) ∧
      IxIR1.Sim.FnOwnershipPreservesAt addTargetCtx
        ⟨2, .shared, code⟩ (List.replicate 2 .shared) limit := by
    simpa [addLiftedExpr, IxIR1.Lower.lamArity] using hgenerated
  obtain ⟨address, code, hmember, _, hpreserves⟩ := hgenerated'
  rw [addLiftedReplayState_extra] at hmember
  simp only [List.mem_singleton, Prod.mk.injEq] at hmember
  have hfn : (⟨2, .shared, code⟩ : IxIR1.FnDef) = expectedLiftedDef :=
    IxIR1.Decl.fn.inj hmember.2
  have hd : addLiftedDef = (⟨2, .shared, code⟩ : IxIR1.FnDef) :=
    addLiftedDef_eq_expected.trans hfn.symm
  intro store store' args value rest hlength hown hcodeRun
  have hcodeRun' : IxIR1.runCode addTargetCtx limit
      (⟨2, .shared, code⟩ : IxIR1.FnDef) store args.reverse code =
        .ok (store', value) := by
    simpa only [hd] using hcodeRun
  have hout := hpreserves hlength hown hcodeRun'
  simpa only [hd] using hout

private theorem addExtraFnPreservesAt
    (limit : Nat)
    (happly : IxIR1.Sim.ApplyOwnershipContractBelow addTargetCtx limit)
    (hdecls : SourceDeclContractsBelow ienv addTargetCtx limit) :
    ExtraFnPreservesAt addTargetCtx addFinalState limit := by
  intro address d hmember
  rw [addFinalState_extra] at hmember
  simp only [List.mem_singleton, Prod.mk.injEq] at hmember
  obtain ⟨rfl, hdecl⟩ := hmember
  have hd : d = addLiftedDef :=
    IxIR1.Decl.fn.inj hdecl
  subst d
  have hresult : addLiftedDef.result = .shared := by
    rw [addLiftedDef_eq_expected]
    rfl
  have harity : addLiftedDef.arity = 2 := by
    rw [addLiftedDef_eq_expected]
    rfl
  refine ⟨hresult, ?_⟩
  rw [harity]
  exact addLifted_preservesAt limit happly hdecls

theorem addIxIR1CompilerContracts :
    CompilerContracts ienv addTargetCtx ∧
      ExtraFnContracts addTargetCtx addFinalState := by
  apply compilerContracts_of_source_extra_below_step
    addSourceLayout addSourceAllShared addExtraResultsShared addFnDeclCovered
  intro limit hsource _ happly
  exact ⟨addSourceFnPreservesAt limit happly hsource,
    addExtraFnPreservesAt limit happly hsource⟩

end IxIR1CompilerContracts

/-! ## IxIR₁ semantic forward-simulation instance

The exact compiled `add 2 3` fixture is evaluated through small,
kernel-checked trace segments.  Keeping allocation, recursive-call, and
closure-application steps separate avoids a native evaluation oracle while
making the RC transitions visible in the proof.
-/

section IxIR1SemanticSimulation

open Compilatrix.IxIR1.LowerSim

private def ixNatValue : Nat → IxIR0.Value
  | 0 => .ctor aZero 0 []
  | n + 1 => .ctor aSucc 1 [ixNatValue n]

private def expectedMainCode : IxIR1.Code :=
  .letOp (.alloc .shared (IxIR1.Lower.ctorIdOf aZero 0) #[])
    (.letOp (.alloc .shared (IxIR1.Lower.ctorIdOf aSucc 1) #[.var 0])
      (.letOp (.alloc .shared (IxIR1.Lower.ctorIdOf aSucc 1) #[.var 0])
        (.letOp (.alloc .shared (IxIR1.Lower.ctorIdOf aZero 0) #[])
          (.letOp (.alloc .shared (IxIR1.Lower.ctorIdOf aSucc 1) #[.var 0])
            (.letOp (.alloc .shared (IxIR1.Lower.ctorIdOf aSucc 1) #[.var 0])
              (.letOp (.alloc .shared (IxIR1.Lower.ctorIdOf aSucc 1) #[.var 0])
                (.letOp (.call aAdd #[.var 4, .var 0])
                  (.ret (.var 0)))))))))

private def expectedRecursorDef : IxIR1.FnDef :=
  ⟨4, .shared,
    .case (.var 0) true #[
      .mk 0 0
        (.letOp (.drop (.var 0))
          (.letOp (.drop (.var 2))
            (.letOp (.drop (.var 5))
              (.ret (.var 5))))),
      .mk 1 1
        (.letOp (.dup (.var 0))
          (.letOp (.drop (.var 2))
            (.letOp (.drop (.var 6))
              (.letOp (.dup (.var 5))
                (.letOp (.dup (.var 3))
                  (.letOp (.callSelf #[.erased, .var 8, .var 7, .var 4])
                    (.letOp (.apply (.var 2) #[.var 1, .var 0])
                      (.ret (.var 0)))))))))]⟩

private def expectedAliasDef : IxIR1.FnDef :=
  ⟨0, .shared,
    .letOp (.papp maNatRec #[]) (.ret (.var 0))⟩

private def expectedAddDef : IxIR1.FnDef :=
  ⟨2, .shared,
    .letOp (.call aNatRec #[])
      (.letOp (.papp (IxIR1.Lower.synthAddr 0) #[])
        (.letOp (.apply (.var 1) #[.erased, .var 3, .var 0, .var 2])
          (.ret (.var 0))))⟩

private def expectedTargetDecls : List (Ixon.Address × IxIR1.Decl) :=
  [(maNat, .fn ⟨0, .shared, .ret .erased⟩),
   (maNatRec, .fn expectedRecursorDef),
   (aNat, .fn ⟨0, .shared, .ret .erased⟩),
   (aNatRec, .fn expectedAliasDef),
   (aAdd, .fn expectedAddDef),
   (IxIR1.Lower.synthAddr 0, .fn expectedLiftedDef)]

private theorem addAction_exact : addAction.run {} =
    .ok (expectedTargetDecls, expectedMainCode)
      { extra := [(IxIR1.Lower.synthAddr 0, .fn expectedLiftedDef)],
        fresh := 1 } := by
  simp [addAction, IxIR1.Lower.lowerAllAction, erasedList, addE', natE',
    succRuleBody', addBody', maNat, maNatRec, aNat, aZero, aSucc,
    aNatRec, aAdd, expectedMainCode, expectedTargetDecls,
    expectedRecursorDef, expectedAliasDef, expectedAddDef,
    expectedLiftedDef, addExpectedLiftedDef,
    List.filterMapM, List.filterMapM.loop, List.filter,
    List.range, List.range.loop, IxIR1.Lower.lowerDecl,
    IxIR1.Lower.lowerFnBody, IxIR1.Lower.lowerRecursor,
    IxIR1.Lower.lowerRecursorRule, IxIR1.Lower.releaseSlots,
    IxIR1.Lower.parameterEntries, IxIR1.Lower.parameterDrops,
    IxIR1.Lower.lamUses, IxIR1.Lower.lamArity,
    IxIR1.Lower.stripLams, IxIR1.Lower.lowerE,
    IxIR1.Lower.countUses, IxIR1.Lower.recursorFieldRetains,
    IxIR1.Lower.applyRecursorFieldRetains,
    IxIR1.Lower.SlotDrop.offsetEntry, IxIR1.Lower.VEnv.setEntry,
    IxIR1.Lower.VEnv.bump, IxIR1.Lower.VEnv.rel,
    IxIR1.Lower.worldOfUses, IxIR1.Lower.requireResultWorld,
    IxIR1.Lower.lowerSpine, IxIR1.Lower.knownCall,
    IxIR1.Lower.lowerArgs, IxIR1.Lower.applyRest,
    IxIR1.Lower.lowerCaptures, IxIR1.Lower.lowerLam,
    IxIR1.Lower.freshAddr, IxIR1.Lower.pushExtra,
    IxIR1.Lower.papSafe, IxIR1.Lower.padWorlds,
    IxIR1.Lower.AVal.toAtom, IxIR1.Lower.emitOp,
    IxIR0.Env.ofList, bne]
private def expectedCtx : IxIR1.Ctx :=
  { decls := IxIR1.Env.ofList expectedTargetDecls }

set_option allowUnsafeReducibility true
attribute [local reducible]
  IxIR1.runCode IxIR1.runOp IxIR1.invoke IxIR1.applyGo
  IxIR1.dropVal IxIR1.dropMany IxIR1.dupVals
  IxIR1.checkResultWorld IxIR1.RVal.hasWorld
  IxIR1.resolveAtom IxIR1.resolveAtoms IxIR1.declArity
  IxIR1.Store.allocNode IxIR1.Store.get? IxIR1.Store.setBox
  IxIR1.Store.kill IxIR1.Store.rcTick
set_option allowUnsafeReducibility false

private theorem runCode_letOp_of_runOp {ctx : IxIR1.Ctx} {fuel : Nat}
    {cur : IxIR1.FnDef} {store store' : IxIR1.Store}
    {env : List IxIR1.RVal} {op : IxIR1.Op} {rest : IxIR1.Code}
    {value : IxIR1.RVal}
    (hop : IxIR1.runOp ctx fuel cur store env op = .ok (store', value)) :
    IxIR1.runCode ctx (fuel + 1) cur store env (.letOp op rest) =
      IxIR1.runCode ctx fuel cur store' (value :: env) rest := by
  rw [IxIR1.runCode.eq_def]
  dsimp only
  rw [hop]
  rfl

private theorem checkResultWorld_of_hasWorld {world : Ixon.Owned}
    {store : IxIR1.Store} {value : IxIR1.RVal}
    (hworld : IxIR1.Sim.HasWorld store world value) :
    IxIR1.checkResultWorld world (store, value) = .ok (store, value) := by
  unfold IxIR1.checkResultWorld
  rw [if_pos (IxIR1.Sim.rval_hasWorld_eq_true_iff.mpr hworld)]

private theorem invoke_fn_of_runCode {ctx : IxIR1.Ctx} {fuel : Nat}
    {address : Ixon.Address} {args : List IxIR1.RVal}
    {store store' : IxIR1.Store} {value : IxIR1.RVal}
    {d : IxIR1.FnDef}
    (hdecl : ctx.decls address = some (.fn d))
    (hlength : args.length = d.arity)
    (hrun : IxIR1.runCode ctx fuel d store args.reverse d.body =
      .ok (store', value))
    (hworld : IxIR1.Sim.HasWorld store' d.result value) :
    IxIR1.invoke ctx (fuel + 1) address args store =
      .ok (store', value) := by
  rw [IxIR1.invoke.eq_def]
  dsimp only
  rw [hdecl]
  simp only
  rw [if_neg (by simp [hlength])]
  rw [hrun]
  exact checkResultWorld_of_hasWorld hworld

private theorem runOp_call_of_invoke {ctx : IxIR1.Ctx} {fuel : Nat}
    {cur : IxIR1.FnDef} {store store' : IxIR1.Store}
    {env : List IxIR1.RVal} {address : Ixon.Address}
    {atoms : Array IxIR1.Atom} {args : List IxIR1.RVal}
    {value : IxIR1.RVal}
    (hargs : IxIR1.resolveAtoms env atoms = .ok args)
    (hinvoke : IxIR1.invoke ctx fuel address args store =
      .ok (store', value)) :
    IxIR1.runOp ctx (fuel + 1) cur store env (.call address atoms) =
      .ok (store', value) := by
  rw [IxIR1.runOp.eq_def]
  dsimp only
  rw [hargs]
  simp only [bind, Except.bind]
  exact hinvoke

private theorem runOp_papp {ctx : IxIR1.Ctx} {fuel : Nat}
    {cur : IxIR1.FnDef} {store : IxIR1.Store}
    {env : List IxIR1.RVal} {address : Ixon.Address}
    {atoms : Array IxIR1.Atom} {args : List IxIR1.RVal}
    {decl : IxIR1.Decl}
    (hargs : IxIR1.resolveAtoms env atoms = .ok args)
    (hdecl : ctx.decls address = some decl)
    (hunder : args.length < IxIR1.declArity decl) :
    IxIR1.runOp ctx (fuel + 1) cur store env (.papp address atoms) =
      .ok ((store.allocNode .shared
          (.papN address (IxIR1.declArity decl) args.toArray)).1,
        .loc (store.allocNode .shared
          (.papN address (IxIR1.declArity decl) args.toArray)).2) := by
  rw [IxIR1.runOp.eq_def]
  dsimp only
  rw [hargs]
  simp only [bind, Except.bind]
  rw [hdecl]
  simp only
  rw [if_pos hunder]

private theorem runOp_apply_of_applyGo {ctx : IxIR1.Ctx} {fuel : Nat}
    {cur : IxIR1.FnDef} {store store' : IxIR1.Store}
    {env : List IxIR1.RVal} {function : IxIR1.Atom}
    {atoms : Array IxIR1.Atom} {fv value : IxIR1.RVal}
    {args : List IxIR1.RVal}
    (hfunction : IxIR1.resolveAtom env function = .ok fv)
    (hargs : IxIR1.resolveAtoms env atoms = .ok args)
    (happly : IxIR1.applyGo ctx fuel store fv args = .ok (store', value)) :
    IxIR1.runOp ctx (fuel + 1) cur store env (.apply function atoms) =
      .ok (store', value) := by
  rw [IxIR1.runOp.eq_def]
  dsimp only
  rw [hfunction]
  simp only [bind, Except.bind]
  rw [hargs]
  exact happly

private def mainCur : IxIR1.FnDef := ⟨0, .shared, expectedMainCode⟩

private def mainStep0 := ({} : IxIR1.Store).allocNode .shared
  (.ctorN (IxIR1.Lower.ctorIdOf aZero 0) #[])
private def mainStore1 := mainStep0.1
private def mainLoc0 := mainStep0.2

private def mainStep1 := mainStore1.allocNode .shared
  (.ctorN (IxIR1.Lower.ctorIdOf aSucc 1) ([.loc mainLoc0].toArray))
private def mainStore2 := mainStep1.1
private def mainLoc1 := mainStep1.2

private def mainStep2 := mainStore2.allocNode .shared
  (.ctorN (IxIR1.Lower.ctorIdOf aSucc 1) ([.loc mainLoc1].toArray))
private def mainStore3 := mainStep2.1
private def mainLoc2 := mainStep2.2

private def mainStep3 := mainStore3.allocNode .shared
  (.ctorN (IxIR1.Lower.ctorIdOf aZero 0) #[])
private def mainStore4 := mainStep3.1
private def mainLoc3 := mainStep3.2

private def mainStep4 := mainStore4.allocNode .shared
  (.ctorN (IxIR1.Lower.ctorIdOf aSucc 1) ([.loc mainLoc3].toArray))
private def mainStore5 := mainStep4.1
private def mainLoc4 := mainStep4.2

private def mainStep5 := mainStore5.allocNode .shared
  (.ctorN (IxIR1.Lower.ctorIdOf aSucc 1) ([.loc mainLoc4].toArray))
private def mainStore6 := mainStep5.1
private def mainLoc5 := mainStep5.2

private def mainStep6 := mainStore6.allocNode .shared
  (.ctorN (IxIR1.Lower.ctorIdOf aSucc 1) ([.loc mainLoc5].toArray))
private def mainStore7 := mainStep6.1
private def mainLoc6 := mainStep6.2

private theorem main_prefix :
    IxIR1.runCode expectedCtx 46 mainCur
        {} [] expectedMainCode =
      IxIR1.runCode expectedCtx 39 mainCur mainStore7
        [.loc mainLoc6, .loc mainLoc5, .loc mainLoc4, .loc mainLoc3,
          .loc mainLoc2, .loc mainLoc1, .loc mainLoc0]
        (.letOp (.call aAdd #[.var 4, .var 0]) (.ret (.var 0))) := by
  unfold expectedMainCode
  rw [runCode_letOp_of_runOp (IxIR1.Sim.runOp_alloc (by rfl))]
  rw [runCode_letOp_of_runOp (IxIR1.Sim.runOp_alloc (by rfl))]
  rw [runCode_letOp_of_runOp (IxIR1.Sim.runOp_alloc (by rfl))]
  rw [runCode_letOp_of_runOp (IxIR1.Sim.runOp_alloc (by rfl))]
  rw [runCode_letOp_of_runOp (IxIR1.Sim.runOp_alloc (by rfl))]
  rw [runCode_letOp_of_runOp (IxIR1.Sim.runOp_alloc (by rfl))]
  rw [runCode_letOp_of_runOp (IxIR1.Sim.runOp_alloc (by rfl))]
  rfl

private theorem expectedExpectedCtx_add : expectedCtx.decls aAdd =
    some (.fn expectedAddDef) := by
  simp [expectedCtx, expectedTargetDecls, IxIR1.Env.ofList,
    maNat, maNatRec, aNat, aNatRec, aAdd]

private theorem expectedExpectedCtx_alias : expectedCtx.decls aNatRec =
    some (.fn expectedAliasDef) := by
  simp [expectedCtx, expectedTargetDecls, IxIR1.Env.ofList,
    maNat, maNatRec, aNat, aNatRec, aAdd]

private theorem expectedExpectedCtx_recursor : expectedCtx.decls maNatRec =
    some (.fn expectedRecursorDef) := by
  simp [expectedCtx, expectedTargetDecls, IxIR1.Env.ofList,
    maNat, maNatRec, aNat, aNatRec, aAdd]

private theorem expectedExpectedCtx_lifted :
    expectedCtx.decls (IxIR1.Lower.synthAddr 0) =
      some (.fn expectedLiftedDef) := by
  simp [expectedCtx, expectedTargetDecls, IxIR1.Env.ofList,
    maNat, maNatRec, aNat, aNatRec, aAdd]

private def aliasStep := mainStore7.allocNode .shared
  (.papN maNatRec expectedRecursorDef.arity #[])
private def aliasStore := aliasStep.1
private def aliasLoc := aliasStep.2

private theorem alias_runCode :
    IxIR1.runCode expectedCtx 33 expectedAliasDef mainStore7 []
        expectedAliasDef.body =
      .ok (aliasStore, .loc aliasLoc) := by
  rw [show expectedAliasDef.body =
    .letOp (.papp maNatRec #[]) (.ret (.var 0)) by rfl]
  rw [runCode_letOp_of_runOp (runOp_papp (by rfl)
    expectedExpectedCtx_recursor (by decide))]
  rfl

