private theorem runOp_callSelf_of_runCode {ctx : IxIR1.Ctx} {fuel : Nat}
    {cur : IxIR1.FnDef} {store store' : IxIR1.Store}
    {env : List IxIR1.RVal} {atoms : Array IxIR1.Atom}
    {args : List IxIR1.RVal} {value : IxIR1.RVal}
    (hargs : IxIR1.resolveAtoms env atoms = .ok args)
    (hlength : args.length = cur.arity)
    (hrun : IxIR1.runCode ctx fuel cur store args.reverse cur.body =
      .ok (store', value))
    (hworld : IxIR1.Sim.HasWorld store' cur.result value) :
    IxIR1.runOp ctx (fuel + 1) cur store env (.callSelf atoms) =
      .ok (store', value) := by
  rw [IxIR1.runOp.eq_def]
  dsimp only
  rw [hargs]
  simp only [bind, Except.bind]
  rw [if_neg (by simp [hlength])]
  rw [hrun]
  exact checkResultWorld_of_hasWorld hworld

private theorem applyGo_pap_empty_saturated_of_eval {ctx : IxIR1.Ctx}
    {fuel : Nat} {store dropped store' : IxIR1.Store}
    {loc : Nat} {address : Ixon.Address} {arity : Nat}
    {args : List IxIR1.RVal} {value : IxIR1.RVal}
    (hget : store.get? loc =
      some ⟨.shared, 1, .papN address arity #[]⟩ ∨
      ∃ rc, 1 < rc ∧ store.get? loc =
        some ⟨.shared, rc, .papN address arity #[]⟩)
    (hdrop : IxIR1.dropVal ctx fuel store (.loc loc) = .ok dropped)
    (hlength : args.length = arity)
    (hinvoke : IxIR1.invoke ctx fuel address args dropped =
      .ok (store', value)) :
    IxIR1.applyGo ctx (fuel + 1) store (.loc loc) args =
      .ok (store', value) := by
  obtain hget | ⟨rc, _, hget⟩ := hget
  · rw [IxIR1.applyGo.eq_def]
    dsimp only
    rw [hget]
    dsimp only
    have hdup : IxIR1.dupVals store [] = .ok store := by rfl
    rw [hdup]
    simp only [bind, Except.bind, List.nil_append]
    rw [hdrop]
    simp [hlength, hinvoke]
  · rw [IxIR1.applyGo.eq_def]
    dsimp only
    rw [hget]
    dsimp only
    have hdup : IxIR1.dupVals store [] = .ok store := by rfl
    rw [hdup]
    simp only [bind, Except.bind, List.nil_append]
    rw [hdrop]
    simp [hlength, hinvoke]

