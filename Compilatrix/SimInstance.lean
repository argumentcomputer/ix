      (args := #[.var 1]) (values := [.loc level2ResultLoc]) (by rfl))

private theorem top_lifted_runCode :
    IxIR1.runCode expectedCtx 19 expectedLiftedDef topApplyStore
        [.loc level2ResultLoc, .loc mainLoc5] expectedLiftedDef.body =
      .ok (topResultStore, .loc topResultLoc) := by
  rw [show expectedLiftedDef.body =
    .letOp (.drop (.var 1))
      (.letOp
        (.alloc .shared (IxIR1.Lower.ctorIdOf aSucc 1) #[.var 1])
        (.ret (.var 0))) by rfl]
  rw [runCode_letOp_of_runOp top_dropOp]
  rw [runCode_letOp_of_runOp top_allocOp]
  rfl

private theorem top_result_world :
    IxIR1.Sim.HasWorld topResultStore .shared (.loc topResultLoc) := by
  simpa [topResultStore, topResultLoc, topResultStep] using
    (IxIR1.Sim.HasWorld.allocNode_new topLiftDropStore .shared
      (.ctorN (IxIR1.Lower.ctorIdOf aSucc 1) #[.loc level2ResultLoc]))

private theorem top_lifted_invoke :
    IxIR1.invoke expectedCtx 20 (IxIR1.Lower.synthAddr 0)
        [.loc mainLoc5, .loc level2ResultLoc] topApplyStore =
      .ok (topResultStore, .loc topResultLoc) := by
  exact invoke_fn_of_runCode expectedExpectedCtx_lifted rfl
    top_lifted_runCode top_result_world

private theorem top_applyGo :
    IxIR1.applyGo expectedCtx 21 level2ResultStore (.loc liftLoc)
        [.loc mainLoc5, .loc level2ResultLoc] =
      .ok (topResultStore, .loc topResultLoc) := by
  apply applyGo_pap_empty_saturated_of_eval
  · left
    rfl
  · rfl
  · rfl
  · exact top_lifted_invoke

private theorem recursor_top_run :
    IxIR1.runCode expectedCtx 30 expectedRecursorDef recEntryStore
        [.loc mainLoc6, .loc liftLoc, .loc mainLoc2, .erased]
        expectedRecursorDef.body =
      .ok (topResultStore, .loc topResultLoc) := by
  rw [recursor_top_prefix]
  rw [runCode_letOp_of_runOp
    (runOp_callSelf_of_runCode (by rfl) rfl
      recursor_level2_run level2_result_world)]
  rw [runCode_letOp_of_runOp
    (runOp_apply_of_applyGo (by rfl) (by rfl) top_applyGo)]
  rfl

private theorem recursor_invoke :
    IxIR1.invoke expectedCtx 31 maNatRec
        [.erased, .loc mainLoc2, .loc liftLoc, .loc mainLoc6]
        recEntryStore =
      .ok (topResultStore, .loc topResultLoc) := by
  exact invoke_fn_of_runCode expectedExpectedCtx_recursor rfl
    recursor_top_run top_result_world

private theorem add_applyGo :
    IxIR1.applyGo expectedCtx 32 liftStore (.loc aliasLoc)
        [.erased, .loc mainLoc2, .loc liftLoc, .loc mainLoc6] =
      .ok (topResultStore, .loc topResultLoc) := by
  rw [initial_applyGo]
  exact recursor_invoke

private theorem add_runCode :
    IxIR1.runCode expectedCtx 36 expectedAddDef mainStore7
        [.loc mainLoc6, .loc mainLoc2] expectedAddDef.body =
      .ok (topResultStore, .loc topResultLoc) := by
  rw [add_runCode_to_apply]
  rw [runCode_letOp_of_runOp
    (runOp_apply_of_applyGo (by rfl) (by rfl) add_applyGo)]
  rfl

private theorem add_invoke :
    IxIR1.invoke expectedCtx 37 aAdd
        [.loc mainLoc2, .loc mainLoc6] mainStore7 =
      .ok (topResultStore, .loc topResultLoc) := by
  exact invoke_fn_of_runCode expectedExpectedCtx_add rfl
    add_runCode top_result_world

private theorem expected_main_runCode :
    IxIR1.runCode expectedCtx 46 mainCur {} [] expectedMainCode =
      .ok (topResultStore, .loc topResultLoc) := by
  rw [main_prefix]
  rw [runCode_letOp_of_runOp
    (runOp_call_of_invoke (by rfl) add_invoke)]
  rfl

private theorem expected_runMain :
    IxIR1.runMain expectedCtx expectedMainCode 46 =
      .ok (topResultStore, .loc topResultLoc) := by
  simpa [IxIR1.runMain, mainCur] using expected_main_runCode

private theorem expectedCtx_eq_addTargetCtx : expectedCtx = addTargetCtx := by
  simp [expectedCtx, addTargetCtx, addTargetDecls, addAction_exact]

private theorem expectedMainCode_eq_addMainCode :
    expectedMainCode = addMainCode := by
  simp [addMainCode, addAction_exact]

private theorem add_runMain_exact :
    IxIR1.runMain addTargetCtx addMainCode 46 =
      .ok (topResultStore, .loc topResultLoc) := by
  rw [← expectedCtx_eq_addTargetCtx,
    ← expectedMainCode_eq_addMainCode]
  exact expected_runMain

set_option maxRecDepth 4000 in
private theorem add_value_graph :
    IxIR1.Sim.ValueGraph (fun _ _ _ _ => False) topResultStore
      (ixNatValue 5) (.loc topResultLoc) := by
  simp only [ixNatValue]
  refine .ctor (by rfl) (by rfl) (by rfl) (.cons ?_ .nil)
  refine .ctor (by rfl) (by rfl) (by rfl) (.cons ?_ .nil)
  refine .ctor (by rfl) (by rfl) (by rfl) (.cons ?_ .nil)
  refine .ctor (by rfl) (by rfl) (by rfl) (.cons ?_ .nil)
  refine .ctor (by rfl) (by rfl) (by rfl) (.cons ?_ .nil)
  exact .ctor (by rfl) (by rfl) (by rfl) .nil

private theorem add_source_exact : IxIR0.eval ictxI 23 [] addE' =
    .ok (ixNatValue 5) := by
  have hzero : ienv aZero = some (.ctor 0 0) :=
    sourceEnv_lookup_of_mem_nodup erasedList_nodup (by simp [erasedList])
  have hsucc : ienv aSucc = some (.ctor 1 1) :=
    sourceEnv_lookup_of_mem_nodup erasedList_nodup (by simp [erasedList])
  have hnrec : ienv maNatRec = some (.recursor 3 true #[
      { fields := 0, rhs := .var 1 },
      { fields := 1, rhs := succRuleBody' }]) :=
    sourceEnv_lookup_of_mem_nodup erasedList_nodup (by simp [erasedList])
  have hanrec : ienv aNatRec = some (.defn .shared (.ref maNatRec)) :=
    sourceEnv_lookup_of_mem_nodup erasedList_nodup (by simp [erasedList])
  have hadd : ienv aAdd = some (.defn .shared addBody') :=
    sourceEnv_lookup_of_mem_nodup erasedList_nodup (by simp [erasedList])
  simp [ictxI, addE', natE', addBody', succRuleBody', IxIR0.eval,
    IxIR0.apply, IxIR0.saturate, IxIR0.fire, IxIR0.majorCtor,
    IxIR0.Head.arity,
    hzero, hsucc, hnrec, hanrec, hadd, ixNatValue, bind, Except.bind]

theorem addIxIR1SemanticForwardSimulation :
    SemanticForwardSimulation ictxI addTargetCtx addE' addMainCode
      (fun _ _ _ _ => False) := by
  intro sourceFuel sourceValue hsource
  let commonFuel := max sourceFuel 23
  have hsourceCommon :
      IxIR0.eval ictxI commonFuel [] addE' = .ok sourceValue :=
    IxIR0.eval_mono (Nat.le_max_left sourceFuel 23) hsource
  have hexactCommon :
      IxIR0.eval ictxI commonFuel [] addE' = .ok (ixNatValue 5) :=
    IxIR0.eval_mono (Nat.le_max_right sourceFuel 23) add_source_exact
  have hvalue : sourceValue = ixNatValue 5 := by
    exact Except.ok.inj (hsourceCommon.symm.trans hexactCommon)
  subst sourceValue
  exact ⟨46, topResultStore, .loc topResultLoc,
    add_runMain_exact, add_value_graph⟩


end IxIR1SemanticSimulation

/-! ## Constructor-parameter drop instance -/

private def aPairBlock : Ixon.Address := addrOf 0x20
private def aPairMk : Ixon.Address := addrOf 0x21

private def pairInd : Compilatrix.Ixon.Inductive :=
  { isUnsafe := false, lvls := 0, params := 2, indices := 0
    typ := .sort 0
    ctors := #[
      { isUnsafe := false, lvls := 0, cidx := 0, params := 2, fields := 2
        typ := .sort 0 }] }

private def cPairBlock : Constant :=
  { info := .muts #[.indc pairInd]
    sharing := #[], refs := #[], univs := #[.zero] }

private def cPairMk : Constant :=
  prjConst (.cPrj { idx := 0, cidx := 0, block := aPairBlock })

private def pairStore : List (Ixon.Address × Constant) :=
  [(aPairBlock, cPairBlock), (aPairMk, cPairMk)]

private def pairResolver : Ixon.Address → Option Constant := fun a =>
  (pairStore.find? (fun p => p.1 == a)).map (·.2)

private def pairEctx : Ixon.Eval.EvalCtx :=
  { resolve := pairResolver }

private def pairMember : Ixon.Address := Erase.memberAddr aPairBlock 0

private def pairErased : List (Ixon.Address × IxIR0.Decl) :=
  [(pairMember, .defn .shared .erased), (aPairMk, .ctor 0 2)]

private def pairIctx : IxIR0.Ctx :=
  { env := IxIR0.Env.ofList pairErased }

private def pairFrame : Ixon.Eval.Frame :=
  { refs := #[aPairMk], univs := #[.zero] }

private def pairTables : Erase.ETables :=
  { refs := pairFrame.refs, selfMuts := pairFrame.selfMuts }

private def pairSource : Ixon.Expr :=
  .app (.app (.app (.app (.ref 0 #[]) (.sort 0)) (.sort 0)) (.sort 0))
    (.sort 0)

private def pairTarget : IxIR0.Expr :=
  .app (.app (.ref aPairMk) .erased) .erased

private def pairPartialSource : Ixon.Expr :=
  .app (.ref 0 #[]) (.sort 0)

private def pairProjectionSource : Ixon.Expr := .prj 0 1 pairSource
private def pairProjectionTarget : IxIR0.Expr := .proj 1 pairTarget

private def pairNoCover : EraseValidator.CoverOracle pairEctx pairIctx :=
  fun _ => none

-- The constructor declaration is emitted by the real program eraser.  It is
-- intentionally absent from the ordinary `Covered` database: a bare
-- parameterized constructor head is not yet a related value.
#guard (match EraseValidator.certifyProgram pairEctx pairStore [] 100 100 with
  | .ok cert => cert.target == pairErased && cert.coverage.isEmpty
  | .error _ => false)

#guard (match EraseValidator.certifyExpr pairEctx pairIctx pairNoCover none
    pairTables pairFrame.selfAddr [] pairSource 100 100 with
  | .ok cert => cert.target == pairTarget
  | .error _ => false)

-- A constructor pap that escapes before its complete dropped prefix remains
-- outside the relation; the target has already stuttered to the bare head.
#guard (match EraseValidator.certifyExpr pairEctx pairIctx pairNoCover none
    pairTables pairFrame.selfAddr [] pairPartialSource 100 100 with
  | .error (.relation "constructor parameter prefix is incomplete") => true
  | _ => false)

#guard (match EraseValidator.certifyExpr pairEctx pairIctx pairNoCover none
    pairTables pairFrame.selfAddr [] pairProjectionSource 100 100 with
  | .ok cert => cert.target == pairProjectionTarget
  | .error _ => false)

private theorem pairProjectionDer :
    PErase pairEctx pairIctx none pairFrame.refs pairFrame.selfMuts
      pairFrame.selfAddr [] pairProjectionSource pairProjectionTarget := by
  apply EraseValidator.related_of_validateExpr
    (cover := pairNoCover) (fuel := 100)
  decide

theorem pairProjectionSim {fuel : Nat} {v : Ixon.Eval.Value}
    (hev : Ixon.Eval.eval pairEctx fuel pairFrame [] pairProjectionSource =
      .ok v) :
    ∃ fuel' v',
      IxIR0.eval pairIctx fuel' [] pairProjectionTarget = .ok v' ∧
      ValRel pairEctx pairIctx v v' :=
  erasure_sim_closed hev pairProjectionDer

#guard (match Ixon.Eval.eval pairEctx 100 pairFrame [] pairSource with
  | .ok (.ctorV block 0 0 [_, _, _, _]) => block == aPairBlock
  | _ => false)

#guard (match IxIR0.eval pairIctx 100 [] pairTarget with
  | .ok (.ctor address 0 [.erased, .erased]) => address == aPairMk
  | _ => false)

#guard (match Ixon.Eval.eval pairEctx 100 pairFrame [] pairProjectionSource with
  | .ok (.sortV 0) => true
  | _ => false)

#guard (match IxIR0.eval pairIctx 100 [] pairProjectionTarget with
  | .ok .erased => true
  | _ => false)

/-! ## Parameterized recursor instance -/

private def aListBlock : Ixon.Address := addrOf 0x30
private def aList : Ixon.Address := addrOf 0x31
private def aListNil : Ixon.Address := addrOf 0x32
private def aListCons : Ixon.Address := addrOf 0x33
private def aListRec : Ixon.Address := addrOf 0x34

private def listInd : Compilatrix.Ixon.Inductive :=
  { isUnsafe := false, lvls := 0, params := 1, indices := 0
    typ := .sort 0
    ctors := #[
      { isUnsafe := false, lvls := 0, cidx := 0, params := 1, fields := 0
        typ := .sort 0 },
      { isUnsafe := false, lvls := 0, cidx := 1, params := 1, fields := 2
        typ := .sort 0 }] }

/-- A List-shaped recursor telescope. Its type parameter is syntactically
sort-like, so both the executable eraser and `recParamPolicy` ghost it. The
cons rule returns its head field, which makes the fired result easy to pin. -/
private def listRec : Recursor :=
  { k := false, isUnsafe := false, lvls := 0, params := 1, indices := 0
    motives := 1, minors := 2
    typ := .all .many .shared (.sort 0) (.sort 0)
    rules := #[
      { fields := 0
        rhs := .lam .many (.sort 0) (.lam .many (.sort 0)
          (.lam .many (.sort 0) (.lam .many (.sort 0) (.var 1)))) },
      { fields := 2
        rhs := .lam .many (.sort 0) (.lam .many (.sort 0)
          (.lam .many (.sort 0) (.lam .many (.sort 0)
            (.lam .many (.sort 0) (.lam .many (.sort 0) (.var 1)))))) }] }

private def cListBlock : Constant :=
  { info := .muts #[.indc listInd, .recr listRec]
    sharing := #[], refs := #[], univs := #[.zero] }

private def cList :=
  prjConst (.iPrj { idx := 0, block := aListBlock })

private def cListNil :=
  prjConst (.cPrj { idx := 0, cidx := 0, block := aListBlock })

private def cListCons :=
  prjConst (.cPrj { idx := 0, cidx := 1, block := aListBlock })

private def cListRec :=
  prjConst (.rPrj { idx := 1, block := aListBlock })

private def listStore : List (Ixon.Address × Constant) :=
  [(aListBlock, cListBlock), (aList, cList), (aListNil, cListNil),
   (aListCons, cListCons), (aListRec, cListRec)]

private def listResolver : Ixon.Address → Option Constant := fun a =>
  (listStore.find? (fun p => p.1 == a)).map (·.2)

private def listEctx : Ixon.Eval.EvalCtx :=
  { resolve := listResolver }

private def maList : Ixon.Address := Erase.memberAddr aListBlock 0
private def maListRec : Ixon.Address := Erase.memberAddr aListBlock 1

private def listErased : List (Ixon.Address × IxIR0.Decl) :=
  [(maList, .defn .shared .erased),
   (maListRec, .recursor 4 false #[
     { fields := 0, rhs := .var 1 },
     { fields := 2, rhs := .var 1 }]),
   (aList, .defn .shared .erased),
   (aListNil, .ctor 0 0),
   (aListCons, .ctor 1 2),
   (aListRec, .defn .shared (.ref maListRec))]

private def listIctx : IxIR0.Ctx :=
  { env := IxIR0.Env.ofList listErased }

private def listFrame : Ixon.Eval.Frame :=
  { refs := #[aListRec, aListCons], univs := #[.zero] }

private def listTables : Erase.ETables :=
  { refs := listFrame.refs, selfMuts := listFrame.selfMuts }

private def listMajorSource : Ixon.Expr :=
  .app (.app (.app (.ref 1 #[]) (.sort 0)) (.sort 0)) (.sort 0)

private def listMajorTarget : IxIR0.Expr :=
  .app (.app (.ref aListCons) .erased) .erased

private def listRecSource : Ixon.Expr :=
  .app
    (.app (.app (.app (.app (.ref 0 #[]) (.sort 0)) (.sort 0))
      (.sort 0)) (.sort 0))
    listMajorSource

private def listRecTarget : IxIR0.Expr :=
  .app
    (.app (.app (.app (.app (.ref aListRec) .erased) .erased)
      .erased) .erased)
    listMajorTarget

-- Program validation reconstructs the generalized `RecMember` and both
-- parameterized rule witnesses from the executable eraser's exact output.
#guard (match EraseValidator.certifyProgram listEctx listStore [aListRec]
    200 200 with
  | .ok cert => cert.target == listErased && cert.coverage.length == 1
  | .error _ => false)

private theorem covListRec : Covered listEctx listIctx aListRec := by
  apply EraseValidator.covered_of_validate (db := []) (fuel := 200)
  decide

private def listCoverage : EraseValidator.CoverageDB listEctx listIctx :=
  [{ address := aListRec, covered := covListRec }]

private def listCover : EraseValidator.CoverOracle listEctx listIctx :=
  listCoverage.oracle

#guard (match EraseValidator.certifyExpr listEctx listIctx listCover none
    listTables listFrame.selfAddr [] listRecSource 200 200 with
  | .ok cert => cert.target == listRecTarget
  | .error _ => false)

private theorem listRecDer :
    PErase listEctx listIctx none listFrame.refs listFrame.selfMuts
      listFrame.selfAddr [] listRecSource listRecTarget := by
  apply EraseValidator.related_of_validateExpr
    (cover := listCover) (fuel := 200)
  decide

theorem parameterizedListRecSim {fuel : Nat} {v : Ixon.Eval.Value}
    (hev : Ixon.Eval.eval listEctx fuel listFrame [] listRecSource = .ok v) :
    ∃ fuel' v',
      IxIR0.eval listIctx fuel' [] listRecTarget = .ok v' ∧
      ValRel listEctx listIctx v v' :=
  erasure_sim_closed hev listRecDer

#guard (match Ixon.Eval.eval listEctx 200 listFrame [] listRecSource with
  | .ok (.sortV 0) => true
  | _ => false)

#guard (match IxIR0.eval listIctx 200 [] listRecTarget with
  | .ok .erased => true
  | _ => false)

/-! ## Source-only recursor-index instance -/

private def aIxBlock : Ixon.Address := addrOf 0x40
private def aIxCtor : Ixon.Address := addrOf 0x41
private def aIxRec : Ixon.Address := addrOf 0x42

/-- A one-index family with one unary constructor.  The field is runtime
data; the family index is supplied to the recursor but absent from its erased
pre-major application spine. -/
private def ixInd : Compilatrix.Ixon.Inductive :=
  { isUnsafe := false, lvls := 0, params := 0, indices := 1
    typ := .sort 0
    ctors := #[
      { isUnsafe := false, lvls := 0, cidx := 0, params := 0, fields := 1
        typ := .sort 0 }] }

/-- The sole rule returns its constructor field.  Its lambda chain contains
the motive, minor, and field binders; the source-only index is intentionally
not part of the rule environment. -/
private def ixRec : Recursor :=
  { k := false, isUnsafe := false, lvls := 0, params := 0, indices := 1
    motives := 1, minors := 1, typ := .sort 0
    rules := #[
      { fields := 1
        rhs := .lam .many (.sort 0) (.lam .many (.sort 0)
          (.lam .many (.sort 0) (.var 0))) }] }

private def cIxBlock : Constant :=
  { info := .muts #[.indc ixInd, .recr ixRec]
    sharing := #[], refs := #[], univs := #[.zero] }

private def cIxCtor : Constant :=
  prjConst (.cPrj { idx := 0, cidx := 0, block := aIxBlock })

private def cIxRec : Constant :=
  prjConst (.rPrj { idx := 1, block := aIxBlock })

private def ixStore : List (Ixon.Address × Constant) :=
  [(aIxBlock, cIxBlock), (aIxCtor, cIxCtor), (aIxRec, cIxRec)]

private def ixResolver : Ixon.Address → Option Constant := fun a =>
  (ixStore.find? (fun p => p.1 == a)).map (·.2)

private def ixEctx : Ixon.Eval.EvalCtx :=
  { resolve := ixResolver }

private def maIx : Ixon.Address := Erase.memberAddr aIxBlock 0
private def maIxRec : Ixon.Address := Erase.memberAddr aIxBlock 1

private def ixErased : List (Ixon.Address × IxIR0.Decl) :=
  [(maIx, .defn .shared .erased),
   (maIxRec, .recursor 2 false #[{ fields := 1, rhs := .var 0 }]),
   (aIxCtor, .ctor 0 1),
   (aIxRec, .defn .shared (.ref maIxRec))]

private def ixIctx : IxIR0.Ctx :=
  { env := IxIR0.Env.ofList ixErased }

private def ixFrame : Ixon.Eval.Frame :=
  { refs := #[aIxRec, aIxCtor], univs := #[.zero] }

private def ixTables : Erase.ETables :=
  { refs := ixFrame.refs, selfMuts := ixFrame.selfMuts }

private def ixMajorSource : Ixon.Expr :=
  .app (.ref 1 #[]) (.sort 0)

private def ixMajorTarget : IxIR0.Expr :=
  .app (.ref aIxCtor) .erased

/-- Motive, minor, source-only index, then major. -/
private def ixPreMajorSource : Ixon.Expr :=
  .app (.app (.app (.ref 0 #[]) (.sort 0)) (.sort 0)) (.sort 0)

private def ixPreMajorTarget : IxIR0.Expr :=
  .app (.app (.ref aIxRec) .erased) .erased

private def ixIncompleteSource : Ixon.Expr :=
  .app (.app (.ref 0 #[]) (.sort 0)) (.sort 0)

private def ixRecSource : Ixon.Expr :=
  .app ixPreMajorSource ixMajorSource

/-- The index application has disappeared; target saturation still happens
only when the major is appended. -/
private def ixRecTarget : IxIR0.Expr :=
  .app ixPreMajorTarget ixMajorTarget

private theorem covIxCtor : Covered ixEctx ixIctx aIxCtor := by
  apply EraseValidator.covered_of_validate (db := []) (fuel := 200)
  decide

private def ixCoverage : EraseValidator.CoverageDB ixEctx ixIctx :=
  [{ address := aIxCtor, covered := covIxCtor }]

private def ixCover : EraseValidator.CoverOracle ixEctx ixIctx :=
  ixCoverage.oracle

private theorem ixResolveRec :
    Ixon.Eval.resolveMut ixEctx aIxBlock 1 =
      .ok (cIxBlock, .recr ixRec) := by
  rfl

private theorem ixMember : RecMember ixEctx ixIctx aIxBlock 1 ixRec := by
  apply EraseValidator.recMember_of_validate
    (db := []) (bc := cIxBlock) (hm := ixResolveRec) (fuel := 200)
  decide

private def ixRecMembers : EraseValidator.RecMemberOracle ixEctx ixIctx :=
  fun block idx bc r hm =>
    if hb : block = aIxBlock then
      if hi : idx = 1 then
        some ⟨by
          subst block
          subst idx
          rw [ixResolveRec] at hm
          injection hm with hpair
          injection hpair with hbc hrecr
          injection hrecr with hr
          subst bc
          subst r
          exact ixMember⟩
      else none
    else none

-- The indexed projection is intentionally not `Covered`; only the unary
-- constructor is scheduled. The member declaration is used by the entry
-- oracle directly.
#guard (match EraseValidator.certifyProgram ixEctx ixStore [aIxCtor] 200 200 with
  | .ok cert => cert.target == ixErased && cert.coverage.length == 1
  | .error _ => false)

#guard (match EraseValidator.certifyExprWithRec ixEctx ixIctx ixCover
    ixRecMembers none ixTables ixFrame.selfAddr [] ixRecSource 200 200 with
  | .ok cert => cert.target == ixRecTarget
  | .error _ => false)

-- The target pap is already one argument from firing at this point, while the
-- source still owes its index and major.  It must not escape into `ValRel`.
#guard (match EraseValidator.certifyExprWithRec ixEctx ixIctx ixCover
    ixRecMembers none ixTables ixFrame.selfAddr [] ixIncompleteSource
    200 200 with
  | .error _ => true
  | .ok _ => false)

private theorem ixRecDer :
    PErase ixEctx ixIctx none ixFrame.refs ixFrame.selfMuts
      ixFrame.selfAddr [] ixRecSource ixRecTarget := by
  apply EraseValidator.related_of_validateExprWithRec
    (cover := ixCover) (recMembers := ixRecMembers) (fuel := 200)
  decide

theorem indexedRecSim {fuel : Nat} {v : Ixon.Eval.Value}
    (hev : Ixon.Eval.eval ixEctx fuel ixFrame [] ixRecSource = .ok v) :
    ∃ fuel' v',
      IxIR0.eval ixIctx fuel' [] ixRecTarget = .ok v' ∧
      ValRel ixEctx ixIctx v v' :=
  erasure_sim_closed hev ixRecDer

#guard (match Ixon.Eval.eval ixEctx 200 ixFrame [] ixRecSource with
  | .ok (.sortV 0) => true
  | _ => false)

#guard (match IxIR0.eval ixIctx 200 [] ixRecTarget with
  | .ok .erased => true
  | _ => false)

/-! ## Sharing composition instance

This fixture keeps the entry expression share-free but stores the referenced
definition behind a valid sharing table.  Both the program and expression
certificates are produced from the executable eraser's exact output; the
simulation theorem reaches that certificate through semantic inlining. -/

private def aShared : Ixon.Address := addrOf 0xE1

private def cShared : Ixon.Constant :=
  { info := .defn
      { kind := .defn, safety := .safe, lvls := 0
        typ := .share 0, value := .share 0 }
    sharing := #[.sort 0], refs := #[], univs := #[.zero] }

private def sharedStore : List (Ixon.Address × Ixon.Constant) :=
  [(aShared, cShared)]

private def sharedEctx : Ixon.Eval.EvalCtx :=
  { resolve := fun address =>
      if address = aShared then some cShared else none }

private theorem sharedEctxWF : sharedEctx.SharingWF := by
  constructor
  intro address c hresolve
  by_cases haddress : address = aShared
  · simp [sharedEctx, haddress] at hresolve
    subst c
    simp [cShared, Ixon.Constant.sharingWF, Ixon.Sharing.layer1WF,
      Ixon.Sharing.tableWF, Ixon.Sharing.entriesWF,
      Ixon.Sharing.entryWF, Ixon.Sharing.sharesBelow,
      Ixon.Sharing.entriesUsedTwice, Ixon.Sharing.countShare,
      Ixon.ConstantInfo.exprs, Ixon.Definition.exprs]
  · simp [sharedEctx, haddress] at hresolve

private def sharedIctx : IxIR0.Ctx :=
  { env := fun address =>
      if address = aShared then some (.defn .shared .erased) else none }

private def dSharedInlined : Ixon.Definition :=
  { kind := .defn, safety := .safe, lvls := 0
    typ := .sort 0, value := .sort 0 }

private theorem sharedCovered :
    Covered sharedEctx.inlineSharing sharedIctx aShared := by
  apply Covered.defn (c := cShared.inlineSharing)
    (d := dSharedInlined) (result := .shared) (body' := .erased)
  · simp [sharedEctx, Ixon.Eval.EvalCtx.inlineSharing]
  · simp [cShared, Ixon.Constant.inlineSharing,
      Ixon.ConstantInfo.mapExprs, Ixon.ConstantIdentityLaws.mapInfo,
      Ixon.ConstantIdentityLaws.mapDefinition,
      Ixon.Sharing.inlineExpr, Ixon.Sharing.inlineTable,
      Ixon.Sharing.inlineEntries, Ixon.Sharing.substShares,
      Ixon.Sharing.substSharesList, dSharedInlined]
  · rfl
  · simp [sharedIctx]
  · exact .sortE

private def sharedCoverage :
    EraseValidator.CoverageDB sharedEctx.inlineSharing sharedIctx :=
  [{ address := aShared, covered := sharedCovered }]

private def sharedCover :
    EraseValidator.CoverOracle sharedEctx.inlineSharing sharedIctx :=
  sharedCoverage.oracle

private def sharedFrame : Ixon.Eval.Frame :=
  { refs := #[aShared] }

private theorem sharedFrameWF : sharedFrame.SharingWF := by
  constructor
  · decide
  · intro i member hget
    simp [sharedFrame] at hget

private def sharedSource : Ixon.Expr := .ref 0 #[]

#guard (match EraseValidator.certifySharedProgram sharedEctx sharedStore
    [aShared] 100 100 with
  | .ok cert => cert.target == [(aShared, .defn .shared .erased)]
  | .error _ => false)

#guard (match EraseValidator.certifySharedClosedExpr sharedEctx sharedIctx
    sharedCover sharedFrame sharedSource 100 100 with
  | .ok cert => cert.target == .ref aShared
  | .error _ => false)

private theorem sharedPErase :
    PErase sharedEctx.inlineSharing sharedIctx none
      sharedFrame.inlineSharing.refs sharedFrame.inlineSharing.selfMuts
      sharedFrame.inlineSharing.selfAddr []
      (Ixon.Sharing.inlineExpr sharedFrame.sharing sharedSource)
      (.ref aShared) := by
  simpa [sharedFrame, sharedSource, Ixon.Eval.Frame.inlineSharing,
    Ixon.Sharing.inlineExpr, Ixon.Sharing.inlineTable,
    Ixon.Sharing.inlineEntries, Ixon.Sharing.substShares,
    Ixon.Sharing.substSharesList] using
    (PErase.ref (mask := []) (refs := sharedFrame.inlineSharing.refs)
      (muts := sharedFrame.inlineSharing.selfMuts)
      (sa := sharedFrame.inlineSharing.selfAddr) (sc := none)
      (refIdx := 0) (univIdxs := #[]) (a := aShared) rfl sharedCovered)

/-- A real shared definition, certified through the executable program and
expression erasers, instantiates the composed sharing/erasure simulation. -/
theorem sharedDefinitionSim {fuel : Nat} {v : Ixon.Eval.Value}
    (hev : Ixon.Eval.eval sharedEctx fuel sharedFrame [] sharedSource =
      .ok v) :
    ∃ fuel' v',
      IxIR0.eval sharedIctx fuel' [] (.ref aShared) = .ok v' ∧
      InlinedValRel sharedEctx sharedIctx v v' := by
  apply erasure_sim_inlineSharing_closed sharedEctxWF sharedFrameWF
    (e := sharedSource) (e' := .ref aShared)
  · decide
  · exact hev
  · exact sharedPErase

#guard (match Ixon.Eval.eval sharedEctx 100 sharedFrame [] sharedSource with
  | .ok (.sortV 0) => true
  | _ => false)

#guard (match IxIR0.eval sharedIctx 100 [] (.ref aShared) with
  | .ok .erased => true
  | _ => false)

end Compilatrix.SimInstance
